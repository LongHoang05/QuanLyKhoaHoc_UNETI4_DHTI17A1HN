<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UNETI ADMIN</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        @layer base {
            html, body { margin: 0; padding: 0; }
            body { overscroll-behavior: none; }
            main > :first-child { margin-top: 0 !important; }
            main > :last-child { margin-bottom: 0 !important; }
        }
        ::-webkit-scrollbar { display: none; }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
    tailwind.config = { 
        darkMode: "class", 
        corePlugins: { preflight: false },
        theme: { 
            extend: { 
                "colors": { "inverse-primary": "#bec6e0", "surface-variant": "#d3e4fe", "on-primary": "#ffffff", "surface-bright": "#f8f9ff", "tertiary-container": "#002114", "on-secondary-fixed-variant": "#004b73", "surface-container-high": "#dce9ff", "on-tertiary-fixed-variant": "#005137", "primary": "#000000", "on-surface-variant": "#45464d", "surface-tint": "#565e74", "tertiary": "#000000", "surface-container-low": "#eff4ff", "on-primary-fixed-variant": "#3f465c", "on-secondary-container": "#00476e", "surface-container-lowest": "#ffffff", "on-primary-container": "#7c839b", "on-tertiary-container": "#069669", "on-surface": "#0b1c30", "on-primary-fixed": "#131b2e", "on-background": "#0b1c30", "surface": "#f8f9ff", "tertiary-fixed-dim": "#68dba9", "secondary-fixed-dim": "#93ccff", "background": "#f8f9ff", "on-secondary-fixed": "#001d31", "on-secondary": "#ffffff", "on-error-container": "#93000a", "outline-variant": "#c6c6cd", "on-tertiary-fixed": "#002114", "on-tertiary": "#ffffff", "inverse-surface": "#213145", "surface-container": "#e5eeff", "secondary": "#006398", "surface-container-highest": "#d3e4fe", "secondary-fixed": "#cce5ff", "surface-dim": "#cbdbf5", "error-container": "#ffdad6", "primary-container": "#131b2e", "primary-fixed-dim": "#bec6e0", "tertiary-fixed": "#85f8c4", "inverse-on-surface": "#eaf1ff", "error": "#ba1a1a", "primary-fixed": "#dae2fd", "outline": "#76777d", "secondary-container": "#5bb8fe", "on-error": "#ffffff" }, 
                "borderRadius": { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" }, 
                "spacing": { "space-xl": "2.5rem", "margin-mobile": "1rem", "margin": "2rem", "space-sm": "0.5rem", "space-xs": "0.25rem", "gutter": "1.5rem", "gutter-mobile": "0.75rem", "space-lg": "1.5rem", "space-md": "1rem" }, 
                "fontFamily": { "display-lg": ["Be Vietnam Pro"], "body-lg": ["Be Vietnam Pro"], "label-lg": ["Be Vietnam Pro"], "headline-md": ["Be Vietnam Pro"], "body-md": ["Be Vietnam Pro"], "headline-sm": ["Be Vietnam Pro"], "headline-lg": ["Be Vietnam Pro"], "label-sm": ["Be Vietnam Pro"], "headline-lg-mobile": ["Be Vietnam Pro"], "label-md": ["Be Vietnam Pro"], "body-sm": ["Be Vietnam Pro"] }, 
                "fontSize": { "display-lg": ["36px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }], "body-lg": ["16px", { "lineHeight": "26px", "fontWeight": "400" }], "label-lg": ["14px", { "lineHeight": "20px", "fontWeight": "600" }], "headline-md": ["20px", { "lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": "600" }], "body-md": ["14px", { "lineHeight": "22px", "fontWeight": "400" }], "headline-sm": ["16px", { "lineHeight": "24px", "fontWeight": "600" }], "headline-lg": ["28px", { "lineHeight": "38px", "letterSpacing": "-0.015em", "fontWeight": "700" }], "label-sm": ["11px", { "lineHeight": "16px", "letterSpacing": "0.03em", "fontWeight": "500" }], "headline-lg-mobile": ["22px", { "lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700" }], "label-md": ["12px", { "lineHeight": "18px", "letterSpacing": "0.02em", "fontWeight": "600" }], "body-sm": ["13px", { "lineHeight": "20px", "fontWeight": "400" }] } 
            } 
        } 
    }
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const currentPath = window.location.pathname.toLowerCase();
            const links = document.querySelectorAll('.nav-link');
            
            links.forEach(link => {
                const href = link.getAttribute('href').toLowerCase();
                if (currentPath === href || (currentPath === '/' && href === '/thongke/dashboard')) {
                    link.className = 'nav-link px-3.5 py-2 rounded-lg flex items-center gap-2 transition-all duration-150 bg-inverse-surface text-on-primary font-label-lg shadow-xs';
                    const icon = link.querySelector('span.material-symbols-outlined');
                    if(icon) {
                        icon.classList.add('text-secondary-container');
                    }
                }
            });

            // Mobile menu toggle
            const menuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            if (menuBtn && mobileMenu) {
                menuBtn.addEventListener('click', () => {
                    mobileMenu.classList.toggle('hidden');
                });
            }
        });
    </script>
</head>
<body class="bg-surface font-body-md text-on-surface antialiased">
    <header class="sticky top-0 z-50 w-full bg-primary-container shadow-md border-b border-inverse-surface select-none">
        <div class="w-full px-4 md:px-6 flex items-center justify-between h-16 gap-4">
            <div class="flex items-center gap-4 md:gap-8">
                <!-- Hamburger Menu for Mobile -->
                <button id="mobile-menu-btn" class="md:hidden flex items-center justify-center p-2 rounded-lg text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-colors">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                
                <div class="flex items-center gap-3 shrink-0">
                    <div class="w-10 h-10 rounded-lg bg-secondary flex items-center justify-center shadow-xs">
                        <span class="material-symbols-outlined text-on-secondary text-[22px]">school</span>
                    </div>
                    <div class="flex flex-col hidden sm:flex">
                        <span class="font-headline-sm text-headline-sm text-on-primary tracking-tight font-bold">UNETI ADMIN</span>
                        <span class="font-label-sm text-label-sm text-primary-fixed-dim uppercase tracking-wider">Đại học KT-KTCN</span>
                    </div>
                </div>
                
                <nav class="hidden md:flex items-center gap-1.5">
                    <a class="nav-link px-3.5 py-2 rounded-lg flex items-center gap-2 font-body-md text-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all duration-150" href="/ThongKe/Dashboard">
                        <span class="material-symbols-outlined text-[18px]">dashboard</span>
                        <span>Dashboard</span>
                    </a>
                    <a class="nav-link px-3.5 py-2 rounded-lg flex items-center gap-2 font-body-md text-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all duration-150" href="/BuoiHoc/Index">
                        <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                        <span>Quản lý Lịch học</span>
                    </a>
                    <a class="nav-link px-3.5 py-2 rounded-lg flex items-center gap-2 font-body-md text-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all duration-150" href="/KetQuaHocTap/Index">
                        <span class="material-symbols-outlined text-[18px]">workspace_premium</span>
                        <span>Kết quả học tập</span>
                    </a>
                    <a class="nav-link px-3.5 py-2 rounded-lg flex items-center gap-2 font-body-md text-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all duration-150" href="/ThongKe/Index">
                        <span class="material-symbols-outlined text-[18px]">bar_chart</span>
                        <span>Báo cáo Thống kê</span>
                    </a>
                </nav>
            </div>
            <div class="flex items-center gap-3 shrink-0">
                <div class="hidden xl:flex items-center gap-2 px-3 py-1 rounded-full bg-inverse-surface border border-surface-container-high/20">
                    <span class="material-symbols-outlined text-tertiary-fixed text-[16px]">verified</span>
                    <span class="font-label-sm text-label-sm text-primary-fixed-dim">Học kỳ:</span>
                    <span class="font-label-md text-label-md text-on-primary font-semibold">HK1 - 2024-2025</span>
                </div>
                <div class="flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-inverse-surface">
                    <div class="relative flex items-center justify-center">
                        <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">
                            <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                        </div>
                        <span class="absolute bottom-0 right-0 w-2 h-2 rounded-full bg-tertiary-fixed"></span>
                    </div>
                    <div class="flex flex-col text-left hidden sm:flex">
                        <span class="font-label-md text-label-md text-on-primary leading-tight font-semibold">Giáo vụ (SV5)</span>
                        <span class="font-label-sm text-label-sm text-tertiary-fixed leading-none">Trực tuyến</span>
                    </div>
                </div>
                <a class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary font-label-md text-label-md transition-colors" href="#">
                    <span class="material-symbols-outlined text-[18px]">logout</span>
                    <span class="hidden lg:inline">Đăng xuất</span>
                </a>
            </div>
        </div>
        
        <!-- Mobile Navigation Menu -->
        <div id="mobile-menu" class="hidden md:hidden w-full bg-primary-container border-t border-inverse-surface px-4 py-3">
            <nav class="flex flex-col gap-2">
                <a class="nav-link px-3.5 py-2 rounded-lg flex items-center gap-2 font-body-md text-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all duration-150" href="/ThongKe/Dashboard">
                    <span class="material-symbols-outlined text-[18px]">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a class="nav-link px-3.5 py-2 rounded-lg flex items-center gap-2 font-body-md text-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all duration-150" href="/BuoiHoc/Index">
                    <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                    <span>Quản lý Lịch học</span>
                </a>
                <a class="nav-link px-3.5 py-2 rounded-lg flex items-center gap-2 font-body-md text-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all duration-150" href="/KetQuaHocTap/Index">
                    <span class="material-symbols-outlined text-[18px]">workspace_premium</span>
                    <span>Kết quả học tập</span>
                </a>
                <a class="nav-link px-3.5 py-2 rounded-lg flex items-center gap-2 font-body-md text-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all duration-150" href="/ThongKe/Index">
                    <span class="material-symbols-outlined text-[18px]">bar_chart</span>
                    <span>Báo cáo Thống kê</span>
                </a>
            </nav>
        </div>
    </header>

    <main class="relative min-h-screen bg-surface px-3 py-3 md:px-6 md:py-6">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>