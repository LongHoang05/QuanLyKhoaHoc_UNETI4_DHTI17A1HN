<!DOCTYPE html>
<html class="h-full bg-slate-50" lang="vi">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewData["Title"] - UNETI ADMIN</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        ::-webkit-scrollbar { display: none; }
    </style>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>
<body class="min-h-full bg-slate-50/70 text-slate-800 antialiased selection:bg-indigo-500 selection:text-white">
    <div class="min-h-screen flex flex-col relative overflow-x-hidden">
        <!-- Background Ambient Glow -->
        <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
            <div class="absolute -top-[20%] left-1/2 -translate-x-1/2 w-[1000px] h-[450px] bg-gradient-to-tr from-indigo-200/35 via-blue-100/30 to-violet-200/20 blur-[130px] rounded-full"></div>
            <div class="absolute top-[35%] -left-[10%] w-[600px] h-[500px] bg-blue-100/30 blur-[120px] rounded-full"></div>
        </div>
        
        <!-- Header (Dark Obsidian / Glassmorphic Executive Bar) -->
        <header class="sticky top-0 z-50 w-full bg-slate-950/90 backdrop-blur-md border-b border-slate-800/80 shadow-2xl shadow-slate-950/20 select-none">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16 gap-4">
                <!-- Brand & Primary Nav -->
                <div class="flex items-center gap-8">
                    <div class="flex items-center gap-3 shrink-0 group cursor-pointer">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 via-indigo-600 to-violet-700 flex items-center justify-center shadow-lg shadow-indigo-500/25 ring-1 ring-white/20 transition-transform duration-200 group-hover:scale-105">
                            <span class="material-symbols-outlined text-white text-[22px]">school</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-sm font-extrabold tracking-tight text-white flex items-center gap-1.5">
                                UNETI <span class="text-[10px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">ADMIN</span>
                            </span>
                            <span class="text-[10px] text-slate-400 uppercase tracking-wider font-medium">Đại học KT-KTCN</span>
                        </div>
                    </div>
                    
                    <!-- Navigation Tabs -->
                    <nav class="hidden md:flex items-center gap-1 p-1 rounded-full bg-slate-900/80 border border-slate-800/80">
                        <a class="nav-link px-3.5 py-1.5 rounded-full flex items-center gap-2 text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all duration-150" href="/ThongKe/Dashboard">
                            <span class="material-symbols-outlined text-[17px] text-slate-400">dashboard</span>
                            <span class="">Dashboard</span>
                        </a>
                        <a class="nav-link px-3.5 py-1.5 rounded-full flex items-center gap-2 text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all duration-150" href="/BuoiHoc/Index">
                            <span class="material-symbols-outlined text-[17px] text-slate-400">calendar_month</span>
                            <span class="">Quản lý Lịch học</span>
                        </a>
                        <a class="nav-link px-3.5 py-1.5 rounded-full flex items-center gap-2 text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all duration-150" href="/KetQuaHocTap/Index">
                            <span class="material-symbols-outlined text-[17px] text-slate-400">workspace_premium</span>
                            <span class="">Kết quả học tập</span>
                        </a>
                        <a class="nav-link px-3.5 py-1.5 rounded-full flex items-center gap-2 text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all duration-150" href="/ThongKe/Index">
                            <span class="material-symbols-outlined text-[17px] text-slate-400">bar_chart</span>
                            <span class="">Báo cáo Thống kê</span>
                        </a>
                    </nav>
                </div>
                
                <!-- Actions & Profile -->
                <div class="flex items-center gap-3 shrink-0">
                    <div class="flex items-center gap-2.5 pl-2 pr-3.5 py-1 rounded-full bg-slate-900/90 border border-slate-800 hover:border-slate-700 transition cursor-pointer">
                        <div class="relative flex items-center justify-center">
                            <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-indigo-500 to-cyan-400 text-white font-bold text-xs flex items-center justify-center ring-2 ring-slate-950">
                                SV
                            </div>
                            <span class="absolute -bottom-0.5 -right-0.5 w-2 h-2 rounded-full bg-emerald-400 ring-2 ring-slate-950"></span>
                        </div>
                        <div class="flex flex-col text-left">
                            <span class="text-xs text-white font-semibold leading-tight">Giáo vụ (SV5)</span>
                            <span class="text-[10px] text-emerald-400 leading-none">Trực tuyến</span>
                        </div>
                    </div>
                    <a class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-slate-400 hover:text-rose-300 hover:bg-rose-500/10 text-xs font-medium transition-all" href="#">
                        <span class="material-symbols-outlined text-[18px]">logout</span>
                        <span class="hidden sm:inline">Đăng xuất</span>
                    </a>
                </div>
            </div>
        </header>

        <!-- Main Workspace -->
        <main class="relative z-10 flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
            @RenderBody()
        </main>
    </div>

    <!-- Active Link Highlighter -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const currentPath = window.location.pathname.toLowerCase();
            const links = document.querySelectorAll('.nav-link');
            
            links.forEach(link => {
                const href = link.getAttribute('href').toLowerCase();
                if (currentPath === href || (currentPath === '/' && href === '/thongke/dashboard')) {
                    // Remove inactive classes
                    link.classList.remove('text-slate-300', 'font-medium', 'hover:text-white', 'hover:bg-slate-800/70');
                    // Add active classes
                    link.classList.add('text-white', 'bg-indigo-600', 'shadow-sm', 'shadow-indigo-500/30', 'font-semibold');
                    
                    const icon = link.querySelector('span.material-symbols-outlined');
                    if(icon) {
                        icon.classList.remove('text-slate-400');
                    }
                }
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
