<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UNETI ADMIN</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        @layer base {
            html, body { margin: 0; padding: 0; }
            body { overscroll-behavior: none; }
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
    tailwind.config = { 
        darkMode: "class", 
        corePlugins: { preflight: false },
        theme: { 
            extend: { 
                "colors": { "inverse-primary": "#bec6e0", "surface-variant": "#d3e4fe", "on-primary": "#ffffff", "surface-bright": "#f8f9ff", "tertiary-container": "#002114", "on-secondary-fixed-variant": "#004b73", "surface-container-high": "#dce9ff", "on-tertiary-fixed-variant": "#005137", "primary": "#000000", "on-surface-variant": "#45464d", "surface-tint": "#565e74", "tertiary": "#000000", "surface-container-low": "#eff4ff", "on-primary-fixed-variant": "#3f465c", "on-secondary-container": "#00476e", "surface-container-lowest": "#ffffff", "on-primary-container": "#7c839b", "on-tertiary-container": "#069669", "on-surface": "#0b1c30", "on-primary-fixed": "#131b2e", "on-background": "#0b1c30", "surface": "#f8f9ff", "tertiary-fixed-dim": "#68dba9", "secondary-fixed-dim": "#93ccff", "background": "#f8f9ff", "on-secondary-fixed": "#001d31", "on-secondary": "#ffffff", "on-error-container": "#93000a", "outline-variant": "#c6c6cd", "on-tertiary-fixed": "#002114", "on-tertiary": "#ffffff", "inverse-surface": "#213145", "surface-container": "#e5eeff", "secondary": "#006398", "surface-container-highest": "#d3e4fe", "secondary-fixed": "#cce5ff", "surface-dim": "#cbdbf5", "error-container": "#ffdad6", "primary-container": "#131b2e", "primary-fixed-dim": "#bec6e0", "tertiary-fixed": "#85f8c4", "inverse-on-surface": "#eaf1ff", "error": "#ba1a1a", "primary-fixed": "#dae2fd", "outline": "#76777d", "secondary-container": "#5bb8fe", "on-error": "#ffffff" }, 
                "borderRadius": { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" }, 
                "fontFamily": { "display-lg": ["Be Vietnam Pro"], "body-lg": ["Be Vietnam Pro"], "label-lg": ["Be Vietnam Pro"], "headline-md": ["Be Vietnam Pro"], "body-md": ["Be Vietnam Pro"], "headline-sm": ["Be Vietnam Pro"], "headline-lg": ["Be Vietnam Pro"], "label-sm": ["Be Vietnam Pro"], "headline-lg-mobile": ["Be Vietnam Pro"], "label-md": ["Be Vietnam Pro"], "body-sm": ["Be Vietnam Pro"] } 
            } 
        } 
    }
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const currentPath = window.location.pathname.toLowerCase();
            const links = document.querySelectorAll('.nav-link');
            
            links.forEach(link => {
                const href = link.getAttribute('href').toLowerCase();
                if (currentPath === href || (currentPath === '/' && href === '/thongke/dashboard')) {
                    link.className = 'nav-link px-4 py-3 rounded-lg flex items-center gap-3 transition-all duration-150 bg-inverse-surface text-on-primary font-label-lg shadow-xs';
                    const icon = link.querySelector('span.material-symbols-outlined');
                    if(icon) {
                        icon.classList.add('text-secondary-container');
                    }
                }
            });

            // Mobile menu toggle
            const menuBtn = document.getElementById('mobile-menu-btn');
            const closeBtn = document.getElementById('mobile-menu-close');
            const mobileMenu = document.getElementById('mobile-sidebar');
            
            if (menuBtn && mobileMenu) {
                menuBtn.addEventListener('click', () => {
                    mobileMenu.classList.remove('-translate-x-full');
                });
            }
            if (closeBtn && mobileMenu) {
                closeBtn.addEventListener('click', () => {
                    mobileMenu.classList.add('-translate-x-full');
                });
            }
        });
    </script>
</head>
<body class="bg-surface font-body-md text-on-surface antialiased flex h-screen overflow-hidden">
    
    <!-- DESKTOP SIDEBAR -->
    <aside class="hidden md:flex flex-col w-64 bg-primary-container shadow-md border-r border-inverse-surface shrink-0 h-full">
        <!-- Logo Area -->
        <div class="h-20 flex items-center gap-3 px-6 shrink-0 border-b border-inverse-surface/50">
            <div class="w-10 h-10 rounded-lg bg-secondary flex items-center justify-center shadow-xs">
                <span class="material-symbols-outlined text-on-secondary text-[22px]">school</span>
            </div>
            <div class="flex flex-col">
                <span class="font-headline-sm text-headline-sm text-on-primary tracking-tight font-bold">UNETI ADMIN</span>
                <span class="font-label-sm text-label-sm text-primary-fixed-dim uppercase tracking-wider">Đại học KT-KTCN</span>
            </div>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 px-4 py-6 flex flex-col gap-2 overflow-y-auto">
            <a class="nav-link px-4 py-3 rounded-lg flex items-center gap-3 font-body-md text-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all duration-150" href="/ThongKe/Dashboard">
                <span class="material-symbols-outlined text-[20px]">dashboard</span>
                <span>Dashboard</span>
            </a>
            <a class="nav-link px-4 py-3 rounded-lg flex items-center gap-3 font-body-md text-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all duration-150" href="/BuoiHoc/Index">
                <span class="material-symbols-outlined text-[20px]">calendar_month</span>
                <span>Quản lý Lịch học</span>
            </a>
            <a class="nav-link px-4 py-3 rounded-lg flex items-center gap-3 font-body-md text-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all duration-150" href="/KetQuaHocTap/Index">
                <span class="material-symbols-outlined text-[20px]">workspace_premium</span>
                <span>Kết quả học tập</span>
            </a>
            <a class="nav-link px-4 py-3 rounded-lg flex items-center gap-3 font-body-md text-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all duration-150" href="/ThongKe/Index">
                <span class="material-symbols-outlined text-[20px]">bar_chart</span>
                <span>Báo cáo Thống kê</span>
            </a>
        </nav>

        <!-- User Profile Area -->
        <div class="p-4 border-t border-inverse-surface shrink-0">
            <div class="flex items-center gap-3 mb-4 px-2">
                <div class="relative flex items-center justify-center">
                    <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-on-primary text-[20px]">person</span>
                    </div>
                    <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-tertiary-fixed border-2 border-primary-container"></span>
                </div>
                <div class="flex flex-col text-left">
                    <span class="font-label-md text-label-md text-on-primary font-semibold">Giáo vụ (SV5)</span>
                    <span class="font-label-sm text-label-sm text-primary-fixed-dim">Học kỳ 1 - 2024</span>
                </div>
            </div>
            <a class="flex items-center justify-center gap-2 w-full py-2.5 rounded-lg text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary font-label-md transition-colors border border-inverse-surface" href="#">
                <span class="material-symbols-outlined text-[18px]">logout</span>
                <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <!-- MOBILE SIDEBAR (Offcanvas) -->
    <div id="mobile-sidebar" class="fixed inset-y-0 left-0 z-[60] w-64 bg-primary-container shadow-2xl transform -translate-x-full transition-transform duration-300 md:hidden flex flex-col h-full">
        <div class="h-16 flex items-center justify-between px-4 border-b border-inverse-surface/50">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary text-[22px]">school</span>
                <span class="font-headline-sm text-on-primary font-bold">UNETI ADMIN</span>
            </div>
            <button id="mobile-menu-close" class="text-primary-fixed-dim hover:text-on-primary p-1">
                <span class="material-symbols-outlined text-[24px]">close</span>
            </button>
        </div>
        <nav class="flex-1 px-3 py-4 flex flex-col gap-2 overflow-y-auto">
            <a class="nav-link px-4 py-3 rounded-lg flex items-center gap-3 font-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all" href="/ThongKe/Dashboard">
                <span class="material-symbols-outlined">dashboard</span> Dashboard
            </a>
            <a class="nav-link px-4 py-3 rounded-lg flex items-center gap-3 font-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all" href="/BuoiHoc/Index">
                <span class="material-symbols-outlined">calendar_month</span> Quản lý Lịch học
            </a>
            <a class="nav-link px-4 py-3 rounded-lg flex items-center gap-3 font-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all" href="/KetQuaHocTap/Index">
                <span class="material-symbols-outlined">workspace_premium</span> Kết quả học tập
            </a>
            <a class="nav-link px-4 py-3 rounded-lg flex items-center gap-3 font-body-md text-primary-fixed-dim hover:bg-inverse-surface hover:text-on-primary transition-all" href="/ThongKe/Index">
                <span class="material-symbols-outlined">bar_chart</span> Báo cáo Thống kê
            </a>
        </nav>
    </div>

    <!-- MAIN CONTENT AREA -->
    <div class="flex-1 flex flex-col h-full overflow-hidden bg-surface">
        
        <!-- Mobile Header (Only visible on small screens) -->
        <header class="md:hidden flex items-center justify-between px-4 h-16 bg-primary-container shrink-0 shadow-sm border-b border-inverse-surface">
            <div class="flex items-center gap-3">
                <button id="mobile-menu-btn" class="text-primary-fixed-dim hover:text-on-primary p-1 rounded-lg">
                    <span class="material-symbols-outlined text-[24px]">menu</span>
                </button>
                <span class="font-headline-sm text-on-primary font-bold">UNETI ADMIN</span>
            </div>
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center relative">
                <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                <span class="absolute bottom-0 right-0 w-2 h-2 rounded-full bg-tertiary-fixed"></span>
            </div>
        </header>

        <!-- Main Scrolling Content -->
        <main class="flex-1 overflow-y-auto p-4 md:p-8">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>