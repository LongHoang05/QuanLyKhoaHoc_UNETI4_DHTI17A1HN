    <section id="lien-he" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-24">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Left: Consultation Form -->
            <div class="lg:col-span-6 bg-gradient-to-br from-brand-deep to-[#002f87] text-white rounded-3xl p-6 sm:p-10 shadow-xl space-y-6">
                <div>
                    <span class="text-xs font-bold text-amber-300 uppercase tracking-wider">Hỗ trợ 1-1 Miễn Phí</span>
                    <h3 class="text-2xl font-black text-white mt-1">Đăng Ký Nhận Tư Vấn Lộ Trình</h3>
                    <p class="text-xs text-slate-200 mt-1 leading-relaxed">
                        Chuyên viên tư vấn học vụ sẽ phân tích năng lực và gợi ý lộ trình học tập tối ưu nhất cho định hướng sự nghiệp của bạn.
                    </p>
                </div>

                <form id="tuvanForm" onsubmit="submitTuVan(event)" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-300 mb-1">Họ và tên của bạn <span class="text-amber-400">*</span></label>
                        <input type="text" name="hoTen" value="@(currentStudent?.HoTen ?? "")" required placeholder="Nguyễn Văn A"
                               class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-amber-300 text-xs sm:text-sm" />
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-300 mb-1">Số điện thoại <span class="text-amber-400">*</span></label>
                            <input type="tel" name="soDienThoai" value="@(currentStudent?.SoDienThoai ?? "")" required placeholder="0987654321"
                                   class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-amber-300 text-xs sm:text-sm font-mono" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-300 mb-1">Email liên hệ</label>
                            <input type="email" name="email" value="@(currentStudent?.Email ?? "")" placeholder="email@gmail.com"
                                   class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-amber-300 text-xs sm:text-sm" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-300 mb-1">Khóa học bạn quan tâm</label>
                        <select name="khoaHocQuanTam" class="w-full px-4 py-3 rounded-xl bg-slate-800 border border-white/20 text-white focus:outline-none focus:ring-2 focus:ring-amber-300 text-xs sm:text-sm">
                            <option value="">-- Chọn khóa học bạn mong muốn tìm hiểu --</option>
                            @foreach (var lop in hotCourses)
                            {
                                <option value="@lop.TenLop">@lop.TenLop</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="w-full py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-900 font-extrabold text-xs sm:text-sm shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">send</span>
                        <span>Gửi Yêu Cầu Tư Vấn Ngay</span>
                    </button>
                </form>
            </div>

            <!-- Right: Frequently Asked Questions (FAQ) -->
            <div class="lg:col-span-6 bg-white rounded-3xl p-6 sm:p-10 border border-border-standard shadow-xs space-y-6">
                <div>
                    <span class="text-xs font-bold text-primary uppercase tracking-wider">Giải đáp thắc mắc</span>
                    <h3 class="text-2xl font-black text-brand-deep mt-1">Câu Hỏi Thường Gặp (FAQ)</h3>
                </div>

                <div class="space-y-3 text-xs">
                    <details class="group border border-border-standard rounded-2xl p-4 [&_summary::-webkit-details-marker]:hidden cursor-pointer" open>
                        <summary class="flex items-center justify-between font-bold text-brand-deep">
                            <span>Người chưa có nền tảng CNTT có theo học được không?</span>
                            <span class="material-symbols-outlined text-outline transition-transform group-open:rotate-180 text-[18px]">expand_more</span>
                        </summary>
                        <p class="mt-2.5 text-slate-600 leading-relaxed pt-2 border-t border-border-standard">
                            Hoàn toàn được! Các khóa học tại UNETI EDUSPACE được phân chia theo từng cấp độ rõ ràng (Cơ bản, Trung cấp, Nâng cao). Với người mới bắt đầu, giáo trình được thiết kế chậm rãi, dễ hiểu với nhiều bài tập trực quan có giảng viên kèm cặp 1-1.
                        </p>
                    </details>

                    <details class="group border border-border-standard rounded-2xl p-4 [&_summary::-webkit-details-marker]:hidden cursor-pointer">
                        <summary class="flex items-center justify-between font-bold text-brand-deep">
                            <span>Học phí có được hỗ trợ chia đợt đóng không?</span>
                            <span class="material-symbols-outlined text-outline transition-transform group-open:rotate-180 text-[18px]">expand_more</span>
                        </summary>
                        <p class="mt-2.5 text-slate-600 leading-relaxed pt-2 border-t border-border-standard">
                            Trung tâm có chính sách hỗ trợ đóng học phí linh hoạt cho sinh viên UNETI và học viên có hoàn cảnh khó khăn. Bạn có thể liên hệ trực tiếp ban giáo vụ để được hướng dẫn thủ tục.
                        </p>
                    </details>

                    <details class="group border border-border-standard rounded-2xl p-4 [&_summary::-webkit-details-marker]:hidden cursor-pointer">
                        <summary class="flex items-center justify-between font-bold text-brand-deep">
                            <span>Chứng chỉ sau khóa học có giá trị thế nào?</span>
                            <span class="material-symbols-outlined text-outline transition-transform group-open:rotate-180 text-[18px]">expand_more</span>
                        </summary>
                        <p class="mt-2.5 text-slate-600 leading-relaxed pt-2 border-t border-border-standard">
                            Học viên sau khi đạt điểm tổng kết từ 5.0 trở lên sẽ được cấp Chứng nhận tốt nghiệp chính quy từ Trường Đại học Kinh tế - Kỹ thuật Công nghiệp (UNETI), có giá trị công nhận trên toàn quốc và được các doanh nghiệp liên kết ưu tiên tuyển dụng.
                        </p>
                    </details>

                    <details class="group border border-border-standard rounded-2xl p-4 [&_summary::-webkit-details-marker]:hidden cursor-pointer">
                        <summary class="flex items-center justify-between font-bold text-brand-deep">
                            <span>Nếu bận có được bảo lưu hoặc học bù không?</span>
                            <span class="material-symbols-outlined text-outline transition-transform group-open:rotate-180 text-[18px]">expand_more</span>
                        </summary>
                        <p class="mt-2.5 text-slate-600 leading-relaxed pt-2 border-t border-border-standard">
                            Học viên được phép bảo lưu khóa học tối đa 06 tháng và được sắp xếp học bù ở các lớp có cùng nội dung trong kỳ tiếp theo.
                        </p>
                    </details>
                </div>
            </div>
        </div>
    </section>

</div>

<!-- ================= MODAL 1: CHỨNG CHỈ SỐ TỐT NGHIỆP UNETI (CERTIFICATE MODAL) ================= -->
<div id="certificateModal" class="fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl border-4 border-amber-300 relative space-y-6 max-h-[90vh] overflow-y-auto">
        <!-- Close button -->
        <button type="button" onclick="closeCertificateModal()" class="absolute top-4 right-4 p-2 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors cursor-pointer">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>

        <!-- Certificate Border & Header -->
        <div class="text-center space-y-3 border-b-2 border-amber-200 pb-5">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-gradient-to-tr from-brand-deep to-primary text-white flex items-center justify-center shadow-lg shadow-primary/20">
                <span class="material-symbols-outlined text-[36px]">school</span>
            </div>
            <div>
                <h3 class="text-xs font-bold text-outline uppercase tracking-[3px]">TRƯỜNG ĐẠI HỌC KINH TẾ - KỸ THUẬT CÔNG NGHIỆP</h3>
                <h2 class="text-xl sm:text-2xl font-black text-brand-deep mt-1">CHỨNG NHẬN HOÀN THÀNH KHÓA HỌC</h2>
                <p class="text-xs text-amber-700 font-semibold tracking-wider uppercase mt-0.5">UNETI EDUSPACE DIGITAL CERTIFICATE</p>
            </div>
        </div>

        <!-- Certificate Recipient & Content -->
        <div class="text-center space-y-4 py-2">
            <p class="text-xs text-slate-500 uppercase tracking-widest">Chứng nhận trao tặng cho học viên:</p>
            <h1 class="text-2xl sm:text-3xl font-black text-brand-deep tracking-tight underline decoration-amber-400 decoration-2 underline-offset-8">
                @studentDisplayName
            </h1>
            <p class="text-xs text-outline font-mono">Mã số học viên: <strong>@studentIdDisplay</strong> • Lớp: DHTI17A1HN</p>
            
            <p class="text-xs sm:text-sm text-slate-700 max-w-lg mx-auto leading-relaxed pt-2">
                Đã hoàn thành xuất sắc chương trình đào tạo kỹ năng chuyên sâu:
                <strong class="block text-brand-deep text-sm sm:text-base mt-1">Phát triển Phần mềm .NET 10 & Kiến trúc Cloud Enterprise</strong>
            </p>
            
            <div class="inline-flex items-center gap-4 text-xs font-mono bg-amber-50 border border-amber-200 px-4 py-2 rounded-2xl">
                <span>Điểm tổng kết: <strong class="text-emerald-700">@avgScore.ToString("0.0")/10</strong></span>
                <span>•</span>
                <span>Xếp loại: <strong class="text-emerald-700">Giỏi (Xuất sắc)</strong></span>
            </div>
        </div>

        <!-- Seal & Signatures -->
        <div class="pt-4 border-t border-border-standard flex items-center justify-between text-xs">
            <div class="text-left space-y-1">
                <div class="w-16 h-16 rounded-xl border border-border-standard p-1 bg-slate-50 flex items-center justify-center">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=UNETI-CERT-HV02-2026" alt="QR Verify" class="w-full h-full object-contain" />
                </div>
                <span class="text-[9px] text-outline font-mono block">Mã xác thực số: UNETI-CERT-8899</span>
            </div>
            
            <div class="text-center space-y-1">
                <span class="text-[10px] text-outline block">Hà Nội, ngày 28 tháng 10 năm 2026</span>
                <span class="font-bold text-brand-deep text-xs block">HIỆU TRƯỞNG / TRƯỞNG TRUNG TÂM</span>
                <div class="h-10 flex items-center justify-center italic text-primary font-serif text-sm">
                    GS. TS. Ngô Thành Long
                </div>
                <span class="text-[10px] text-emerald-700 font-semibold block flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">verified</span> Đã ký điện tử xác thực
                </span>
            </div>
        </div>

        <!-- Actions -->
        <div class="pt-2 flex items-center justify-end gap-3">
            <button type="button" onclick="closeCertificateModal()" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold cursor-pointer">
                Đóng
            </button>
            <button type="button" onclick="showStudentToast('Chứng chỉ số PDF đã được tải xuống máy tính của bạn!', 'success'); closeCertificateModal();" class="px-5 py-2 rounded-xl bg-primary hover:bg-primary-hover text-white text-xs font-bold shadow-md transition-colors flex items-center gap-1.5 cursor-pointer">
                <span class="material-symbols-outlined text-[16px]">download</span>
                <span>Tải Chứng Chỉ (PDF Bản In)</span>
            </button>
        </div>
    </div>
</div>

