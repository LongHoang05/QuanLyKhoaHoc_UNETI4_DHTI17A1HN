                <button type="button" onclick="openVietQRModal('DK05', 'React 19 & Next.js 15 Thực chiến', 3200000)" class="px-3.5 py-2 rounded-xl bg-[#0284c7] hover:bg-[#0369a1] text-white text-xs font-bold shadow-xs transition-colors flex items-center gap-1.5 cursor-pointer self-start sm:self-auto">
