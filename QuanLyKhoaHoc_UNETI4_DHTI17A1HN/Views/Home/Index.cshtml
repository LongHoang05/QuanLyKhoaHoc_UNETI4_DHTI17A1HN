    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-7 shadow-2xl border border-border-standard relative space-y-5">
        <button type="button" onclick="closeVietQRModal()" class="absolute top-4 right-4 p-2 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors cursor-pointer">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>

        <div class="flex items-center gap-3 pb-3 border-b border-border-standard">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">qr_code_2</span>
            </div>
            <div>
                <h3 class="text-sm font-bold text-brand-deep">Cổng Nộp Học Phí VietQR UNETI</h3>
                <p class="text-xs text-outline">Xác nhận gạch nợ tự động trong 60 giây</p>
            </div>
        </div>

        <!-- VietQR Box -->
        <div class="bg-slate-50 p-4 rounded-2xl border border-border-standard text-center space-y-3">
            <div class="w-48 h-48 mx-auto bg-white p-2 rounded-xl border border-border-standard shadow-xs flex items-center justify-center">
                <img id="vietQrImg" src="https://api.vietqr.io/image/970422-1903686888-qrx68.jpg?amount=3200000&addInfo=DK05%20TRAN%20MINH%20TUAN" alt="VietQR" class="w-full h-full object-contain" />
            </div>
            <p class="text-xs text-outline font-medium">Mở ứng dụng Ngân hàng (MBBank, Vietcombank, Techcombank...) quét mã QR</p>
        </div>

        <!-- Bank Transfer Details -->
        <div class="space-y-2 text-xs bg-sky-50/60 p-3.5 rounded-2xl border border-sky-100">
            <div class="flex justify-between">
                <span class="text-outline">Ngân hàng thụ hưởng:</span>
                <strong class="text-brand-deep">MBBank (Quân Đội)</strong>
            </div>
            <div class="flex justify-between">
                <span class="text-outline">Số tài khoản:</span>
                <strong class="text-brand-deep font-mono">1903 6868 88</strong>
            </div>
            <div class="flex justify-between">
                <span class="text-outline">Chủ tài khoản:</span>
                <strong class="text-brand-deep">TRUONG DH KT-KT CONG NGHIEP</strong>
            </div>
            <div class="flex justify-between">
                <span class="text-outline">Số tiền:</span>
                <strong class="text-rose-600 font-mono text-sm" id="qrAmountDisplay">3.200.000 đ</strong>
            </div>
            <div class="flex justify-between">
                <span class="text-outline">Nội dung chuyển khoản:</span>
                <strong class="text-primary font-mono" id="qrNoteDisplay">DK05 TRAN MINH TUAN</strong>
            </div>
        </div>

        <!-- Buttons -->
        <div class="pt-2 flex items-center justify-end gap-3">
            <button type="button" onclick="closeVietQRModal()" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold cursor-pointer">
                Đóng
            </button>
            <button type="button" onclick="confirmPaymentSuccess()" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-md transition-colors flex items-center gap-1.5 cursor-pointer">
                <span class="material-symbols-outlined text-[16px]">check_circle</span>
                <span>Tôi Đã Chuyển Khoản Xong</span>
            </button>
        </div>
    </div>
</div>

<!-- ================= TOAST NOTIFICATION CONTAINER ================= -->
<div id="studentToast" class="fixed bottom-6 right-6 z-50 hidden max-w-sm p-4 rounded-2xl shadow-xl border text-xs font-semibold flex items-center gap-2.5 transition-all transform translate-y-4">
    <span id="toastIcon" class="material-symbols-outlined text-[20px]">info</span>
    <span id="toastMessage">Thông báo</span>
</div>

@section Scripts {
<script>
    // ================= 1. TAB SWITCHER (5 TABS THEO ẢNH MẪU) =================
    function switchPortalTab(tab) {
        const tabs = ['courses', 'registrations', 'schedule', 'grades', 'profile'];
        
        tabs.forEach(t => {
            const btn = document.getElementById('portal-tab-' + t);
            const pane = document.getElementById('portal-pane-' + t);
            if (btn && pane) {
                if (t === tab) {
                    btn.classList.add('bg-[#0284c7]', 'text-white', 'shadow-xs', 'active');
                    btn.classList.remove('text-slate-700', 'hover:bg-slate-50');
                    pane.classList.remove('hidden');
                } else {
                    btn.classList.remove('bg-[#0284c7]', 'text-white', 'shadow-xs', 'active');
                    btn.classList.add('text-slate-700', 'hover:bg-slate-50');
                    pane.classList.add('hidden');
                }
            }
        });
    }

    // ================= 2. LIVE FILTER CHO KHÓA HỌC TAB 1 =================
    function filterPortalCards() {
        const searchVal = (document.getElementById('portalCourseSearch')?.value || '').toLowerCase().trim();
        const programVal = document.getElementById('portalProgramFilter')?.value || '';
        const seatVal = document.getElementById('portalSeatFilter')?.value || '';
        
        const cards = document.querySelectorAll('.portal-course-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const name = (card.getAttribute('data-name') || '').toLowerCase();
            const lecturer = (card.getAttribute('data-lecturer') || '').toLowerCase();
            const program = card.getAttribute('data-program') || '';
            const seats = card.getAttribute('data-seats') || '';

            const matchSearch = !searchVal || name.includes(searchVal) || lecturer.includes(searchVal);
            const matchProgram = !programVal || program.toLowerCase().includes(programVal.toLowerCase());
            const matchSeats = !seatVal || seats === seatVal;

            if (matchSearch && matchProgram && matchSeats) {
                card.classList.remove('hidden');
                visibleCount++;
            } else {
                card.classList.add('hidden');
            }
        });

        const badge = document.getElementById('portalCourseCountBadge');
        if (badge) {
            badge.textContent = visibleCount + ' lớp mở';
        }
    }

    // ================= 3. MODAL XEM CHỨNG CHỈ SỐ =================
    function openCertificateModal() {
        const modal = document.getElementById('certificateModal');
        if (modal) modal.classList.remove('hidden');
    }

    function closeCertificateModal() {
        const modal = document.getElementById('certificateModal');
        if (modal) modal.classList.add('hidden');
    }

    // ================= 4. MODAL THANH TOÁN HỌC PHÍ VIETQR =================
    function openVietQRModal(code, courseName, amount) {
        const modal = document.getElementById('vietQrModal');
        const amountDisplay = document.getElementById('qrAmountDisplay');
        const noteDisplay = document.getElementById('qrNoteDisplay');
        const qrImg = document.getElementById('vietQrImg');

        if (amountDisplay) amountDisplay.textContent = Number(amount).toLocaleString('vi-VN') + ' đ';
        if (noteDisplay) noteDisplay.textContent = code + ' TRAN MINH TUAN';
        if (qrImg) {
            qrImg.src = 'https://api.vietqr.io/image/970422-1903686888-qrx68.jpg?amount=' + amount + '&addInfo=' + encodeURIComponent(code + ' TRAN MINH TUAN');
        }

        if (modal) modal.classList.remove('hidden');
    }

    function closeVietQRModal() {
        const modal = document.getElementById('vietQrModal');
        if (modal) modal.classList.add('hidden');
    }

    function confirmPaymentSuccess() {
        closeVietQRModal();
        showStudentToast('Hệ thống đã ghi nhận thông tin chuyển khoản! Kế toán sẽ xác nhận sau 1-2 phút.', 'success');
    }

    // ================= 5. TOGGLE GIỮA CỔNG HỌC VIÊN & TRANG CHỦ CHUNG =================
    function toggleStudentPortalDemo() {
        const portal = document.getElementById('studentPortalSection');
        const guest = document.getElementById('guestLandingSection');
        const label = document.getElementById('topDemoToggleLabel');

        if (portal && guest) {
            const isPortalVisible = !portal.classList.contains('hidden');
            if (isPortalVisible) {
                portal.classList.add('hidden');
                guest.classList.remove('hidden');
                if (label) label.textContent = 'Xem thử Giao diện Sinh viên theo ảnh';
                guest.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } else {
                portal.classList.remove('hidden');
                guest.classList.add('hidden');
                if (label) label.textContent = 'Quay lại Trang chủ Giới thiệu';
                portal.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }
    }
    // Gán ra window để navbar gọi được
    window.toggleStudentPortalDemo = toggleStudentPortalDemo;

    function togglePublicLanding() {
        const guest = document.getElementById('guestLandingSection');
        const btnText = document.getElementById('btnTogglePublicText');
        if (guest) {
            guest.classList.toggle('hidden');
            const isHidden = guest.classList.contains('hidden');
            if (btnText) {
                btnText.textContent = isHidden ? "Xem thêm Giới thiệu Học viện & Toàn bộ Khóa học Tuyển sinh" : "Thu gọn phần Giới thiệu chung";
            }
            if (!isHidden) {
                guest.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }
    }

    // ================= 6. LƯU THAY ĐỔI HỒ SƠ =================
    function saveStudentProfile(e) {
        e.preventDefault();
        showStudentToast('Cập nhật hồ sơ cá nhân học viên thành công!', 'success');
    }

    // ================= 7. TOAST NOTIFICATION HELPER =================
    function showStudentToast(message, type = 'info') {
        const toast = document.getElementById('studentToast');
        const toastMsg = document.getElementById('toastMessage');
        const toastIcon = document.getElementById('toastIcon');

        if (!toast || !toastMsg) return;

        toastMsg.textContent = message;
        toast.className = 'fixed bottom-6 right-6 z-50 max-w-sm p-4 rounded-2xl shadow-xl border text-xs font-semibold flex items-center gap-2.5 transition-all transform translate-y-0';

        if (type === 'success') {
            toast.classList.add('bg-emerald-50', 'text-emerald-800', 'border-emerald-200');
            if (toastIcon) {
                toastIcon.className = 'material-symbols-outlined text-[20px] text-emerald-600';
                toastIcon.textContent = 'check_circle';
            }
        } else if (type === 'error') {
            toast.classList.add('bg-rose-50', 'text-rose-800', 'border-rose-200');
            if (toastIcon) {
                toastIcon.className = 'material-symbols-outlined text-[20px] text-rose-600';
                toastIcon.textContent = 'error';
            }
        } else {
            toast.classList.add('bg-sky-50', 'text-sky-800', 'border-sky-200');
            if (toastIcon) {
                toastIcon.className = 'material-symbols-outlined text-[20px] text-primary';
                toastIcon.textContent = 'info';
            }
        }

        toast.classList.remove('hidden');

        setTimeout(() => {
            toast.classList.add('hidden');
        }, 3500);
    }

    // ================= 8. FORM TƯ VẤN (GUEST SECTION) =================
    async function submitTuVan(e) {
        e.preventDefault();
        const form = document.getElementById('tuvanForm');
        if (!form) return;
        const formData = new FormData(form);

        try {
            const res = await fetch('/Home/GuiTuVan', {
                method: 'POST',
                body: formData
            });
            const data = await res.json();
            if (data.success) {
                showStudentToast(data.message, 'success');
                form.reset();
            } else {
                showStudentToast(data.message || 'Có lỗi xảy ra', 'error');
            }
        } catch (err) {
            showStudentToast('Lỗi kết nối máy chủ. Vui lòng thử lại sau.', 'error');
        }
    }
</script>
}
