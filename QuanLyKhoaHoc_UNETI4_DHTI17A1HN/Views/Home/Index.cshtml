@using QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models
@{
    ViewData["Title"] = "Tổng quan Hệ thống Quản lý Đào tạo";
    var chuongTrinhs = ViewBag.ChuongTrinhs as List<ChuongTrinhDaoTao> ?? new List<ChuongTrinhDaoTao>();
    var lopHocs = ViewBag.LopHocs as List<LopHoc> ?? new List<LopHoc>();
    var recentDangKys = ViewBag.RecentDangKys as List<DangKyHoc> ?? new List<DangKyHoc>();
    var hoTen = Context.Session.GetString("HoTen");
    var vaiTro = Context.Session.GetString("VaiTro");
}

<!-- 1. HERO BANNER GREETING -->
<div class="page-hero">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="hero-badge"><i class="bi bi-stars"></i> UNETI Training Portal</span>
                <span class="badge bg-white bg-opacity-25 text-white">Khoa CNTT • Nhóm 4 (DHTI17A1HN)</span>
            </div>
            <h1 class="hero-title">Xin chào, @(hoTen ?? "Quý Thầy Cô & Học Viên") 👋</h1>
            <p class="hero-subtitle">
                Hệ thống hiện có <strong class="text-white">@ViewBag.TotalChuongTrinh chương trình đào tạo</strong>, 
                <strong class="text-white">@ViewBag.OpenLopHoc lớp đang tuyển sinh</strong> và 
                <strong class="text-white">@ViewBag.PendingDangKy đơn đăng ký mới</strong> đang chờ xét duyệt.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="ChuongTrinhDaoTao" asp-action="Index" class="btn btn-light rounded-pill px-3 py-2 fw-bold text-primary shadow-sm" style="font-size: 0.85rem;">
                <i class="bi bi-journal-bookmark-fill me-1"></i> Chương trình ĐT (M1)
            </a>
            @if (vaiTro == "Admin")
            {
                <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2 fw-semibold" style="font-size: 0.85rem;">
                    <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
                </a>
            }
        </div>
    </div>
</div>

<!-- 2. 4 THẺ CHỈ SỐ KPI TỔNG QUAN -->
<div class="row g-3 mb-4">
    <!-- KPI 1: Lớp đang mở tuyển sinh -->
    <div class="col-sm-6 col-xl-3">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Lớp đang mở tuyển sinh</div>
                <div class="mini-stat-num text-success">@ViewBag.OpenLopHoc</div>
                <small class="text-muted">Trên tổng số @ViewBag.TotalLopHoc lớp học</small>
            </div>
            <div class="mini-stat-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                <i class="bi bi-door-open-fill"></i>
            </div>
        </div>
    </div>

    <!-- KPI 2: Đăng ký chờ xét duyệt -->
    <div class="col-sm-6 col-xl-3">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Đăng ký chờ xét duyệt</div>
                <div class="mini-stat-num text-warning">@ViewBag.PendingDangKy</div>
                <small class="text-muted">Trên tổng số @ViewBag.TotalDangKy lượt nộp</small>
            </div>
            <div class="mini-stat-icon" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                <i class="bi bi-hourglass-split"></i>
            </div>
        </div>
    </div>

    <!-- KPI 3: Chương trình đào tạo -->
    <div class="col-sm-6 col-xl-3">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Chương trình đào tạo</div>
                <div class="mini-stat-num text-primary">@ViewBag.TotalChuongTrinh</div>
                <small class="text-muted">Khung chuẩn Đề tài 16 BTL</small>
            </div>
            <div class="mini-stat-icon" style="background: var(--surface-container); color: var(--primary-rose);">
                <i class="bi bi-collection-fill"></i>
            </div>
        </div>
    </div>

    <!-- KPI 4: Tổng số học viên -->
    <div class="col-sm-6 col-xl-3">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Tổng số học viên</div>
                <div class="mini-stat-num" style="color: #6366f1;">@ViewBag.TotalHocVien</div>
                <small class="text-muted">Hệ thống có @ViewBag.TotalTaiKhoan tài khoản</small>
            </div>
            <div class="mini-stat-icon" style="background: #eef2ff; color: #6366f1;">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
        </div>
    </div>
</div>

<!-- 3. KHỐI NỘI DUNG CHÍNH (LAYOUT 7 - 5) -->
<div class="row g-4">
    <!-- CỘT TRÁI (7 CỘT): CHƯƠNG TRÌNH ĐÀO TẠO & ĐƠN ĐĂNG KÝ GẦN ĐÂY -->
    <div class="col-xl-7">
        <div class="d-flex flex-column gap-4">
            
            <!-- Khối 1: Danh sách Chương trình Đào tạo nổi bật (Module 1) -->
            <div class="content-card">
                <div class="toolbar">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-journal-bookmark-fill me-2 text-primary"></i>Chương trình Đào tạo nổi bật
                        </h6>
                        <small class="text-muted">Khung chương trình đào tạo chuyên môn và hướng nghiệp</small>
                    </div>
                    <a asp-controller="ChuongTrinhDaoTao" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        Xem tất cả (@ViewBag.TotalChuongTrinh) <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

                @if (!chuongTrinhs.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                        Chưa có dữ liệu chương trình đào tạo.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-custom align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Chương trình đào tạo</th>
                                    <th>Lớp trực thuộc</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ct in chuongTrinhs)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="avatar-circle">
                                                    @(ct.TenChuongTrinh?.Length > 0 ? ct.TenChuongTrinh.Substring(0, 1).ToUpper() : "C")
                                                </div>
                                                <div>
                                                    <a asp-controller="ChuongTrinhDaoTao" asp-action="Details" asp-route-id="@ct.MaChuongTrinh" class="fw-bold text-dark text-decoration-none hover-primary">
                                                        @ct.TenChuongTrinh
                                                    </a>
                                                    <div class="small text-muted" style="font-size: 0.75rem;">
                                                        <i class="bi bi-envelope me-1"></i>@(ct.EmailLienHe ?? "cntt@uneti.edu.vn")
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-primary border px-2 py-1 rounded-pill">
                                                <i class="bi bi-easel me-1"></i>@(ct.LopHocs?.Count ?? 0) lớp
                                            </span>
                                        </td>
                                        <td>
                                            @if (ct.TrangThai)
                                            {
                                                <span class="status-pill active">
                                                    <span class="status-dot"></span> Đang hoạt động
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-pill locked">
                                                    <span class="status-dot"></span> Tạm dừng
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="ChuongTrinhDaoTao" asp-action="Details" asp-route-id="@ct.MaChuongTrinh" class="btn-action-icon" title="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Khối 2: Đơn đăng ký gần đây -->
            <div class="content-card">
                <div class="toolbar">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-clipboard2-pulse-fill me-2 text-warning"></i>Đơn đăng ký gần đây
                        </h6>
                        <small class="text-muted">Module 4 • Hồ sơ đăng ký học viên mới nộp vào hệ thống</small>
                    </div>
                    <span class="badge rounded-pill fw-bold" style="background: var(--surface-container); color: var(--primary-rose);">
                        @ViewBag.PendingDangKy chờ duyệt
                    </span>
                </div>

                @if (!recentDangKys.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-clipboard-x fs-3 d-block mb-1 text-secondary"></i>
                        Chưa có đơn đăng ký nào được ghi nhận.
                    </div>
                }
                else
                {
                    <div class="p-3">
                        @foreach (var dk in recentDangKys)
                        {
                            <div class="p-3 mb-2 rounded-3 border d-flex align-items-center justify-content-between" style="background: var(--surface-variant);">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle" style="background: #e0f2fe; color: #0284c7; width: 36px; height: 36px; font-size: 0.78rem;">
                                        @(dk.HocVien?.HoTen?.Length > 0 ? dk.HocVien.HoTen.Substring(0, 1).ToUpper() : "H")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark small">@(dk.HocVien?.HoTen ?? "Học viên #" + dk.MaHocVien)</div>
                                        <div class="text-muted" style="font-size: 0.74rem;">
                                            Lớp: <strong class="text-dark">@(dk.LopHoc?.TenLop ?? "Mã lớp #" + dk.MaLopHoc)</strong> • 
                                            Ngày nộp: @dk.NgayDangKy.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    @if (dk.TrangThai == "Chờ duyệt")
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-2 py-1">
                                            <i class="bi bi-clock-history me-1"></i>Chờ duyệt
                                        </span>
                                    }
                                    else if (dk.TrangThai == "Đã đóng học phí" || dk.TrangThai == "Hoàn thành")
                                    {
                                        <span class="badge bg-success rounded-pill px-2 py-1">
                                            <i class="bi bi-check2-circle me-1"></i>@dk.TrangThai
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-white rounded-pill px-2 py-1">
                                            @dk.TrangThai
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    </div>

    <!-- CỘT PHẢI (5 CỘT): LỚP HỌC MỚI NHẤT & LỐI TẮT HỆ THỐNG -->
    <div class="col-xl-5">
        <div class="d-flex flex-column gap-4">

            <!-- Khối 1: Lớp học tuyển sinh mới nhất -->
            <div class="content-card">
                <div class="toolbar">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-easel2-fill me-2 text-success"></i>Lớp học mở tuyển sinh
                        </h6>
                        <small class="text-muted">Module 2 • Kế hoạch mở lớp và giảng viên</small>
                    </div>
                    <span class="badge bg-success bg-opacity-75 rounded-pill text-white">@ViewBag.OpenLopHoc đang mở</span>
                </div>

                @if (!lopHocs.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-easel fs-3 d-block mb-1 text-secondary"></i>
                        Chưa có lớp học nào.
                    </div>
                }
                else
                {
                    <div class="p-3">
                        @foreach (var lop in lopHocs)
                        {
                            <div class="p-3 mb-2 rounded-3 border" style="background: #ffffff;">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div class="fw-bold text-dark">@lop.TenLop</div>
                                    <span class="badge @(lop.TrangThai == "Đang mở đăng ký" ? "bg-success" : "bg-secondary") rounded-pill" style="font-size: 0.7rem;">
                                        @lop.TrangThai
                                    </span>
                                </div>
                                <div class="small text-muted mb-2" style="font-size: 0.76rem;">
                                    <i class="bi bi-journal-text me-1 text-primary"></i>@(lop.ChuongTrinhDaoTao?.TenChuongTrinh ?? "Đào tạo chuyên đề")
                                </div>
                                <div class="d-flex flex-wrap justify-content-between align-items-center small text-muted pt-2 border-top" style="font-size: 0.74rem;">
                                    <span><i class="bi bi-person-workspace me-1"></i>@(lop.TenGiangVien ?? "Chưa phân công")</span>
                                    <span class="fw-bold text-primary">@lop.HocPhi.ToString("N0") VNĐ</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Khối 2: Lối tắt tác vụ nhanh -->
            <div class="content-card">
                <div class="toolbar">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-lightning-charge-fill me-2 text-warning"></i>Lối tắt tác vụ nhanh
                    </h6>
                </div>
                <div class="p-3 d-flex flex-column gap-2">
                    <a asp-controller="ChuongTrinhDaoTao" asp-action="Create" class="btn btn-outline-primary d-flex align-items-center justify-content-between rounded-3 py-2 px-3 text-start">
                        <span><i class="bi bi-plus-circle-fill me-2 text-primary"></i>Tạo mới Chương trình Đào tạo</span>
                        <i class="bi bi-chevron-right small text-muted"></i>
                    </a>

                    @if (vaiTro == "Admin")
                    {
                        <a asp-controller="TaiKhoan" asp-action="Create" class="btn btn-outline-danger d-flex align-items-center justify-content-between rounded-3 py-2 px-3 text-start">
                            <span><i class="bi bi-person-plus-fill me-2 text-danger"></i>Thêm Tài khoản người dùng mới</span>
                            <i class="bi bi-chevron-right small text-muted"></i>
                        </a>
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-warning d-flex align-items-center justify-content-between rounded-3 py-2 px-3 text-start">
                            <span><i class="bi bi-pie-chart-fill me-2 text-warning"></i>Báo cáo Thống kê & Biểu đồ Chart.js</span>
                            <i class="bi bi-chevron-right small text-muted"></i>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-outline-secondary d-flex align-items-center justify-content-between rounded-3 py-2 px-3 text-start">
                            <span><i class="bi bi-shield-lock-fill me-2 text-info"></i>Đăng nhập quyền Quản trị (Admin)</span>
                            <i class="bi bi-chevron-right small text-muted"></i>
                        </a>
                    }

                    <div class="p-3 mt-2 rounded-3 border" style="background: var(--surface-container); border-color: var(--border-color) !important;">
                        <div class="fw-bold small text-primary mb-1">
                            <i class="bi bi-info-circle-fill me-1"></i>Hệ thống Đào tạo UNETI EDU
                        </div>
                        <div class="small text-muted" style="font-size: 0.75rem; line-height: 1.4;">
                            Đề tài 16: Quản lý đăng ký khóa học & học viên. Hệ thống được tối ưu theo kiến trúc MVC chuẩn, Entity Framework Core và giao diện Xanh Da Trời & Trắng tinh khôi.
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
