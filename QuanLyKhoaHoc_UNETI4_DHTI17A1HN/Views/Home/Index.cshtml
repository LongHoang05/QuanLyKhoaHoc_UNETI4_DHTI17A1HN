                                <div class="pt-1">
                                    <div class="flex items-center justify-between text-[11px] mb-1">
                                        <span class="text-outline">Đã ghi danh: <strong class="text-brand-deep font-mono">@currentEnrolled/@maxCapacity</strong></span>
                                        <span class="font-bold @(isFull ? "text-rose-600" : remainingSeats <= 5 ? "text-amber-600" : "text-emerald-600")">
                                            @(isFull ? "Đã hết chỗ" : $"Còn {remainingSeats} chỗ")
