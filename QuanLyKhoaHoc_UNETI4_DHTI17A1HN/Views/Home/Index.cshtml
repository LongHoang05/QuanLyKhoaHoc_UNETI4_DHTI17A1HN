            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-xs text-left border-collapse min-w-[700px]">
                    <thead class="bg-slate-50 text-brand-deep border-b border-border-standard font-bold text-[11px] uppercase tracking-wider">
                        <tr>
                            <th class="p-3.5 border-r border-border-standard">Mã Đơn / Khóa Học</th>
                            <th class="p-3.5 border-r border-border-standard">Ngày ĐK</th>
                            <th class="p-3.5 border-r border-border-standard text-right">Học Phí</th>
                            <th class="p-3.5 border-r border-border-standard text-right">Đã Đóng</th>
                            <th class="p-3.5 border-r border-border-standard text-right">Còn Lại</th>
                            <th class="p-3.5 border-r border-border-standard text-center">Trạng Thái</th>
                            <th class="p-3.5 text-center">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-standard">
                        @if (!studentDangKys.Any())
                        {
                            <tr>
                                <td colspan="7" class="p-8 text-center text-outline">Chưa có đơn đăng ký khóa học nào trong CSDL.</td>
                            </tr>
                        }
                        @foreach (var dk in studentDangKys)
                        {
                            decimal hocPhi = dk.LopHoc?.HocPhi ?? 0;
                            bool daDong = dk.TrangThai == "Đang học" || dk.TrangThai == "Đã đóng học phí";
                            decimal daDongTien = daDong ? hocPhi : 0;
                            decimal conLai = hocPhi - daDongTien;
                            <tr class="hover:bg-slate-50/50">
                                <td class="p-3.5 border-r border-border-standard">
                                    <div class="font-bold text-brand-deep">@(dk.LopHoc?.TenLop ?? "Lớp học")</div>
                                    <span class="text-[10px] text-outline font-mono">Mã đơn: #DK@(dk.MaDangKy.ToString("D2")) • Mã lớp: #LOP@(dk.MaLopHoc.ToString("D2"))</span>
                                </td>
                                <td class="p-3.5 border-r border-border-standard font-mono text-outline">@dk.NgayDangKy.ToString("dd/MM/yyyy")</td>
                                <td class="p-3.5 border-r border-border-standard text-right font-mono font-bold">@hocPhi.ToString("N0") đ</td>
                                <td class="p-3.5 border-r border-border-standard text-right font-mono font-bold text-emerald-700">@daDongTien.ToString("N0") đ</td>
                                <td class="p-3.5 border-r border-border-standard text-right font-mono @(conLai > 0 ? "font-bold text-rose-600" : "text-slate-400")">@conLai.ToString("N0") đ</td>
                                <td class="p-3.5 border-r border-border-standard text-center">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold @(daDong ? "bg-emerald-100 text-emerald-800 border border-emerald-300" : "bg-amber-100 text-amber-800 border border-amber-300")">
                                        @dk.TrangThai
                                    </span>
                                </td>
                                <td class="p-3.5 text-center">
                                    @if (daDong)
                                    {
                                        <span class="text-xs font-semibold text-emerald-700">Đã hoàn tất</span>
                                    }
                                    else
                                    {
                                        <button type="button" onclick="openVietQRModal('DK@(dk.MaDangKy.ToString("D2"))', '@(dk.LopHoc?.TenLop)', @hocPhi)" class="px-3 py-1.5 rounded-lg bg-[#0284c7] hover:bg-[#0369a1] text-white text-xs font-bold shadow-xs cursor-pointer">
                                            Thanh toán VietQR
                                        </button>
                                    }
                                </td>
                            </tr>
                        }</tbody>
                </table>
            </div>
        </div>
    </div>

