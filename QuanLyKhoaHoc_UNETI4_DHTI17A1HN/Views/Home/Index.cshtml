@{
    // Họ và tên: Nhóm 5 (Vũ Đình Trường - Nguyễn Đình Kiên - Nguyễn Đức Linh - Nguyễn Hoàng Long - Nguyễn Tùng Dương)
    // Lớp: DHTI17A1HN - Đại học Kinh tế - Kỹ thuật Công nghiệp (UNETI)
    // Nội dung thực hiện: Trang chủ Nền tảng Thương mại Giáo dục UNETI EDUSPACE (EdTech Commercial Homepage)
    Layout = "_StudentLayout";
    ViewData["Title"] = "UNETI EDUSPACE - Học Viện Đào Tạo & Kỹ Năng Thực Chiến Chuẩn Doanh Nghiệp";

    var chuongTrinhs = ViewBag.ChuongTrinhs as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.ChuongTrinhDaoTao> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.ChuongTrinhDaoTao>();
    var openClassCounts = ViewBag.OpenClassCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var hotCourses = ViewBag.HotCourses as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc>();
    var upcomingCourses = ViewBag.UpcomingCourses as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc>();
    var siSoMap = ViewBag.SiSoMap as Dictionary<int, int> ?? new Dictionary<int, int>();
    var allOpenClasses = ViewBag.AllOpenClasses as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc>();
    var allSiSoMap = ViewBag.AllSiSoMap as Dictionary<int, int> ?? new Dictionary<int, int>();

    int totalCourses = ViewBag.TotalCourses ?? 0;
    int totalStudents = ViewBag.TotalStudents ?? 0;
    int totalRegistrations = ViewBag.TotalRegistrations ?? 0;

    var currentStudent = ViewBag.CurrentStudent as QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.HocVien;
    bool isLoggedInStudent = currentStudent != null;
    var myRegistrations = ViewBag.MyRegistrations as Dictionary<int, QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.DangKyHoc> ?? new Dictionary<int, QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.DangKyHoc>();
    var studentDangKys = ViewBag.StudentDangKys as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.DangKyHoc> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.DangKyHoc>();
    var activeCourse = ViewBag.ActiveCourse as QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.DangKyHoc;
    var nextSession = ViewBag.NextSession as QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.BuoiHoc;
    int totalSessions = ViewBag.TotalSessions ?? 0;
    int completedSessions = ViewBag.CompletedSessions ?? 0;
    double progressPercent = totalSessions > 0 ? Math.Min(100.0, Math.Round((double)completedSessions / totalSessions * 100, 1)) : 0;

    var studentBuoiHocs = ViewBag.StudentBuoiHocs as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.BuoiHoc> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.BuoiHoc>();
    var studentKetQuas = ViewBag.StudentKetQuas as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.KetQuaHocTap> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.KetQuaHocTap>();
    var giangViens = ViewBag.GiangViens as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.GiangVien> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.GiangVien>();
    double avgScore = ViewBag.AvgScore ?? 0.0;
    double gpa4 = ViewBag.Gpa4 ?? 0.0;
    int dangKyCount = ViewBag.DangKyCount ?? 0;
    int lopDangHocCount = ViewBag.LopDangHocCount ?? 0;
    int chuyenCanPercent = ViewBag.ChuyenCanPercent ?? 0;

    string studentDisplayName = !string.IsNullOrWhiteSpace(currentStudent?.HoTen) ? currentStudent.HoTen : "Trần Minh Tuấn";
    string studentIdDisplay = currentStudent != null ? $"HV-{currentStudent.MaHocVien:D2}" : "HV-02";
}

<!-- ================= A. CỔNG HỌC VIÊN CHÍNH THỨC (THEO ĐÚNG LAYOUT ẢNH MẪU KHI ĐĂNG NHẬP) ================= -->
<div id="studentPortalSection" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-16 space-y-6">
    
    <!-- 1. WELCOME BANNER (DARK NAVY GRADIENT MATCHING SCREENSHOT) -->
    <div class="rounded-3xl bg-gradient-to-r from-[#031B3B] via-[#082B63] to-[#0D47A1] p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
        <!-- Ambient tech glow circles -->
        <div class="absolute -right-16 -top-16 w-80 h-80 bg-sky-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-brand-deep/30 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 relative z-10">
            <!-- Left Info Area -->
            <div class="space-y-4 max-w-2xl">
                <!-- Pill tag -->
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs font-medium text-amber-200">
                    <span class="material-symbols-outlined text-[15px] text-amber-300">sparkles</span>
                    <span>Cổng Đào Tạo Trực Tuyến UNETI • Phục Vụ Học Viên Chuẩn Mực 17.1 & 25.1</span>
                </div>

                <!-- Greeting Headline -->
                <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-white flex items-center gap-2.5">
                    <span>Chào buổi chiều, @studentDisplayName</span>
                    <span class="material-symbols-outlined text-amber-300 text-2xl sm:text-3xl">sparkles</span>
                </h1>

                <!-- Subtitle text -->
                <p class="text-xs sm:text-sm text-slate-200 leading-relaxed font-normal">
                    Khám phá các khóa học thực chiến công nghệ, đăng ký lớp học linh hoạt, theo dõi thời khóa biểu và tải chứng chỉ số hoàn thành khóa học từ Trung tâm Đào tạo UNETI.
                </p>

                <!-- 3 Action Pills -->
                <div class="flex flex-wrap items-center gap-2.5 pt-1">
                    <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 text-xs text-emerald-300 font-semibold backdrop-blur-xs">
                        <span class="material-symbols-outlined text-[16px] text-emerald-400">check_circle</span>
                        <span>Tài khoản đã kích hoạt</span>
                    </div>
                    <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 text-xs text-sky-200 font-semibold backdrop-blur-xs">
                        <span class="material-symbols-outlined text-[16px]">school</span>
                        <span>Khóa K17 - CNTT</span>
                    </div>
                    <button type="button" onclick="openCertificateModal()" class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-[#0284c7] hover:bg-[#0369a1] text-white text-xs font-bold shadow-md shadow-sky-500/30 transition-all cursor-pointer">
                        <span class="material-symbols-outlined text-[16px]">verified</span>
                        <span>Xem Chứng Chỉ Của Tôi</span>
                    </button>
                </div>
            </div>

            <!-- Right 4 Glassmorphism Metric Cards -->
            <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-4 gap-3 shrink-0">
                <!-- Card 1: ĐƠN ĐK -->
                <div class="rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 p-4 text-center min-w-[95px] flex flex-col justify-center">
                    <span class="text-2xl sm:text-3xl font-black text-white font-mono block">@(dangKyCount < 10 ? $"0{dangKyCount}" : $"{dangKyCount}")</span>
                    <span class="text-[10px] font-bold text-slate-300 uppercase tracking-wider mt-1 block">ĐƠN ĐK</span>
                </div>
                <!-- Card 2: GPA TÍCH LŨY -->
                <div class="rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 p-4 text-center min-w-[95px] flex flex-col justify-center">
                    <span class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono block">@avgScore.ToString("0.0")</span>
                    <span class="text-[10px] font-bold text-slate-300 uppercase tracking-wider mt-1 block">GPA TÍCH LŨY</span>
                </div>
                <!-- Card 3: LỚP ĐANG HỌC -->
                <div class="rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 p-4 text-center min-w-[95px] flex flex-col justify-center">
                    <span class="text-2xl sm:text-3xl font-black text-white font-mono block">@(lopDangHocCount < 10 ? $"0{lopDangHocCount}" : $"{lopDangHocCount}")</span>
                    <span class="text-[10px] font-bold text-slate-300 uppercase tracking-wider mt-1 block">LỚP ĐANG HỌC</span>
                </div>
                <!-- Card 4: CHUYÊN CẦN -->
                <div class="rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 p-4 text-center min-w-[95px] flex flex-col justify-center">
                    <span class="text-2xl sm:text-3xl font-black text-cyan-300 font-mono block">@(chuyenCanPercent)%</span>
                    <span class="text-[10px] font-bold text-slate-300 uppercase tracking-wider mt-1 block">CHUYÊN CẦN</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. 5-TAB NAVIGATION BAR (WHITE PILL CONTAINER MATCHING SCREENSHOT) -->
    <div class="bg-white rounded-2xl p-1.5 shadow-xs border border-border-standard flex items-center gap-1.5 overflow-x-auto no-scrollbar">
        <!-- Tab 1: Khóa học đang mở đăng ký -->
        <button type="button" onclick="switchPortalTab('courses')" id="portal-tab-courses"
                class="portal-tab-btn active px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition-all cursor-pointer whitespace-nowrap bg-[#0284c7] text-white shadow-xs">
            <span class="material-symbols-outlined text-[18px]">grid_view</span>
            <span>Khóa học đang mở đăng ký</span>
        </button>

        <!-- Tab 2: Đơn đăng ký & Học phí -->
        <button type="button" onclick="switchPortalTab('registrations')" id="portal-tab-registrations"
                class="portal-tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:text-brand-deep hover:bg-slate-50 flex items-center gap-2 transition-all cursor-pointer whitespace-nowrap">
            <span class="material-symbols-outlined text-[18px]">receipt_long</span>
            <span>Đơn đăng ký & Học phí</span>
            <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 text-[11px] font-bold">@dangKyCount</span>
        </button>

        <!-- Tab 3: Thời khóa biểu tuần -->
        <button type="button" onclick="switchPortalTab('schedule')" id="portal-tab-schedule"
                class="portal-tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:text-brand-deep hover:bg-slate-50 flex items-center gap-2 transition-all cursor-pointer whitespace-nowrap">
            <span class="material-symbols-outlined text-[18px]">calendar_month</span>
            <span>Thời khóa biểu tuần</span>
        </button>

        <!-- Tab 4: Bảng điểm & Chứng nhận -->
        <button type="button" onclick="switchPortalTab('grades')" id="portal-tab-grades"
                class="portal-tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:text-brand-deep hover:bg-slate-50 flex items-center gap-2 transition-all cursor-pointer whitespace-nowrap">
            <span class="material-symbols-outlined text-[18px]">workspace_premium</span>
            <span>Bảng điểm & Chứng nhận</span>
        </button>

        <!-- Tab 5: Thẻ sinh viên & Hồ sơ -->
        <button type="button" onclick="switchPortalTab('profile')" id="portal-tab-profile"
                class="portal-tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:text-brand-deep hover:bg-slate-50 flex items-center gap-2 transition-all cursor-pointer whitespace-nowrap">
            <span class="material-symbols-outlined text-[18px]">badge</span>
            <span>Thẻ sinh viên & Hồ sơ</span>
        </button>
    </div>

    <!-- 3. TAB 1 PANE: KHÓA HỌC ĐANG MỞ ĐĂNG KÝ -->
    <div id="portal-pane-courses" class="portal-pane space-y-6">
        <!-- Filter Toolbar -->
        <div class="bg-white rounded-2xl p-3 border border-border-standard shadow-xs flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 text-xs">
            <div class="relative flex-1">
                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">search</span>
                <input type="text" id="portalCourseSearch" oninput="filterPortalCards()" placeholder="Tìm tên lớp, chương trình đào tạo, giảng viên..."
                       class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-border-standard bg-slate-50/60 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 text-slate-800 placeholder:text-slate-400 transition-all text-xs" />
            </div>

            <div class="relative">
                <select id="portalProgramFilter" onchange="filterPortalCards()"
                        class="w-full md:w-auto px-3.5 py-2.5 rounded-xl border border-border-standard bg-slate-50/60 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 text-slate-700 font-medium text-xs cursor-pointer">
                    <option value="">-- Tất cả Chương trình Đào tạo --</option>
                    @foreach (var ct in chuongTrinhs)
                    {
                        <option value="@ct.TenChuongTrinh">@ct.TenChuongTrinh</option>
                    }
                </select>
            </div>

            <div class="relative">
                <select id="portalSeatFilter" onchange="filterPortalCards()"
                        class="w-full md:w-auto px-3.5 py-2.5 rounded-xl border border-border-standard bg-slate-50/60 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 text-slate-700 font-medium text-xs cursor-pointer">
                    <option value="">-- Tình trạng chỗ --</option>
                    <option value="con-cho">Còn chỗ</option>
                    <option value="sap-day">Sắp đầy chỗ</option>
                </select>
            </div>

            <div class="flex items-center gap-1.5 px-3 py-2 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 font-bold shrink-0 self-start md:self-auto">
                <span class="material-symbols-outlined text-[16px] text-rose-600">filter_alt</span>
                <span id="portalCourseCountBadge">@allOpenClasses.Count lớp mở</span>
            </div>
        </div>

        <!-- 3-Column Course Cards Grid Matching Screenshot -->
        <div id="portalCardsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var cls in allOpenClasses)
            {
                int currentSiSo = allSiSoMap.ContainsKey(cls.MaLopHoc) ? allSiSoMap[cls.MaLopHoc] : 0;
                string seatStatus = currentSiSo >= cls.SiSoToiDa * 0.8 ? "sap-day" : "con-cho";
                string gvDisplay = !string.IsNullOrWhiteSpace(cls.GiangVien?.HoTen)
                    ? ($"{cls.GiangVien.HocVi ?? "ThS."} {cls.GiangVien.HoTen}")
                    : (!string.IsNullOrWhiteSpace(cls.TenGiangVien) ? cls.TenGiangVien : "ThS. Giảng viên UNETI");
                string hinhAnh = cls.TenLop.Contains("React", StringComparison.OrdinalIgnoreCase)
                    ? "https://images.unsplash.com/photo-1633356122544-f134324a6cee?auto=format&fit=crop&w=600&q=80"
                    : (cls.TenLop.Contains("Python", StringComparison.OrdinalIgnoreCase) || cls.TenLop.Contains("AI", StringComparison.OrdinalIgnoreCase))
                        ? "https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=600&q=80"
                        : "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=600&q=80";
                string moTa = !string.IsNullOrWhiteSpace(cls.MoTa) ? cls.MoTa : (!string.IsNullOrWhiteSpace(cls.ChuongTrinhDaoTao?.MoTa) ? cls.ChuongTrinhDaoTao.MoTa : "Khóa đào tạo chuyên sâu kiến thức và kỹ năng thực tế với giảng viên hướng dẫn trực tiếp.");
                string lichHoc = !string.IsNullOrWhiteSpace(cls.PhongHoc) ? $"Phòng {cls.PhongHoc}" : "Phòng Lab CNTT";

                <div class="portal-course-card bg-white rounded-3xl overflow-hidden border border-border-standard shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col group"
                     data-program="@(cls.ChuongTrinhDaoTao?.TenChuongTrinh ?? "")" data-name="@cls.TenLop" data-lecturer="@gvDisplay" data-seats="@seatStatus">
                    <div class="relative aspect-video overflow-hidden bg-slate-900">
                        <img src="@hinhAnh"
                             alt="@cls.TenLop"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20"></div>

                        <span class="absolute top-3 left-3 px-2.5 py-1 rounded-lg bg-black/50 backdrop-blur-md text-white text-[11px] font-mono font-bold tracking-wider border border-white/20">
                            #LOP@(cls.MaLopHoc.ToString("D2"))
                        </span>

                        <span class="absolute top-3 right-3 px-3 py-1 rounded-lg bg-emerald-600 text-white text-[11px] font-bold shadow-md shadow-emerald-600/30">
                            Tuyển sinh
                        </span>

                        <div class="absolute bottom-3 left-3 inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-black/60 backdrop-blur-md text-amber-300 text-xs font-bold border border-white/10">
                            <span class="material-symbols-outlined text-[15px] text-amber-400">bookmark</span>
                            <span>@(cls.ChuongTrinhDaoTao?.TenChuongTrinh ?? "Khóa học")</span>
                        </div>
                    </div>

                    <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                        <div class="space-y-2">
                            <h3 class="text-base font-bold text-slate-900 line-clamp-1 group-hover:text-primary transition-colors">
                                @cls.TenLop
                            </h3>
                            <p class="text-xs text-outline line-clamp-2">
                                @moTa
                            </p>
                        </div>

                        <div class="space-y-2 pt-2 border-t border-border-standard text-xs text-slate-600">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-[16px] text-primary">person</span>
                                <span class="truncate">@gvDisplay</span>
                            </div>
                            <div class="flex items-center gap-2 font-mono">
                                <span class="material-symbols-outlined text-[16px] text-primary">schedule</span>
                                <span>@lichHoc • @cls.SoBuoiHoc buổi</span>
                            </div>
                        </div>

                        <div class="pt-3 border-t border-border-standard flex items-center justify-between">
                            <div>
                                <span class="text-[10px] text-outline uppercase font-semibold block">Học phí</span>
                                <span class="text-base font-black text-rose-600 font-mono">@cls.HocPhi.ToString("N0") đ</span>
                            </div>
                            <div class="text-right">
                                <span class="text-[10px] text-outline font-mono block">Sĩ số: <strong>@currentSiSo/@cls.SiSoToiDa</strong></span>
                                <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold @(seatStatus == "con-cho" ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700")">
                                    @(seatStatus == "con-cho" ? "Còn chỗ" : "Sắp đầy")
                                </span>
                            </div>
                        </div>

                        <div class="pt-1">
                            <a href="/CongHocVien/DangKy" class="w-full py-2.5 rounded-xl bg-primary hover:bg-primary-hover text-white text-xs font-bold shadow-xs transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                                <span class="material-symbols-outlined text-[16px]">how_to_reg</span>
                                <span>Đăng ký tham gia lớp</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- 4. TAB 2 PANE: ĐƠN ĐĂNG KÝ & HỌC PHÍ -->
    <div id="portal-pane-registrations" class="portal-pane space-y-6 hidden">
        <!-- Status summary stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-white rounded-2xl p-4 border border-border-standard shadow-xs flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">receipt_long</span>
                </div>
                <div>
                    <span class="text-xs text-outline font-medium">Tổng số đơn đăng ký</span>
                    <h4 class="text-xl font-black text-brand-deep font-mono">@dangKyCount khóa</h4>
                </div>
            </div>
            <div class="bg-white rounded-2xl p-4 border border-border-standard shadow-xs flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">check_circle</span>
                </div>
                <div>
                    <span class="text-xs text-outline font-medium">Đã hoàn tất học phí</span>
                    <h4 class="text-xl font-black text-emerald-700 font-mono">@lopDangHocCount khóa</h4>
                </div>
            </div>
            <div class="bg-white rounded-2xl p-4 border border-border-standard shadow-xs flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">pending_actions</span>
                </div>
                <div>
                    <span class="text-xs text-outline font-medium">Chờ thanh toán / xác nhận</span>
                    <h4 class="text-xl font-black text-amber-700 font-mono">@(Math.Max(0, dangKyCount - lopDangHocCount)) khóa</h4>
                </div>
            </div>
        </div>

        <!-- Registration Records Table -->
        <div class="bg-white rounded-3xl border border-border-standard shadow-xs overflow-hidden">
            <div class="p-5 border-b border-border-standard flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
