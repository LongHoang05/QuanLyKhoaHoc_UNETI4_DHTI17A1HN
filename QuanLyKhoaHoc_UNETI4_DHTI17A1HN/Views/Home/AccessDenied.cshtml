@{
    ViewData["Title"] = "Từ chối quyền truy cập";
}

<div class="min-h-[70vh] flex items-center justify-center p-4">
    <div class="bg-surface-white border border-border-subtle shadow-xl rounded-3xl max-w-lg w-full p-8 text-center space-y-5">
        <div class="w-16 h-16 rounded-2xl bg-red-50 text-danger-crimson flex items-center justify-center mx-auto border border-red-200">
            <span class="material-symbols-outlined text-[36px]">gpp_maybe</span>
        </div>
        <div class="space-y-2">
            <h2 class="text-2xl font-extrabold text-brand-deep">Truy Cập Bị Từ Chối</h2>
            <p class="text-sm text-outline leading-relaxed">
                Tài khoản của bạn không có quyền hạn cần thiết để truy cập vào phân hệ này.
                Chức năng chỉ dành cho quản trị viên hoặc người dùng được phân quyền tương ứng.
            </p>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-semibold text-sm shadow-sm transition-all">
                <span class="material-symbols-outlined text-[18px]">home</span>
                <span>Về Trang Chủ</span>
            </a>
            <a asp-controller="TaiKhoan" asp-action="DangNhap" asp-route-switchAccount="true" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-border-standard hover:bg-surface-container-low text-brand-deep font-semibold text-sm transition-all">
                <span class="material-symbols-outlined text-[18px]">switch_account</span>
                <span>Đổi Tài Khoản</span>
            </a>
        </div>
    </div>
</div>
