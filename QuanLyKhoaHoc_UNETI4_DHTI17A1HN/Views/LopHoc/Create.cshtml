@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc

@{
    ViewData["Title"] = "Mở Lớp Học Mới (Module 2)";
}

<div class="container py-3" style="max-width: 950px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Quản lý Lớp học</a></li>
            <li class="breadcrumb-item active" aria-current="page">Mở lớp mới</li>
        </ol>
    </nav>

    <!-- Card Form -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-primary text-white p-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="badge bg-light text-primary fw-bold px-3 py-1 rounded-pill mb-2">
                        <i class="bi bi-plus-circle-fill me-1"></i> Module 2 • Thêm mới LopHoc
                    </span>
                    <h3 class="fw-bold mb-0 text-white">Mở Lớp Học Đào Tạo Mới</h3>
                    <p class="mb-0 text-white-50 small mt-1">
                        Kiểm tra nghiêm ngặt tính hợp lệ của ngày mở, hạn đăng ký, ngày khai giảng & chỉ số sĩ số
                    </p>
                </div>
                <i class="bi bi-easel2-fill display-5 opacity-25"></i>
            </div>
        </div>

        <form asp-action="Create" method="post" class="p-4">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

            <div class="row g-3 mb-4">
                <div class="col-12">
                    <h6 class="fw-bold text-primary border-bottom pb-2">
                        <i class="bi bi-info-circle me-1"></i> 1. Thông Tin Cơ Bản Lớp Học
                    </h6>
                </div>

                <!-- Tên lớp học -->
                <div class="col-md-8">
                    <label asp-for="TenLop" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <input asp-for="TenLop" class="form-control" placeholder="Ví dụ: Lập trình ASP.NET Core K17 - Lớp 01" />
                    <span asp-validation-for="TenLop" class="text-danger small"></span>
                </div>

                <!-- Chương trình đào tạo -->
                <div class="col-md-4">
                    <label asp-for="MaChuongTrinh" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <select asp-for="MaChuongTrinh" asp-items="ViewBag.MaChuongTrinh" class="form-select">
                        <option value="">-- Chọn Chương trình ĐT --</option>
                    </select>
                    <span asp-validation-for="MaChuongTrinh" class="text-danger small"></span>
                </div>

                <!-- Giảng viên phụ trách -->
                <div class="col-md-6">
                    <label asp-for="MaGiangVien" class="form-label fw-semibold small"></label>
                    <select asp-for="MaGiangVien" asp-items="ViewBag.MaGiangVien" class="form-select">
                        <option value="">-- Chưa phân công / Chọn sau --</option>
                    </select>
                    <span asp-validation-for="MaGiangVien" class="text-danger small"></span>
                </div>

                <!-- Trình độ đầu vào -->
                <div class="col-md-3">
                    <label asp-for="TrinhDoDauVao" class="form-label fw-semibold small"></label>
                    <select asp-for="TrinhDoDauVao" class="form-select">
                        <option value="Cơ bản">Cơ bản</option>
                        <option value="Trung cấp">Trung cấp</option>
                        <option value="Nâng cao">Nâng cao</option>
                    </select>
                    <span asp-validation-for="TrinhDoDauVao" class="text-danger small"></span>
                </div>

                <!-- Phòng học -->
                <div class="col-md-3">
                    <label asp-for="PhongHoc" class="form-label fw-semibold small"></label>
                    <input asp-for="PhongHoc" class="form-control" placeholder="Lab 302 - Nhà HA8" />
                    <span asp-validation-for="PhongHoc" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12">
                    <h6 class="fw-bold text-primary border-bottom pb-2">
                        <i class="bi bi-cash-coin me-1"></i> 2. Chỉ Số Quy Mô & Học Phí
                    </h6>
                </div>

                <!-- Sĩ số tối đa -->
                <div class="col-md-4">
                    <label asp-for="SiSoToiDa" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <input asp-for="SiSoToiDa" class="form-control" type="number" min="1" max="500" />
                        <span class="input-group-text small">học viên</span>
                    </div>
                    <span asp-validation-for="SiSoToiDa" class="text-danger small"></span>
                </div>

                <!-- Số buổi học -->
                <div class="col-md-4">
                    <label asp-for="SoBuoiHoc" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <input asp-for="SoBuoiHoc" class="form-control" type="number" min="1" max="200" />
                        <span class="input-group-text small">buổi</span>
                    </div>
                    <span asp-validation-for="SoBuoiHoc" class="text-danger small"></span>
                </div>

                <!-- Học phí -->
                <div class="col-md-4">
                    <label asp-for="HocPhi" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <input asp-for="HocPhi" class="form-control" type="number" min="0" step="50000" />
                        <span class="input-group-text small">VNĐ</span>
                    </div>
                    <span asp-validation-for="HocPhi" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12">
                    <h6 class="fw-bold text-primary border-bottom pb-2">
                        <i class="bi bi-calendar3 me-1"></i> 3. Lịch Trình Đăng Ký & Trạng Thái
                    </h6>
                </div>

                <!-- Ngày bắt đầu đăng ký -->
                <div class="col-md-4">
                    <label asp-for="NgayBatDauDangKy" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <input asp-for="NgayBatDauDangKy" class="form-control" type="date" />
                    <span asp-validation-for="NgayBatDauDangKy" class="text-danger small"></span>
                </div>

                <!-- Hạn chót đăng ký -->
                <div class="col-md-4">
                    <label asp-for="HanDangKy" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <input asp-for="HanDangKy" class="form-control" type="date" />
                    <div class="form-text small">Phải &ge; ngày mở đăng ký</div>
                    <span asp-validation-for="HanDangKy" class="text-danger small"></span>
                </div>

                <!-- Ngày khai giảng -->
                <div class="col-md-4">
                    <label asp-for="NgayKhaiGiang" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <input asp-for="NgayKhaiGiang" class="form-control" type="date" />
                    <div class="form-text small">Phải &ge; hạn chót đăng ký</div>
                    <span asp-validation-for="NgayKhaiGiang" class="text-danger small"></span>
                </div>

                <!-- Trạng thái -->
                <div class="col-md-6">
                    <label asp-for="TrangThai" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                    <select asp-for="TrangThai" class="form-select">
                        <option value="Đang mở đăng ký">Đang mở đăng ký</option>
                        <option value="Chưa mở">Chưa mở</option>
                        <option value="Tạm dừng">Tạm dừng</option>
                        <option value="Đã đóng đăng ký">Đã đóng đăng ký</option>
                    </select>
                    <span asp-validation-for="TrangThai" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12">
                    <h6 class="fw-bold text-primary border-bottom pb-2">
                        <i class="bi bi-file-text me-1"></i> 4. Mô Tả Chi Tiết & Yêu Cầu Học Viên
                    </h6>
                </div>

                <!-- Mô tả -->
                <div class="col-12">
                    <label asp-for="MoTa" class="form-label fw-semibold small"></label>
                    <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Mô tả tóm tắt nội dung chương trình học, mục tiêu đầu ra..."></textarea>
                    <span asp-validation-for="MoTa" class="text-danger small"></span>
                </div>

                <!-- Yêu cầu học viên -->
                <div class="col-12">
                    <label asp-for="YeuCauHocVien" class="form-label fw-semibold small"></label>
                    <textarea asp-for="YeuCauHocVien" class="form-control" rows="2" placeholder="Kiến thức nền tảng cần chuẩn bị, trang thiết bị máy tính..."></textarea>
                    <span asp-validation-for="YeuCauHocVien" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                </a>
                <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                    <i class="bi bi-check-circle-fill me-1"></i> Xác nhận tạo lớp học
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
