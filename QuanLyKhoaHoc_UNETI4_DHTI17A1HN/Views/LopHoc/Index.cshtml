@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.ViewModels.LopHocListViewModel

@{
    ViewData["Title"] = "Quản lý Lớp học";
}

<div class="container-fluid px-4 py-4">
    <!-- 1. TIÊU ĐỀ & NÚT THAO TÁC NHANH -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h3 class="fw-bold text-dark mb-0">Quản lý Lớp học</h3>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">Module 2</span>
            </div>
            <p class="text-muted small mb-0 mt-1">
                Phụ trách: <strong>Nguyễn Đình Kiên</strong> (MSV: 23103100020) • Tìm kiếm, Lọc đa điều kiện, Sắp xếp & Phân trang LINQ
            </p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-info rounded-pill px-3 shadow-sm btn-sm" data-bs-toggle="modal" data-bs-target="#modalQuyDinhM2">
                <i class="bi bi-info-circle me-1"></i> Quy định Mục 6
            </button>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm btn-sm fw-bold">
                <i class="bi bi-plus-circle me-1"></i> Mở lớp học mới
            </a>
        </div>
    </div>

    <!-- 2. THỐNG KÊ NHANH CÁC CHỈ SỐ LỚP HỌC (KPI CARDS) -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Tổng số lớp</div>
                        <div class="fs-3 fw-bold text-dark">@Model.TongSoLop</div>
                    </div>
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary fs-4">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Đang mở đăng ký</div>
                        <div class="fs-3 fw-bold text-success">@Model.SoLopDangMo</div>
                    </div>
                    <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success fs-4">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Đã đóng đăng ký</div>
                        <div class="fs-3 fw-bold text-secondary">@Model.SoLopDaDong</div>
                    </div>
                    <div class="rounded-3 p-3 bg-secondary bg-opacity-10 text-secondary fs-4">
                        <i class="bi bi-lock-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Tạm dừng / Chưa mở</div>
                        <div class="fs-3 fw-bold text-warning">@Model.SoLopTamDung</div>
                    </div>
                    <div class="rounded-3 p-3 bg-warning bg-opacity-10 text-warning fs-4">
                        <i class="bi bi-pause-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. KHU VỰC BỘ LỌC TÌM KIẾM ĐA ĐIỀU KIỆN (LINQ SEARCH & FILTER) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="mb-0 fw-bold text-primary">
                <i class="bi bi-funnel-fill me-1"></i> Bộ Lọc Tìm Kiếm & Sắp Xếp Nâng Cao (LINQ Queryable)
            </h6>
        </div>
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <!-- Từ khóa tìm kiếm -->
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Từ khóa (Tên lớp, CTĐT, Giảng viên)</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="keyword" value="@Model.Keyword" class="form-control border-start-0" placeholder="Nhập từ khóa tìm kiếm..." />
                    </div>
                </div>

                <!-- Lọc theo Chương trình ĐT -->
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Chương trình đào tạo</label>
                    <select name="maChuongTrinh" asp-items="Model.ChuongTrinhOptions" class="form-select form-select-sm">
                        <option value="">-- Tất cả chương trình --</option>
                    </select>
                </div>

                <!-- Lọc theo Giảng viên -->
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Giảng viên</label>
                    <select name="giangVien" asp-items="Model.GiangVienOptions" class="form-select form-select-sm">
                        <option value="">-- Tất cả giảng viên --</option>
                    </select>
                </div>

                <!-- Lọc theo Trạng thái -->
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Trạng thái lớp</label>
                    <select name="trangThai" class="form-select form-select-sm">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Đang mở đăng ký" selected="@(Model.TrangThai == "Đang mở đăng ký")">Đang mở đăng ký</option>
                        <option value="Chưa mở" selected="@(Model.TrangThai == "Chưa mở")">Chưa mở</option>
                        <option value="Tạm dừng" selected="@(Model.TrangThai == "Tạm dừng")">Tạm dừng</option>
                        <option value="Đã đóng đăng ký" selected="@(Model.TrangThai == "Đã đóng đăng ký")">Đã đóng đăng ký</option>
                    </select>
                </div>

                <!-- Sắp xếp LINQ -->
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Sắp xếp</label>
                    <select name="sortBy" class="form-select form-select-sm">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">Mới nhất (Mặc định)</option>
                        <option value="ten_asc" selected="@(Model.SortBy == "ten_asc")">Tên lớp: A -> Z</option>
                        <option value="ten_desc" selected="@(Model.SortBy == "ten_desc")">Tên lớp: Z -> A</option>
                        <option value="hocphi_asc" selected="@(Model.SortBy == "hocphi_asc")">Học phí: Thấp -> Cao</option>
                        <option value="hocphi_desc" selected="@(Model.SortBy == "hocphi_desc")">Học phí: Cao -> Thấp</option>
                        <option value="handk_asc" selected="@(Model.SortBy == "handk_asc")">Hạn ĐK: Gần nhất</option>
                        <option value="khaigiang_asc" selected="@(Model.SortBy == "khaigiang_asc")">Khai giảng: Gần nhất</option>
                    </select>
                </div>

                <!-- Hàng lọc phụ: Trình độ, Còn hạn, Còn chỗ -->
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Trình độ đầu vào</label>
                    <select name="trinhDo" class="form-select form-select-sm">
                        <option value="">-- Tất cả trình độ --</option>
                        <option value="Cơ bản" selected="@(Model.TrinhDoDauVao == "Cơ bản")">Cơ bản</option>
                        <option value="Trung cấp" selected="@(Model.TrinhDoDauVao == "Trung cấp")">Trung cấp</option>
                        <option value="Nâng cao" selected="@(Model.TrinhDoDauVao == "Nâng cao")">Nâng cao</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Hạn đăng ký</label>
                    <select name="filterHanDangKy" class="form-select form-select-sm">
                        <option value="">-- Tất cả hạn nộp --</option>
                        <option value="con_han" selected="@(Model.FilterHanDangKy == "con_han")">Còn hạn đăng ký</option>
                        <option value="het_han" selected="@(Model.FilterHanDangKy == "het_han")">Đã hết hạn đăng ký</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Tình trạng chỗ</label>
                    <select name="filterConCho" class="form-select form-select-sm">
                        <option value="">-- Tất cả sĩ số --</option>
                        <option value="con_cho" selected="@(Model.FilterConCho == "con_cho")">Còn chỗ trống</option>
                        <option value="het_cho" selected="@(Model.FilterConCho == "het_cho")">Đã hết chỗ</option>
                    </select>
                </div>

                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary w-50 fw-semibold">
                        <i class="bi bi-search me-1"></i> Lọc dữ liệu
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-50">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- 4. DANH SÁCH LỚP HỌC (MODERN TABLE) -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark">
                <i class="bi bi-table me-2 text-primary"></i>Kết quả hiển thị: 
                <span class="badge bg-primary rounded-pill">@Model.TotalCount</span> lớp học
            </span>
            <span class="text-muted small">Trang @Model.PageIndex / @Model.TotalPages</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary text-uppercase" style="font-size: 0.75rem;">
                    <tr>
                        <th class="ps-3 py-3">Lớp học / CTĐT</th>
                        <th>Giảng viên</th>
                        <th>Học phí</th>
                        <th style="min-width: 140px;">Sĩ số & Tiến độ</th>
                        <th>Lịch trình</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                Không tìm thấy lớp học nào phù hợp với bộ lọc hiện tại.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        var soDaDuyet = item.DangKyHocs.Count(d =>
                            d.TrangThai == "Đã duyệt" ||
                            d.TrangThai == "Đã đóng học phí" ||
                            d.TrangThai == "Đang học" ||
                            d.TrangThai == "Hoàn thành");
                        var tyLe = item.SiSoToiDa > 0 ? (int)Math.Round((double)soDaDuyet / item.SiSoToiDa * 100) : 0;
                        var conHan = item.HanDangKy >= DateTime.Today;

                        <tr>
                            <!-- Thông tin Lớp học -->
                            <td class="ps-3">
                                <div class="fw-bold text-dark">@item.TenLop</div>
                                <div class="text-muted small">
                                    <i class="bi bi-journal-text me-1"></i>@(item.ChuongTrinhDaoTao?.TenChuongTrinh ?? "N/A")
                                </div>
                                <div class="mt-1">
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25" style="font-size: 0.7rem;">
                                        @item.TrinhDoDauVao
                                    </span>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25" style="font-size: 0.7rem;">
                                        @item.SoBuoiHoc buổi
                                    </span>
                                    @if (!string.IsNullOrEmpty(item.PhongHoc))
                                    {
                                        <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">
                                            <i class="bi bi-geo-alt"></i> @item.PhongHoc
                                        </span>
                                    }
                                </div>
                            </td>

                            <!-- Giảng viên phụ trách -->
                            <td>
                                @if (!string.IsNullOrEmpty(item.TenGiangVien))
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            @(item.TenGiangVien.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="small fw-semibold text-dark">@item.TenGiangVien</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic small">Chưa phân công</span>
                                }
                            </td>

                            <!-- Học phí -->
                            <td>
                                <span class="fw-bold text-primary">@item.HocPhi.ToString("N0") đ</span>
                            </td>

                            <!-- Tiến độ Sĩ số -->
                            <td>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold">@soDaDuyet / @item.SiSoToiDa học viên</span>
                                    <span class="text-muted">@tyLe%</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar @(tyLe >= 100 ? "bg-danger" : tyLe >= 80 ? "bg-warning" : "bg-success")"
                                         role="progressbar" style="width: @(Math.Min(tyLe, 100))%" aria-valuenow="@tyLe" aria-valuemin="0" aria-valuemax="100">
                                    </div>
                                </div>
                                <div style="font-size: 0.72rem;" class="mt-1">
                                    @if (soDaDuyet >= item.SiSoToiDa)
                                    {
                                        <span class="text-danger fw-semibold"><i class="bi bi-x-circle me-1"></i>Hết chỗ</span>
                                    }
                                    else
                                    {
                                        <span class="text-success"><i class="bi bi-check-circle me-1"></i>Còn @(item.SiSoToiDa - soDaDuyet) chỗ</span>
                                    }
                                </div>
                            </td>

                            <!-- Lịch trình -->
                            <td class="small">
                                <div><i class="bi bi-calendar-event me-1 text-muted"></i>Hạn ĐK: <strong>@item.HanDangKy.ToString("dd/MM/yyyy")</strong></div>
                                <div class="text-muted"><i class="bi bi-flag me-1"></i>Khai giảng: @item.NgayKhaiGiang.ToString("dd/MM/yyyy")</div>
                                @if (conHan)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success mt-1">Còn hạn ĐK</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger mt-1">Hết hạn ĐK</span>
                                }
                            </td>

                            <!-- Trạng thái -->
                            <td class="text-center">
                                @if (item.TrangThai == "Đang mở đăng ký")
                                {
                                    <span class="badge bg-success px-2 py-1 rounded-pill">
                                        <i class="bi bi-check2-circle me-1"></i>Đang mở
                                    </span>
                                }
                                else if (item.TrangThai == "Chưa mở")
                                {
                                    <span class="badge bg-secondary px-2 py-1 rounded-pill">Chưa mở</span>
                                }
                                else if (item.TrangThai == "Tạm dừng")
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1 rounded-pill">Tạm dừng</span>
                                }
                                else
                                {
                                    <span class="badge bg-dark px-2 py-1 rounded-pill">Đã đóng</span>
                                }
                            </td>

                            <!-- Thao tác -->
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.MaLopHoc" class="btn btn-outline-info" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.MaLopHoc" class="btn btn-outline-primary" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" title="Xóa lớp" 
                                            onclick="confirmDelete(@item.MaLopHoc, '@Html.Raw(item.TenLop.Replace("'", "\\'"))')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 5. PHÂN TRANG SERVER-SIDE (GIỮ NGUYÊN TẤT CẢ THAM SỐ LỌC & TÌM KIẾM) -->
        <div class="card-footer bg-white border-top py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="small text-muted">
                Hiển thị <strong>@(((Model.PageIndex - 1) * Model.PageSize) + 1)</strong> - 
                <strong>@(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount))</strong> 
                trong tổng số <strong>@Model.TotalCount</strong> lớp học
            </div>

            <nav aria-label="Phân trang lớp học">
                <ul class="pagination pagination-sm mb-0">
                    <!-- Nút Về trang đầu -->
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="1"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-maChuongTrinh="@Model.MaChuongTrinh"
                           asp-route-trinhDo="@Model.TrinhDoDauVao"
                           asp-route-trangThai="@Model.TrangThai"
                           asp-route-giangVien="@Model.GiangVien"
                           asp-route-minHocPhi="@Model.MinHocPhi"
                           asp-route-maxHocPhi="@Model.MaxHocPhi"
                           asp-route-filterHanDangKy="@Model.FilterHanDangKy"
                           asp-route-filterConCho="@Model.FilterConCho"
                           asp-route-sortBy="@Model.SortBy">
                            <i class="bi bi-chevron-double-left"></i>
                        </a>
                    </li>

                    <!-- Nút Trang trước -->
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(Model.PageIndex - 1)"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-maChuongTrinh="@Model.MaChuongTrinh"
                           asp-route-trinhDo="@Model.TrinhDoDauVao"
                           asp-route-trangThai="@Model.TrangThai"
                           asp-route-giangVien="@Model.GiangVien"
                           asp-route-minHocPhi="@Model.MinHocPhi"
                           asp-route-maxHocPhi="@Model.MaxHocPhi"
                           asp-route-filterHanDangKy="@Model.FilterHanDangKy"
                           asp-route-filterConCho="@Model.FilterConCho"
                           asp-route-sortBy="@Model.SortBy">
                            Trang trước
                        </a>
                    </li>

                    @for (int i = Math.Max(1, Model.PageIndex - 2); i <= Math.Min(Model.TotalPages, Model.PageIndex + 2); i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@i"
                               asp-route-keyword="@Model.Keyword"
                               asp-route-maChuongTrinh="@Model.MaChuongTrinh"
                               asp-route-trinhDo="@Model.TrinhDoDauVao"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-giangVien="@Model.GiangVien"
                               asp-route-minHocPhi="@Model.MinHocPhi"
                               asp-route-maxHocPhi="@Model.MaxHocPhi"
                               asp-route-filterHanDangKy="@Model.FilterHanDangKy"
                               asp-route-filterConCho="@Model.FilterConCho"
                               asp-route-sortBy="@Model.SortBy">
                                @i
                            </a>
                        </li>
                    }

                    <!-- Nút Trang kế -->
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(Model.PageIndex + 1)"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-maChuongTrinh="@Model.MaChuongTrinh"
                           asp-route-trinhDo="@Model.TrinhDoDauVao"
                           asp-route-trangThai="@Model.TrangThai"
                           asp-route-giangVien="@Model.GiangVien"
                           asp-route-minHocPhi="@Model.MinHocPhi"
                           asp-route-maxHocPhi="@Model.MaxHocPhi"
                           asp-route-filterHanDangKy="@Model.FilterHanDangKy"
                           asp-route-filterConCho="@Model.FilterConCho"
                           asp-route-sortBy="@Model.SortBy">
                            Trang sau
                        </a>
                    </li>

                    <!-- Nút Đến trang cuối -->
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@Model.TotalPages"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-maChuongTrinh="@Model.MaChuongTrinh"
                           asp-route-trinhDo="@Model.TrinhDoDauVao"
                           asp-route-trangThai="@Model.TrangThai"
                           asp-route-giangVien="@Model.GiangVien"
                           asp-route-minHocPhi="@Model.MinHocPhi"
                           asp-route-maxHocPhi="@Model.MaxHocPhi"
                           asp-route-filterHanDangKy="@Model.FilterHanDangKy"
                           asp-route-filterConCho="@Model.FilterConCho"
                           asp-route-sortBy="@Model.SortBy">
                            <i class="bi bi-chevron-double-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- MODAL XÁC NHẬN XÓA LỚP HỌC -->
<div class="modal fade" id="modalDeleteConfirm" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa lớp học</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="deleteForm" method="post" asp-action="Delete">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <p class="mb-2">Bạn có chắc chắn muốn xóa lớp học:</p>
                    <div class="alert alert-warning py-2 mb-3">
                        <strong id="deleteClassName"></strong>
                    </div>
                    <p class="text-danger small mb-0">
                        <i class="bi bi-shield-exclamation me-1"></i>Lưu ý: Hệ thống sẽ chặn xóa nếu lớp học đã có dữ liệu học viên đăng ký nhằm bảo toàn dữ liệu lịch sử theo quy định Mục 6.2.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3 fw-bold">Xác nhận xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL THÔNG TIN QUY ĐỊNH MỤC 6 (M2) -->
<div class="modal fade" id="modalQuyDinhM2" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-info-circle-fill me-2"></i>Quy định nghiệp vụ Module 2 (Mục 6 - Đề tài 16 UNETI)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100 border">
                            <h6 class="fw-bold text-primary"><i class="bi bi-check2-circle me-1"></i>Ràng buộc Validation:</h6>
                            <ul class="small mb-0 ps-3">
                                <li>Tên lớp bắt buộc, không để trống.</li>
                                <li>Sĩ số tối đa &gt; 0, Số buổi học &gt; 0, Học phí &ge; 0.</li>
                                <li><code>HanDangKy &ge; NgayBatDauDangKy</code>.</li>
                                <li><code>NgayKhaiGiang &ge; HanDangKy</code>.</li>
                                <li>Không cho giảm sĩ số tối đa xuống thấp hơn số học viên đã duyệt.</li>
                                <li>Chặn xóa lớp nếu đã có đăng ký học viên.</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100 border">
                            <h6 class="fw-bold text-primary"><i class="bi bi-search me-1"></i>Bộ lọc LINQ & Phân trang:</h6>
                            <ul class="small mb-0 ps-3">
                                <li>Tìm kiếm: Tên lớp, Chương trình đào tạo, Giảng viên.</li>
                                <li>Lọc: Trình độ, Trạng thái, CTĐT, Giảng viên, Còn hạn/Hết hạn, Còn chỗ/Hết chỗ.</li>
                                <li>Sắp xếp: Tên A-Z, Học phí tăng/giảm, Hạn ĐK, Khai giảng.</li>
                                <li>Phân trang server bằng <code>Skip()</code> và <code>Take()</code>.</li>
                                <li>Giữ nguyên tất cả tham số lọc khi chuyển trang.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Đã hiểu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteClassName').textContent = name;
            var form = document.getElementById('deleteForm');
            form.action = '/LopHoc/Delete/' + id;
            var modal = new bootstrap.Modal(document.getElementById('modalDeleteConfirm'));
            modal.show();
        }
    </script>
}
