@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc

@{
    ViewData["Title"] = "Chi Tiết Lớp Học - " + Model.TenLop;
    var soDaDuyet = (int)(ViewBag.SoHocVienDaDuyet ?? 0);
    var tyLe = Model.SiSoToiDa > 0 ? (int)Math.Round((double)soDaDuyet / Model.SiSoToiDa * 100) : 0;
}

<div class="container-fluid px-4 py-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 mb-2">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách lớp
            </a>
            <div class="d-flex align-items-center gap-2">
                <h3 class="fw-bold text-dark mb-0">@Model.TenLop</h3>
                <span class="badge bg-primary rounded-pill">Mã lớp: #@Model.MaLopHoc</span>
                @if (Model.TrangThai == "Đang mở đăng ký")
                {
                    <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-check2-circle me-1"></i>@Model.TrangThai</span>
                }
                else
                {
                    <span class="badge bg-secondary rounded-pill px-3 py-1">@Model.TrangThai</span>
                }
            </div>
            <p class="text-muted small mb-0 mt-1">
                Chương trình: <strong>@(Model.ChuongTrinhDaoTao?.TenChuongTrinh ?? "N/A")</strong>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.MaLopHoc" class="btn btn-primary rounded-pill px-4 shadow-sm btn-sm fw-bold">
                <i class="bi bi-pencil me-1"></i> Chỉnh sửa
            </a>
        </div>
    </div>

    <!-- Thông tin chi tiết lớp học -->
    <div class="row g-4 mb-4">
        <!-- Cột thông tin chung -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                    <i class="bi bi-info-circle me-1"></i> Thông Tin Chi Tiết Lớp Học
                </h6>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Giảng viên phụ trách:</label>
                        <div class="fw-bold text-dark">@(Model.TenGiangVien ?? "Chưa phân công")</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Trình độ đầu vào:</label>
                        <div><span class="badge bg-info bg-opacity-10 text-info">@Model.TrinhDoDauVao</span></div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Phòng học:</label>
                        <div class="fw-bold text-dark"><i class="bi bi-geo-alt text-danger me-1"></i>@(Model.PhongHoc ?? "Chưa xếp")</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Số buổi học:</label>
                        <div class="fw-bold text-dark">@Model.SoBuoiHoc buổi</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Học phí:</label>
                        <div class="fs-5 fw-bold text-primary">@Model.HocPhi.ToString("N0") VNĐ</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small fw-semibold">Tiến độ tuyển sinh:</label>
                        <div class="fw-bold text-dark">@soDaDuyet / @Model.SiSoToiDa học viên (@tyLe%)</div>
                        <div class="progress mt-1" style="height: 6px;">
                            <div class="progress-bar @(tyLe >= 100 ? "bg-danger" : tyLe >= 80 ? "bg-warning" : "bg-success")"
                                 style="width: @Math.Min(tyLe, 100)%"></div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.MoTa))
                {
                    <div class="mt-4 pt-3 border-top">
                        <label class="text-muted small fw-semibold">Mô tả lớp học:</label>
                        <p class="text-dark mb-0 small">@Model.MoTa</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.YeuCauHocVien))
                {
                    <div class="mt-3">
                        <label class="text-muted small fw-semibold">Yêu cầu đối với học viên:</label>
                        <p class="text-dark mb-0 small">@Model.YeuCauHocVien</p>
                    </div>
                }
            </div>

            <!-- Danh sách buổi học -->
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-primary">
                        <i class="bi bi-calendar-week me-1"></i> Lịch Buổi Học (@Model.BuoiHocs.Count / @Model.SoBuoiHoc buổi)
                    </h6>
                    <a asp-controller="BuoiHoc" asp-action="Index" asp-route-maLop="@Model.MaLopHoc" class="btn btn-sm btn-outline-primary rounded-pill">
                        Quản lý lịch học
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase">
                            <tr>
                                <th class="ps-3">#</th>
                                <th>Thời gian</th>
                                <th>Phòng học</th>
                                <th>Giảng viên</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.BuoiHocs.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted small">
                                        Chưa có buổi học nào được lên lịch cho lớp này.
                                    </td>
                                </tr>
                            }
                            @{ int bIdx = 1; }
                            @foreach (var b in Model.BuoiHocs.OrderBy(x => x.ThoiGianBatDau))
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">@(bIdx++)</td>
                                    <td>
                                        <div class="fw-bold small">@b.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") - @b.ThoiGianKetThuc.ToString("HH:mm")</div>
                                        @if (!string.IsNullOrEmpty(b.NoiDung))
                                        {
                                            <div class="text-muted" style="font-size: 0.72rem;">@b.NoiDung</div>
                                        }
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@b.PhongHoc</span></td>
                                    <td class="small">@b.GiangVien</td>
                                    <td>
                                        <span class="badge @(b.TrangThai == "Đã hoàn thành" ? "bg-success" : b.TrangThai == "Đã hủy" ? "bg-danger" : "bg-primary") rounded-pill">
                                            @b.TrangThai
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Cột lịch trình & Danh sách học viên -->
        <div class="col-lg-4">
            <!-- Timeline card -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                    <i class="bi bi-clock-history me-1"></i> Mốc Thời Gian
                </h6>
                <div class="d-flex flex-column gap-3 small">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2">
                            <i class="bi bi-calendar-plus"></i>
                        </div>
                        <div>
                            <div class="text-muted" style="font-size: 0.7rem;">Mở đăng ký</div>
                            <div class="fw-bold text-dark">@Model.NgayBatDauDangKy.ToString("dd/MM/yyyy")</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2">
                            <i class="bi bi-calendar-x"></i>
                        </div>
                        <div>
                            <div class="text-muted" style="font-size: 0.7rem;">Hạn chót đăng ký</div>
                            <div class="fw-bold text-dark">@Model.HanDangKy.ToString("dd/MM/yyyy")</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-success bg-opacity-10 text-success p-2">
                            <i class="bi bi-flag"></i>
                        </div>
                        <div>
                            <div class="text-muted" style="font-size: 0.7rem;">Ngày khai giảng</div>
                            <div class="fw-bold text-dark">@Model.NgayKhaiGiang.ToString("dd/MM/yyyy")</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Học viên đăng ký -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h6 class="fw-bold text-primary mb-0">
                        <i class="bi bi-people me-1"></i> Học Viên Đăng Ký (@Model.DangKyHocs.Count)
                    </h6>
                    <a asp-controller="HocVien" asp-action="Index" class="small text-primary text-decoration-none">Xem tất cả</a>
                </div>
                <div class="d-flex flex-column gap-2">
                    @if (!Model.DangKyHocs.Any())
                    {
                        <div class="text-center py-4 text-muted small">
                            Chưa có học viên nào đăng ký lớp này.
                        </div>
                    }
                    @foreach (var dk in Model.DangKyHocs)
                    {
                        <div class="p-2 rounded-3 bg-light d-flex align-items-center justify-content-between small">
                            <div>
                                <div class="fw-bold text-dark">@(dk.HocVien?.HoTen ?? $"HV #{dk.MaHocVien}")</div>
                                <div class="text-muted" style="font-size: 0.7rem;">@dk.NgayDangKy.ToString("dd/MM/yyyy")</div>
                            </div>
                            <span class="badge @(dk.TrangThai == "Đã duyệt" || dk.TrangThai == "Đang học" ? "bg-primary" : dk.TrangThai == "Đã đóng học phí" || dk.TrangThai == "Hoàn thành" ? "bg-success" : dk.TrangThai == "Chờ duyệt" ? "bg-warning text-dark" : "bg-secondary") rounded-pill">
                                @dk.TrangThai
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
