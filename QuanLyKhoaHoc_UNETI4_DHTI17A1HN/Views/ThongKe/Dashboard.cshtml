@*
Họ và tên: Nguyễn Tùng Dương
Mã sinh viên: 23103100003
Nội dung thực hiện: Giao diện Dashboard (Module 5) - Phong cách Prep.vn
*@

@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.ViewModels.DashboardVM
@{
    ViewData["Title"] = "Dashboard - Tổng quan";
}

<div class="flex flex-col gap-y-6">
    <!-- 1. Action Strip (Prep.vn Style with UI/UX Pro Max Tokens) -->
    <section class="bg-surface-white rounded-2xl border border-border-standard shadow-sm p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4 card-pro">
        <div class="flex flex-col gap-1">
            <h1 class="text-xl sm:text-2xl text-brand-deep tracking-tight font-extrabold flex items-center gap-2">
                Xin chào, @(Context.Session.GetString("HoTen") ?? "Quản trị viên")
            </h1>
            <div class="flex items-center gap-2 text-on-surface-variant font-body-sm text-body-sm flex-wrap">
                <span class="relative flex h-2.5 w-2.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-warning-amber opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-warning-amber"></span>
                </span>
                <span>
                    Hôm nay có <strong class="text-brand-deep font-semibold">@Model.DangKyChoDuyet yêu cầu</strong> đang chờ duyệt, 
                    <strong class="text-primary-container font-semibold">@Model.BuoiHocSapToi buổi học</strong> sắp tới cần giám sát.
                </span>
            </div>
        </div>
        <div class="flex items-center flex-wrap gap-2.5">
            <a href="/ThongKe/Index" class="border border-border-standard bg-surface-white hover:bg-slate-50 text-brand-deep font-label-md text-label-md px-3.5 py-2 rounded-xl shadow-xs inline-flex items-center gap-2 transition-all active:scale-[0.98] cursor-pointer">
                <span class="material-symbols-outlined text-[17px] text-outline">bar_chart</span>
                <span>Báo cáo thống kê</span>
            </a>
            <a href="/BuoiHoc/Index?create=true" class="bg-primary hover:bg-primary-hover text-surface-white font-label-md text-label-md px-4 py-2 rounded-xl shadow-sm hover:shadow-card inline-flex items-center gap-1.5 transition-all active:scale-[0.98] cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">add</span>
                <span> Lên lịch buổi học</span>
            </a>
        </div>
    </section>

    <!-- 2. 4-Column Stats Bento Grid -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Card 1: Tổng CTĐT -->
        <div class="bg-surface-white rounded-2xl border border-border-standard shadow-sm p-5 flex flex-col justify-between card-pro card-pro-hover">
            <div class="flex items-center justify-between mb-3">
                <span class="text-outline font-label-md text-label-md font-medium">Tổng chương trình ĐT</span>
                <div class="w-10 h-10 rounded-2xl bg-primary-light flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">menu_book</span>
                </div>
            </div>
            <div>
                <div class="font-display text-[30px] leading-8 text-brand-deep tracking-tight tabular-nums font-black mb-2 font-mono">
                    @Model.TongSoCTDT
                </div>
                <div class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 font-label-sm text-label-sm px-2.5 py-0.5 rounded-full font-semibold">
                    <span class="material-symbols-outlined text-[14px]">school</span>
                    <span>Hệ đào tạo UNETI</span>
                </div>
            </div>
        </div>

        <!-- Card 2: Sinh viên đăng ký -->
        <div class="bg-surface-white rounded-2xl border border-border-standard shadow-sm p-5 flex flex-col justify-between card-pro card-pro-hover">
            <div class="flex items-center justify-between mb-2">
                <span class="text-outline font-label-md text-label-md font-medium">Tổng số sinh viên</span>
                <div class="w-10 h-10 rounded-2xl bg-blue-50 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">groups</span>
                </div>
            </div>
            <div>
                <div class="flex items-baseline gap-1.5 mb-1.5">
                    <span class="font-display text-[30px] leading-8 text-brand-deep tracking-tight tabular-nums font-black font-mono">
                        @Model.TongSoHocVien
                    </span>
                    <span class="text-outline font-body-sm text-body-sm">/ @Model.TongSoLop lớp học</span>
                </div>
                <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden mb-2">
                    <div class="h-full bg-gradient-to-r from-primary to-blue-400 rounded-full" style="width: @(Model.TongSoCTDT > 0 ? Math.Min(100, Model.TongSoLop * 12) : 50)%"></div>
                </div>
                <div class="text-primary font-label-sm text-label-sm font-semibold flex items-center gap-1">
                    <span class="material-symbols-outlined text-[13px]">play_circle</span>
                    <span>@Model.LopDangMo lớp đang mở đăng ký</span>
                </div>
            </div>
        </div>

        <!-- Card 3: Chờ phê duyệt -->
        <div class="bg-surface-white rounded-2xl border border-border-standard shadow-sm p-5 flex flex-col justify-between card-pro card-pro-hover">
            <div class="flex items-center justify-between mb-3">
                <span class="text-outline font-label-md text-label-md font-medium">Chờ phê duyệt</span>
                <div class="w-10 h-10 rounded-2xl bg-amber-50 flex items-center justify-center text-amber-600">
                    <span class="material-symbols-outlined text-[20px]">pending_actions</span>
                </div>
            </div>
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="font-display text-[30px] leading-8 text-brand-deep tracking-tight tabular-nums font-black font-mono">
                        @Model.DangKyChoDuyet
                    </span>
                    @if (Model.DangKyChoDuyet > 0)
                    {
                        <span class="relative flex h-2.5 w-2.5">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-500 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>
                        </span>
                    }
                </div>
                <div class="inline-flex items-center gap-1 bg-amber-50 text-amber-700 font-label-sm text-label-sm px-2.5 py-0.5 rounded-full font-semibold">
                    <span class="material-symbols-outlined text-[13px]">priority_high</span>
                    <span>@Model.DangKyDaDuyet lượt đã được duyệt</span>
                </div>
            </div>
        </div>

        <!-- Card 4: Tỷ lệ hoàn thành khóa học -->
        <div class="bg-surface-white rounded-2xl border border-border-standard shadow-sm p-5 flex flex-col justify-between card-pro card-pro-hover">
            <div class="flex items-center justify-between mb-2">
                <span class="text-outline font-label-md text-label-md font-medium">Kết quả hoàn thành</span>
                <div class="w-10 h-10 rounded-2xl bg-emerald-50 flex items-center justify-center text-emerald-600">
                    <span class="material-symbols-outlined text-[20px]">workspace_premium</span>
                </div>
            </div>
            <div class="flex items-center justify-between">
                <div>
                    <div class="font-display text-[30px] leading-8 text-brand-deep tracking-tight tabular-nums font-black mb-1 font-mono">
                        @Model.TyLeHoanThanh%
                    </div>
                    <div class="text-outline font-body-sm text-body-sm">
                        @Model.HocVienHoanThanh HV đạt chuẩn
                    </div>
                </div>
                <div class="relative w-12 h-12 flex-shrink-0">
                    <svg class="w-12 h-12 -rotate-90" viewBox="0 0 36 36">
                        <path class="text-slate-100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3.5"></path>
                        <path class="text-emerald-500" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-dasharray="@Model.TyLeHoanThanh, 100" stroke-linecap="round" stroke-width="3.5"></path>
                    </svg>
                    <span class="absolute inset-0 flex items-center justify-center font-label-sm text-[10px] text-brand-deep font-bold font-mono">
                        @(Math.Round(Model.TyLeHoanThanh))%
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Middle Split Section: Lịch học phần sắp tới (1/2) & Hoạt động đăng ký (1/2) -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Left: Lịch Lớp Học Phần Sắp Tới (Module 5 BuoiHoc) -->
        <div class="bg-surface-white rounded-2xl border border-border-standard shadow-sm p-6 flex flex-col gap-4 h-full card-pro">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-border-subtle">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">calendar_clock</span>
                    <h2 class="font-headline-sm text-headline-sm text-brand-deep font-bold">Lịch Lớp Học Phần Sắp Tới</h2>
                </div>
                <a href="/BuoiHoc/Index" class="text-xs text-primary hover:text-primary-hover font-semibold flex items-center gap-1 active:scale-[0.98]">
                    Xem tất cả lịch học <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
            </div>

            <div class="flex flex-col gap-3 flex-1">
                @if (Model.DanhSachBuoiHoc != null && Model.DanhSachBuoiHoc.Any())
                {
                    @foreach (var buoi in Model.DanhSachBuoiHoc)
                    {
                        var isSapDienRa = buoi.ThoiGianBatDau > DateTime.Now && buoi.ThoiGianBatDau <= DateTime.Now.AddDays(7);
                        <div class="border @(isSapDienRa ? "border-blue-200 bg-blue-50/30" : "border-border-standard bg-surface-white") rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-slate-50 transition-colors">
                            <div class="flex items-start gap-3 min-w-0">
                                <div class="px-2.5 py-1.5 rounded-lg @(isSapDienRa ? "bg-primary-light text-primary" : "bg-slate-100 text-slate-700") font-label-sm text-label-sm font-bold flex-shrink-0 whitespace-nowrap mt-0.5 text-center font-mono">
                                    @buoi.ThoiGianBatDau.ToString("HH:mm") - @buoi.ThoiGianKetThuc.ToString("HH:mm")<br>
                                    <span class="text-[10px] font-normal">@buoi.ThoiGianBatDau.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="flex flex-col gap-1 min-w-0">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <h3 class="font-headline-sm text-[15px] font-bold text-brand-deep truncate">
                                            @(buoi.LopHoc != null ? buoi.LopHoc.TenLop : "Buổi học mã #" + buoi.MaBuoiHoc)
                                        </h3>
                                        <span class="px-2 py-0.5 rounded-md bg-surface-white text-brand-deep font-label-sm text-label-sm border border-border-standard flex-shrink-0">
                                            Phòng @buoi.PhongHoc
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-4 text-outline font-body-sm text-body-sm flex-wrap">
                                        <span class="flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[15px]">person</span> GV: @buoi.GiangVien
                                        </span>
                                        @if (!string.IsNullOrEmpty(buoi.NoiDung))
                                        {
                                            <span class="flex items-center gap-1 truncate max-w-xs text-on-surface-variant">
                                                <span class="material-symbols-outlined text-[15px]">description</span> @buoi.NoiDung
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 sm:flex-col sm:items-end flex-shrink-0">
                                @if (buoi.TrangThai == "Đã lên lịch")
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 font-label-sm text-label-sm font-semibold">
                                        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>@buoi.TrangThai
                                    </span>
                                }
                                else if (buoi.TrangThai == "Đã hoàn thành")
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 font-label-sm text-label-sm font-semibold">
                                        <span class="h-2 w-2 rounded-full bg-slate-400"></span>@buoi.TrangThai
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-rose-50 text-rose-700 font-label-sm text-label-sm font-semibold">
                                        <span class="h-2 w-2 rounded-full bg-rose-500"></span>@buoi.TrangThai
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="py-8 text-center text-outline flex flex-col items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-4xl text-outline/50">calendar_month</span>
                        <p class="font-medium text-xs">Chưa có buổi học nào được lên lịch.</p>
                        <a href="/BuoiHoc/Index?create=true" class="text-xs text-primary font-semibold hover:underline">+ Tạo lịch buổi học mới</a>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Hoạt động đăng ký gần đây -->
        <div class="bg-surface-white rounded-2xl border border-border-standard shadow-sm p-6 flex flex-col gap-4 h-full card-pro">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-border-subtle">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">history</span>
                    <h2 class="font-headline-sm text-headline-sm text-brand-deep font-bold">Hoạt động đăng ký gần đây</h2>
                </div>
                <a href="/DangKyHoc/Index" class="text-xs text-primary hover:text-primary-hover font-semibold flex items-center gap-1 active:scale-[0.98]">
                    Xem tất cả đơn đăng ký <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
            </div>

            <!-- Table Container -->
            <div class="w-full overflow-x-auto flex-1">
                <table class="w-full text-left border-collapse min-w-[560px] h-full">
                    <thead>
                        <tr class="bg-surface-container-low/80 border-b border-border-standard font-label-sm text-[11px] text-outline font-bold tracking-wider uppercase">
                            <th class="py-3.5 px-3">Sinh viên</th>
                            <th class="py-3.5 px-3">Lớp học phần</th>
                            <th class="py-3.5 px-3">Thời gian</th>
                            <th class="py-3.5 px-3 text-center">Trạng thái</th>
                            <th class="py-3.5 px-3 text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-subtle text-xs text-brand-deep">
                        @if (Model.HoatDongGanDay != null && Model.HoatDongGanDay.Any())
                        {
                            @foreach (var item in Model.HoatDongGanDay.Take(5))
                            {
                                <tr class="hover:bg-slate-50/80 transition-colors">
                                    <td class="py-3.5 px-3">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-8 h-8 rounded-full bg-primary-light text-primary font-bold flex items-center justify-center font-label-md text-label-md flex-shrink-0">
                                                @(item.HocVien != null && !string.IsNullOrEmpty(item.HocVien.HoTen) ? item.HocVien.HoTen.Substring(0, 1) : "H")
                                            </div>
                                            <div class="flex flex-col min-w-0">
                                                <span class="font-headline-sm text-brand-deep font-semibold text-[13px] truncate">
                                                    @(item.HocVien != null ? item.HocVien.HoTen : "Học viên #" + item.MaHocVien)
                                                </span>
                                                <span class="font-mono text-outline text-[11px] tabular-nums">
                                                    MSSV: @(item.HocVien != null ? item.HocVien.MaHocVien.ToString() : "N/A")
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-3">
                                        <div class="flex flex-col min-w-0">
                                            <span class="font-semibold text-brand-deep text-[13px] truncate">
                                                @(item.LopHoc != null ? item.LopHoc.TenLop : "Lớp #" + item.MaLopHoc)
                                            </span>
                                            <span class="text-outline text-[11px] font-mono truncate">
                                                GV: @(item.LopHoc != null ? item.LopHoc.TenGiangVien : "Chưa xếp")
                                            </span>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-3 whitespace-nowrap">
                                        <span class="font-mono text-outline text-[11px] flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[13px]">schedule</span>
                                            @item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-3 text-center whitespace-nowrap">
                                        @if (item.TrangThai == "Chờ duyệt")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-700 font-label-sm text-[11px] font-semibold">
                                                <span class="h-1.5 w-1.5 rounded-full bg-amber-500 animate-pulse"></span>Chờ duyệt
                                            </span>
                                        }
                                        else if (item.TrangThai == "Đã duyệt" || item.TrangThai == "Đã đóng học phí" || item.TrangThai == "Đang học")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-label-sm text-[11px] font-semibold">
                                                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>@item.TrangThai
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-rose-50 text-rose-700 font-label-sm text-[11px] font-semibold">
                                                <span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>@item.TrangThai
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3.5 px-3 text-right whitespace-nowrap">
                                        <div class="inline-flex items-center gap-1">
                                            @if (item.TrangThai == "Chờ duyệt")
                                            {
                                                <form asp-controller="ThongKe" asp-action="DuyetNhanh" asp-route-id="@item.MaDangKy" method="post" class="inline" onsubmit="event.preventDefault(); submitDuyetNhanh(this);">
                                                    <button class="p-1 rounded-lg text-outline hover:text-emerald-600 hover:bg-emerald-50 transition-colors cursor-pointer active:scale-95" title="Duyệt nhanh" type="submit">
                                                        <span class="material-symbols-outlined text-[18px]">check_circle</span>
                                                    </button>
                                                </form>
                                            }
                                            <a href="/DangKyHoc/Index" class="p-1 rounded-lg text-outline hover:text-primary hover:bg-slate-100 transition-colors active:scale-95" title="Xem trong danh sách đăng ký">
                                                <span class="material-symbols-outlined text-[18px]">visibility</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="py-8 text-center text-outline">
                                    Không có dữ liệu hoạt động đăng ký.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@section Scripts {
<script>
    // Handle AJAX DuyetNhanh
    async function submitDuyetNhanh(form) {
        const btn = form.querySelector('button');
        if (btn) btn.disabled = true;

        try {
            const formData = new FormData(form);
            const res = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            const contentType = res.headers.get("content-type");
            if (contentType && contentType.indexOf("application/json") !== -1) {
                const data = await res.json();
                if (data.success) {
                    if (window.showToast) window.showToast(data.message, 'success');
                    setTimeout(() => window.location.reload(), 400);
                } else {
                    if (window.showToast) window.showToast(data.message, 'error');
                }
            } else {
                window.location.reload();
            }
        } catch (err) {
            console.error('Lỗi duyệt nhanh:', err);
            if (window.showToast) window.showToast('Có lỗi xảy ra khi phê duyệt.', 'error');
        } finally {
            if (btn) btn.disabled = false;
        }
    }
</script>
}
