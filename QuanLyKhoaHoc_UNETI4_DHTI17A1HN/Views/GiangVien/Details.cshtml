@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.GiangVien
@{
    ViewData["Title"] = "Chi Tiết Giảng Viên";
}

<!--
// ========================================================
// Họ và tên: Vũ Đình Trường - MSV: 23103100026
// Phụ trách: Module 1 - Chi tiết giảng viên
// ========================================================
-->

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
        <a asp-action="Edit" asp-route-id="@Model.MaGiangVien" class="btn btn-warning px-3 py-2 fw-semibold rounded-3">
            <i class="bi bi-pencil-square me-1"></i> Chỉnh Sửa
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-gradient bg-primary text-white py-4 px-4 border-0">
            <div class="d-flex justify-content-between align-items-center">
                <span class="badge bg-white text-primary px-3 py-2 fw-bold">MÃ: #@Model.MaGiangVien</span>
                @if (Model.TrangThai)
                {
                    <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle me-1"></i> Đang công tác</span>
                }
                else
                {
                    <span class="badge bg-secondary px-3 py-2"><i class="bi bi-pause-circle me-1"></i> Tạm ngưng</span>
                }
            </div>
            <h3 class="fw-bold mt-3 mb-1">@Model.HoTen</h3>
            <p class="text-white-50 small mb-0">Chuyên ngành: @(Model.ChuyenNganh ?? "Đào tạo chung") | Ngày tham gia: @Model.NgayTao.ToString("dd/MM/yyyy")</p>
        </div>

        <div class="card-body p-4 bg-white">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold">Email liên hệ</small>
                        <div class="fw-semibold text-dark mt-1"><i class="bi bi-envelope text-primary me-1"></i> @Model.Email</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold">Số điện thoại</small>
                        <div class="fw-semibold text-dark mt-1"><i class="bi bi-telephone text-primary me-1"></i> @(Model.SoDienThoai ?? "Chưa thiết lập")</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold">Số lớp phụ trách</small>
                        <div class="fw-semibold text-primary mt-1"><i class="bi bi-easel text-primary me-1"></i> @(Model.LopHocs?.Count ?? 0) lớp học</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách các lớp học do giảng viên phụ trách -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-0">
            <h5 class="fw-bold text-primary mb-0">
                <i class="bi bi-easel-fill me-2"></i>CÁC LỚP HỌC ĐANG PHỤ TRÁCH (@(Model.LopHocs?.Count ?? 0))
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Tên lớp</th>
                        <th>Chương trình đào tạo</th>
                        <th>Sĩ số</th>
                        <th>Ngày khai giảng</th>
                        <th class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.LopHocs != null && Model.LopHocs.Any())
                    {
                        foreach (var lop in Model.LopHocs)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@lop.TenLop</td>
                                <td>@(lop.ChuongTrinhDaoTao?.TenChuongTrinh ?? "Chương trình đào tạo")</td>
                                <td>@lop.SiSoToiDa học viên</td>
                                <td>@lop.NgayKhaiGiang.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">
                                        @lop.TrangThai
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                Giảng viên hiện chưa được phân công phụ trách lớp học nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
