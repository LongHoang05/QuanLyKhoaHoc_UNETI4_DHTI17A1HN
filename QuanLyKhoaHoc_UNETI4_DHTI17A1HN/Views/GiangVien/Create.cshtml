@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.GiangVien
@{
    ViewData["Title"] = "Thêm Mới Giảng Viên";
}

<!--
// ========================================================
// Họ và tên: Vũ Đình Trường - MSV: 23103100026
// Phụ trách: Module 1 - Thêm mới giảng viên
// ========================================================
-->

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold text-primary mb-0">
                    <i class="bi bi-person-plus-fill me-2"></i>THÊM MỚI GIẢNG VIÊN ĐÀO TẠO
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="HoTen" class="form-label fw-semibold small">Họ và tên <span class="text-danger">*</span></label>
                            <input asp-for="HoTen" class="form-control" placeholder="ThS. Nguyễn Văn A..." />
                            <span asp-validation-for="HoTen" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small">Email <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" placeholder="giangvien@uneti.edu.vn" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="SoDienThoai" class="form-label fw-semibold small">Số điện thoại</label>
                            <input asp-for="SoDienThoai" class="form-control" placeholder="09xxxxxxxx" />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ChuyenNganh" class="form-label fw-semibold small">Chuyên ngành giảng dạy</label>
                            <input asp-for="ChuyenNganh" class="form-control" placeholder="Công nghệ phần mềm, AI, Mạng..." />
                            <span asp-validation-for="ChuyenNganh" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch fs-6">
                            <input asp-for="TrangThai" class="form-check-input" type="checkbox" role="switch" checked />
                            <label asp-for="TrangThai" class="form-check-label fw-semibold small">Đang công tác giảng dạy</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            <i class="bi bi-check-circle-fill me-1"></i> Lưu Giảng Viên
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
