@model List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.GiangVien>
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Đội Ngũ Giảng Viên";
    var vaiTro = Context.Session.GetString("VaiTro");
    var isAdmin = vaiTro == "Admin";
    var isGiaoVu = vaiTro == "GiaoVu";

    var countActive = Model.Count(x => x.TrangThai);
    var countPaused = Model.Count(x => !x.TrangThai);
    var totalCount = (int)(ViewBag.TotalCount ?? Model.Count);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var pageIndex = (int)(ViewBag.PageIndex ?? 1);
    var keyword = ViewBag.Keyword as string;
    var trangThai = ViewBag.TrangThai as bool?;
}

<!--
// ========================================================
// Họ và tên: Vũ Đình Trường - MSV: 23103100026
// Phụ trách: Module 1 - Quản lý Dữ liệu dùng chung (Giảng viên)
// Giao diện chuẩn Prototype Giao_DIen_Test (Tone Xanh Da Trời & Trắng)
// ========================================================
-->

<!-- 1. Page Hero Banner -->
<div class="page-hero">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                <span class="hero-badge"><i class="bi bi-mortarboard-fill"></i> Module 1 - Phụ trách: Vũ Đình Trường</span>
                <span class="badge bg-white bg-opacity-25 text-white">MSV: 23103100026</span>
                <span class="badge bg-info bg-opacity-50 text-white">Dữ Liệu Dùng Chung (Mục 6 & 17.2)</span>
            </div>
            <h1 class="hero-title">Đội Ngũ Giảng Viên & Chuyên Gia</h1>
            <p class="hero-subtitle">Quản lý hồ sơ giảng viên cơ hữu, thỉnh giảng, chuyên ngành giảng dạy và phân công lớp học trực thuộc</p>
        </div>
        @if (isAdmin || isGiaoVu)
        {
            <div>
                <a asp-action="Create" class="btn btn-light rounded-pill px-3 py-2 fw-bold text-primary shadow-sm">
                    <i class="bi bi-person-plus-fill me-1"></i> Thêm Giảng Viên Mới
                </a>
            </div>
        }
    </div>
</div>

<!-- 2. Row Thống kê Mini Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Tổng Giảng Viên</div>
                <div class="mini-stat-num">@totalCount</div>
                <small class="text-muted" style="font-size: 0.72rem;">Đội ngũ chuyên môn</small>
            </div>
            <div class="mini-stat-icon" style="background: var(--surface-container); color: var(--primary-rose);">
                <i class="bi bi-person-video3"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Đang Giảng Dạy</div>
                <div class="mini-stat-num text-success">@countActive</div>
                <small class="text-success" style="font-size: 0.72rem;"><i class="bi bi-check-circle-fill me-1"></i>Sẵn sàng nhận lớp</small>
            </div>
            <div class="mini-stat-icon bg-success-subtle text-success">
                <i class="bi bi-check2-circle"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Tạm Nghỉ / Bảo Lưu</div>
                <div class="mini-stat-num text-muted">@countPaused</div>
                <small class="text-muted" style="font-size: 0.72rem;">Tạm ngưng công tác</small>
            </div>
            <div class="mini-stat-icon bg-secondary-subtle text-secondary">
                <i class="bi bi-pause-circle"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Lớp Phụ Trách</div>
                <div class="mini-stat-num text-primary">@Model.Sum(x => x.LopHocs?.Count ?? 0)</div>
                <small class="text-primary" style="font-size: 0.72rem;"><i class="bi bi-easel me-1"></i>Lớp học liên kết</small>
            </div>
            <div class="mini-stat-icon bg-primary-subtle text-primary">
                <i class="bi bi-easel2-fill"></i>
            </div>
        </div>
    </div>
</div>

<!-- 3. Khung Dữ liệu & Bảng Chuẩn Giao_DIen_Test -->
<div class="content-card mb-4">
    <!-- Toolbar Tìm kiếm & Lọc -->
    <div class="toolbar">
        <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2 w-100 justify-content-between">
            <div class="d-flex flex-wrap align-items-center gap-2 flex-grow-1">
                <!-- Hộp tìm kiếm -->
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" name="keyword" value="@keyword" placeholder="Tìm theo tên, email, sđt, chuyên ngành..." />
                </div>

                <!-- Lọc trạng thái -->
                <select name="trangThai" class="filter-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="true" selected="@(trangThai == true)">Đang công tác</option>
                    <option value="false" selected="@(trangThai == false)">Tạm ngưng</option>
                </select>

                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-semibold">
                    <i class="bi bi-funnel-fill me-1"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại
                </a>
            </div>
        </form>
    </div>

    <!-- Table View -->
    <div class="table-responsive">
        <table class="modern-table align-middle">
            <thead>
                <tr>
                    <th style="width: 50px;">#Mã</th>
                    <th>Giảng viên</th>
                    <th>Chuyên ngành</th>
                    <th>Email liên hệ</th>
                    <th>Số điện thoại</th>
                    <th class="text-center">Số lớp phụ trách</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end" style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted font-monospace fw-bold" style="font-size: 0.8rem;">#@item.MaGiangVien</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="program-avatar" style="background: var(--surface-container); color: var(--primary-rose);">
                                        <i class="bi bi-person-video3"></i>
                                    </div>
                                    <div>
                                        <div class="program-name">
                                            <a asp-action="Details" asp-route-id="@item.MaGiangVien" class="text-decoration-none text-dark hover-primary">
                                                @item.HoTen
                                            </a>
                                        </div>
                                        <div class="program-code">GV-@item.MaGiangVien.ToString("D3") • Tham gia @item.NgayTao.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-info-subtle text-info-emphasis border px-2 py-1 rounded-pill small">
                                    @(item.ChuyenNganh ?? "Chung")
                                </span>
                            </td>
                            <td>
                                <span class="text-muted small">
                                    <i class="bi bi-envelope text-primary me-1"></i>@item.Email
                                </span>
                            </td>
                            <td>
                                <span class="text-muted small">
                                    <i class="bi bi-telephone text-primary me-1"></i>@(item.SoDienThoai ?? "Chưa có")
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.LopHocs != null && item.LopHocs.Any())
                                {
                                    <span class="class-pill">
                                        <i class="bi bi-easel"></i> @item.LopHocs.Count lớp
                                    </span>
                                }
                                else
                                {
                                    <span class="class-pill empty">
                                        <i class="bi bi-dash"></i> 0 lớp
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.TrangThai)
                                {
                                    <span class="status-pill active">
                                        <span class="status-dot"></span> Đang công tác
                                    </span>
                                }
                                else
                                {
                                    <span class="status-pill paused">
                                        <span class="status-dot"></span> Tạm ngưng
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.MaGiangVien" class="btn-action-icon" title="Chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (isAdmin || isGiaoVu)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.MaGiangVien" class="btn-action-icon" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (isAdmin)
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.MaGiangVien" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa giảng viên @item.HoTen?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-action-icon delete" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5">
                            <div class="text-muted mb-3">
                                <i class="bi bi-person-x fs-1 d-block text-secondary opacity-50 mb-2"></i>
                                Không tìm thấy giảng viên nào phù hợp với bộ lọc.
                            </div>
                            <a asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa bộ lọc
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (totalPages > 1)
    {
        <div class="p-3 border-top d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div class="small text-muted">
                Hiển thị trang <strong>@pageIndex</strong> / <strong>@totalPages</strong> (Tổng cộng <strong>@totalCount</strong> giảng viên)
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(pageIndex <= 1 ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3 me-1" asp-action="Index"
                           asp-route-page="1"
                           asp-route-keyword="@keyword"
                           asp-route-trangThai="@trangThai">
                            <i class="bi bi-chevron-double-left"></i>
                        </a>
                    </li>
                    <li class="page-item @(pageIndex <= 1 ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3 me-1" asp-action="Index"
                           asp-route-page="@(pageIndex - 1)"
                           asp-route-keyword="@keyword"
                           asp-route-trangThai="@trangThai">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == pageIndex ? "active" : "")">
                            <a class="page-link rounded-pill px-3 me-1" asp-action="Index"
                               asp-route-page="@p"
                               asp-route-keyword="@keyword"
                               asp-route-trangThai="@trangThai">@p</a>
                        </li>
                    }

                    <li class="page-item @(pageIndex >= totalPages ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3 me-1" asp-action="Index"
                           asp-route-page="@(pageIndex + 1)"
                           asp-route-keyword="@keyword"
                           asp-route-trangThai="@trangThai">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                    <li class="page-item @(pageIndex >= totalPages ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3" asp-action="Index"
                           asp-route-page="@totalPages"
                           asp-route-keyword="@keyword"
                           asp-route-trangThai="@trangThai">
                            <i class="bi bi-chevron-double-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
