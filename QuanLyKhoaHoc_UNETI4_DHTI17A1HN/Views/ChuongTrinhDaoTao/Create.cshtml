@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.ChuongTrinhDaoTao
@{
    ViewData["Title"] = "Thêm Mới Chương Trình Đào Tạo";
}

<!--
// ========================================================
// Họ và tên: Vũ Đình Trường - MSV: 23103100026
// Phụ trách: Module 1 - Thêm mới chương trình đào tạo
// ========================================================
-->

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold text-primary mb-0">
                    <i class="bi bi-plus-circle-fill me-2"></i>THÊM MỚI CHƯƠNG TRÌNH ĐÀO TẠO
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

                    <!-- Tên chương trình -->
                    <div class="mb-3">
                        <label asp-for="TenChuongTrinh" class="form-label fw-semibold small">
                            Tên chương trình đào tạo <span class="text-danger">*</span>
                        </label>
                        <input asp-for="TenChuongTrinh" class="form-control" placeholder="Ví dụ: Lập trình Web & Phần mềm, Trí tuệ nhân tạo..." />
                        <span asp-validation-for="TenChuongTrinh" class="text-danger small"></span>
                    </div>

                    <!-- Email liên hệ -->
                    <div class="mb-3">
                        <label asp-for="EmailLienHe" class="form-label fw-semibold small">
                            Email liên hệ chương trình
                        </label>
                        <input asp-for="EmailLienHe" class="form-control" placeholder="cntt@uneti.edu.vn" />
                        <span asp-validation-for="EmailLienHe" class="text-danger small"></span>
                    </div>

                    <!-- Mô tả dùng textarea theo yêu cầu mục 5.5 -->
                    <div class="mb-3">
                        <label asp-for="MoTa" class="form-label fw-semibold small">Mô tả tổng quan</label>
                        <textarea asp-for="MoTa" class="form-control" rows="4" placeholder="Mô tả mục tiêu, định hướng và phạm vi kiến thức của chương trình đào tạo..."></textarea>
                        <span asp-validation-for="MoTa" class="text-danger small"></span>
                    </div>

                    <!-- Trạng thái -->
                    <div class="mb-4">
                        <div class="form-check form-switch fs-6">
                            <input asp-for="TrangThai" class="form-check-input" type="checkbox" role="switch" checked />
                            <label asp-for="TrangThai" class="form-check-label fw-semibold small">Kích hoạt chương trình đào tạo ngay</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            <i class="bi bi-check-circle-fill me-1"></i> Lưu Chương Trình
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
