@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.ChuongTrinhDaoTao
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = $"Chi tiết chương trình: {Model.TenChuongTrinh}";
    var vaiTro = Context.Session.GetString("VaiTro");
    var isAdmin = vaiTro == "Admin";
    int soLop = Model.LopHocs?.Count ?? 0;
}

<div class="flex flex-col gap-y-6">
    <!-- Sub-header Navigation Bar -->
    <section class="bg-surface-white rounded-2xl border border-border-standard shadow-sm p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4 card-pro">
        <div>
            <div class="flex items-center gap-2 text-outline font-label-sm text-label-sm uppercase tracking-wider mb-1">
                <span>ĐÀO TẠO UNETI</span>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <a asp-action="Index" class="hover:text-primary transition-colors">CHƯƠNG TRÌNH ĐÀO TẠO</a>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-primary font-semibold">CHI TIẾT CHƯƠNG TRÌNH</span>
            </div>
            <div class="flex items-center gap-3">
                <h1 class="font-headline-md text-headline-md text-brand-deep font-bold tracking-tight">
                    @Model.TenChuongTrinh
                </h1>
                <span class="font-mono text-xs px-2.5 py-1 rounded-md bg-surface-container-high text-brand-deep font-semibold border border-border-standard">
                    #CT@(Model.MaChuongTrinh.ToString("D3"))
                </span>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <a asp-action="Index" class="inline-flex items-center gap-1.5 bg-surface-white border border-border-standard hover:bg-surface-container-low text-brand-deep font-label-md text-label-md px-3.5 py-2.5 rounded-xl transition-all shadow-xs cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                <span>Quay lại</span>
            </a>
            <a asp-controller="LopHoc" asp-action="Index" asp-route-maCT="@Model.MaChuongTrinh" class="inline-flex items-center gap-1.5 bg-primary hover:bg-primary-hover text-surface-white font-label-md text-label-md px-4 py-2.5 rounded-xl shadow-sm hover:shadow-md transition-all cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">meeting_room</span>
                <span>Xem danh sách lớp</span>
            </a>
        </div>
    </section>

    <!-- Program Metadata Bento Card -->
    <div class="bg-surface-white rounded-2xl border border-border-standard p-6 shadow-sm card-pro">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Info: Description & Details -->
            <div class="lg:col-span-2 space-y-4">
                <div class="flex flex-wrap items-center gap-2">
                    @if (Model.TrangThai)
                    {
                        <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-success-emerald bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full font-semibold">
                            <span class="w-1.5 h-1.5 rounded-full bg-success-emerald animate-pulse"></span>Đang hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-outline bg-gray-100 border border-gray-200 px-3 py-1 rounded-full font-semibold">
                            <span class="w-1.5 h-1.5 rounded-full bg-outline"></span>Tạm ngưng
                        </span>
                    }
                    <span class="text-xs text-outline font-mono">
                        Ngày tạo: @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <div>
                    <h3 class="text-xs font-bold text-outline uppercase tracking-wider mb-2">Mô tả chương trình</h3>
                    <div class="bg-surface-container-low border border-border-standard rounded-xl p-4 text-xs text-brand-deep leading-relaxed whitespace-pre-line">
                        @(string.IsNullOrEmpty(Model.MoTa) ? "Chưa có nội dung mô tả cho chương trình đào tạo này." : Model.MoTa)
                    </div>
                </div>
            </div>

            <!-- Right Info: Quick stats & Contact -->
            <div class="bg-surface-container-low/60 border border-border-standard rounded-xl p-5 flex flex-col justify-between gap-4">
                <div>
                    <h3 class="text-xs font-bold text-outline uppercase tracking-wider mb-3">Thông tin liên hệ & Quy mô</h3>
                    <div class="space-y-3 text-xs">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-[18px]">mail</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-[11px] text-outline">Email liên hệ</p>
                                <p class="font-semibold text-brand-deep truncate">@(Model.EmailLienHe ?? "Chưa thiết lập")</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-[18px]">meeting_room</span>
                            </div>
                            <div>
                                <p class="text-[11px] text-outline">Số lớp học mở</p>
                                <p class="font-bold text-brand-deep font-mono">@soLop lớp học</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pt-3 border-t border-border-standard/80 text-[11px] text-outline flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px] text-primary">verified</span>
                    <span>Chương trình đào tạo chuẩn UNETI</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách các lớp học trực thuộc chương trình -->
    <div class="bg-surface-white rounded-2xl border border-border-standard shadow-sm overflow-hidden card-pro">
        <div class="p-5 border-b border-border-standard flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[20px]">layers</span>
                <h2 class="font-headline-sm text-headline-sm text-brand-deep font-bold">
                    Danh sách Lớp học trực thuộc (@soLop)
                </h2>
            </div>
            <a asp-controller="LopHoc" asp-action="Index" class="text-xs text-primary hover:underline font-semibold flex items-center gap-1">
                <span>Quản lý toàn bộ lớp học</span>
                <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low/80 border-b border-border-standard font-label-sm text-[11px] text-outline font-bold tracking-wider uppercase">
                        <th class="py-3.5 px-4 w-12 text-center">#</th>
                        <th class="py-3.5 px-4">Mã lớp</th>
                        <th class="py-3.5 px-4 min-w-[200px]">Tên lớp học</th>
                        <th class="py-3.5 px-4">Giảng viên</th>
                        <th class="py-3.5 px-4 text-center">Sĩ số tối đa</th>
                        <th class="py-3.5 px-4">Học phí</th>
                        <th class="py-3.5 px-4">Khai giảng</th>
                        <th class="py-3.5 px-4 text-center">Trạng thái</th>
                        <th class="py-3.5 px-4 text-right">Chi tiết</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle text-xs text-brand-deep">
                    @if (Model.LopHocs != null && Model.LopHocs.Any())
                    {
                        int idx = 1;
                        foreach (var lop in Model.LopHocs)
                        {
                            <tr class="hover:bg-surface-container-low/50 transition-colors">
                                <td class="py-3.5 px-4 text-center text-outline font-mono text-[11px]">@(idx++)</td>
                                <td class="py-3.5 px-4 font-mono font-semibold text-brand-deep">
                                    #LH@(lop.MaLopHoc.ToString("D3"))
                                </td>
                                <td class="py-3.5 px-4 font-bold text-brand-deep">
                                    @lop.TenLop
                                </td>
                                <td class="py-3.5 px-4 text-outline">
                                    @(lop.TenGiangVien ?? "Chưa phân công")
                                </td>
                                <td class="py-3.5 px-4 text-center font-mono">
                                    @lop.SiSoToiDa HV
                                </td>
                                <td class="py-3.5 px-4 font-mono font-bold text-brand-deep">
                                    @lop.HocPhi.ToString("N0") đ
                                </td>
                                <td class="py-3.5 px-4 font-mono text-outline">
                                    @lop.NgayKhaiGiang.ToString("dd/MM/yyyy")
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded-full font-semibold">
                                        @lop.TrangThai
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <a href="/LopHoc/Details/@lop.MaLopHoc" class="p-1.5 rounded-lg text-outline hover:text-primary hover:bg-surface-container-low transition-colors inline-flex items-center" title="Xem chi tiết lớp">
                                        <span class="material-symbols-outlined text-[18px]">visibility</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="py-12 text-center text-outline">
                                <span class="material-symbols-outlined text-4xl block mb-2 text-outline/50">meeting_room</span>
                                Chưa có lớp học nào được tạo trong chương trình đào tạo này.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
