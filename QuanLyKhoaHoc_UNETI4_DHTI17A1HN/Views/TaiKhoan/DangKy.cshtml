@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.ViewModels.DangKyViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký tài khoản - UNETI ĐÀO TẠO";
}

<!--
// ========================================================
// Họ và tên: Vũ Đình Trường
// Mã sinh viên: 23103100026
// Phụ trách: Module 1 - Tài khoản, Đăng nhập, Phân quyền và Chương trình đào tạo
// ========================================================
-->
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "brand-deep": "#0D47A1",
                        "primary": "#2196F3",
                        "primary-dark": "#1976D2",
                        "primary-container": "#1E88E5",
                        "primary-light": "#90CAF9",
                        "surface-container-low": "#E3F2FD",
                        "canvas-base": "#F8FAFC",
                        "surface-white": "#FFFFFF",
                        "border-standard": "#E2E8F0",
                        "border-subtle": "#E3F2FD",
                        "outline": "#64748B",
                        "danger-crimson": "#EF4444"
                    },
                    fontFamily: {
                        sans: ["'Be Vietnam Pro'", "sans-serif"]
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-gradient-to-br from-[#0D47A1] via-[#1565C0] to-[#2196F3] min-h-screen flex items-center justify-center p-4 py-8 font-sans antialiased">
    <div class="w-full max-w-lg">
        <!-- Main Register Card -->
        <div class="bg-surface-white rounded-3xl shadow-2xl p-8 border border-white/20 backdrop-blur-sm">
            <!-- Brand Logo & Header -->
            <div class="flex flex-col items-center text-center mb-6">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-primary to-primary-container text-surface-white flex items-center justify-center shadow-lg shadow-primary/30 mb-3.5">
                    <span class="material-symbols-outlined text-[32px]">school</span>
                </div>
                <h1 class="text-2xl font-black text-brand-deep tracking-tight">UNETI ĐÀO TẠO</h1>
                <p class="text-xs text-outline mt-1">Đăng ký tài khoản học viên mới để bắt đầu học tập</p>
                <span class="mt-1 px-2.5 py-0.5 rounded-full bg-primary/10 text-primary font-semibold text-[11px]">Module 1 • Vũ Đình Trường (23103100026)</span>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="mb-4 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-center gap-2">
                    <span class="material-symbols-outlined text-rose-600 text-base">error</span>
                    <span>@TempData["Error"]</span>
                </div>
            }

            <!-- Form -->
            <form asp-action="DangKy" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs"></div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1.5">Tên đăng nhập <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">person</span>
                            <input asp-for="TenDangNhap" required autofocus
                                   class="w-full pl-10 pr-3.5 py-2.5 bg-slate-50 border border-border-standard rounded-xl text-xs font-medium text-brand-deep placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                                   placeholder="vd: nguyenvana" />
                        </div>
                        <span asp-validation-for="TenDangNhap" class="text-[11px] text-rose-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1.5">Họ và tên <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">badge</span>
                            <input asp-for="HoTen" required
                                   class="w-full pl-10 pr-3.5 py-2.5 bg-slate-50 border border-border-standard rounded-xl text-xs font-medium text-brand-deep placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                                   placeholder="vd: Nguyễn Văn A" />
                        </div>
                        <span asp-validation-for="HoTen" class="text-[11px] text-rose-600 mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1.5">Email liên hệ <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">mail</span>
                            <input asp-for="Email" type="email" required
                                   class="w-full pl-10 pr-3.5 py-2.5 bg-slate-50 border border-border-standard rounded-xl text-xs font-medium text-brand-deep placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                                   placeholder="sinhvien@uneti.edu.vn" />
                        </div>
                        <span asp-validation-for="Email" class="text-[11px] text-rose-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1.5">Số điện thoại</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">phone</span>
                            <input asp-for="SoDienThoai"
                                   class="w-full pl-10 pr-3.5 py-2.5 bg-slate-50 border border-border-standard rounded-xl text-xs font-medium text-brand-deep placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                                   placeholder="0987654321" />
                        </div>
                        <span asp-validation-for="SoDienThoai" class="text-[11px] text-rose-600 mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1.5">Mật khẩu <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">lock</span>
                            <input asp-for="MatKhau" type="password" id="inputPass" required
                                   class="w-full pl-10 pr-10 py-2.5 bg-slate-50 border border-border-standard rounded-xl text-xs font-medium text-brand-deep placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                                   placeholder="Tối thiểu 6 ký tự" />
                            <button type="button" onclick="togglePass('inputPass', 'iconPass')" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-outline hover:text-brand-deep">
                                <span id="iconPass" class="material-symbols-outlined text-[18px]">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="MatKhau" class="text-[11px] text-rose-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1.5">Xác nhận mật khẩu <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">lock_reset</span>
                            <input asp-for="XacNhanMatKhau" type="password" id="inputConfirmPass" required
                                   class="w-full pl-10 pr-10 py-2.5 bg-slate-50 border border-border-standard rounded-xl text-xs font-medium text-brand-deep placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                                   placeholder="Nhập lại mật khẩu" />
                            <button type="button" onclick="togglePass('inputConfirmPass', 'iconConfirmPass')" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-outline hover:text-brand-deep">
                                <span id="iconConfirmPass" class="material-symbols-outlined text-[18px]">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="XacNhanMatKhau" class="text-[11px] text-rose-600 mt-1 block"></span>
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit"
                            class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-primary to-primary-container hover:from-primary-dark hover:to-primary text-surface-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-primary/30 transition-all flex items-center justify-center gap-2 cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">person_add</span>
                        <span>Đăng Ký Tài Khoản</span>
                    </button>
                </div>
            </form>

            <!-- Bottom redirect to login -->
            <div class="mt-6 pt-5 border-t border-border-standard flex items-center justify-between text-xs">
                <span class="text-outline">Đã có tài khoản?</span>
                <a href="/TaiKhoan/DangNhap" class="font-bold text-primary hover:text-primary-dark flex items-center gap-1 transition-colors">
                    <span>Đăng nhập ngay</span>
                    <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
            </div>

            <div class="mt-4 text-center">
                <a href="/" class="inline-flex items-center gap-1 text-[11px] text-outline hover:text-brand-deep transition-colors">
                    <span class="material-symbols-outlined text-[14px]">home</span>
                    <span>Về trang chủ</span>
                </a>
            </div>
        </div>
    </div>

    <script>
        function togglePass(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }
    </script>
</body>
</html>
