@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.ViewModels.DangNhapViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập - UNETI ĐÀO TẠO";
}

<!--
// ========================================================
// Họ và tên: Vũ Đình Trường
// Mã sinh viên: 23103100026
// Phụ trách: Module 1 - Tài khoản, Đăng nhập, Phân quyền và Chương trình đào tạo
// ========================================================
-->
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "brand-deep": "#0D47A1",
                        "primary": "#2196F3",
                        "primary-dark": "#1976D2",
                        "primary-container": "#1E88E5",
                        "primary-light": "#90CAF9",
                        "surface-container-low": "#E3F2FD",
                        "canvas-base": "#F8FAFC",
                        "surface-white": "#FFFFFF",
                        "border-standard": "#E2E8F0",
                        "border-subtle": "#E3F2FD",
                        "outline": "#64748B",
                        "danger-crimson": "#EF4444"
                    },
                    fontFamily: {
                        sans: ["'Be Vietnam Pro'", "sans-serif"]
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-gradient-to-br from-[#0D47A1] via-[#1565C0] to-[#2196F3] min-h-screen flex items-center justify-center p-4 font-sans antialiased">
    <div class="w-full max-w-md">
        <!-- Main Login Card -->
        <div class="bg-surface-white rounded-3xl shadow-2xl p-8 border border-white/20 backdrop-blur-sm">
            <!-- Brand Logo & Header -->
            <div class="flex flex-col items-center text-center mb-6">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-primary to-primary-container text-surface-white flex items-center justify-center shadow-lg shadow-primary/30 mb-3.5">
                    <span class="material-symbols-outlined text-[32px]">school</span>
                </div>
                <h1 class="text-2xl font-black text-brand-deep tracking-tight">UNETI ĐÀO TẠO</h1>
                <p class="text-xs text-outline mt-1">Cổng Quản lý Đăng ký Khóa học & Đào tạo</p>
                <span class="mt-1 px-2.5 py-0.5 rounded-full bg-primary/10 text-primary font-semibold text-[11px]">Module 1 • Vũ Đình Trường (23103100026)</span>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="mb-4 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center gap-2">
                    <span class="material-symbols-outlined text-emerald-600 text-base">check_circle</span>
                    <span>@TempData["Success"]</span>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="mb-4 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-center gap-2">
                    <span class="material-symbols-outlined text-rose-600 text-base">error</span>
                    <span>@TempData["Error"]</span>
                </div>
            }

            <!-- Form -->
            <form asp-action="DangNhap" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs"></div>

                <div>
                    <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1.5">Tên đăng nhập</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">person</span>
                        <input asp-for="TenDangNhap" id="loginUsername" required autofocus
                               class="w-full pl-10 pr-3.5 py-2.5 rounded-xl bg-canvas-base border border-border-standard text-brand-deep placeholder:text-outline text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-mono"
                               placeholder="Nhập tên đăng nhập..." />
                    </div>
                    <span asp-validation-for="TenDangNhap" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1.5">Mật khẩu</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">lock</span>
                        <input asp-for="MatKhau" type="password" id="loginPassword" required
                               class="w-full pl-10 pr-10 py-2.5 rounded-xl bg-canvas-base border border-border-standard text-brand-deep placeholder:text-outline text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                               placeholder="Nhập mật khẩu..." />
                        <button type="button" onclick="togglePasswordVisibility()" class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-brand-deep">
                            <span class="material-symbols-outlined text-[18px]" id="eyeIcon">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="MatKhau" class="text-rose-600 text-[11px] mt-1 block"></span>
                </div>

                <div class="flex items-center justify-between text-xs pt-1">
                    <label class="flex items-center gap-2 cursor-pointer text-outline hover:text-brand-deep">
                        <input asp-for="GhiNho" type="checkbox" class="rounded border-border-standard text-primary focus:ring-primary" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                    <a asp-action="DangKy" class="text-primary hover:underline font-semibold">Đăng ký học viên</a>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full bg-primary hover:bg-primary-dark text-surface-white font-bold text-sm py-3 rounded-xl shadow-md shadow-primary/25 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-98">
                        <span>Đăng nhập hệ thống</span>
                        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </button>
                </div>
            </form>

            <!-- Quick Login Shortcuts for Review & Testing -->
            <div class="mt-6 pt-5 border-t border-border-subtle">
                <span class="block text-[11px] font-bold text-outline uppercase tracking-wider text-center mb-3">Đăng nhập nhanh theo vai trò (Kiểm thử)</span>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                    <button type="button" onclick="quickFill('admin', 'admin123')" class="px-2 py-2 rounded-xl border border-border-standard hover:border-primary hover:bg-surface-container-low text-center text-xs font-semibold text-brand-deep transition-all flex flex-col items-center gap-1 group cursor-pointer">
                        <span class="material-symbols-outlined text-primary text-[20px] group-hover:scale-110 transition-transform">admin_panel_settings</span>
                        <span>Admin</span>
                    </button>
                    <button type="button" onclick="quickFill('giaovu', 'giaovu123')" class="px-2 py-2 rounded-xl border border-border-standard hover:border-primary hover:bg-surface-container-low text-center text-xs font-semibold text-brand-deep transition-all flex flex-col items-center gap-1 group cursor-pointer">
                        <span class="material-symbols-outlined text-primary text-[20px] group-hover:scale-110 transition-transform">badge</span>
                        <span>Giáo vụ</span>
                    </button>
                    <button type="button" onclick="quickFill('giangvien', '123456')" class="px-2 py-2 rounded-xl border border-border-standard hover:border-primary hover:bg-surface-container-low text-center text-xs font-semibold text-brand-deep transition-all flex flex-col items-center gap-1 group cursor-pointer">
                        <span class="material-symbols-outlined text-primary text-[20px] group-hover:scale-110 transition-transform">co_present</span>
                        <span>Giảng viên</span>
                    </button>
                    <button type="button" onclick="quickFill('hocvien', 'hocvien123')" class="px-2 py-2 rounded-xl border border-border-standard hover:border-primary hover:bg-surface-container-low text-center text-xs font-semibold text-brand-deep transition-all flex flex-col items-center gap-1 group cursor-pointer">
                        <span class="material-symbols-outlined text-primary text-[20px] group-hover:scale-110 transition-transform">school</span>
                        <span>Học viên</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Footer Info -->
        <p class="text-center text-white/70 text-xs mt-6 font-medium leading-relaxed">
            TRƯỜNG ĐẠI HỌC KINH TẾ - KỸ THUẬT CÔNG NGHIỆP (UNETI)<br/>
            Bài tập lớn Thực hành Lập trình .NET 10 • Nhóm 4 - DHTI17A1HN
        </p>
    </div>

    <script>
        function quickFill(user, pass) {
            document.getElementById('loginUsername').value = user;
            document.getElementById('loginPassword').value = pass;
        }

        function togglePasswordVisibility() {
            const pwd = document.getElementById('loginPassword');
            const icon = document.getElementById('eyeIcon');
            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                pwd.type = 'password';
                icon.textContent = 'visibility';
            }
        }
    </script>
</body>
</html>
