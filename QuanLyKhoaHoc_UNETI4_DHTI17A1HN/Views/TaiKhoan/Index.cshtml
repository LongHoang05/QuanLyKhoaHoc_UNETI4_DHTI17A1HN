@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.ViewModels.TaiKhoanListViewModel
@{
    ViewData["Title"] = "Quản Lý Tài Khoản";

    var countAdmin = Model.Items.Count(x => x.VaiTro == "Admin");
    var countGiaoVu = Model.Items.Count(x => x.VaiTro == "GiaoVu");
    var countHocVien = Model.Items.Count(x => x.VaiTro == "HocVien");
}

<!--
// ========================================================
// Họ và tên: Vũ Đình Trường - MSV: 23103100026
// Phụ trách: Module 1 - Quản lý tài khoản (Admin)
// Giao diện chuẩn Prototype Giao_DIen_Test (Tone Xanh Da Trời & Trắng)
// ========================================================
-->

<!-- 1. Page Hero Banner -->
<div class="page-hero">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                <span class="hero-badge"><i class="bi bi-shield-lock-fill"></i> Module 1 - Phụ trách: Vũ Đình Trường</span>
                <span class="badge bg-white bg-opacity-25 text-white">MSV: 23103100026</span>
                <span class="badge bg-danger bg-opacity-75 text-white">Quản Trị Hệ Thống</span>
            </div>
            <h1 class="hero-title">Quản Lý Tài Khoản & Phân Quyền</h1>
            <p class="hero-subtitle">Kiểm soát người dùng toàn hệ thống, cấp quyền vai trò (Admin / Giáo vụ / Học viên), khóa & đặt lại mật khẩu</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-light rounded-pill px-3 py-2 fw-bold text-primary shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Thêm Tài Khoản Mới
            </a>
        </div>
    </div>
</div>

<!-- 2. Row Thống kê Mini Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Tổng Tài Khoản</div>
                <div class="mini-stat-num">@Model.TotalCount</div>
                <small class="text-muted" style="font-size: 0.72rem;">Người dùng hệ thống</small>
            </div>
            <div class="mini-stat-icon" style="background: var(--surface-container); color: var(--primary-rose);">
                <i class="bi bi-people-fill"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Quản Trị Viên (Admin)</div>
                <div class="mini-stat-num text-danger">@countAdmin</div>
                <small class="text-danger" style="font-size: 0.72rem;"><i class="bi bi-shield-fill me-1"></i>Toàn quyền hệ thống</small>
            </div>
            <div class="mini-stat-icon bg-danger-subtle text-danger">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Giáo Vụ Trung Tâm</div>
                <div class="mini-stat-num text-info">@countGiaoVu</div>
                <small class="text-info" style="font-size: 0.72rem;"><i class="bi bi-briefcase-fill me-1"></i>Quản lý đào tạo</small>
            </div>
            <div class="mini-stat-icon bg-info-subtle text-info">
                <i class="bi bi-person-workspace"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Học Viên</div>
                <div class="mini-stat-num text-success">@countHocVien</div>
                <small class="text-success" style="font-size: 0.72rem;"><i class="bi bi-mortarboard-fill me-1"></i>Cổng học tập</small>
            </div>
            <div class="mini-stat-icon bg-success-subtle text-success">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
        </div>
    </div>
</div>

<!-- 3. Khung Dữ liệu & Bảng Chuẩn Giao_DIen_Test -->
<div class="content-card mb-4">
    <!-- Toolbar Tìm kiếm & Lọc -->
    <div class="toolbar">
        <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2 w-100 justify-content-between">
            <div class="d-flex flex-wrap align-items-center gap-2 flex-grow-1">
                <!-- Hộp tìm kiếm -->
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" name="keyword" value="@Model.Keyword" placeholder="Tìm theo tên đăng nhập, họ tên, email..." />
                </div>

                <!-- Lọc vai trò -->
                <select name="vaiTro" class="filter-select">
                    <option value="">-- Tất cả vai trò --</option>
                    <option value="Admin" selected="@(Model.VaiTro == "Admin")">Quản trị viên (Admin)</option>
                    <option value="GiaoVu" selected="@(Model.VaiTro == "GiaoVu")">Giáo vụ (GiaoVu)</option>
                    <option value="HocVien" selected="@(Model.VaiTro == "HocVien")">Học viên (HocVien)</option>
                </select>

                <!-- Lọc trạng thái -->
                <select name="trangThai" class="filter-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="true" selected="@(Model.TrangThai == true)">Hoạt động</option>
                    <option value="false" selected="@(Model.TrangThai == false)">Đã khóa</option>
                </select>

                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-semibold">
                    <i class="bi bi-funnel-fill me-1"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại
                </a>
            </div>
        </form>
    </div>

    <!-- Table View -->
    <div class="table-responsive">
        <table class="modern-table align-middle">
            <thead>
                <tr>
                    <th style="width: 50px;">#Mã</th>
                    <th>Người dùng / Tài khoản</th>
                    <th>Email liên hệ</th>
                    <th class="text-center">Vai trò</th>
                    <th class="text-center">Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th class="text-end" style="width: 180px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-muted font-monospace fw-bold" style="font-size: 0.8rem;">#@item.MaTaiKhoan</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="program-avatar" style="background: var(--surface-container); color: var(--primary-rose);">
                                        @if (item.VaiTro == "Admin")
                                        {
                                            <i class="bi bi-shield-fill text-danger"></i>
                                        }
                                        else if (item.VaiTro == "GiaoVu")
                                        {
                                            <i class="bi bi-briefcase-fill text-primary"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-fill text-success"></i>
                                        }
                                    </div>
                                    <div>
                                        <div class="program-name">
                                            <a asp-action="Edit" asp-route-id="@item.MaTaiKhoan" class="text-decoration-none text-dark hover-primary">
                                                @item.HoTen
                                            </a>
                                        </div>
                                        <div class="program-code">@@@item.TenDangNhap</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-muted small">
                                    <i class="bi bi-envelope text-primary me-1"></i>@item.Email
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.VaiTro == "Admin")
                                {
                                    <span class="badge bg-danger-subtle text-danger border px-2 py-1 rounded-pill">Quản trị viên</span>
                                }
                                else if (item.VaiTro == "GiaoVu")
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis border px-2 py-1 rounded-pill">Giáo vụ</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border px-2 py-1 rounded-pill">Học viên</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.TrangThai)
                                {
                                    <span class="status-pill active">
                                        <span class="status-dot"></span> Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="status-pill paused">
                                        <span class="status-dot"></span> Đã khóa
                                    </span>
                                }
                            </td>
                            <td class="text-muted small">
                                @item.NgayTao.ToString("dd/MM/yyyy")
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.MaTaiKhoan" class="btn-action-icon" title="Chỉnh sửa thông tin">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <!-- Nút Khóa / Mở khóa -->
                                    <form asp-action="ToggleKhoa" asp-route-id="@item.MaTaiKhoan" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        @if (item.TrangThai)
                                        {
                                            <button type="submit" class="btn-action-icon text-warning" title="Khóa tài khoản" onclick="return confirm('Bạn có chắc muốn KHÓA tài khoản @item.TenDangNhap?');">
                                                <i class="bi bi-lock-fill"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn-action-icon text-success" title="Mở khóa tài khoản" onclick="return confirm('Bạn có chắc muốn MỞ KHÓA tài khoản @item.TenDangNhap?');">
                                                <i class="bi bi-unlock-fill"></i>
                                            </button>
                                        }
                                    </form>

                                    <!-- Nút Reset Mật khẩu về 123456 -->
                                    <form asp-action="ResetMatKhau" asp-route-id="@item.MaTaiKhoan" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-action-icon text-danger" title="Đặt lại mật khẩu về 123456" onclick="return confirm('Bạn có chắc muốn ĐẶT LẠI mật khẩu của tài khoản @item.TenDangNhap về mặc định (123456)?');">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="text-muted mb-3">
                                <i class="bi bi-person-x fs-1 d-block text-secondary opacity-50 mb-2"></i>
                                Không tìm thấy tài khoản nào phù hợp với điều kiện tìm kiếm.
                            </div>
                            <a asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa bộ lọc
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div class="small text-muted">
                Hiển thị trang <strong>@Model.PageNumber</strong> / <strong>@Model.TotalPages</strong> (Tổng cộng <strong>@Model.TotalCount</strong> tài khoản)
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3 me-1" asp-action="Index"
                           asp-route-page="1"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-vaiTro="@Model.VaiTro"
                           asp-route-trangThai="@Model.TrangThai">
                            <i class="bi bi-chevron-double-left"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3 me-1" asp-action="Index"
                           asp-route-page="@(Model.PageNumber - 1)"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-vaiTro="@Model.VaiTro"
                           asp-route-trangThai="@Model.TrangThai">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                            <a class="page-link rounded-pill px-3 me-1" asp-action="Index"
                               asp-route-page="@p"
                               asp-route-keyword="@Model.Keyword"
                               asp-route-vaiTro="@Model.VaiTro"
                               asp-route-trangThai="@Model.TrangThai">@p</a>
                        </li>
                    }

                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3 me-1" asp-action="Index"
                           asp-route-page="@(Model.PageNumber + 1)"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-vaiTro="@Model.VaiTro"
                           asp-route-trangThai="@Model.TrangThai">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3" asp-action="Index"
                           asp-route-page="@Model.TotalPages"
                           asp-route-keyword="@Model.Keyword"
                           asp-route-vaiTro="@Model.VaiTro"
                           asp-route-trangThai="@Model.TrangThai">
                            <i class="bi bi-chevron-double-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
