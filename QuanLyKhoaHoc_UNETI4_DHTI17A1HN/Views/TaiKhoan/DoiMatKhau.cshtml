@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.ViewModels.DoiMatKhauViewModel
@{
    ViewData["Title"] = "Đổi Mật Khẩu";
}

<!--
// ========================================================
// Họ và tên: Vũ Đình Trường
// Mã sinh viên: 23103100026
// Phụ trách: Module 1 - Tài khoản, Đăng nhập, Phân quyền và Chương trình đào tạo
// ========================================================
-->

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-warning text-dark text-center py-3 border-0">
                <h5 class="fw-bold mb-0"><i class="bi bi-shield-lock-fill me-2"></i>ĐỔI MẬT KHẨU</h5>
            </div>
            <div class="card-body p-4 bg-white">
                <form asp-action="DoiMatKhau" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="MatKhauCu" class="form-label fw-semibold small">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                        <input asp-for="MatKhauCu" class="form-control" />
                        <span asp-validation-for="MatKhauCu" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MatKhauMoi" class="form-label fw-semibold small">Mật khẩu mới <span class="text-danger">*</span></label>
                        <input asp-for="MatKhauMoi" class="form-control" />
                        <span asp-validation-for="MatKhauMoi" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="XacNhanMatKhauMoi" class="form-label fw-semibold small">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                        <input asp-for="XacNhanMatKhauMoi" class="form-control" />
                        <span asp-validation-for="XacNhanMatKhauMoi" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Profile" class="btn btn-outline-secondary px-3">Quay lại</a>
                        <button type="submit" class="btn btn-warning px-4 fw-bold">
                            <i class="bi bi-check2-circle me-1"></i> Cập Nhật Mật Khẩu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
