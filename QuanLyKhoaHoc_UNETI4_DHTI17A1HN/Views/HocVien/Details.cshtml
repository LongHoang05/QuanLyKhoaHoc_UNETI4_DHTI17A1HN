@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.HocVien
@{
    ViewData["Title"] = $"Hồ Sơ Học Viên: {Model.HoTen}";
    var initialLetter = string.IsNullOrEmpty(Model.HoTen) ? "H" : Model.HoTen.Trim().Substring(Model.HoTen.Trim().LastIndexOf(' ') + 1).Substring(0, 1).ToUpper();
}

<!-- Page Hero -->
<div class="page-hero">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="hero-badge"><i class="bi bi-person-vcard"></i> Hồ Sơ Chi Tiết</span>
                <span class="small" style="color: #bae6fd;">Mã Học Viên: #@Model.MaHocVien</span>
            </div>
            <h1 class="hero-title">@Model.HoTen</h1>
            <p class="hero-subtitle">
                Chi tiết lý lịch học viên, thông tin tài khoản liên kết và lịch sử đăng ký các chương trình đào tạo tại UNETI.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.MaHocVien" class="btn btn-sm px-3 py-2 rounded-pill fw-semibold text-white shadow-sm" style="background: var(--primary-rose); border: 1px solid rgba(56,189,248,0.4); font-size: 0.85rem;">
                <i class="bi bi-pencil-square me-1"></i> Chỉnh Sửa Hồ Sơ
            </a>
            <a asp-action="Index" class="btn btn-sm px-3 py-2 rounded-pill fw-semibold text-white" style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.25); font-size: 0.85rem;">
                <i class="bi bi-arrow-left me-1"></i> Quay lại Danh sách
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- CỘT TRÁI: THẺ HỌC VIÊN ĐIỆN TỬ (DIGITAL STUDENT ID CARD) CHUẨN Giao_DIen_Test -->
    <div class="col-lg-4">
        <div class="student-id-card mb-4">
            <div class="card-hologram">UNETI</div>
            <div class="card-chip">CHIP</div>

            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="avatar-circle" style="width: 56px; height: 56px; font-size: 1.4rem;">
                    @initialLetter
                </div>
                <div>
                    <div class="fw-bold fs-5 text-white">@Model.HoTen</div>
                    <div style="font-size: 0.75rem; color: #7dd3fc;">Mã HV: <strong>HV-@Model.MaHocVien.ToString("D4")</strong></div>
                </div>
            </div>

            <div class="pt-2 border-top border-light border-opacity-25" style="font-size: 0.82rem;">
                <div class="d-flex justify-content-between py-1">
                    <span class="text-white-50">Email:</span>
                    <span class="fw-semibold text-truncate ms-2" style="max-width: 180px;">@Model.Email</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-white-50">Số điện thoại:</span>
                    <span class="fw-semibold">@(Model.SoDienThoai ?? "Chưa có")</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-white-50">Ngày sinh:</span>
                    <span class="fw-semibold">@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-white-50">Trạng thái:</span>
                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success bg-opacity-75 rounded-pill"><i class="bi bi-check-circle me-1"></i>Đang học</span>
                    }
                    else
                    {
                        <span class="badge bg-danger bg-opacity-75 rounded-pill"><i class="bi bi-lock me-1"></i>Tạm khóa</span>
                    }
                </div>
            </div>
        </div>

        <!-- Thẻ thông tin tài khoản liên kết -->
        <div class="content-card p-4">
            <h6 class="fw-bold mb-3 d-flex align-items-center text-primary" style="font-family: var(--font-serif);">
                <i class="bi bi-shield-lock-fill me-2"></i>Tài Khoản Hệ Thống (Entity TaiKhoan)
            </h6>
            @if (Model.TaiKhoan != null)
            {
                <ul class="list-unstyled mb-0 small">
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Tên đăng nhập:</span>
                        <strong class="text-dark">@Model.TaiKhoan.TenDangNhap</strong>
                    </li>
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Vai trò hệ thống:</span>
                        <span class="badge bg-primary rounded-pill">@Model.TaiKhoan.VaiTro</span>
                    </li>
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Trạng thái tài khoản:</span>
                        <span class="badge @(Model.TaiKhoan.TrangThai ? "bg-success" : "bg-danger") rounded-pill">
                            @(Model.TaiKhoan.TrangThai ? "Kích hoạt" : "Bị khóa")
                        </span>
                    </li>
                    <li class="d-flex justify-content-between py-2">
                        <span class="text-muted">Ngày cấp tài khoản:</span>
                        <span>@Model.TaiKhoan.NgayTao.ToString("dd/MM/yyyy")</span>
                    </li>
                </ul>
            }
            else
            {
                <div class="text-center py-3 text-muted small">
                    <i class="bi bi-person-x fs-3 d-block mb-1 text-secondary"></i>
                    Học viên này chưa được cấp tài khoản hệ thống.
                </div>
            }
        </div>
    </div>

    <!-- CỘT PHẢI: LỊCH SỬ ĐĂNG KÝ KHÓA HỌC & CHƯƠNG TRÌNH ĐÀO TẠO -->
    <div class="col-lg-8">
        <!-- Thông tin mở rộng -->
        <div class="content-card p-4 mb-4">
            <h5 class="fw-bold mb-3 text-dark" style="font-family: var(--font-serif);">
                <i class="bi bi-info-circle-fill text-primary me-2"></i>Thông Tin Bổ Sung Hồ Sơ
            </h5>
            <div class="row g-3 small">
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted mb-1">Giới tính:</div>
                        <div class="fw-bold fs-6 text-dark">@(Model.GioiTinh ?? "Chưa rõ")</div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted mb-1">Trình độ học vấn:</div>
                        <div class="fw-bold fs-6 text-dark">@(Model.TrinhDoHocVan ?? "Chưa cập nhật")</div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted mb-1">Nghề nghiệp:</div>
                        <div class="fw-bold fs-6 text-dark">@(Model.NgheNghiep ?? "Chưa cập nhật")</div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted mb-1">Địa chỉ thường trú:</div>
                        <div class="fw-bold fs-6 text-dark">@(Model.DiaChi ?? "Chưa cập nhật")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng lịch sử đăng ký học (Entity DangKyHoc) -->
        <div class="content-card">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark" style="font-family: var(--font-serif);">
                    <i class="bi bi-journal-check text-primary me-2"></i>Lịch Sử Đăng Ký Lớp Học (Mục 7 & 8)
                </h5>
                <span class="badge rounded-pill fw-bold" style="background: var(--surface-container); color: var(--primary-rose);">
                    @(Model.DangKyHocs?.Count ?? 0) Đơn Đăng Ký
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Mã ĐK</th>
                            <th>Lớp Học & Chương Trình</th>
                            <th>Ngày Đăng Ký</th>
                            <th>Học Phí / Đã Nộp</th>
                            <th class="text-center">Trạng Thái Đơn</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DangKyHocs == null || !Model.DangKyHocs.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder2-open fs-2 d-block mb-2 text-secondary"></i>
                                    Học viên này chưa đăng ký lớp học nào trong hệ thống.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var dk in Model.DangKyHocs)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">#@dk.MaDangKy</td>
                                    <td>
                                        <div class="fw-bold text-primary">@(dk.LopHoc?.TenLop ?? "N/A")</div>
                                        <div class="small text-muted">
                                            Chương trình: <strong>@(dk.LopHoc?.ChuongTrinhDaoTao?.TenChuongTrinh ?? "N/A")</strong>
                                        </div>
                                    </td>
                                    <td class="small">@dk.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <div class="fw-semibold">@((dk.LopHoc?.HocPhi ?? 0).ToString("N0")) VNĐ</div>
                                        <div class="small text-success">Đã đóng: @dk.SoTienDaDong.ToString("N0") VNĐ</div>
                                    </td>
                                    <td class="text-center">
                                        @switch (dk.TrangThai)
                                        {
                                            case "Chờ duyệt":
                                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                                    <i class="bi bi-hourglass-split me-1"></i>Chờ duyệt
                                                </span>
                                                break;
                                            case "Đã duyệt":
                                                <span class="badge bg-info text-dark px-3 py-2 rounded-pill">
                                                    <i class="bi bi-check2-circle me-1"></i>Đã duyệt
                                                </span>
                                                break;
                                            case "Đã đóng học phí":
                                            case "Đang học":
                                                <span class="badge bg-success px-3 py-2 rounded-pill">
                                                    <i class="bi bi-check-circle-fill me-1"></i>@dk.TrangThai
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary px-3 py-2 rounded-pill">@dk.TrangThai</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
