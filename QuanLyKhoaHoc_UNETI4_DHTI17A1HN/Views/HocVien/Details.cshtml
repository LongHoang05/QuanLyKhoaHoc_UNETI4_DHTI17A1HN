@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.HocVien
@{
    ViewData["Title"] = $"Hồ Sơ Học Viên: {Model.HoTen}";
    var initialLetter = string.IsNullOrEmpty(Model.HoTen) ? "H" : Model.HoTen.Trim().Substring(Model.HoTen.Trim().LastIndexOf(' ') + 1).Substring(0, 1).ToUpper();
    int soDon = Model.DangKyHocs?.Count ?? 0;
}

<div class="flex flex-col gap-y-6">
    <!-- Sub-header Navigation Bar -->
    <section class="bg-surface-white rounded-2xl border border-border-standard shadow-sm p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4 card-pro">
        <div>
            <div class="flex items-center gap-2 text-outline font-label-sm text-label-sm uppercase tracking-wider mb-1">
                <span>ĐÀO TẠO UNETI</span>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <a asp-action="Index" class="hover:text-primary transition-colors">QUẢN LÝ HỌC VIÊN</a>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-primary font-semibold">HỒ SƠ HỌC VIÊN</span>
            </div>
            <div class="flex items-center gap-3">
                <h1 class="font-headline-md text-headline-md text-brand-deep font-bold tracking-tight">
                    @Model.HoTen
                </h1>
                <span class="font-mono text-xs px-2.5 py-1 rounded-md bg-surface-container-high text-brand-deep font-semibold border border-border-standard">
                    #HV@(Model.MaHocVien.ToString("D4"))
                </span>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <a asp-action="Index" class="inline-flex items-center gap-1.5 bg-surface-white border border-border-standard hover:bg-surface-container-low text-brand-deep font-label-md text-label-md px-3.5 py-2.5 rounded-xl transition-all shadow-xs cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                <span>Quay lại</span>
            </a>
            <a asp-action="Edit" asp-route-id="@Model.MaHocVien" class="inline-flex items-center gap-1.5 bg-primary hover:bg-primary-hover text-surface-white font-label-md text-label-md px-4 py-2.5 rounded-xl shadow-sm hover:shadow-md transition-all cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">edit</span>
                <span>Chỉnh sửa hồ sơ</span>
            </a>
        </div>
    </section>

    <!-- Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Cột trái: Thẻ học viên & Tài khoản liên kết -->
        <div class="space-y-6">
            <!-- Thẻ học viên điện tử -->
            <div class="bg-gradient-to-br from-brand-deep to-primary text-white rounded-2xl p-6 shadow-md relative overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-white/10 rounded-full blur-xl"></div>
                <div class="flex items-center justify-between pb-4 border-b border-white/20">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-white/80 text-[20px]">badge</span>
                        <span class="text-xs font-bold tracking-wider uppercase text-white/80">THẺ HỌC VIÊN ĐIỆN TỬ</span>
                    </div>
                    <span class="text-[10px] font-mono uppercase bg-white/20 px-2 py-0.5 rounded text-white font-bold">UNETI</span>
                </div>

                <div class="flex items-center gap-4 mt-5">
                    <div class="w-14 h-14 rounded-2xl bg-white text-brand-deep font-black text-xl flex items-center justify-center shrink-0 shadow-md">
                        @initialLetter
                    </div>
                    <div class="min-w-0">
                        <h2 class="text-base font-bold text-white truncate">@Model.HoTen</h2>
                        <p class="text-xs text-sky-200 font-mono">HV-@Model.MaHocVien.ToString("D4")</p>
                    </div>
                </div>

                <div class="mt-5 pt-4 border-t border-white/20 space-y-2 text-xs">
                    <div class="flex justify-between items-center text-sky-100">
                        <span class="text-white/70">Email:</span>
                        <span class="font-medium text-white truncate max-w-[170px]" title="@Model.Email">@Model.Email</span>
                    </div>
                    <div class="flex justify-between items-center text-sky-100">
                        <span class="text-white/70">Điện thoại:</span>
                        <span class="font-medium text-white font-mono">@(Model.SoDienThoai ?? "Chưa có")</span>
                    </div>
                    <div class="flex justify-between items-center text-sky-100">
                        <span class="text-white/70">Ngày sinh:</span>
                        <span class="font-medium text-white font-mono">@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</span>
                    </div>
                    <div class="flex justify-between items-center text-sky-100 pt-1">
                        <span class="text-white/70">Trạng thái:</span>
                        @if (Model.TrangThai)
                        {
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-400/20 text-emerald-200 font-semibold text-[11px] border border-emerald-300/30">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-300"></span>Đang học
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-rose-400/20 text-rose-200 font-semibold text-[11px] border border-rose-300/30">
                                <span class="w-1.5 h-1.5 rounded-full bg-rose-300"></span>Tạm khóa
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Thẻ Tài khoản liên kết -->
            <div class="bg-surface-white rounded-2xl border border-border-standard p-5 shadow-sm card-pro">
                <div class="flex items-center gap-2 pb-3 border-b border-border-standard">
                    <span class="material-symbols-outlined text-primary text-[20px]">manage_accounts</span>
                    <h3 class="text-xs font-bold text-brand-deep uppercase tracking-wider">Tài khoản hệ thống</h3>
                </div>

                @if (Model.TaiKhoan != null)
                {
                    <div class="mt-4 space-y-3 text-xs">
                        <div class="flex justify-between items-center py-1.5 border-b border-border-subtle">
                            <span class="text-outline">Tên đăng nhập:</span>
                            <span class="font-bold text-brand-deep font-mono">@@@Model.TaiKhoan.TenDangNhap</span>
                        </div>
                        <div class="flex justify-between items-center py-1.5 border-b border-border-subtle">
                            <span class="text-outline">Vai trò:</span>
                            <span class="px-2 py-0.5 rounded bg-surface-container-low font-semibold text-brand-deep">@Model.TaiKhoan.VaiTro</span>
                        </div>
                        <div class="flex justify-between items-center py-1.5 border-b border-border-subtle">
                            <span class="text-outline">Trạng thái TK:</span>
                            @if (Model.TaiKhoan.TrangThai)
                            {
                                <span class="text-success-emerald font-semibold flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-success-emerald"></span>Kích hoạt
                                </span>
                            }
                            else
                            {
                                <span class="text-danger-crimson font-semibold flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-danger-crimson"></span>Bị khóa
                                </span>
                            }
                        </div>
                        <div class="flex justify-between items-center py-1.5">
                            <span class="text-outline">Ngày cấp:</span>
                            <span class="font-mono text-outline">@Model.TaiKhoan.NgayTao.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="py-6 text-center text-outline">
                        <span class="material-symbols-outlined text-3xl block mb-1 text-outline/50">person_off</span>
                        <p class="text-xs">Chưa liên kết tài khoản hệ thống.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Cột phải: Thông tin mở rộng & Lịch sử Đăng ký -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Thông tin bổ sung hồ sơ -->
            <div class="bg-surface-white rounded-2xl border border-border-standard p-5 shadow-sm card-pro">
                <div class="flex items-center gap-2 pb-3 border-b border-border-standard">
                    <span class="material-symbols-outlined text-primary text-[20px]">info</span>
                    <h3 class="text-xs font-bold text-brand-deep uppercase tracking-wider">Thông tin bổ sung hồ sơ</h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4 text-xs">
                    <div class="p-3 bg-surface-container-low rounded-xl border border-border-standard">
                        <p class="text-[11px] text-outline mb-1">Giới tính</p>
                        <p class="font-bold text-brand-deep text-sm">@(Model.GioiTinh ?? "Chưa rõ")</p>
                    </div>
                    <div class="p-3 bg-surface-container-low rounded-xl border border-border-standard">
                        <p class="text-[11px] text-outline mb-1">Trình độ học vấn</p>
                        <p class="font-bold text-brand-deep text-sm">@(Model.TrinhDoHocVan ?? "Chưa cập nhật")</p>
                    </div>
                    <div class="p-3 bg-surface-container-low rounded-xl border border-border-standard">
                        <p class="text-[11px] text-outline mb-1">Nghề nghiệp</p>
                        <p class="font-bold text-brand-deep text-sm">@(Model.NgheNghiep ?? "Chưa cập nhật")</p>
                    </div>
                    <div class="p-3 bg-surface-container-low rounded-xl border border-border-standard">
                        <p class="text-[11px] text-outline mb-1">Địa chỉ thường trú</p>
                        <p class="font-bold text-brand-deep text-sm">@(Model.DiaChi ?? "Chưa cập nhật")</p>
                    </div>
                </div>
            </div>

            <!-- Bảng lịch sử đăng ký lớp học -->
            <div class="bg-surface-white rounded-2xl border border-border-standard shadow-sm overflow-hidden card-pro">
                <div class="p-5 border-b border-border-standard flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[20px]">how_to_reg</span>
                        <h2 class="font-headline-sm text-headline-sm text-brand-deep font-bold">
                            Lịch sử Đăng ký Lớp học (@soDon)
                        </h2>
                    </div>
                    <a asp-controller="DangKyHoc" asp-action="Index" class="text-xs text-primary hover:underline font-semibold flex items-center gap-1">
                        <span>Xét duyệt &amp; Học phí</span>
                        <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                    </a>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-surface-container-low/80 border-b border-border-standard font-label-sm text-[11px] text-outline font-bold tracking-wider uppercase">
                                <th class="py-3.5 px-4 w-12 text-center">#</th>
                                <th class="py-3.5 px-4">Mã ĐK</th>
                                <th class="py-3.5 px-4 min-w-[200px]">Lớp học &amp; Chương trình</th>
                                <th class="py-3.5 px-4">Ngày đăng ký</th>
                                <th class="py-3.5 px-4">Học phí / Đã nộp</th>
                                <th class="py-3.5 px-4 text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border-subtle text-xs text-brand-deep">
                            @if (Model.DangKyHocs != null && Model.DangKyHocs.Any())
                            {
                                int idx = 1;
                                foreach (var dk in Model.DangKyHocs)
                                {
                                    <tr class="hover:bg-surface-container-low/50 transition-colors">
                                        <td class="py-3.5 px-4 text-center text-outline font-mono text-[11px]">@(idx++)</td>
                                        <td class="py-3.5 px-4 font-mono font-semibold text-brand-deep">
                                            #DK@(dk.MaDangKy.ToString("D3"))
                                        </td>
                                        <td class="py-3.5 px-4">
                                            <p class="font-bold text-brand-deep">@(dk.LopHoc?.TenLop ?? "N/A")</p>
                                            <p class="text-[11px] text-outline">@(dk.LopHoc?.ChuongTrinhDaoTao?.TenChuongTrinh ?? "N/A")</p>
                                        </td>
                                        <td class="py-3.5 px-4 font-mono text-outline">
                                            @dk.NgayDangKy.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td class="py-3.5 px-4">
                                            <p class="font-mono font-semibold text-brand-deep">@((dk.LopHoc?.HocPhi ?? 0).ToString("N0")) đ</p>
                                            <p class="text-[11px] text-success-emerald font-mono font-medium">Đã đóng: @dk.SoTienDaDong.ToString("N0") đ</p>
                                        </td>
                                        <td class="py-3.5 px-4 text-center">
                                            @switch (dk.TrangThai)
                                            {
                                                case "Chờ duyệt":
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-700 font-semibold text-[11px]">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Chờ duyệt
                                                    </span>
                                                    break;
                                                case "Đã duyệt":
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 font-semibold text-[11px]">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Đã duyệt
                                                    </span>
                                                    break;
                                                case "Đã đóng học phí":
                                                case "Đang học":
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-semibold text-[11px]">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>@dk.TrangThai
                                                    </span>
                                                    break;
                                                default:
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 font-semibold text-[11px]">
                                                        @dk.TrangThai
                                                    </span>
                                                    break;
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="py-12 text-center text-outline">
                                        <span class="material-symbols-outlined text-4xl block mb-2 text-outline/50">folder_open</span>
                                        Học viên này chưa đăng ký lớp học nào trong hệ thống.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
