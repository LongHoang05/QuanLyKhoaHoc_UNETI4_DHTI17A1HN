@model List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.HocVien>
@{
    ViewData["Title"] = "Quản Lý Danh Sách Học Viên (Module 3)";
    var vaiTroHienTai = Context.Session.GetString("VaiTro");
    var hoTenHienTai = Context.Session.GetString("HoTen");
    var totalStudents = Model?.Count ?? 0;
    var activeStudents = Model?.Count(h => h.TrangThai) ?? 0;
    var lockedStudents = Model?.Count(h => !h.TrangThai) ?? 0;
    var hasAccountCount = Model?.Count(h => h.MaTaiKhoan != null) ?? 0;
}

<!-- 1. HERO BANNER CHUẨN DESIGN Giao_DIen_Test -->
<div class="page-hero">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="hero-badge"><i class="bi bi-person-badge"></i> Entity HocVien & TaiKhoan</span>
                <span class="small" style="color: #bae6fd;">Mục 7 Đề tài BTL UNETI • Module 3</span>
            </div>
            <h1 class="hero-title">Quản lý Hồ sơ & Danh sách Học viên</h1>
            <p class="hero-subtitle">
                Kiến trúc 3 tầng: <code>Controller -> Service -> Repository -> Database</code>. Bảo mật phân quyền Session, tìm kiếm jQuery AJAX Live Search không tải lại trang và quản lý lịch sử học tập.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Portal" class="btn btn-sm px-3 py-2 rounded-pill fw-semibold text-white" style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.25); font-size: 0.82rem;">
                <i class="bi bi-box-arrow-up-right me-1"></i> Mở Cổng Học Viên
            </a>
            <a asp-action="Create" class="btn btn-sm px-3 py-2 rounded-pill fw-semibold text-white shadow-sm" style="background: var(--primary-rose); border: 1px solid rgba(56,189,248,0.4); font-size: 0.82rem;">
                <i class="bi bi-person-plus-fill me-1"></i> Thêm Học Viên Mới
            </a>
        </div>
    </div>
</div>

<!-- 2. BỐN THẺ CHỈ SỐ NHANH TỐI GIẢN (MINI STAT CARDS) -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Tổng số Học viên</div>
                <div class="mini-stat-num" style="color: var(--primary-rose);" id="statTotalStudents">@totalStudents</div>
                <div class="small" style="font-size: 0.72rem; color: #15803d;"><i class="bi bi-check-circle me-1"></i>Đạt chuẩn hồ sơ BTL</div>
            </div>
            <div class="mini-stat-icon" style="background: var(--surface-container); color: var(--primary-rose);">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Đang theo học</div>
                <div class="mini-stat-num" style="color: #15803d;" id="statActiveStudents">@activeStudents</div>
                <div class="small text-muted" style="font-size: 0.72rem;">Trạng thái hoạt động</div>
            </div>
            <div class="mini-stat-icon" style="background: #dcfce7; color: #15803d;">
                <i class="bi bi-check-circle-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Tạm khóa học viên</div>
                <div class="mini-stat-num" style="color: #dc2626;" id="statLockedStudents">@lockedStudents</div>
                <div class="small text-muted" style="font-size: 0.72rem;">Không được đăng ký mới</div>
            </div>
            <div class="mini-stat-icon" style="background: #fee2e2; color: #dc2626;">
                <i class="bi bi-lock-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="mini-stat-card">
            <div>
                <div class="mini-stat-label">Đã có Tài khoản</div>
                <div class="mini-stat-num" style="color: #0369a1;">@hasAccountCount</div>
                <div class="small text-muted" style="font-size: 0.72rem;">Liên kết Entity TaiKhoan</div>
            </div>
            <div class="mini-stat-icon" style="background: #e0f2fe; color: #0369a1;">
                <i class="bi bi-person-check-fill"></i>
            </div>
        </div>
    </div>
</div>

<!-- 3. CONTENT CARD & BẢNG DỮ LIỆU TÌM KIẾM AJAX -->
<div class="content-card">
    
    <!-- Toolbar Tìm kiếm & Lọc AJAX -->
    <div class="toolbar">
        <div class="d-flex flex-wrap align-items-center gap-2 flex-grow-1">
            <!-- Search Box AJAX -->
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="keyword" class="form-control form-control-sm" placeholder="Tìm tên, username, email, SĐT tức thì..." autocomplete="off">
            </div>

            <!-- Filter Tiêu chí tìm kiếm -->
            <select id="searchType" class="form-select form-select-sm filter-select">
                <option value="all" selected>-- Tất cả thông tin --</option>
                <option value="name">Theo Họ và Tên</option>
                <option value="email">Theo Email</option>
                <option value="phone">Theo Số điện thoại</option>
            </select>

            <!-- Nút Xóa lọc -->
            <button type="button" id="btnXoaLoc" class="btn btn-sm btn-outline-secondary rounded-pill px-3" style="font-size: 0.8rem;">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa lọc
            </button>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill" style="background: var(--surface-container); color: var(--primary-rose); font-size: 0.75rem;">
                <i class="bi bi-lightning-charge-fill me-1"></i> jQuery AJAX Debounce 300ms
            </span>
            <div class="small text-muted">
                Tổng cộng: <strong id="filterCount">@totalStudents</strong> học viên
            </div>
        </div>
    </div>

    <!-- Spinner Loading AJAX -->
    <div id="loadingSpinner" class="text-center py-4 d-none">
        <div class="spinner-border text-primary spinner-border-sm" role="status">
            <span class="visually-hidden">Đang tải...</span>
        </div>
        <span class="ms-2 text-muted small">Đang tìm kiếm dữ liệu học viên...</span>
    </div>

    <!-- Vùng hiển thị Danh Sách Học Viên qua AJAX PartialView -->
    <div id="vungDanhSachHocVien">
        @await Html.PartialAsync("_DanhSachHocVien", Model)
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let debounceTimer = null;

            // 1. Tìm kiếm jQuery AJAX Live Search khi gõ từ khóa (keyup)
            $('#keyword').on('keyup', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    thucHienTimKiemAjax();
                }, 300);
            });

            // Thay đổi tiêu chí tìm kiếm
            $('#searchType').on('change', function () {
                thucHienTimKiemAjax();
            });

            // Nút xóa lọc
            $('#btnXoaLoc').on('click', function () {
                $('#keyword').val('');
                $('#searchType').val('all');
                thucHienTimKiemAjax();
                $('#keyword').focus();
            });

            // Hàm gửi yêu cầu AJAX tìm kiếm
            function thucHienTimKiemAjax() {
                const keywordVal = $('#keyword').val();
                const searchTypeVal = $('#searchType').val();

                $('#loadingSpinner').removeClass('d-none');
                $('#vungDanhSachHocVien').css('opacity', '0.4');

                $.ajax({
                    url: '@Url.Action("LiveSearch", "HocVien")',
                    type: 'GET',
                    data: {
                        keyword: keywordVal,
                        searchType: searchTypeVal
                    },
                    success: function (result) {
                        $('#vungDanhSachHocVien').html(result);
                        $('#vungDanhSachHocVien').css('opacity', '1');
                        $('#loadingSpinner').addClass('d-none');

                        const count = $('#soLuongKetQuaMoi').val() || 0;
                        $('#filterCount').text(count);
                    },
                    error: function (xhr) {
                        $('#loadingSpinner').addClass('d-none');
                        $('#vungDanhSachHocVien').css('opacity', '1');
                        showToast("Lỗi tìm kiếm: " + (xhr.responseText || "Vui lòng kiểm tra lại kết nối"), "danger");
                    }
                });
            }

            // 2. Chức năng Đổi trạng thái Bật/Tắt (ToggleTrangThai) bằng AJAX
            $(document).on('click', '.btn-toggle-status', function (e) {
                e.preventDefault();
                const btn = $(this);
                const maHocVien = btn.data('id');
                const tenHocVien = btn.data('name');

                btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("ToggleTrangThai", "HocVien")',
                    type: 'POST',
                    data: { id: maHocVien },
                    success: function (res) {
                        btn.prop('disabled', false);
                        if (res.success) {
                            const badgeCell = $('#status-badge-' + maHocVien);
                            if (res.newStatus) {
                                badgeCell.html(`
                                    <span class="status-pill active">
                                        <span class="status-dot"></span>Đang học
                                    </span>
                                `);
                                btn.html('<i class="bi bi-lock" style="color: #d97706;"></i>');
                                btn.attr('title', 'Khóa tài khoản học viên');
                                showToast(`Đã mở khóa học viên: ${tenHocVien}`, 'success');
                            } else {
                                badgeCell.html(`
                                    <span class="status-pill locked">
                                        <span class="status-dot"></span>Tạm khóa
                                    </span>
                                `);
                                btn.html('<i class="bi bi-unlock-fill" style="color: #059669;"></i>');
                                btn.attr('title', 'Mở khóa học viên');
                                showToast(`Đã tạm khóa học viên: ${tenHocVien}`, 'warning');
                            }
                        } else {
                            showToast(res.message || 'Không thể thay đổi trạng thái', 'danger');
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false);
                        showToast('Lỗi kết nối máy chủ khi đổi trạng thái!', 'danger');
                    }
                });
            });

            // 3. Xóa học viên
            $(document).on('click', '.btn-delete-hocvien', function (e) {
                e.preventDefault();
                const maHocVien = $(this).data('id');
                const tenHocVien = $(this).data('name');

                if (confirm(`Bạn có chắc chắn muốn xóa học viên "${tenHocVien}" (Mã #${maHocVien}) không?`)) {
                    $.ajax({
                        url: '@Url.Action("DeleteAjax", "HocVien")',
                        type: 'POST',
                        data: { id: maHocVien },
                        success: function (res) {
                            if (res.success) {
                                showToast(res.message, 'success');
                                thucHienTimKiemAjax();
                            } else {
                                showToast(res.message, 'danger');
                            }
                        },
                        error: function () {
                            showToast('Lỗi khi gửi yêu cầu xóa học viên!', 'danger');
                        }
                    });
                }
            });
        });
    </script>
}
