@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.ViewModels.HocVienIndexViewModel
@{
    ViewData["Title"] = "Quản lý Hồ sơ Học viên";
    int tongSoHocVien = Model.TongSoHocVien > 0 ? Model.TongSoHocVien : Model.DanhSachHocVien.Count;
    int dangHocCount = ViewBag.DangHocCount ?? Model.DanhSachHocVien.Count(h => h.TrangThai);
    int hoanThanhCount = ViewBag.TamKhoaCount ?? Model.DanhSachHocVien.Count(h => !h.TrangThai);
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? Model.DanhSachHocVien.Count;
    int pageSize = ViewBag.PageSize ?? 8;
    string search = ViewBag.Search as string ?? "";
    string selectedTrangThai = ViewBag.SelectedTrangThai as string ?? "";
    string selectedTrinhDo = ViewBag.SelectedTrinhDo as string ?? "";
    string sortBy = ViewBag.SortBy as string ?? "";
}

<!--
// ========================================================
// Họ và tên: Nguyễn Đức Linh
// Mã sinh viên: 23103100042
// Phụ trách: Module 3 - Quản lý học viên, Hồ sơ cá nhân và Đăng ký học
// ========================================================
-->

@Html.AntiForgeryToken()

<div id="hocvien-content-area" class="flex flex-col gap-y-6 transition-opacity duration-200">
    <!-- Sub-header Navigation Bar -->
    <section class="bg-surface-white rounded-2xl border border-border-standard shadow-sm p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4 card-pro">
        <div>
            <div class="flex items-center gap-2 text-outline font-label-sm text-label-sm uppercase tracking-wider mb-1">
                <span>ĐÀO TẠO UNETI</span>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-primary font-semibold">QUẢN LÝ HỌC VIÊN</span>
            </div>
            <h1 class="font-headline-md text-headline-md text-brand-deep font-bold tracking-tight flex items-center gap-2">
                Danh sách Hồ sơ Học viên
                <span class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary text-xs font-semibold">23103100042</span>
            </h1>
        </div>

        <div class="flex items-center gap-2.5">
            <button onclick="exportTableToCSV('danh-sach-hoc-vien.csv')" class="inline-flex items-center gap-1.5 bg-surface-white border border-border-standard hover:bg-slate-50 text-brand-deep font-label-md text-xs px-3.5 py-2.5 rounded-xl transition-all shadow-xs active:scale-95 cursor-pointer">
                <span class="material-symbols-outlined text-[18px] text-primary">file_download</span>
                <span class="hidden sm:inline">Xuất Excel</span>
            </button>
            <button onclick="openDrawer('create')" class="inline-flex items-center gap-1.5 bg-primary hover:bg-primary-hover text-surface-white font-label-md text-xs px-4 py-2.5 rounded-xl shadow-sm hover:shadow-card transition-all active:scale-95 cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                <span>Thêm học viên</span>
            </button>
        </div>
    </section>

    <!-- 3 Stat Cards (Top KPI) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="card-pro card-pro-hover p-5 flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
                <span class="text-outline font-label-md text-label-md font-medium">Tổng số học viên</span>
                <div class="w-10 h-10 rounded-2xl bg-primary-light flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">group</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="font-display text-[30px] leading-8 text-brand-deep tracking-tight font-black font-mono">@tongSoHocVien</span>
                <span class="text-xs text-outline font-medium">hồ sơ trong hệ thống</span>
            </div>
        </div>

        <div class="card-pro card-pro-hover p-5 flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
                <span class="text-outline font-label-md text-label-md font-medium">Học viên đang hoạt động</span>
                <div class="w-10 h-10 rounded-2xl bg-emerald-50 flex items-center justify-center text-emerald-600">
                    <span class="material-symbols-outlined text-[20px]">school</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="font-display text-[30px] leading-8 text-emerald-700 tracking-tight font-black font-mono">@dangHocCount</span>
                <span class="text-xs text-emerald-600 font-medium">hồ sơ tích cực</span>
            </div>
        </div>

        <div class="card-pro card-pro-hover p-5 flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
                <span class="text-outline font-label-md text-label-md font-medium">Đã hoàn thành / Tạm dừng</span>
                <div class="w-10 h-10 rounded-2xl bg-blue-50 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">verified</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="font-display text-[30px] leading-8 text-blue-700 tracking-tight font-black font-mono">@hoanThanhCount</span>
                <span class="text-xs text-outline font-medium">đã xong hoặc bảo lưu</span>
            </div>
        </div>
    </div>

    <!-- Filter Toolbar -->
    <div class="bg-surface-white rounded-2xl border border-border-standard shadow-sm p-4 card-pro flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3 flex-1 min-w-[280px]">
            <div class="relative flex-1 min-w-[240px]">
                <span class="material-symbols-outlined text-outline absolute left-3 top-1/2 -translate-y-1/2 text-[18px]">search</span>
                <input id="hvSearchInput" value="@search" oninput="debounceHvFilter()" class="w-full bg-surface-container-low border border-border-standard pl-9 pr-3 py-2 rounded-xl text-brand-deep font-body-sm text-xs focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" placeholder="Tìm theo mã HV, họ tên, email, sđt..." type="text">
            </div>

            <!-- Filter Trạng thái -->
            <div class="relative min-w-[160px]">
                <select id="filterHvStatus" onchange="filterHvTable()" class="w-full appearance-none bg-surface-white border border-border-standard text-brand-deep text-xs px-3.5 py-2 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-container-low transition-colors">
                    <option value="">Tất cả trạng thái</option>
                    <!option value="Đang học" @(selectedTrangThai == "Đang học" ? "selected" : "")>Đang học (Hoạt động)</!option>
                    <!option value="Tạm khóa" @(selectedTrangThai == "Tạm khóa" ? "selected" : "")>Tạm khóa / Nghỉ</!option>
                </select>
                <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">expand_more</span>
            </div>

            <!-- Filter Trình độ học vấn -->
            <div class="relative min-w-[150px]">
                <select id="filterHvLevel" onchange="filterHvTable()" class="w-full appearance-none bg-surface-white border border-border-standard text-brand-deep text-xs px-3.5 py-2 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-container-low transition-colors">
                    <option value="">Tất cả trình độ</option>
                    <!option value="Đại học" @(selectedTrinhDo == "Đại học" ? "selected" : "")>Đại học</!option>
                    <!option value="Kỹ sư" @(selectedTrinhDo == "Kỹ sư" ? "selected" : "")>Kỹ sư</!option>
                    <!option value="Thạc sĩ" @(selectedTrinhDo == "Thạc sĩ" ? "selected" : "")>Thạc sĩ</!option>
                    <!option value="Cao đẳng" @(selectedTrinhDo == "Cao đẳng" ? "selected" : "")>Cao đẳng</!option>
                    <!option value="Trung cấp" @(selectedTrinhDo == "Trung cấp" ? "selected" : "")>Trung cấp</!option>
                    <!option value="THPT" @(selectedTrinhDo == "THPT" ? "selected" : "")>THPT</!option>
                    <!option value="Sau đại học" @(selectedTrinhDo == "Sau đại học" ? "selected" : "")>Sau đại học</!option>
                </select>
                <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">expand_more</span>
            </div>

            <!-- Sắp xếp (Sort) -->
            <div class="relative min-w-[165px]">
                <select id="filterHvSortBy" onchange="filterHvTable()" class="w-full appearance-none bg-surface-white border border-border-standard text-brand-deep text-xs px-3.5 py-2 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-container-low transition-colors font-medium">
                    <!option value="" @(sortBy == "" ? "selected" : "")>Sắp xếp: Mới nhất</!option>
                    <!option value="ten_asc" @(sortBy == "ten_asc" ? "selected" : "")>Họ tên: A → Z</!option>
                    <!option value="ten_desc" @(sortBy == "ten_desc" ? "selected" : "")>Họ tên: Z → A</!option>
                    <!option value="mahv_asc" @(sortBy == "mahv_asc" ? "selected" : "")>Mã HV: Tăng dần</!option>
                    <!option value="mahv_desc" @(sortBy == "mahv_desc" ? "selected" : "")>Mã HV: Giảm dần</!option>
                    <!option value="ngaysinh_asc" @(sortBy == "ngaysinh_asc" ? "selected" : "")>Ngày sinh: Cũ → Mới</!option>
                </select>
                <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">sort</span>
            </div>
        </div>

        <button type="button" onclick="resetHvFilters()" class="text-xs text-outline hover:text-primary font-medium flex items-center gap-1.5 px-3 py-2 rounded-xl border border-border-standard hover:bg-surface-container-low transition-colors cursor-pointer shrink-0" title="Đặt lại bộ lọc">
            <span class="material-symbols-outlined text-[16px]">restart_alt</span>
            <span>Đặt lại</span>
        </button>
    </div>

    <!-- Table Section -->
    <div class="bg-surface-white rounded-2xl border border-border-standard shadow-sm overflow-hidden card-pro">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[960px]" id="hvTable">
                <thead>
                    <tr class="bg-surface-container-low/80 border-b border-border-standard font-label-sm text-[11px] text-outline font-bold tracking-wider uppercase">
                        <th class="py-3.5 px-4 w-12 text-center">#</th>
                        <th class="py-3.5 px-4">Mã HV</th>
                        <th class="py-3.5 px-4">Họ và Tên</th>
                        <th class="py-3.5 px-4">Liên hệ</th>
                        <th class="py-3.5 px-4">Ngày sinh / Giới tính</th>
                        <th class="py-3.5 px-4">Trình độ & Nghề nghiệp</th>
                        <th class="py-3.5 px-4 text-center">Trạng thái</th>
                        <th class="py-3.5 px-4 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle text-xs text-brand-deep" id="hvTableBody">
                    @if (Model.DanhSachHocVien == null || !Model.DanhSachHocVien.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-12 text-outline">
                                <span class="material-symbols-outlined text-4xl block mb-2 text-outline/50">person_off</span>
                                <span class="font-semibold">Chưa có hồ sơ học viên nào.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int idx = (currentPage - 1) * pageSize + 1;
                        foreach (var item in Model.DanhSachHocVien)
                        {
                            string initialLetter = string.IsNullOrWhiteSpace(item.HoTen) ? "H" : item.HoTen.Trim().Substring(item.HoTen.Trim().LastIndexOf(' ') + 1).Substring(0, 1).ToUpper();
                            string statusText = item.TrangThai ? "Đang học" : "Tạm khóa";

                            <tr class="hv-row hover:bg-canvas-base/60 transition-colors" data-id="@item.MaHocVien" data-mahv="HV@(item.MaHocVien.ToString("D3"))" data-name="@item.HoTen" data-email="@item.Email" data-phone="@item.SoDienThoai" data-birth="@(item.NgaySinh?.ToString("dd/MM/yyyy") ?? "")" data-gender="@(item.GioiTinh ?? "Nam")" data-address="@(item.DiaChi ?? "")" data-level="@(item.TrinhDoHocVan ?? "Đại học")" data-job="@(item.NgheNghiep ?? "")" data-status="@statusText">
                                <td class="py-3.5 px-4 text-center text-outline font-mono text-[11px]">@(idx++)</td>
                                <td class="py-3.5 px-4 font-mono font-semibold text-primary">#HV@(item.MaHocVien.ToString("D3"))</td>
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center text-xs shrink-0">@initialLetter</div>
                                        <div>
                                            <a href="javascript:void(0)" onclick="openStudentDetails(@item.MaHocVien)" class="font-bold text-brand-deep hover:text-primary transition-colors">
                                                @item.HoTen
                                            </a>
                                            <span class="text-[11px] text-outline block">@(item.TaiKhoan != null ? $"Tài khoản: {item.TaiKhoan.TenDangNhap}" : "Chưa liên kết TK")</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 font-mono">
                                    <span class="text-brand-deep block">@item.Email</span>
                                    <span class="text-outline text-[11px]">@(item.SoDienThoai ?? "Chưa có SĐT")</span>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="font-mono text-brand-deep block">@(item.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</span>
                                    <span class="text-outline text-[11px]">@(item.GioiTinh ?? "Khác")</span>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="font-semibold text-brand-deep block">@(item.TrinhDoHocVan ?? "Đại học")</span>
                                    <span class="text-outline text-[11px]">@(string.IsNullOrWhiteSpace(item.NgheNghiep) ? "Sinh viên" : item.NgheNghiep)</span>
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    @if (item.TrangThai)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-success-emerald/10 text-success-emerald font-semibold text-[11px]">
                                            <span class="h-1.5 w-1.5 rounded-full bg-success-emerald"></span>Đang học
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-rose-50 text-danger-crimson font-semibold text-[11px]">
                                            <span class="h-1.5 w-1.5 rounded-full bg-danger-crimson"></span>Tạm khóa
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <button onclick="openStudentDetails(@item.MaHocVien)" class="p-1.5 rounded-lg text-outline hover:text-primary hover:bg-surface-container-low cursor-pointer" title="Xem chi tiết">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </button>
                                        <button onclick="openEditDrawerFromHv(this, @item.MaHocVien)" class="p-1.5 rounded-lg text-outline hover:text-brand-deep hover:bg-surface-container-low cursor-pointer" title="Sửa hồ sơ">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </button>
                                        <button onclick="toggleStatusHv(this, @item.MaHocVien)" class="p-1.5 rounded-lg text-outline hover:text-amber-600 hover:bg-amber-50 cursor-pointer" title="Đổi trạng thái">
                                            <span class="material-symbols-outlined text-[18px]">sync</span>
                                        </button>
                                        <button onclick="confirmDeleteHv(@item.MaHocVien, '@(item.HoTen?.Replace("'", "\\'") ?? "")')" class="p-1.5 rounded-lg text-outline hover:text-danger-crimson hover:bg-red-50 cursor-pointer" title="Xóa">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Clean Reusable Pagination Component -->
        @await Html.PartialAsync("_Pagination", new QuanLyKhoaHoc_UNETI4_DHTI17A1HN.ViewModels.PaginationModel {
            CurrentPage = currentPage,
            TotalPages = totalPages,
            TotalItems = totalItems,
            PageSize = pageSize,
            ItemLabel = "học viên",
            BaseUrl = "/HocVien/Index",
            AjaxFunction = "loadHocVienPage",
            RouteParams = new Dictionary<string, string?> {
                { "search", search },
                { "trangThai", selectedTrangThai },
                { "trinhDo", selectedTrinhDo },
                { "sortBy", sortBy }
            }
        })
    </div>
</div>

<!-- ================= RIGHT SLIDE-OVER DRAWER (CREATE / EDIT STUDENT) ================= -->
<div id="drawer-backdrop" onclick="closeDrawer()" class="fixed inset-0 bg-brand-deep/40 backdrop-blur-xs z-50 transition-opacity duration-300 opacity-0 pointer-events-none"></div>

<aside id="drawer" class="fixed top-0 right-0 h-full w-full max-w-lg bg-surface-white border-l border-border-standard shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
    <div class="p-6 border-b border-border-standard flex items-center justify-between bg-surface-container-lowest">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[22px]">person_add</span>
            </div>
            <div>
                <h2 class="font-bold text-base text-brand-deep" id="drawer-title">Thêm Học Viên Mới</h2>
                <p class="text-xs text-outline">Nhập thông tin hồ sơ học viên</p>
            </div>
        </div>
        <button onclick="closeDrawer()" class="p-2 rounded-xl hover:bg-surface-container-high text-outline hover:text-brand-deep cursor-pointer">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
    </div>

    <form id="drawer-form" onsubmit="handleDrawerSubmit(event)" class="flex-1 overflow-y-auto p-6 space-y-4 text-xs">
        <input type="hidden" id="drawer-mahv" value="0">

        <div>
            <label class="block font-bold text-brand-deep uppercase mb-1">Họ và tên <span class="text-rose-500">*</span></label>
            <input type="text" id="drawer-name" required maxlength="100" placeholder="Nguyễn Văn A" class="w-full px-3.5 py-2.5 rounded-xl border border-border-standard bg-surface-white focus:outline-none focus:border-primary text-brand-deep">
        </div>

        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="block font-bold text-brand-deep uppercase mb-1">Số điện thoại <span class="text-rose-500">*</span></label>
                <input type="tel" id="drawer-phone" required maxlength="10" pattern="0[0-9]{9}" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" placeholder="0912345678" class="w-full px-3.5 py-2.5 rounded-xl border border-border-standard bg-surface-white font-mono focus:outline-none focus:border-primary text-brand-deep">
            </div>
            <div>
                <label class="block font-bold text-brand-deep uppercase mb-1">Email <span class="text-rose-500">*</span></label>
                <input type="email" id="drawer-email" required placeholder="student@gmail.com" class="w-full px-3.5 py-2.5 rounded-xl border border-border-standard bg-surface-white focus:outline-none focus:border-primary text-brand-deep">
            </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="block font-bold text-brand-deep uppercase mb-1">Ngày sinh <span class="text-rose-500">*</span></label>
                <input type="date" id="drawer-birth" required value="2003-05-15" class="w-full px-3.5 py-2.5 rounded-xl border border-border-standard bg-surface-white font-mono focus:outline-none focus:border-primary text-brand-deep">
            </div>
            <div>
                <label class="block font-bold text-brand-deep uppercase mb-1">Giới tính</label>
                <div class="relative">
                    <select id="drawer-gender" class="w-full px-3.5 py-2.5 pr-8 rounded-xl border border-border-standard bg-surface-white focus:outline-none focus:border-primary text-brand-deep cursor-pointer transition-all">
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[18px]">expand_more</span>
                </div>
            </div>
        </div>

        <div>
            <label class="block font-bold text-brand-deep uppercase mb-1">Địa chỉ thường trú</label>
            <input type="text" id="drawer-address" placeholder="Hà Nội" class="w-full px-3.5 py-2.5 rounded-xl border border-border-standard bg-surface-white focus:outline-none focus:border-primary text-brand-deep">
        </div>

        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="block font-bold text-brand-deep uppercase mb-1">Trình độ học vấn</label>
                <div class="relative">
                    <select id="drawer-level" class="w-full px-3.5 py-2.5 pr-8 rounded-xl border border-border-standard bg-surface-white focus:outline-none focus:border-primary text-brand-deep cursor-pointer transition-all">
                        <option value="Đại học">Đại học</option>
                        <option value="Kỹ sư">Kỹ sư</option>
                        <option value="Thạc sĩ">Thạc sĩ</option>
                        <option value="Cao đẳng">Cao đẳng</option>
                        <option value="Trung cấp">Trung cấp</option>
                        <option value="THPT">THPT</option>
                        <option value="Sau đại học">Sau đại học</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[18px]">expand_more</span>
                </div>
            </div>
            <div>
                <label class="block font-bold text-brand-deep uppercase mb-1">Nghề nghiệp</label>
                <input type="text" id="drawer-job" placeholder="Sinh viên CNTT UNETI" class="w-full px-3.5 py-2.5 rounded-xl border border-border-standard bg-surface-white focus:outline-none focus:border-primary text-brand-deep">
            </div>
        </div>

        <div>
            <label class="block font-bold text-brand-deep uppercase mb-1">Trạng thái hồ sơ</label>
            <div class="relative">
                <select id="drawer-status" class="w-full px-3.5 py-2.5 pr-8 rounded-xl border border-border-standard bg-surface-white focus:outline-none focus:border-primary text-brand-deep cursor-pointer transition-all">
                    <option value="true">Đang học (Hoạt động)</option>
                    <option value="false">Tạm khóa / Bảo lưu</option>
                </select>
                <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[18px]">expand_more</span>
            </div>
        </div>

        <div class="pt-4 border-t border-border-standard flex items-center justify-end gap-3">
            <button type="button" onclick="closeDrawer()" class="px-4 py-2.5 font-semibold rounded-xl border border-border-standard text-outline hover:text-brand-deep cursor-pointer">Hủy bỏ</button>
            <button type="submit" class="px-5 py-2.5 font-semibold rounded-xl bg-primary text-surface-white hover:bg-[#0047b3] shadow-md shadow-primary/20 flex items-center gap-1.5 cursor-pointer">
                <span class="material-symbols-outlined text-[16px]">save</span>
                <span>Lưu hồ sơ</span>
            </button>
        </div>
    </form>
</aside>

<!-- ================= STUDENT DETAILS MODAL ================= -->
<div id="studentDetailsModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-brand-deep/50 backdrop-blur-xs hidden transition-all duration-300">
    <div class="bg-surface-white max-w-xl w-full rounded-3xl shadow-2xl border border-border-subtle p-6 space-y-4 animate-scale-up" onclick="event.stopPropagation()">
        <div class="flex items-center justify-between pb-3 border-b border-border-standard">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary flex items-center justify-center font-bold text-sm">
                    HV
                </div>
                <div>
                    <h3 class="font-bold text-base text-brand-deep" id="detailHvName">Hồ Sơ Học Viên</h3>
                    <p class="text-xs text-outline" id="detailHvSub">Mã học viên: #HV001</p>
                </div>
            </div>
            <button onclick="closeStudentDetails()" class="p-1.5 rounded-xl hover:bg-surface-container-low text-outline cursor-pointer">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <div class="grid grid-cols-2 gap-3 bg-canvas-base/80 p-4 rounded-2xl border border-border-subtle text-xs">
            <div>
                <span class="text-outline block mb-0.5">Họ và tên:</span>
                <strong class="text-brand-deep text-sm" id="detailHvFullName">-</strong>
            </div>
            <div>
                <span class="text-outline block mb-0.5">Số điện thoại:</span>
                <span class="font-mono text-brand-deep font-semibold" id="detailHvPhone">-</span>
            </div>
            <div>
                <span class="text-outline block mb-0.5">Email liên hệ:</span>
                <span class="font-mono text-brand-deep font-semibold" id="detailHvEmail">-</span>
            </div>
            <div>
                <span class="text-outline block mb-0.5">Địa chỉ:</span>
                <span class="text-brand-deep font-semibold" id="detailHvAddress">-</span>
            </div>
            <div>
                <span class="text-outline block mb-0.5">Ngày sinh / Giới tính:</span>
                <span class="font-mono text-brand-deep font-semibold" id="detailHvBirthGender">-</span>
            </div>
            <div>
                <span class="text-outline block mb-0.5">Trình độ & Nghề nghiệp:</span>
                <span class="text-brand-deep font-semibold" id="detailHvLevelJob">-</span>
            </div>
            <div>
                <span class="text-outline block mb-0.5">Tài khoản liên kết:</span>
                <span class="font-mono text-primary font-bold" id="detailHvUser">-</span>
            </div>
            <div>
                <span class="text-outline block mb-0.5">Trạng thái:</span>
                <span class="px-2 py-0.5 rounded-full font-semibold" id="detailHvStatus">-</span>
            </div>
        </div>

        <div class="pt-2 flex justify-end">
            <button onclick="closeStudentDetails()" class="px-4 py-2 rounded-xl bg-surface-container-low text-brand-deep hover:bg-surface-container font-semibold text-xs cursor-pointer">
                Đóng
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const drawerBackdrop = document.getElementById('drawer-backdrop');
    const drawer = document.getElementById('drawer');

    function openDrawer(mode) {
        drawerBackdrop.classList.remove('opacity-0', 'pointer-events-none');
        drawerBackdrop.classList.add('opacity-100');
        drawer.classList.remove('translate-x-full');
        document.getElementById('drawer-mahv').value = '0';
        document.getElementById('drawer-title').innerText = 'Thêm Học Viên Mới';
        document.getElementById('drawer-name').value = '';
        document.getElementById('drawer-phone').value = '';
        document.getElementById('drawer-email').value = '';
        document.getElementById('drawer-birth').value = '2003-05-15';
        document.getElementById('drawer-gender').value = 'Nam';
        document.getElementById('drawer-address').value = '';
        document.getElementById('drawer-level').value = 'Đại học';
        document.getElementById('drawer-job').value = '';
        document.getElementById('drawer-status').value = 'true';
    }

    function closeDrawer() {
        drawerBackdrop.classList.remove('opacity-100');
        drawerBackdrop.classList.add('opacity-0', 'pointer-events-none');
        drawer.classList.add('translate-x-full');
    }

    function openEditDrawerFromHv(btn, id) {
        document.getElementById('drawer-title').innerText = 'Chỉnh sửa hồ sơ học viên';
        document.getElementById('drawer-mahv').value = id;

        fetch(`/HocVien/GetHocVienJson?id=${id}`)
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    const data = res.data;
                    document.getElementById('drawer-name').value = data.hoTen;
                    document.getElementById('drawer-phone').value = data.soDienThoai;
                    document.getElementById('drawer-email').value = data.email;
                    document.getElementById('drawer-birth').value = data.ngaySinh;
                    document.getElementById('drawer-gender').value = data.gioiTinh;
                    document.getElementById('drawer-address').value = data.diaChi;
                    document.getElementById('drawer-level').value = data.trinhDoHocVan;
                    document.getElementById('drawer-job').value = data.ngheNghiep;
                    document.getElementById('drawer-status').value = data.trangThai ? 'true' : 'false';

                    drawerBackdrop.classList.remove('opacity-0', 'pointer-events-none');
                    drawerBackdrop.classList.add('opacity-100');
                    drawer.classList.remove('translate-x-full');
                } else {
                    showToast(res.message, 'error');
                }
            })
            .catch(() => showToast('Không thể tải thông tin học viên.', 'error'));
    }

    function handleDrawerSubmit(e) {
        e.preventDefault();
        const id = parseInt(document.getElementById('drawer-mahv').value);
        const name = document.getElementById('drawer-name').value.trim();
        const phone = document.getElementById('drawer-phone').value.trim();
        const email = document.getElementById('drawer-email').value.trim();

        if (!name || name.length < 2) {
            showToast('Vui lòng nhập họ và tên học viên hợp lệ (từ 2 đến 100 ký tự)!', 'error');
            document.getElementById('drawer-name').focus();
            return;
        }

        if (!/^0\d{9}$/.test(phone)) {
            showToast('Số điện thoại phải gồm đúng 10 chữ số (bắt đầu bằng số 0, ví dụ: 0912345678)!', 'error');
            document.getElementById('drawer-phone').focus();
            return;
        }
        const birth = document.getElementById('drawer-birth').value;
        const gender = document.getElementById('drawer-gender').value;
        const address = document.getElementById('drawer-address').value.trim();
        const level = document.getElementById('drawer-level').value;
        const job = document.getElementById('drawer-job').value.trim();
        const status = document.getElementById('drawer-status').value === 'true';

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        const formData = new FormData();
        formData.append('__RequestVerificationToken', token);
        formData.append('HoTen', name);
        formData.append('SoDienThoai', phone);
        formData.append('Email', email);
        formData.append('NgaySinh', birth);
        formData.append('GioiTinh', gender);
        formData.append('DiaChi', address);
        formData.append('TrinhDoHocVan', level);
        formData.append('NgheNghiep', job);
        formData.append('TrangThai', status);

        let url = '/HocVien/CreatePost';
        if (id > 0) {
            url = `/HocVien/EditPost?id=${id}`;
            formData.append('MaHocVien', id);
        }

        fetch(url, {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                showToast(res.message, 'success');
                closeDrawer();
                setTimeout(() => location.reload(), 800);
            } else {
                showToast(res.message, 'error');
            }
        })
        .catch(() => showToast('Đã có lỗi xảy ra khi lưu hồ sơ.', 'error'));
    }

    function openStudentDetails(id) {
        fetch(`/HocVien/GetHocVienJson?id=${id}`)
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    const data = res.data;
                    document.getElementById('detailHvName').innerText = data.hoTen;
                    document.getElementById('detailHvSub').innerText = `Mã học viên: #HV${String(data.maHocVien).padStart(3, '0')}`;
                    document.getElementById('detailHvFullName').innerText = data.hoTen;
                    document.getElementById('detailHvPhone').innerText = data.soDienThoai || 'Chưa cập nhật';
                    document.getElementById('detailHvEmail').innerText = data.email;
                    document.getElementById('detailHvAddress').innerText = data.diaChi || 'Chưa cập nhật';
                    document.getElementById('detailHvBirthGender').innerText = `${data.ngaySinh || 'N/A'} (${data.gioiTinh})`;
                    document.getElementById('detailHvLevelJob').innerText = `${data.trinhDoHocVan} • ${data.ngheNghiep || 'Sinh viên'}`;
                    document.getElementById('detailHvUser').innerText = data.tenDangNhap ? `@@${data.tenDangNhap}` : 'Chưa có tài khoản';

                    const statusBadge = document.getElementById('detailHvStatus');
                    if (data.trangThai) {
                        statusBadge.className = 'px-2 py-0.5 rounded-full bg-success-emerald/10 text-success-emerald font-semibold';
                        statusBadge.innerText = 'Đang học';
                    } else {
                        statusBadge.className = 'px-2 py-0.5 rounded-full bg-rose-50 text-danger-crimson font-semibold';
                        statusBadge.innerText = 'Tạm khóa';
                    }

                    document.getElementById('studentDetailsModal').classList.remove('hidden');
                } else {
                    showToast(res.message, 'error');
                }
            })
            .catch(() => showToast('Không thể tải chi tiết học viên.', 'error'));
    }

    function closeStudentDetails() {
        document.getElementById('studentDetailsModal').classList.add('hidden');
    }

    function toggleStatusHv(btn, id) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const formData = new FormData();
        formData.append('__RequestVerificationToken', token);
        formData.append('id', id);

        fetch('/HocVien/ToggleTrangThai', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                showToast(res.message || 'Cập nhật trạng thái thành công!', 'success');
                setTimeout(() => location.reload(), 600);
            } else {
                showToast(res.message, 'error');
            }
        })
        .catch(() => showToast('Không thể đổi trạng thái học viên.', 'error'));
    }

    function confirmDeleteHv(id, name) {
        openGlobalDeleteModal({
            title: 'Xóa hồ sơ học viên?',
            itemName: name,
            message: `Bạn có chắc chắn muốn xóa hồ sơ học viên <strong class="text-brand-deep">${name}</strong>?`,
            warning: 'Thao tác này sẽ xóa hồ sơ và các đăng ký học liên quan nếu có.',
            submitText: 'Xóa học viên',
            onConfirm: function() {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const formData = new FormData();
                formData.append('__RequestVerificationToken', token);
                formData.append('id', id);

                fetch('/HocVien/DeleteAjax', {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => res.json())
                .then(res => {
                    if (res.success) {
                        showToast(res.message, 'success');
                        setTimeout(() => location.reload(), 600);
                    } else {
                        showToast(res.message, 'error');
                    }
                })
                .catch(() => showToast('Không thể xóa học viên.', 'error'));
            }
        });
    }

    let hvDebounceTimer = null;
    function debounceHvFilter() {
        clearTimeout(hvDebounceTimer);
        hvDebounceTimer = setTimeout(() => filterHvTable(), 320);
    }

    function filterHvTable() {
        const search = document.getElementById('hvSearchInput')?.value.trim() || '';
        const trangThai = document.getElementById('filterHvStatus')?.value || '';
        const trinhDo = document.getElementById('filterHvLevel')?.value || '';
        const sortBy = document.getElementById('filterHvSortBy')?.value || '';

        const params = new URLSearchParams();
        if (search) params.set('search', search);
        if (trangThai) params.set('trangThai', trangThai);
        if (trinhDo) params.set('trinhDo', trinhDo);
        if (sortBy) params.set('sortBy', sortBy);
        params.set('page', '1');

        loadHocVienPage(`/HocVien/Index?${params.toString()}`);
    }

    function resetHvFilters() {
        if (document.getElementById('hvSearchInput')) document.getElementById('hvSearchInput').value = '';
        if (document.getElementById('filterHvStatus')) document.getElementById('filterHvStatus').value = '';
        if (document.getElementById('filterHvLevel')) document.getElementById('filterHvLevel').value = '';
        if (document.getElementById('filterHvSortBy')) document.getElementById('filterHvSortBy').value = '';
        loadHocVienPage('/HocVien/Index');
    }

    async function loadHocVienPage(url, pushState = true) {
        const area = document.getElementById('hocvien-content-area');
        if (area) area.classList.add('opacity-50', 'pointer-events-none');
        try {
            const res = await fetch(url);
            const html = await res.text();
            const doc = new DOMParser().parseFromString(html, 'text/html');
            const newContent = doc.getElementById('hocvien-content-area');
            if (newContent && area) {
                area.innerHTML = newContent.innerHTML;
            }
            if (pushState) window.history.pushState({ url }, '', url);
        } catch (err) {
            window.location.href = url;
        } finally {
            if (area) area.classList.remove('opacity-50', 'pointer-events-none');
        }
    }

    window.addEventListener('popstate', (e) => {
        if (e.state && e.state.url) loadHocVienPage(e.state.url, false);
    });

    function exportTableToCSV(filename) {
        const rows = document.querySelectorAll('#hvTable tr');
        let csv = [];
        rows.forEach(row => {
            if (row.style.display === 'none') return;
            const cols = row.querySelectorAll('th, td');
            let rowData = [];
            cols.forEach((col, idx) => {
                if (idx === cols.length - 1) return; // skip actions col
                let text = col.innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/\s+/g, ' ').trim();
                rowData.push('"' + text.replace(/"/g, '""') + '"');
            });
            csv.push(rowData.join(','));
        });

        const csvFile = new Blob(["\uFEFF" + csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
        const downloadLink = document.createElement('a');
        downloadLink.download = filename;
        downloadLink.href = window.URL.createObjectURL(csvFile);
        downloadLink.style.display = 'none';
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
    }

    // Tự động mở drawer nếu URL có ?create=true
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('create') === 'true' || urlParams.get('action') === 'create') {
        openDrawer('create');
        const cleanUrl = window.location.pathname + window.location.search.replace(/[?&]create=true/, '').replace(/[?&]action=create/, '');
        window.history.replaceState({}, document.title, cleanUrl || window.location.pathname);
    }
</script>
}