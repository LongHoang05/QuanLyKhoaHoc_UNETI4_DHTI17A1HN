@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.HocVien
@{
    ViewData["Title"] = $"Chỉnh Sửa Học Viên - {Model.HoTen}";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header & Breadcrumb -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Quản lý học viên</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa #@Model.MaHocVien</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold text-primary mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Thông Tin Học Viên
                    </h2>
                    <p class="text-muted small mb-0">Cập nhật hồ sơ học viên mã số <strong>#@Model.MaHocVien</strong> qua Repository</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@Model.MaHocVien" class="btn btn-outline-info">
                        <i class="bi bi-eye me-1"></i> Xem chi tiết
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.MaHocVien" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaHocVien" />
                        <input type="hidden" asp-for="MaTaiKhoan" />
                        <input type="hidden" asp-for="NgayTao" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        @if (Model.TaiKhoan != null && !string.IsNullOrEmpty(Model.TaiKhoan.TenDangNhap))
                        {
                            <div class="alert alert-info py-2 d-flex align-items-center mb-4">
                                <i class="bi bi-info-circle-fill fs-5 me-2"></i>
                                <div>
                                    Học viên này đang liên kết với tài khoản: <strong>@Model.TaiKhoan.TenDangNhap</strong> (Mã TK: #@Model.MaTaiKhoan)
                                </div>
                            </div>
                        }

                        <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">
                            <i class="bi bi-info-circle me-1"></i> Thông Tin Cơ Bản
                        </h5>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="HoTen" class="form-label fw-semibold">
                                    Họ và tên <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input asp-for="HoTen" class="form-control" />
                                </div>
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold">
                                    Địa chỉ Email <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="SoDienThoai" class="form-label fw-semibold">Số điện thoại</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="SoDienThoai" class="form-control" />
                                </div>
                                <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NgaySinh" class="form-label fw-semibold">
                                    Ngày sinh <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                                    <input asp-for="NgaySinh" class="form-control" type="date" required />
                                </div>
                                <span asp-validation-for="NgaySinh" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="GioiTinh" class="form-label fw-semibold">Giới tính</label>
                                <select asp-for="GioiTinh" class="form-select">
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                                <span asp-validation-for="GioiTinh" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TrinhDoHocVan" class="form-label fw-semibold">Trình độ học vấn</label>
                                <select asp-for="TrinhDoHocVan" class="form-select">
                                    <option value="THPT">THPT</option>
                                    <option value="Trung cấp">Trung cấp</option>
                                    <option value="Cao đẳng">Cao đẳng</option>
                                    <option value="Đại học">Đại học</option>
                                    <option value="Sau đại học">Sau đại học</option>
                                    <option value="Đi làm">Đang đi làm</option>
                                </select>
                                <span asp-validation-for="TrinhDoHocVan" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="fw-bold text-secondary mb-3 mt-4 border-bottom pb-2">
                            <i class="bi bi-geo-alt me-1"></i> Thông Tin Bổ Sung
                        </h5>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="NgheNghiep" class="form-label fw-semibold">Nghề nghiệp</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-briefcase"></i></span>
                                    <input asp-for="NgheNghiep" class="form-control" />
                                </div>
                                <span asp-validation-for="NgheNghiep" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DiaChi" class="form-label fw-semibold">Địa chỉ liên hệ</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-house"></i></span>
                                    <input asp-for="DiaChi" class="form-control" />
                                </div>
                                <span asp-validation-for="DiaChi" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="TrangThai" class="form-check-input" type="checkbox" id="trangThaiSwitchEdit" />
                            <label class="form-check-label fw-semibold" for="trangThaiSwitchEdit">
                                Trạng thái hoạt động (Bật = Đang hoạt động, Tắt = Đã khóa / Tạm dừng)
                            </label>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-save-fill me-1"></i> Cập Nhật Thông Tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
