@model QuanLyKhoaHoc_UNETI4_DHTI17A1HN.ViewModels.CongHocVienViewModel
@{
    ViewData["Title"] = "Cổng Thông Tin Học Viên - UNETI EDU";
    var hv = Model.HocVien;
    var initialLetter = string.IsNullOrEmpty(hv.HoTen) ? "H" : hv.HoTen.Trim().Substring(hv.HoTen.Trim().LastIndexOf(' ') + 1).Substring(0, 1).ToUpper();
}

<!-- 1. LUXURY HERO BANNER HỌC VIÊN CHUẨN hoc-vien.html -->
<div class="page-hero" style="background: linear-gradient(135deg, #071d36 0%, #0b3966 45%, #051426 100%);">
    <div class="row align-items-center position-relative" style="z-index: 2;">
        <div class="col-lg-7 mb-4 mb-lg-0">
            <div class="hero-badge mb-2">
                <i class="bi bi-stars text-warning"></i> Cổng Đào Tạo Trực Tuyến UNETI • Phục Vụ Học Viên Chuẩn Mục 17.1 & 25.1
            </div>
            <h1 class="hero-title">Chào bạn, @hv.HoTen ✨</h1>
            <p class="hero-subtitle mb-3">
                Khám phá các khóa học thực chiến công nghệ, đăng ký lớp học linh hoạt, theo dõi thời khóa biểu và quản lý học phí trực tiếp từ Trung tâm Đào tạo UNETI.
            </p>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="badge rounded-pill px-3 py-2" style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);">
                    <i class="bi bi-shield-check me-1 text-success"></i> Mã HV: HV-@hv.MaHocVien.ToString("D4")
                </span>
                <span class="badge rounded-pill px-3 py-2" style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);">
                    <i class="bi bi-mortarboard me-1 text-warning"></i> Khóa K17 - Khoa CNTT
                </span>
                <span class="badge rounded-pill px-3 py-2" style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);">
                    <i class="bi bi-envelope me-1 text-info"></i> @hv.Email
                </span>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="d-flex justify-content-lg-end justify-content-center gap-2 gap-sm-3">
                <div class="mini-stat-card text-center p-3" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2); color: #fff;">
                    <div style="font-size: 0.72rem; color: #bae6fd; text-transform: uppercase;">Lớp Đang Học</div>
                    <div class="mini-stat-num text-white my-1">@Model.DanhSachDangKy.Count(d => d.TrangThai == "Đang học" || d.TrangThai == "Đã duyệt" || d.TrangThai == "Đã đóng học phí")</div>
                    <div class="small" style="font-size: 0.7rem; color: #7dd3fc;">Tích lũy kiến thức</div>
                </div>

                <div class="mini-stat-card text-center p-3" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2); color: #fff;">
                    <div style="font-size: 0.72rem; color: #bae6fd; text-transform: uppercase;">Đơn Đã Gửi</div>
                    <div class="mini-stat-num text-white my-1">@Model.DanhSachDangKy.Count</div>
                    <div class="small" style="font-size: 0.7rem; color: #7dd3fc;">Tổng đơn đăng ký</div>
                </div>

                <div class="mini-stat-card text-center p-3" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2); color: #fff;">
                    <div style="font-size: 0.72rem; color: #bae6fd; text-transform: uppercase;">Học Phí Đã Đóng</div>
                    <div class="mini-stat-num text-white my-1" style="font-size: 1.25rem;">@(Model.DanhSachDangKy.Sum(d => d.SoTienDaDong).ToString("N0"))đ</div>
                    <div class="small" style="font-size: 0.7rem; color: #7dd3fc;">Ghi nhận hệ thống</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. FLOATING SEGMENTED TABS (Mục 17.1 & 25.1) -->
<ul class="nav nav-pills mb-4 p-2 bg-white rounded-4 border shadow-sm" id="portalTab" role="tablist">
    <li class="nav-item me-2" role="presentation">
        <button class="nav-link active rounded-pill fw-semibold px-4" id="classes-tab" data-bs-toggle="pill" data-bs-target="#tab-classes" type="button" role="tab">
            <i class="bi bi-grid-fill me-1"></i> Khóa học đang mở đăng ký (@Model.LopHocDangMos.Count)
        </button>
    </li>
    <li class="nav-item me-2" role="presentation">
        <button class="nav-link rounded-pill fw-semibold px-4" id="myreg-tab" data-bs-toggle="pill" data-bs-target="#tab-myreg" type="button" role="tab">
            <i class="bi bi-clipboard2-check-fill me-1"></i> Đơn đăng ký & Học phí (@Model.DanhSachDangKy.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill fw-semibold px-4" id="profile-tab" data-bs-toggle="pill" data-bs-target="#tab-profile" type="button" role="tab">
            <i class="bi bi-person-vcard-fill me-1"></i> Thẻ sinh viên & Hồ sơ
        </button>
    </li>
</ul>

<!-- 3. TAB CONTENT PANELS -->
<div class="tab-content" id="portalTabContent">

    <!-- ==================== TAB 1: KHÓA HỌC ĐANG MỞ ==================== -->
    <div class="tab-pane fade show active" id="tab-classes" role="tabpanel">
        <div class="row g-4">
            @if (!Model.LopHocDangMos.Any())
            {
                <div class="col-12">
                    <div class="content-card text-center py-5">
                        <i class="bi bi-calendar-x fs-1 text-muted d-block mb-2"></i>
                        <h5 class="text-muted">Hiện tại chưa có lớp học nào đang mở đăng ký.</h5>
                    </div>
                </div>
            }
            else
            {
                foreach (var lop in Model.LopHocDangMos)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="content-card h-100 d-flex flex-direction-column justify-content-between p-4 position-relative">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge rounded-pill" style="background: var(--surface-container); color: var(--primary-rose); font-size: 0.75rem;">
                                        @(lop.ChuongTrinhDaoTao?.TenChuongTrinh ?? "Chương trình chung")
                                    </span>
                                    <span class="badge bg-success-subtle text-success border border-success rounded-pill px-2 py-1 small">
                                        <i class="bi bi-dot"></i>@lop.TrangThai
                                    </span>
                                </div>

                                <h5 class="fw-bold text-dark mb-2" style="font-family: var(--font-serif);">@lop.TenLop</h5>
                                <p class="text-muted small mb-3">@(lop.MoTa ?? "Khóa đào tạo chất lượng cao cung cấp kiến thức thực chiến chuẩn doanh nghiệp.")</p>

                                <div class="small text-muted mb-2">
                                    <div><i class="bi bi-person-video3 me-2 text-primary"></i>Giảng viên: <strong>@(lop.TenGiangVien ?? "ThS. Giảng viên Khoa CNTT")</strong></div>
                                    <div><i class="bi bi-calendar-event me-2 text-primary"></i>Khai giảng: <strong>@lop.NgayKhaiGiang.ToString("dd/MM/yyyy")</strong></div>
                                    <div><i class="bi bi-clock-history me-2 text-primary"></i>Số buổi: <strong>@lop.SoBuoiHoc buổi</strong> (Lab @(lop.PhongHoc ?? "402"))</div>
                                    <div><i class="bi bi-people me-2 text-primary"></i>Sĩ số: <strong>@lop.SiSoToiDa học viên</strong></div>
                                </div>
                            </div>

                            <div class="pt-3 border-top mt-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="small text-muted">Học phí:</div>
                                    <div class="fw-bold fs-5 text-primary" style="font-family: var(--font-serif);">@lop.HocPhi.ToString("N0") VNĐ</div>
                                </div>
                                <button type="button" class="btn btn-sm rounded-pill px-3 py-2 text-white fw-semibold" style="background: var(--primary-rose);" onclick="showToast('Bạn đã gửi đăng ký lớp: @lop.TenLop thành công! Đơn đang ở trạng thái Chờ duyệt.', 'success')">
                                    <i class="bi bi-pencil-square me-1"></i> Đăng Ký Học
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- ==================== TAB 2: ĐƠN ĐĂNG KÝ & HỌC PHÍ ==================== -->
    <div class="tab-pane fade" id="tab-myreg" role="tabpanel">
        <div class="content-card">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark" style="font-family: var(--font-serif);">
                    <i class="bi bi-clipboard2-check text-primary me-2"></i>Tiến Trình Đơn Đăng Ký & Trạng Thái Học Phí
                </h5>
                <span class="badge rounded-pill fw-bold" style="background: var(--surface-container); color: var(--primary-rose);">
                    @Model.DanhSachDangKy.Count Đơn Ghi Nhận
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Mã ĐK</th>
                            <th>Lớp Học & Chương Trình</th>
                            <th>Ngày Nộp Đơn</th>
                            <th>Học Phí Lớp</th>
                            <th>Đã Nộp (VNĐ)</th>
                            <th class="text-center">Trạng Thái Xử Lý</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.DanhSachDangKy.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                    Bạn chưa nộp đơn đăng ký lớp học nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var dk in Model.DanhSachDangKy)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">#@dk.MaDangKy</td>
                                    <td>
                                        <div class="fw-bold text-dark">@(dk.LopHoc?.TenLop ?? "N/A")</div>
                                        <div class="small text-muted">@(dk.LopHoc?.ChuongTrinhDaoTao?.TenChuongTrinh ?? "N/A")</div>
                                    </td>
                                    <td class="small">@dk.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-semibold">@((dk.LopHoc?.HocPhi ?? 0).ToString("N0")) đ</td>
                                    <td>
                                        <span class="fw-bold text-success">@dk.SoTienDaDong.ToString("N0") đ</span>
                                        @if (dk.NgayDongHocPhi.HasValue)
                                        {
                                            <div class="small text-muted">Ngày: @dk.NgayDongHocPhi.Value.ToString("dd/MM/yyyy")</div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @switch (dk.TrangThai)
                                        {
                                            case "Chờ duyệt":
                                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                                    <i class="bi bi-hourglass-split me-1"></i>Chờ duyệt
                                                </span>
                                                break;
                                            case "Đã duyệt":
                                                <span class="badge bg-info text-dark px-3 py-2 rounded-pill">
                                                    <i class="bi bi-check2-circle me-1"></i>Đã duyệt
                                                </span>
                                                break;
                                            case "Đang học":
                                            case "Đã đóng học phí":
                                                <span class="badge bg-success px-3 py-2 rounded-pill">
                                                    <i class="bi bi-check-circle-fill me-1"></i>@dk.TrangThai
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary px-3 py-2 rounded-pill">@dk.TrangThai</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 3: THẺ SINH VIÊN & HỒ SƠ ==================== -->
    <div class="tab-pane fade" id="tab-profile" role="tabpanel">
        <div class="row g-4">
            <!-- Thẻ Sinh Viên Điện Tử -->
            <div class="col-lg-5">
                <div class="student-id-card">
                    <div class="card-hologram">UNETI</div>
                    <div class="card-chip">CHIP</div>

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="avatar-circle" style="width: 56px; height: 56px; font-size: 1.4rem;">
                            @initialLetter
                        </div>
                        <div>
                            <div class="fw-bold fs-5 text-white">@hv.HoTen</div>
                            <div style="font-size: 0.75rem; color: #7dd3fc;">Mã HV: <strong>HV-@hv.MaHocVien.ToString("D4")</strong></div>
                        </div>
                    </div>

                    <div class="pt-2 border-top border-light border-opacity-25" style="font-size: 0.82rem;">
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-white-50">Email:</span>
                            <span class="fw-semibold text-truncate ms-2" style="max-width: 200px;">@hv.Email</span>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-white-50">Số điện thoại:</span>
                            <span class="fw-semibold">@(hv.SoDienThoai ?? "Chưa có")</span>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-white-50">Ngày sinh:</span>
                            <span class="fw-semibold">@(hv.NgaySinh.HasValue ? hv.NgaySinh.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</span>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-white-50">Trạng thái hồ sơ:</span>
                            <span class="badge bg-success rounded-pill">Kích hoạt</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Cập Nhật Hồ Sơ Học Viên -->
            <div class="col-lg-7">
                <div class="content-card p-4">
                    <h5 class="fw-bold mb-3 text-dark" style="font-family: var(--font-serif);">
                        <i class="bi bi-person-gear text-primary me-2"></i>Cập Nhật Thông Tin Cá Nhân
                    </h5>

                    <form asp-action="Edit" asp-route-id="@hv.MaHocVien" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MaHocVien" value="@hv.MaHocVien" />
                        <input type="hidden" name="MaTaiKhoan" value="@hv.MaTaiKhoan" />
                        <input type="hidden" name="NgayTao" value="@hv.NgayTao.ToString("yyyy-MM-ddTHH:mm:ss")" />
                        <input type="hidden" name="TrangThai" value="true" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small text-muted">Họ và tên</label>
                                <input type="text" name="HoTen" class="form-control form-control-sm" value="@hv.HoTen" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted">Email</label>
                                <input type="email" name="Email" class="form-control form-control-sm" value="@hv.Email" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted">Số điện thoại</label>
                                <input type="text" name="SoDienThoai" class="form-control form-control-sm" value="@hv.SoDienThoai" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted">Ngày sinh</label>
                                <input type="date" name="NgaySinh" class="form-control form-control-sm" value="@(hv.NgaySinh.HasValue ? hv.NgaySinh.Value.ToString("yyyy-MM-dd") : "")" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted">Địa chỉ thường trú</label>
                                <input type="text" name="DiaChi" class="form-control form-control-sm" value="@hv.DiaChi" />
                            </div>
                        </div>

                        <div class="text-end mt-4">
                            <button type="submit" class="btn btn-sm rounded-pill px-4 text-white fw-semibold" style="background: var(--primary-rose);">
                                <i class="bi bi-check2-circle me-1"></i> Lưu Thay Đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
