</div>

@section Scripts {
<script>
    const tabParamMap = {
        'dangky': 'courses',
        'courses': 'courses',
        'tkb': 'schedule',
        'schedule': 'schedule',
        'ketqua': 'grades',
        'grades': 'grades',
        'hoso': 'profile',
        'profile': 'profile'
    };

    const reverseTabParamMap = {
        'courses': 'dangky',
        'schedule': 'tkb',
        'grades': 'ketqua',
        'profile': 'hoso'
    };

    function switchTab(tab, updateHistory = true) {
        const normalized = tabParamMap[tab] || 'courses';
        const allTabs = ['courses', 'schedule', 'grades', 'profile'];

        allTabs.forEach(t => {
            const contentEl = document.getElementById(`tab-content-${t}`);
            const btnEl = document.getElementById(`tab-btn-${t}`);
            if (contentEl) contentEl.classList.add('hidden');
            if (btnEl) btnEl.className = 'py-3 px-4 text-xs sm:text-sm font-bold border-b-2 border-transparent text-outline hover:text-brand-deep flex items-center gap-2 transition-colors cursor-pointer whitespace-nowrap';
        });

        const activeContent = document.getElementById(`tab-content-${normalized}`);
        const activeBtn = document.getElementById(`tab-btn-${normalized}`);
        if (activeContent) activeContent.classList.remove('hidden');
        if (activeBtn) activeBtn.className = 'py-3 px-4 text-xs sm:text-sm font-bold border-b-2 border-primary text-primary flex items-center gap-2 transition-colors cursor-pointer whitespace-nowrap';

        if (updateHistory) {
            const url = new URL(window.location.href);
            url.searchParams.set('tab', reverseTabParamMap[normalized] || 'dangky');
            window.history.replaceState({}, '', url.toString());
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const urlTab = new URLSearchParams(window.location.search).get('tab');
        if (urlTab && tabParamMap[urlTab.toLowerCase()]) {
            switchTab(urlTab.toLowerCase(), false);
        }
    });

    function submitHoSo(e) {
        e.preventDefault();
        const form = document.getElementById('hosoForm');
        const formData = new FormData(form);

        fetch('/CongHocVien/CapNhatHoSoPost', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                if (window.showToast) window.showToast(res.message, 'success');
                setTimeout(() => window.location.reload(), 800);
            } else {
                if (window.showToast) window.showToast(res.message, 'error');
            }
        })
        .catch(() => {
            if (window.showToast) window.showToast('Có lỗi xảy ra khi cập nhật hồ sơ!', 'error');
        });
    }

    function confirmHuyDangKy(maDangKy, tenLop) {
        if (window.openGlobalDeleteModal) {
            window.openGlobalDeleteModal({
                title: 'Hủy đăng ký khóa học?',
                action: '/CongHocVien/HuyDangKyPost',
                id: maDangKy,
                paramName: 'maDangKy',
                itemName: `Khóa học "${tenLop}"`,
                message: `Bạn có chắc chắn muốn hủy đăng ký khóa học <strong class="text-brand-deep">${tenLop}</strong>?`,
                warning: 'Nếu lớp đã bắt đầu hoặc hết hạn đăng ký, bạn có thể không thể đăng ký lại.',
                submitText: 'Xác nhận hủy',
                onSuccess: function(res) {
                    if (window.showToast) window.showToast(res.message || 'Đã hủy đăng ký thành công!', 'success');
                    setTimeout(() => window.location.reload(), 1000);
                }
            });
            return;
        }

        if (confirm(`Bạn có chắc chắn muốn hủy đăng ký khóa học "${tenLop}" không?`)) {
            const formData = new FormData();
            formData.append('maDangKy', maDangKy);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

            fetch('/CongHocVien/HuyDangKyPost', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    if (window.showToast) window.showToast(res.message, 'success');
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    if (window.showToast) window.showToast(res.message, 'error');
                }
            })
            .catch(err => {
                console.error(err);
                if (window.showToast) window.showToast('Có lỗi xảy ra khi hủy đăng ký!', 'error');
            });
        }
    }

    // Modal Thanh Toán Học Phí (VietQR & Trực tiếp)
    function openPaymentModal(maDangKy, tenLop, hocPhiGoc, daDong) {
        const conLai = Math.max(0, Number(hocPhiGoc) - Number(daDong));
        const amountToPay = conLai > 0 ? conLai : Number(hocPhiGoc);
        const syntax = `UNETI DK${maDangKy}`;

        const inputHidden = document.getElementById('pay-modal-input-maDangKy');
        if (inputHidden) inputHidden.value = maDangKy;

        document.getElementById('pay-modal-maDK').innerText = `#DK${String(maDangKy).padStart(3, '0')}`;
        document.getElementById('pay-modal-tenLop').innerText = tenLop;
        document.getElementById('pay-modal-soTien').innerText = Number(amountToPay).toLocaleString('vi-VN') + ' đ';
        document.getElementById('pay-modal-syntax').innerText = syntax;

        // Ảnh QR chuyển khoản MB Bank
        const qrUrl = `https://img.vietqr.io/image/MB-0381000556688-compact2.png?amount=${amountToPay}&addInfo=${encodeURIComponent(syntax)}&accountName=TRUNG%20TAM%20DAO%20TAO%20UNETI`;
        document.getElementById('pay-modal-qr-img').src = qrUrl;

        const modal = document.getElementById('payment-modal');
        const content = document.getElementById('payment-modal-content');
        modal.classList.remove('opacity-0', 'pointer-events-none');
        content.classList.remove('scale-95');
        content.classList.add('scale-100');
    }

    function closePaymentModal() {
        const modal = document.getElementById('payment-modal');
        const content = document.getElementById('payment-modal-content');
        modal.classList.add('opacity-0', 'pointer-events-none');
        content.classList.add('scale-95');
        content.classList.remove('scale-100');
    }

    function copyPaymentText(text, successMsg) {
        navigator.clipboard.writeText(text).then(() => {
            if (window.showToast) window.showToast(successMsg, 'success');
            else alert(successMsg);
        }).catch(() => {
            if (window.showToast) window.showToast('Không thể sao chép tự động!', 'warning');
        });
    }

    // Drawer chi tiết bảng điểm môn học
    function openDetailDrawer(subjectName, subjectCode, credits, cc, tx, th, thi, tongKet, nhanXet, xepLoai) {
        document.getElementById('drawer-subject-name').innerText = subjectName || 'Môn học';
        document.getElementById('drawer-subject-code').innerText = subjectCode || 'HP';
        document.getElementById('drawer-credits-text').innerText = `${credits || 3} Tín chỉ`;
        document.getElementById('drawer-score-cc').innerText = cc || '--';
        document.getElementById('drawer-score-tx').innerText = tx || '--';
        document.getElementById('drawer-score-th').innerText = th || '--';
        document.getElementById('drawer-score-thi').innerText = thi || '--';
        document.getElementById('drawer-score-final').innerText = tongKet || '--';
        document.getElementById('drawer-evaluation').innerText = xepLoai || 'Đang cập nhật';
        document.getElementById('drawer-notes').innerText = nhanXet ? `"${nhanXet}"` : 'Đang cập nhật đánh giá quá trình học tập...';

        const backdrop = document.getElementById('grade-detail-drawer-backdrop');
        const drawer = document.getElementById('grade-detail-drawer');
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100');
        drawer.classList.remove('translate-x-full');
    }

    function closeDetailDrawer() {
        const backdrop = document.getElementById('grade-detail-drawer-backdrop');
        const drawer = document.getElementById('grade-detail-drawer');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        backdrop.classList.remove('opacity-100');
        drawer.classList.add('translate-x-full');
    }

    // Bộ lọc hàng bảng điểm
    function filterGradeRows(status, btn) {
        document.querySelectorAll('.grade-filter-btn').forEach(b => {
            b.className = 'grade-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer';
        });
        if (btn) btn.className = 'grade-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold bg-primary text-white shadow-xs cursor-pointer transition-all';

        const rows = document.querySelectorAll('.grade-row');
        rows.forEach(r => {
            if (status === 'all') {
                r.style.display = '';
            } else if (r.getAttribute('data-status') === status) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    // Tìm kiếm môn học
    function searchGradeSubjects(keyword) {
        const term = keyword.toLowerCase().trim();
        const rows = document.querySelectorAll('.grade-row');
        rows.forEach(r => {
            const nameEl = r.querySelector('.subject-name');
            const text = nameEl ? nameEl.innerText.toLowerCase() : '';
            if (!term || text.includes(term)) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }
</script>
}