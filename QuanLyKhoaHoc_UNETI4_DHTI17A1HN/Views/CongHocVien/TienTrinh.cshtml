        <!-- Giảng viên nhận xét -->
        <div>
            <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-amber-500 text-[16px]">rate_review</span>
                <span>Nhận xét của Giảng viên</span>
            </h4>
            <div class="p-3.5 rounded-xl bg-amber-50/70 border border-amber-200 text-xs text-amber-900 leading-relaxed italic" id="drawer-notes">
                Đang cập nhật đánh giá quá trình học tập...
