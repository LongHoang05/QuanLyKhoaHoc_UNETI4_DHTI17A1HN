    <!-- Drawer Footer -->
    <div class="p-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between gap-3 shrink-0">
        <button type="button" onclick="closeDetailDrawer()" class="w-full py-2.5 px-4 text-xs font-semibold text-slate-700 bg-white border border-slate-300 rounded-xl hover:bg-slate-100 transition-colors text-center cursor-pointer">
            Đóng
        </button>
