                        <span class="text-slate-500 text-[11px] block">Số tài khoản:</span>
                        <strong class="text-slate-800 font-mono text-xs font-bold" id="pay-modal-stk">0381000556688</strong>
                    </div>
                    <button type="button" onclick="copyPaymentText('0381000556688', 'Đã sao chép số tài khoản!')" class="text-blue-600 hover:text-blue-800 p-1 rounded hover:bg-blue-50 transition-colors" title="Sao chép">
                        <span class="material-symbols-outlined text-[16px]">content_copy</span>
                    </button>
                </div>
                <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200">
                    <span class="text-slate-500 text-[11px] block">Chủ tài khoản:</span>
                    <strong class="text-slate-800 font-semibold uppercase text-[11px]">TRUNG TAM DAO TAO UNETI</strong>
                </div>
                <div class="p-2.5 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-between">
                    <div>
                        <span class="text-amber-800 text-[11px] block font-medium">Nội dung CK:</span>
                        <strong class="text-amber-900 font-mono text-xs font-bold" id="pay-modal-syntax">UNETI DK000</strong>
                    </div>
                    <button type="button" onclick="copyPaymentText(document.getElementById('pay-modal-syntax').innerText, 'Đã sao chép nội dung chuyển khoản!')" class="text-amber-800 hover:text-amber-950 p-1 rounded hover:bg-amber-200/50 transition-colors" title="Sao chép">
                        <span class="material-symbols-outlined text-[16px]">content_copy</span>
                    </button>
                </div>
            </div>

            <!-- Nộp trực tiếp -->
            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-[11px] text-slate-600 flex items-start gap-2">
                <span class="material-symbols-outlined text-[18px] text-blue-600 shrink-0 mt-0.5">location_on</span>
                <div>
                    <strong class="text-slate-800 block">Hoặc nộp trực tiếp tại Văn phòng Tuyển sinh:</strong>
                    <span>Phòng 101, Nhà HA8, Số 218 Đường Lĩnh Nam, Hoàng Mai, Hà Nội (Giờ hành chính Thứ 2 - Thứ 7).</span>
                </div>
            </div>
        </div>

        <!-- Modal Footer (Luôn hiển thị không bị che) -->
        <form method="post" action="/CongHocVien/ThanhToanHocPhi" class="shrink-0 flex items-center justify-end gap-3 pt-3 border-t border-slate-200">
            @Html.AntiForgeryToken()
            <input type="hidden" name="maDangKy" id="pay-modal-input-maDangKy" value="" />
            <input type="hidden" name="ghiChu" value="Chuyển khoản VietQR" />
            <button type="button" onclick="closePaymentModal()" class="px-4 py-2.5 text-xs font-semibold text-slate-600 hover:text-slate-900 border border-slate-300 rounded-xl hover:bg-slate-100 transition-colors">
                Đóng
            </button>
            <button type="submit" class="px-5 py-2.5 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:scale-95 rounded-xl shadow-md hover:shadow-lg transition-all flex items-center gap-1.5 cursor-pointer">
                <span class="material-symbols-outlined text-[16px]">check_circle</span>
                <span>Tôi Đã Chuyển Khoản</span>
            </button>
        </form>
    </div>
</div>

<!-- ================= DETAIL DRAWER (BẢNG ĐIỂM CHI TIẾT) ================= -->
<div id="grade-detail-drawer-backdrop" class="fixed inset-0 z-50 transition-opacity duration-300 opacity-0 pointer-events-none" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(4px);" onclick="closeDetailDrawer()"></div>

<div id="grade-detail-drawer" class="fixed inset-y-0 right-0 max-w-md w-full bg-white shadow-2xl z-50 transform translate-x-full transition-transform duration-300 flex flex-col justify-between overflow-hidden border-l border-slate-200" style="background-color: #ffffff !important;">
    <!-- Drawer Header -->
    <div class="p-6 bg-slate-50 border-b border-slate-200 flex items-start justify-between shrink-0">
        <div>
            <div class="flex items-center gap-2 mb-1.5">
                <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-blue-100 text-blue-700" id="drawer-subject-code">IT4029.02</span>
                <span class="text-xs text-slate-500 font-medium" id="drawer-credits-text">3 Tín chỉ</span>
