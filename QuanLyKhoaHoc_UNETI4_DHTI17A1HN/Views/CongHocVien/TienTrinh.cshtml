@model IEnumerable<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.DangKyHoc>
@{
    // Họ và tên: Nguyễn Đức Linh
    // Mã sinh viên: 23103100042
    // Nội dung thực hiện: Không Gian Học Tập Của Tôi (My Learning Space) - Cổng Học viên
    ViewData["Title"] = "Không Gian Học Tập Của Tôi";
    var currentStudent = ViewBag.CurrentStudent as QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.HocVien;
    var taiKhoan = ViewBag.TaiKhoan as QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.TaiKhoan;
    var paymentHistory = ViewBag.PaymentHistory as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.DangKyHoc> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.DangKyHoc>();
    var buoiHocs = ViewBag.BuoiHocs as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.BuoiHoc> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.BuoiHoc>();
    var ketQuas = ViewBag.KetQuas as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.KetQuaHocTap> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.KetQuaHocTap>();
    var completedSessionsMap = ViewBag.CompletedSessionsCount as Dictionary<int, int> ?? new Dictionary<int, int>();
    string activeTab = ViewBag.ActiveTab as string ?? "courses";

    var myClasses = ViewBag.MyClasses as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc>();
    int? selectedMaLop = ViewBag.SelectedMaLop as int?;
    int diffWeek = (7 + (DateTime.Today.DayOfWeek - DayOfWeek.Monday)) % 7;
    DateTime selectedWeek = ViewBag.SelectedWeek != null ? (DateTime)ViewBag.SelectedWeek : DateTime.Today.AddDays(-diffWeek);
    int totalWeekSessions = ViewBag.TotalWeekSessions != null ? (int)ViewBag.TotalWeekSessions : buoiHocs.Count(b => b.ThoiGianBatDau >= selectedWeek && b.ThoiGianBatDau < selectedWeek.AddDays(7));
    string lopParam = selectedMaLop.HasValue ? $"&maLop={selectedMaLop.Value}" : "";

    var days = new DayOfWeek[] {
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday
    };

    var dayNames = new Dictionary<DayOfWeek, string> {
        { DayOfWeek.Monday, "Thứ 2" },
        { DayOfWeek.Tuesday, "Thứ 3" },
        { DayOfWeek.Wednesday, "Thứ 4" },
        { DayOfWeek.Thursday, "Thứ 5" },
        { DayOfWeek.Friday, "Thứ 6" },
        { DayOfWeek.Saturday, "Thứ 7" },
        { DayOfWeek.Sunday, "Chủ nhật" }
    };

    string activeBtnClass = "py-3 px-4 text-xs sm:text-sm font-bold border-b-2 border-primary text-primary flex items-center gap-2 transition-colors cursor-pointer whitespace-nowrap";
    string inactiveBtnClass = "py-3 px-4 text-xs sm:text-sm font-bold border-b-2 border-transparent text-outline hover:text-brand-deep flex items-center gap-2 transition-colors cursor-pointer whitespace-nowrap";

    int totalCourses = Model.Count();
    int activeCourses = Model.Count(d => d.TrangThai == "Đang học" || d.TrangThai == "Đã đóng học phí");
    int pendingCourses = Model.Count(d => d.TrangThai == "Chờ duyệt" || d.TrangThai == "Đã duyệt");
    int completedCourses = ketQuas.Count(k => k.KetQua == "Hoàn thành" || k.KetQua == "Đạt");
}

@Html.AntiForgeryToken()

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- ================= STUDENT PROFILE HERO BAR ================= -->
    <div class="bg-gradient-to-r from-brand-deep via-[#002f87] to-primary text-white rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex flex-col sm:flex-row items-center gap-5 text-center sm:text-left">
                <div class="w-20 h-20 rounded-3xl bg-white text-brand-deep font-black text-3xl flex items-center justify-center shadow-lg shrink-0">
                    @(string.IsNullOrWhiteSpace(currentStudent?.HoTen) ? "HV" : currentStudent.HoTen.Substring(0, 1).ToUpper())
                </div>
                <div class="space-y-1.5">
                    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
                        <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight">
                            @(currentStudent?.HoTen ?? "Học viên UNETI")
                        </h1>
                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-400 text-slate-900">
                            Học viên chính thức
                        </span>
                    </div>
                    <p class="text-xs text-slate-200 font-mono">
                        Mã HV: <strong>#HV@(currentStudent?.MaHocVien.ToString("D3") ?? "001")</strong> • @(currentStudent?.Email ?? "hocvien@uneti.edu.vn")
                    </p>
                </div>
            </div>

            <!-- Learning Stats -->
            <div class="flex items-center gap-4 sm:gap-6 bg-white/10 backdrop-blur-md px-5 py-3 rounded-2xl border border-white/20 text-center">
                <div>
                    <span class="text-xl sm:text-2xl font-black text-white font-mono block">@totalCourses</span>
                    <span class="text-[10px] text-slate-300 uppercase tracking-wider font-semibold">Khóa đã ĐK</span>
                </div>
                <div class="h-8 w-px bg-white/20"></div>
                <div>
                    <span class="text-xl sm:text-2xl font-black text-amber-300 font-mono block">@activeCourses</span>
                    <span class="text-[10px] text-slate-300 uppercase tracking-wider font-semibold">Đang theo học</span>
                </div>
                <div class="h-8 w-px bg-white/20"></div>
                <div>
                    <span class="text-xl sm:text-2xl font-black text-emerald-300 font-mono block">@completedCourses</span>
                    <span class="text-[10px] text-slate-300 uppercase tracking-wider font-semibold">Đã hoàn thành</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= TABS NAVIGATION ================= -->
    <div class="border-b border-border-standard flex items-center justify-between gap-4">
        <div class="flex items-center gap-2 sm:gap-4 overflow-x-auto custom-scrollbar">
            <button type="button" onclick="switchTab('courses')" id="tab-btn-courses"
                    class="@(activeTab == "courses" ? activeBtnClass : inactiveBtnClass)">
                <span class="material-symbols-outlined text-[20px]">school</span>
                <span>Đơn đăng ký & Khóa học (@totalCourses)</span>
            </button>
            <button type="button" onclick="switchTab('schedule')" id="tab-btn-schedule"
                    class="@(activeTab == "schedule" ? activeBtnClass : inactiveBtnClass)">
                <span class="material-symbols-outlined text-[20px]">calendar_month</span>
                <span>Thời khóa biểu tuần</span>
            </button>
            <button type="button" onclick="switchTab('grades')" id="tab-btn-grades"
                    class="@(activeTab == "grades" ? activeBtnClass : inactiveBtnClass)">
                <span class="material-symbols-outlined text-[20px]">workspace_premium</span>
                <span>Bảng điểm & Chứng nhận</span>
            </button>
            <button type="button" onclick="switchTab('profile')" id="tab-btn-profile"
                    class="@(activeTab == "profile" ? activeBtnClass : inactiveBtnClass)">
                <span class="material-symbols-outlined text-[20px]">badge</span>
                <span>Thẻ sinh viên & Hồ sơ</span>
            </button>
        </div>

        <a href="/CongHocVien/DangKy" class="hidden lg:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary text-white text-xs font-bold hover:bg-primary-hover shadow-xs transition-colors shrink-0">
            <span class="material-symbols-outlined text-[16px]">add_shopping_cart</span>
            <span>Khám phá thêm khóa học</span>
        </a>
    </div>

    <!-- ================= TAB 1: KHÓA HỌC CỦA TÔI ================= -->
    <div id="tab-content-courses" class="space-y-6 @(activeTab == "courses" ? "" : "hidden")">
        @if (!Model.Any())
        {
            <div class="bg-white rounded-3xl border border-border-standard p-12 text-center text-outline shadow-xs space-y-4">
                <span class="material-symbols-outlined text-[54px] opacity-40 text-primary">menu_book</span>
                <h3 class="text-base font-bold text-brand-deep">Bạn chưa đăng ký khóa học nào</h3>
                <p class="text-xs max-w-md mx-auto">Hãy ghé thăm trang Khám phá khóa học để lựa chọn lớp học phù hợp với định hướng của bạn nhé!</p>
                <a href="/CongHocVien/DangKy" class="inline-block px-6 py-2.5 rounded-xl bg-primary text-white text-xs font-bold shadow-md hover:bg-primary-hover transition-colors">
                    Khám phá khóa học ngay
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var dk in Model)
                {
                    var lop = dk.LopHoc;
                    int maLop = dk.MaLopHoc;
                    int totalSessions = lop?.SoBuoiHoc ?? 1;
                    int completedSessions = completedSessionsMap.ContainsKey(maLop) ? completedSessionsMap[maLop] : 0;
                    double progressPercent = totalSessions > 0 ? Math.Min(100.0, Math.Round((double)completedSessions / totalSessions * 100, 1)) : 0;

                    <div class="bg-white rounded-3xl border border-border-standard hover:border-primary/40 shadow-xs hover:shadow-lg transition-all flex flex-col justify-between overflow-hidden">
                        <!-- Top Banner -->
                        <div class="p-5 bg-gradient-to-r from-slate-900 to-brand-deep text-white flex items-center justify-between">
                            <span class="text-[10px] font-bold uppercase tracking-wider bg-white/20 px-2 py-0.5 rounded">
                                @(lop?.TrinhDoDauVao ?? "Đào tạo")
                            </span>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold
                                @(dk.TrangThai == "Đang học" ? "bg-blue-500 text-white" :
                                  dk.TrangThai == "Đã đóng học phí" ? "bg-emerald-500 text-white" :
                                  dk.TrangThai == "Chờ xác nhận học phí" ? "bg-amber-500 text-white animate-pulse" :
                                  dk.TrangThai == "Đã duyệt" ? "bg-sky-500 text-white" :
                                  dk.TrangThai == "Hoàn thành" ? "bg-purple-500 text-white" :
                                  dk.TrangThai == "Chờ duyệt" ? "bg-amber-400 text-slate-900 animate-pulse" :
                                  "bg-rose-500 text-white")">
                                @dk.TrangThai
                            </span>
                        </div>

                        <!-- Card Body -->
                        <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                            <div class="space-y-2">
                                <h3 class="text-base font-bold text-brand-deep line-clamp-2">
                                    @(lop?.TenLop ?? $"Lớp #{maLop}")
                                </h3>
                                <p class="text-xs text-outline">
                                    @(lop?.ChuongTrinhDaoTao?.TenChuongTrinh ?? "Chương trình chuyên biệt")
                                </p>

                                <div class="space-y-1.5 pt-2 text-xs text-slate-600 border-t border-border-standard">
                                    <div class="flex items-center justify-between">
                                        <span class="text-outline">Giảng viên:</span>
                                        <strong class="text-brand-deep">@(lop?.TenGiangVien ?? "Chưa chỉ định")</strong>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-outline">Khai giảng:</span>
                                        <span class="font-mono text-brand-deep">@(lop?.NgayKhaiGiang.ToString("dd/MM/yyyy") ?? "—")</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-outline">Học phí:</span>
                                        <span class="font-mono font-bold text-emerald-700">@(lop?.HocPhi.ToString("N0") ?? "0") đ</span>
                                    </div>
                                </div>

                                <!-- Progress bar for enrolled courses -->
                                @if (dk.TrangThai == "Đang học" || dk.TrangThai == "Đã đóng học phí")
                                {
                                    <div class="pt-3 space-y-1.5">
                                        <div class="flex justify-between items-center text-[11px]">
                                            <span class="text-outline">Tiến độ khóa học:</span>
                                            <strong class="text-primary font-mono">@completedSessions / @totalSessions buổi (@progressPercent%)</strong>
                                        </div>
                                        <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                                            <div class="h-2 rounded-full bg-primary transition-all duration-500" style="width: @progressPercent%"></div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Actions -->
                            <div class="pt-3 border-t border-border-standard space-y-2">
                                @if (dk.TrangThai == "Đang học" || dk.TrangThai == "Đã đóng học phí")
                                {
                                    <a asp-action="ChiTiet" asp-route-id="@maLop" class="w-full py-2.5 px-3 rounded-xl bg-primary hover:bg-primary-hover text-white text-xs font-bold text-center flex items-center justify-center gap-1.5 shadow-xs transition-colors">
                                        <span class="material-symbols-outlined text-[16px]">school</span>
                                        <span>Vào học • Xem Lịch & Đề Cương</span>
                                    </a>
                                }
                                else if (dk.TrangThai == "Chờ xác nhận học phí")
                                {
                                    <div class="space-y-1.5">
                                        <div class="p-2.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs flex items-center gap-2">
                                            <span class="material-symbols-outlined text-amber-600 text-[18px]">hourglass_top</span>
                                            <span class="font-medium">Đã báo chuyển khoản • Chờ Giáo vụ xác nhận</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <a asp-action="ChiTiet" asp-route-id="@maLop" class="flex-1 py-1.5 px-2 rounded-xl border border-border-standard text-brand-deep text-xs font-semibold text-center hover:bg-slate-50 transition-colors">
                                                Chi tiết
                                            </a>
                                            <button type="button" onclick="openPaymentModal(@dk.MaDangKy, '@(lop?.TenLop?.Replace("'", "\\'") ?? "")', @(lop?.HocPhi ?? 0), @(dk.SoTienDaDong))"
                                                    class="py-1.5 px-2.5 rounded-xl border border-border-standard text-outline hover:text-brand-deep text-xs font-semibold hover:bg-slate-50 transition-colors" title="Xem lại mã QR">
                                                Xem lại QR
                                            </button>
                                        </div>
                                    </div>
                                }
                                else if (dk.TrangThai == "Đã duyệt" && (dk.SoTienDaDong < (lop?.HocPhi ?? 0) || (lop?.HocPhi ?? 0) == 0))
                                {
                                    <div class="space-y-1.5">
                                        <button type="button" onclick="openPaymentModal(@dk.MaDangKy, '@(lop?.TenLop?.Replace("'", "\\'") ?? "")', @(lop?.HocPhi ?? 0), @(dk.SoTienDaDong))"
                                                class="w-full py-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold text-center flex items-center justify-center gap-1.5 shadow-sm transition-all cursor-pointer">
                                            <span class="material-symbols-outlined text-[16px]">qr_code_2</span>
                                            <span>Đóng Học Phí (VietQR / CK)</span>
                                        </button>
                                        <div class="flex items-center gap-2">
                                            <a asp-action="ChiTiet" asp-route-id="@maLop" class="flex-1 py-1.5 px-2 rounded-xl border border-border-standard text-brand-deep text-xs font-semibold text-center hover:bg-slate-50 transition-colors">
                                                Chi tiết
                                            </a>
                                            <button type="button" onclick="confirmHuyDangKy(@dk.MaDangKy, '@(lop?.TenLop?.Replace("'", "\\'") ?? "")')"
                                                    class="py-1.5 px-2.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-semibold transition-colors">
                                                Hủy đơn
                                            </button>
                                        </div>
                                    </div>
                                }
                                else if (dk.TrangThai == "Chờ duyệt")
                                {
                                    <div class="flex items-center gap-2">
                                        <a asp-action="ChiTiet" asp-route-id="@maLop" class="flex-1 py-2 px-2 rounded-xl border border-border-standard text-brand-deep text-xs font-bold text-center hover:bg-slate-50 transition-colors">
                                            Chi tiết
                                        </a>
                                        <button type="button" onclick="confirmHuyDangKy(@dk.MaDangKy, '@(lop?.TenLop?.Replace("'", "\\'") ?? "")')"
                                                class="py-2 px-3 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold transition-colors">
                                            Hủy đơn
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <a asp-action="ChiTiet" asp-route-id="@maLop" class="w-full py-2 px-3 rounded-xl border border-border-standard text-brand-deep text-xs font-bold text-center block hover:bg-slate-50 transition-colors">
                                        Xem chi tiết khóa học
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ================= TAB 2: THỜI KHÓA BIỂU CÁ NHÂN ================= -->
    <div id="tab-content-schedule" class="space-y-6 @(activeTab == "schedule" ? "" : "hidden")">
        <!-- Sub-header & Action Bar -->
        <div class="bg-surface-white rounded-3xl border border-border-standard p-6 shadow-xs flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <div class="flex items-center gap-2 text-outline font-label-sm text-xs uppercase tracking-wider mb-1">
                    <span>CỔNG HỌC VIÊN</span>
                    <span class="material-symbols-outlined text-[13px]">chevron_right</span>
                    <span class="text-brand-deep font-semibold">THỜI KHÓA BIỂU CÁ NHÂN</span>
                </div>
                <h2 class="text-xl font-black text-brand-deep tracking-tight flex items-center gap-2">
                    Thời Khóa Biểu Học Tập
                    <span class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary text-xs font-semibold">
                        @(currentStudent?.HoTen ?? "Học viên")
                    </span>
                </h2>
                <p class="text-xs text-outline mt-1">Được đồng bộ và tổng hợp tự động từ tất cả các khóa học bạn đang tham gia</p>
            </div>

            <div class="flex items-center gap-2.5 shrink-0">
                <button type="button" onclick="window.print()" class="inline-flex items-center gap-1.5 bg-surface-white border border-border-standard hover:bg-surface-container-low text-brand-deep font-label-md text-xs px-3.5 py-2.5 rounded-xl transition-all shadow-xs cursor-pointer">
                    <span class="material-symbols-outlined text-[18px] text-primary">print</span>
                    <span class="hidden sm:inline">In Thời Khóa Biểu</span>
                </button>
                <a href="/CongHocVien/DangKy" class="inline-flex items-center gap-1.5 bg-primary hover:bg-primary-hover text-surface-white font-label-md text-xs px-4 py-2.5 rounded-xl shadow-xs transition-all cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">add_shopping_cart</span>
                    <span>Đăng ký môn học mới</span>
                </a>
            </div>
        </div>

        <!-- Filter & Week Navigator Bar (Thống nhất với giao diện giảng viên) -->
        <div class="bg-surface-white rounded-2xl p-4 border border-border-standard shadow-xs flex flex-col md:flex-row items-center justify-between gap-4">
            <form method="get" action="/CongHocVien/TienTrinh" class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                <input type="hidden" name="tab" value="schedule" />
                <input type="hidden" name="weekStart" value="@selectedWeek.ToString("yyyy-MM-dd")" />

                <!-- Lọc lớp học -->
                <div class="relative min-w-[220px]">
                    <select name="maLop" onchange="this.form.submit()" class="w-full appearance-none bg-surface-container-low border border-border-standard text-brand-deep text-xs px-3.5 py-2.5 pr-8 rounded-xl focus:outline-none focus:border-primary">
                        <option value="">Tất cả khóa học đang theo học</option>
                        @foreach (var lop in myClasses)
                        {
                            <option value="@lop.MaLopHoc" selected="@(selectedMaLop == lop.MaLopHoc)">@lop.TenLop - @(lop.ChuongTrinhDaoTao?.TenChuongTrinh ?? "")</option>
                        }
                    </select>
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">expand_more</span>
                </div>
            </form>

            <!-- Week Navigator -->
            <div class="flex items-center gap-2">
                <a href="/CongHocVien/TienTrinh?tab=schedule&weekStart=@selectedWeek.AddDays(-7).ToString("yyyy-MM-dd")@lopParam" class="p-2 rounded-xl border border-border-standard hover:bg-surface-container-low text-outline hover:text-brand-deep cursor-pointer" title="Tuần trước">
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                </a>
                <div class="px-4 py-1.5 rounded-xl bg-surface-container-low text-xs font-bold text-brand-deep text-center">
                    <span>Tuần từ @selectedWeek.ToString("dd/MM") đến @selectedWeek.AddDays(6).ToString("dd/MM/yyyy")</span>
                </div>
                <a href="/CongHocVien/TienTrinh?tab=schedule&weekStart=@selectedWeek.AddDays(7).ToString("yyyy-MM-dd")@lopParam" class="p-2 rounded-xl border border-border-standard hover:bg-surface-container-low text-outline hover:text-brand-deep cursor-pointer" title="Tuần sau">
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                </a>
                <a href="/CongHocVien/TienTrinh?tab=schedule@lopParam" class="px-3 py-1.5 text-xs font-semibold text-primary hover:underline">
                    Tuần này
                </a>
            </div>
        </div>

        <!-- Weekly Timetable Grid (7 ngày Thứ 2 -> Chủ nhật) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-7 gap-3.5">
            @for (int i = 0; i < 7; i++)
            {
                var dayOfWeek = days[i];
                var currentDayDate = selectedWeek.AddDays(i);
                bool isToday = currentDayDate.Date == DateTime.Today.Date;
                var daySessions = buoiHocs.Where(b => b.ThoiGianBatDau.Date == currentDayDate.Date).OrderBy(b => b.ThoiGianBatDau).ToList();

                <div class="flex flex-col bg-surface-white rounded-2xl border @(isToday ? "border-primary ring-2 ring-primary/10 shadow-md" : "border-border-standard shadow-xs") overflow-hidden">
                    <!-- Day Column Header -->
                    <div class="p-3 text-center border-b border-border-standard @(isToday ? "bg-primary text-white" : "bg-surface-container-lowest text-brand-deep")">
                        <span class="block text-xs font-bold uppercase tracking-wider">@dayNames[dayOfWeek]</span>
                        <span class="block text-sm font-black font-mono mt-0.5 @(isToday ? "text-white" : "text-primary")">
                            @currentDayDate.ToString("dd/MM")
                        </span>
                        @if (isToday)
                        {
                            <span class="inline-block px-2 py-0.5 rounded-full bg-white/20 text-[9px] font-bold mt-1">Hôm nay</span>
                        }
                    </div>

                    <!-- Day Sessions Content -->
                    <div class="p-2.5 flex-1 space-y-2.5 min-h-[300px] bg-canvas-base/30">
                        @if (!daySessions.Any())
                        {
                            <div class="h-full flex items-center justify-center text-center py-10 text-outline/40">
                                <span class="text-[11px] font-medium">Không có ca học</span>
                            </div>
                        }
                        else
                        {
                            foreach (var session in daySessions)
                            {
                                <div class="p-3 rounded-xl bg-surface-white border border-border-subtle shadow-2xs hover:shadow-sm transition-all space-y-1.5 border-l-4 border-l-primary">
                                    <div class="flex items-center justify-between">
                                        <span class="px-2 py-0.5 rounded-md bg-primary/10 text-primary font-mono text-[10px] font-bold truncate max-w-[120px]" title="@(session.LopHoc?.TenLop ?? "Khóa học")">
                                            @(session.LopHoc?.TenLop ?? "Khóa học")
                                        </span>
                                        <span class="text-[10px] font-semibold @(session.TrangThai == "Đã hoàn thành" ? "text-emerald-600" : session.TrangThai == "Đang diễn ra" ? "text-blue-600" : "text-outline")">
                                            @session.TrangThai
                                        </span>
                                    </div>

                                    <div class="text-xs font-bold text-brand-deep line-clamp-2" title="@(string.IsNullOrWhiteSpace(session.NoiDung) ? "Buổi học lý thuyết & thực hành" : session.NoiDung)">
                                        @(string.IsNullOrWhiteSpace(session.NoiDung) ? "Buổi học lý thuyết & thực hành" : session.NoiDung)
                                    </div>

                                    <div class="text-[11px] text-outline space-y-0.5 pt-1 border-t border-border-standard/50">
                                        <div class="flex items-center gap-1 font-mono font-semibold text-brand-deep">
                                            <span class="material-symbols-outlined text-[13px] text-primary">schedule</span>
                                            <span>@session.ThoiGianBatDau.ToString("HH:mm") - @session.ThoiGianKetThuc.ToString("HH:mm")</span>
                                        </div>
                                        <div class="flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[13px] text-outline">location_on</span>
                                            <span>Phòng @session.PhongHoc</span>
                                        </div>
                                        <div class="flex items-center gap-1 truncate" title="Giảng viên: @session.GiangVien">
                                            <span class="material-symbols-outlined text-[13px] text-outline">person</span>
                                            <span class="truncate">GV: @session.GiangVien</span>
                                        </div>
                                    </div>

                                    <div class="pt-1 flex justify-end">
                                        <a asp-action="ChiTiet" asp-route-id="@session.MaLopHoc" class="text-[11px] font-bold text-primary hover:underline flex items-center gap-0.5">
                                            <span>Xem lớp học</span>
                                            <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Sessions List Table View (Detail) -->
        <div class="bg-surface-white rounded-2xl border border-border-standard shadow-xs overflow-hidden">
            <div class="p-4 border-b border-border-standard flex items-center justify-between bg-surface-container-lowest">
                <div>
                    <h3 class="font-bold text-sm text-brand-deep">Chi Tiết Các Buổi Học Trong Tuần Này</h3>
                    <p class="text-xs text-outline">Tổng cộng @totalWeekSessions ca học từ @selectedWeek.ToString("dd/MM") đến @selectedWeek.AddDays(6).ToString("dd/MM/yyyy")</p>
                </div>
                <span class="px-3 py-1 rounded-full text-xs font-bold font-mono bg-primary/10 text-primary">
                    @totalWeekSessions buổi
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse min-w-[960px]">
                    <thead>
                        <tr class="bg-surface-container-lowest border-b border-border-standard text-[11px] font-bold text-outline uppercase tracking-wider">
                            <th class="py-3 px-4 w-12 text-center whitespace-nowrap">#</th>
                            <th class="py-3 px-4 whitespace-nowrap">Lớp Học Phần</th>
                            <th class="py-3 px-4 whitespace-nowrap">Ngày Học</th>
                            <th class="py-3 px-4 whitespace-nowrap">Thời Gian</th>
                            <th class="py-3 px-4 whitespace-nowrap">Phòng Học</th>
                            <th class="py-3 px-4 whitespace-nowrap">Giảng Viên</th>
                            <th class="py-3 px-4 whitespace-nowrap">Nội Dung Bài Học</th>
                            <th class="py-3 px-4 text-center whitespace-nowrap">Trạng Thái</th>
                            <th class="py-3 px-4 text-right whitespace-nowrap">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-subtle text-xs text-brand-deep">
                        @{
                            var weekSessionsList = buoiHocs
                                .Where(b => b.ThoiGianBatDau >= selectedWeek && b.ThoiGianBatDau < selectedWeek.AddDays(7))
                                .OrderBy(b => b.ThoiGianBatDau)
                                .ToList();
                        }
                        @if (!weekSessionsList.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-10 text-outline">
                                    <span class="material-symbols-outlined text-3xl opacity-40 block mb-1">event_busy</span>
                                    <span>Không có ca học nào trong tuần được chọn. Hãy dùng nút điều hướng tuần để xem lịch các tuần khác.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int idx = 1;
                            foreach (var session in weekSessionsList)
                            {
                                bool isTodaySession = session.ThoiGianBatDau.Date == DateTime.Today.Date;
                                <tr class="hover:bg-canvas-base/60 transition-colors @(isTodaySession ? "bg-amber-50/40" : "")">
                                    <td class="py-3 px-4 text-center font-mono text-outline whitespace-nowrap">@(idx++)</td>
                                    <td class="py-3 px-4 font-mono font-bold text-primary whitespace-nowrap">
                                        @(session.LopHoc?.TenLop ?? $"Lớp #{session.MaLopHoc}")
                                    </td>
                                    <td class="py-3 px-4 whitespace-nowrap">
                                        <div class="flex flex-col items-start gap-1">
                                            <span class="font-bold text-brand-deep font-mono">@session.ThoiGianBatDau.ToString("dd/MM/yyyy")</span>
                                            @if (isTodaySession)
                                            {
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-400 text-slate-900 inline-block whitespace-nowrap">HÔM NAY</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="py-3 px-4 font-mono font-semibold whitespace-nowrap">
                                        @session.ThoiGianBatDau.ToString("HH:mm") - @session.ThoiGianKetThuc.ToString("HH:mm")
                                    </td>
                                    <td class="py-3 px-4 font-semibold text-brand-deep whitespace-nowrap">
                                        Phòng @session.PhongHoc
                                    </td>
                                    <td class="py-3 px-4 whitespace-nowrap">
                                        @session.GiangVien
                                    </td>
                                    <td class="py-3 px-4 max-w-xs truncate whitespace-nowrap" title="@(string.IsNullOrWhiteSpace(session.NoiDung) ? "Học tập lý thuyết và thực hành theo đề cương" : session.NoiDung)">
                                        @(string.IsNullOrWhiteSpace(session.NoiDung) ? "Học tập lý thuyết và thực hành theo đề cương" : session.NoiDung)
                                    </td>
                                    <td class="py-3 px-4 text-center whitespace-nowrap">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full font-semibold text-[11px] whitespace-nowrap
                                            @(session.TrangThai == "Đã hoàn thành" ? "bg-success-emerald/10 text-success-emerald" :
                                              session.TrangThai == "Đang diễn ra" ? "bg-primary/10 text-primary" :
                                              "bg-surface-container-high text-brand-deep")">
                                            <span class="h-1.5 w-1.5 rounded-full @(session.TrangThai == "Đã hoàn thành" ? "bg-success-emerald" : session.TrangThai == "Đang diễn ra" ? "bg-primary animate-pulse" : "bg-outline")"></span>
                                            @session.TrangThai
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-right whitespace-nowrap">
                                        <a asp-action="ChiTiet" asp-route-id="@session.MaLopHoc" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-surface-container-low hover:bg-surface-container text-primary font-bold text-xs transition-colors whitespace-nowrap">
                                            <span class="material-symbols-outlined text-[15px]">visibility</span>
                                            <span>Khóa học</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= TAB 3: BẢNG ĐIỂM & KẾT QUẢ HỌC TẬP ================= -->
    <div id="tab-content-grades" class="space-y-6 @(activeTab == "grades" ? "" : "hidden")">
        @{
            var completedDangKyIds = ketQuas.Select(k => k.MaDangKy).ToHashSet();
            var ongoingList = Model.Where(d => !completedDangKyIds.Contains(d.MaDangKy) && d.TrangThai != "Đã hủy" && d.TrangThai != "Từ chối").ToList();
            var completedList = ketQuas.ToList();

            double avgHe10 = completedList.Any() ? completedList.Average(k => k.DiemTongKet) : 0;
            double avgHe4 = completedList.Any() ? completedList.Average(k => k.DiemHe4 ?? (k.DiemTongKet >= 8.5 ? 4.0 : k.DiemTongKet >= 7.0 ? 3.0 : 2.0)) : 0;
            int totalAccumCredits = completedList.Count * 3;
            int totalOngoingCredits = ongoingList.Count * 3;

            string academicRank = "Chưa xếp loại";
            string rankBadgeClass = "bg-slate-100 text-slate-700 border-slate-200";
            if (completedList.Any())
            {
                if (avgHe10 >= 8.5) { academicRank = "Học lực Xuất sắc"; rankBadgeClass = "bg-emerald-50 text-emerald-700 border-emerald-200/50"; }
                else if (avgHe10 >= 8.0) { academicRank = "Học lực Giỏi"; rankBadgeClass = "bg-blue-50 text-blue-700 border-blue-200/50"; }
                else if (avgHe10 >= 7.0) { academicRank = "Học lực Khá"; rankBadgeClass = "bg-amber-50 text-amber-700 border-amber-200/50"; }
                else if (avgHe10 >= 5.5) { academicRank = "Học lực Trung bình"; rankBadgeClass = "bg-slate-100 text-slate-700 border-slate-200"; }
                else { academicRank = "Cần cố gắng"; rankBadgeClass = "bg-rose-50 text-rose-700 border-rose-200/50"; }
            }
        }

        <!-- Semester Block 1: HK1 2026-2027 (Current / Ongoing) -->
        <div class="semester-block bg-white rounded-2xl border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] overflow-hidden" data-semester-group="hk1_2627">
            <!-- Semester Subheader -->
            <div class="px-6 py-4 bg-slate-50/60 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold">
                        <span class="material-symbols-outlined text-[18px]">school</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="font-display font-bold text-slate-900 text-sm">Học kỳ I • Năm học 2026 - 2027</h3>
                            <span class="text-[10px] font-semibold uppercase tracking-wider bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full border border-blue-200/50">Học kỳ hiện tại</span>
                        </div>
                        <p class="text-xs text-slate-400 mt-0.5">Tiến độ đào tạo chính khóa • Kỹ thuật phần mềm & AI (@ongoingList.Count học phần đang học)</p>
                    </div>
                </div>
                <div class="flex items-center gap-5 text-xs text-slate-500">
                    <div><span class="text-slate-400">ĐTB Kỳ:</span> <strong class="text-blue-600 font-semibold font-mono">-- | --</strong></div>
                    <div class="h-3 w-px bg-slate-200"></div>
                    <div><span class="text-slate-400">ĐTB Tích lũy:</span> <strong class="text-slate-800 font-semibold font-mono">@(completedList.Any() ? avgHe4.ToString("0.00") : "--")</strong></div>
                    <div class="h-3 w-px bg-slate-200"></div>
                    <div><span class="text-slate-400">Lũy kế:</span> <strong class="text-slate-700 font-semibold font-mono">@(totalAccumCredits + totalOngoingCredits) / 120 TC</strong></div>
                </div>
            </div>

            <!-- Clean Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-100 bg-white text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                            <th class="py-3 px-6 w-12 text-center">#</th>
                            <th class="py-3 px-6 min-w-[280px]">Môn học &amp; Giảng viên</th>
                            <th class="py-3 px-4 text-center w-16">TC</th>
                            <th class="py-3 px-6">Quá trình</th>
                            <th class="py-3 px-4 text-center">Thi KTHP</th>
                            <th class="py-3 px-6 text-center">Tổng kết</th>
                            <th class="py-3 px-4 text-center">Trạng thái</th>
                            <th class="py-3 px-4 text-right pr-6 w-20">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100/80 text-xs text-slate-700">
                        @if (ongoingList.Any())
                        {
                            int ongoingIdx = 1;
                            @foreach (var dk in ongoingList)
                            {
                                var lop = dk.LopHoc;
                                bool isDept = dk.TrangThai == "Chờ duyệt" || dk.TrangThai == "Chờ xác nhận học phí" || (lop != null && lop.HocPhi > 0 && dk.SoTienDaDong < lop.HocPhi);
                                string statusRowClass = isDept ? "bg-rose-50/40 hover:bg-rose-50/70" : "hover:bg-slate-50/60";
                                string statusRowData = isDept ? "fail" : "current";
                                string maHocPhan = lop != null ? $"HP{lop.MaLopHoc:D4}.01" : $"#DK{dk.MaDangKy:D3}";
                                string tenLop = lop?.TenLop ?? "Học phần";
                                string tenGv = lop?.TenGiangVien ?? "ThS. Giảng viên Khoa CNTT";
                                var kq = dk.KetQuaHocTap;
                                
                                <tr class="@statusRowClass transition-colors grade-row" data-status="@statusRowData">
                                    <td class="py-4 px-6 text-center font-mono @(isDept ? "text-rose-500 font-bold" : "text-slate-400")">@(ongoingIdx++)</td>
                                    <td class="py-4 px-6">
                                        <div class="flex items-center gap-2">
                                            <span class="font-semibold @(isDept ? "text-rose-950" : "text-slate-900") text-sm subject-name">@tenLop</span>
                                            @if (isDept)
                                            {
                                                <span class="material-symbols-outlined text-[16px] text-rose-500" title="Chưa hoàn tất học phí">warning</span>
                                            }
                                        </div>
                                        <div class="text-[11px] @(isDept ? "text-rose-600/70" : "text-slate-400") font-mono mt-0.5">
                                            @maHocPhan • GV: @tenGv
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 text-center font-mono font-medium @(isDept ? "text-rose-900" : "")">3</td>
                                    <td class="py-4 px-6">
                                        <div class="flex items-center gap-1.5">
                                            @if (isDept)
                                            {
                                                <span class="bg-rose-100/60 text-rose-800 px-2 py-0.5 rounded text-[11px] font-mono">CC 8.0</span>
                                                <span class="bg-rose-100/60 text-rose-800 px-2 py-0.5 rounded text-[11px] font-mono">TX 7.0</span>
                                            }
                                            else if (kq != null && kq.DiemChuyenCan > 0)
                                            {
                                                <span class="bg-slate-100/90 text-slate-600 px-2 py-0.5 rounded text-[11px] font-mono">CC @kq.DiemChuyenCan.ToString("0.0")</span>
                                                <span class="bg-slate-100/90 text-slate-600 px-2 py-0.5 rounded text-[11px] font-mono">TX @kq.DiemChuyenCan.ToString("0.0")</span>
                                            }
                                            else
                                            {
                                                <span class="bg-slate-100/90 text-slate-600 px-2 py-0.5 rounded text-[11px] font-mono">CC 9.0</span>
                                                <span class="bg-slate-100/90 text-slate-600 px-2 py-0.5 rounded text-[11px] font-mono">TX1 8.5</span>
                                                <span class="bg-slate-100/90 text-slate-600 px-2 py-0.5 rounded text-[11px] font-mono">TH 8.0</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 text-center">
                                        @if (isDept)
                                        {
                                            <span class="font-semibold text-rose-600 text-xs">Cấm thi</span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400 italic font-mono">Chưa thi</span>
                                        }
                                    </td>
                                    <td class="py-4 px-6 text-center font-mono @(isDept ? "font-bold text-rose-600" : "text-slate-400 font-medium")">
                                        @(isDept ? "F (0.0)" : "--")
                                    </td>
                                    <td class="py-4 px-4 text-center">
                                        @if (isDept)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-rose-100 text-rose-700">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Nợ học phí
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700">
                                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span> Đang học
                                            </span>
                                        }
                                    </td>
                                    <td class="py-4 px-4 text-right pr-6">
                                        <button class="w-8 h-8 rounded-lg @(isDept ? "hover:bg-rose-100/80 text-rose-600" : "hover:bg-slate-100 text-slate-400 hover:text-slate-700") inline-flex items-center justify-center transition-colors cursor-pointer" 
                                                onclick="openDetailDrawer('@tenLop.Replace("'", "\\'")', '@maHocPhan', '3', '9.0', '8.5', '8.0', '@(isDept ? "0.0" : "--")', '@(isDept ? "Cấm thi" : "Chưa công bố")', '@(isDept ? "Lý do: Nợ học phí học phần" : "Điểm quá trình đang được giảng viên phụ trách cập nhật")', '@(isDept ? "Cần đóng HP" : "Đang học")')">
                                            <span class="material-symbols-outlined text-[18px]">@(isDept ? "info" : "chevron_right")</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="py-8 text-center text-slate-400 text-xs">
                                    <span class="material-symbols-outlined text-[32px] text-slate-300 block mb-1">school</span>
                                    Hiện tại bạn chưa có học phần nào đang học trong học kỳ này.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Semester Block 2: HK2 2025-2026 (Completed) -->
        <div class="semester-block bg-white rounded-2xl border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] overflow-hidden" data-semester-group="hk2_2526">
            <!-- Semester Subheader -->
            <div class="px-6 py-4 bg-slate-50/60 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
                        <span class="material-symbols-outlined text-[18px]">check_circle</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="font-display font-bold text-slate-900 text-sm">Học kỳ II • Năm học 2025 - 2026</h3>
                            <span class="text-[10px] font-semibold uppercase tracking-wider @rankBadgeClass px-2 py-0.5 rounded-full border">@academicRank</span>
                        </div>
                        <p class="text-xs text-slate-400 mt-0.5">Hoàn thành @totalAccumCredits tín chỉ tích lũy (@completedList.Count học phần đã hoàn thành)</p>
                    </div>
                </div>
                <div class="flex items-center gap-5 text-xs text-slate-500">
                    <div><span class="text-slate-400">ĐTB Kỳ:</span> <strong class="text-blue-600 font-semibold font-mono">@(completedList.Any() ? $"{avgHe10:0.00} | {avgHe4:0.00}" : "-- | --")</strong></div>
                    <div class="h-3 w-px bg-slate-200"></div>
                    <div><span class="text-slate-400">ĐTB Tích lũy:</span> <strong class="text-slate-800 font-semibold font-mono">@(completedList.Any() ? avgHe4.ToString("0.00") : "--")</strong></div>
                    <div class="h-3 w-px bg-slate-200"></div>
                    <div><span class="text-slate-400">Lũy kế:</span> <strong class="text-slate-700 font-semibold font-mono">@totalAccumCredits / 120 TC</strong></div>
                </div>
            </div>

            <!-- Clean Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-100 bg-white text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                            <th class="py-3 px-6 w-12 text-center">#</th>
                            <th class="py-3 px-6 min-w-[280px]">Môn học &amp; Giảng viên</th>
                            <th class="py-3 px-4 text-center w-16">TC</th>
                            <th class="py-3 px-6">Quá trình</th>
                            <th class="py-3 px-4 text-center">Thi KTHP</th>
                            <th class="py-3 px-6 text-center">Tổng kết</th>
                            <th class="py-3 px-4 text-center">Trạng thái</th>
                            <th class="py-3 px-4 text-right pr-6 w-20">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100/80 text-xs text-slate-700">
                        @if (completedList.Any())
                        {
                            int completedIdx = 1;
                            @foreach (var kq in completedList)
                            {
                                var lp = kq.DangKyHoc?.LopHoc;
                                bool isPassed = kq.KetQua == "Hoàn thành" || kq.KetQua == "Đạt" || kq.DiemTongKet >= 4.0;
                                string maHocPhan = lp != null ? $"HP{lp.MaLopHoc:D4}.01" : $"#DK{kq.MaDangKy:D3}";
                                string tenLop = lp?.TenLop ?? "Học phần";
                                string tenGv = lp?.TenGiangVien ?? "ThS. Giảng viên Khoa CNTT";
                                string diemChu = kq.DiemChu ?? (kq.DiemTongKet >= 8.5 ? "A" : kq.DiemTongKet >= 8.0 ? "B+" : kq.DiemTongKet >= 7.0 ? "B" : "C");
                                double diemHe4 = kq.DiemHe4 ?? (kq.DiemTongKet >= 8.5 ? 4.0 : kq.DiemTongKet >= 8.0 ? 3.5 : kq.DiemTongKet >= 7.0 ? 3.0 : 2.0);
                                
                                <tr class="hover:bg-slate-50/60 transition-colors grade-row" data-status="@(isPassed ? "pass" : "fail")">
                                    <td class="py-4 px-6 text-center font-mono text-slate-400">@(completedIdx++)</td>
                                    <td class="py-4 px-6">
                                        <div class="font-semibold text-slate-900 text-sm subject-name">@tenLop</div>
                                        <div class="text-[11px] text-slate-400 font-mono mt-0.5">@maHocPhan • GV: @tenGv</div>
                                    </td>
                                    <td class="py-4 px-4 text-center font-mono font-medium">3</td>
                                    <td class="py-4 px-6">
                                        <div class="flex items-center gap-1.5">
                                            <span class="bg-slate-100/90 text-slate-600 px-2 py-0.5 rounded text-[11px] font-mono">CC @kq.DiemChuyenCan.ToString("0.0")</span>
                                            <span class="bg-slate-100/90 text-slate-600 px-2 py-0.5 rounded text-[11px] font-mono">TX @kq.DiemChuyenCan.ToString("0.0")</span>
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 text-center font-mono font-bold text-slate-800">@kq.DiemCuoiKhoa.ToString("0.0")</td>
                                    <td class="py-4 px-6 text-center">
                                        <div class="inline-flex items-center gap-1.5 font-mono">
                                            <span class="font-bold text-slate-900">@kq.DiemTongKet.ToString("0.00")</span>
                                            <span class="bg-blue-600 text-white text-[10px] font-bold px-1.5 py-0.2 rounded font-sans">@diemChu</span>
                                            <span class="text-slate-400 text-[11px]">(@diemHe4.ToString("0.0"))</span>
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 text-center">
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold @(isPassed ? "bg-emerald-50 text-emerald-700" : "bg-rose-50 text-rose-700")">
                                            <span class="w-1.5 h-1.5 rounded-full @(isPassed ? "bg-emerald-500" : "bg-rose-500")"></span> @(isPassed ? "Đạt" : "Chưa đạt")
                                        </span>
                                    </td>
                                    <td class="py-4 px-4 text-right pr-6">
                                        <button class="w-8 h-8 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-700 inline-flex items-center justify-center transition-colors cursor-pointer" 
                                                onclick="openDetailDrawer('@tenLop.Replace("'", "\\'")', '@maHocPhan', '3', '@kq.DiemChuyenCan.ToString("0.0")', '@kq.DiemChuyenCan.ToString("0.0")', '--', '@kq.DiemCuoiKhoa.ToString("0.0")', '@kq.DiemTongKet.ToString("0.00") (@diemChu)', '@(kq.NhanXet?.Replace("'", "\\'") ?? "Hoàn thành học phần")', '@(kq.XepLoai ?? "Đạt")')">
                                            <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="py-8 text-center text-slate-400 text-xs">
                                    <span class="material-symbols-outlined text-[32px] text-slate-300 block mb-1">history_edu</span>
                                    Chưa có học phần nào hoàn thành điểm tổng kết trong kỳ này.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= TAB 4: THẺ SINH VIÊN & HỒ SƠ CÁ NHÂN ================= -->
    <div id="tab-content-profile" class="space-y-6 @(activeTab == "profile" ? "" : "hidden")">
        @if (currentStudent != null)
        {
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                <!-- Left Column: Thẻ Sinh Viên Điện Tử UNETI -->
                <div class="lg:col-span-5 space-y-4">
                    <div class="bg-gradient-to-tr from-[#0D47A1] via-[#1565C0] to-[#1E88E5] text-white rounded-3xl p-6 shadow-xl relative overflow-hidden border border-white/20">
                        <div class="absolute -right-10 -bottom-10 w-44 h-44 rounded-full bg-white/10 blur-xl pointer-events-none"></div>

                        <!-- Card Header -->
                        <div class="flex items-center justify-between pb-4 border-b border-white/20">
                            <div class="flex items-center gap-2.5">
                                <div class="w-10 h-10 rounded-xl bg-white text-brand-deep flex items-center justify-center font-bold shadow-xs">
                                    <span class="material-symbols-outlined text-[24px]">school</span>
                                </div>
                                <div>
                                    <h4 class="text-xs font-black tracking-wide uppercase">TRƯỜNG ĐH KT-KT CÔNG NGHIỆP</h4>
                                    <p class="text-[10px] text-sky-200">THẺ HỌC VIÊN ĐIỆN TỬ - UNETI EDUSPACE</p>
                                </div>
                            </div>
                            <span class="material-symbols-outlined text-amber-300 text-[26px]">contactless</span>
                        </div>

                        <!-- Card Body -->
                        <div class="pt-5 flex items-center gap-4">
                            <div class="w-20 h-24 rounded-2xl bg-white/20 border-2 border-white/40 flex flex-col items-center justify-center font-black text-3xl text-white shadow-inner shrink-0 overflow-hidden">
                                @(string.IsNullOrWhiteSpace(currentStudent.HoTen) ? "HV" : currentStudent.HoTen.Trim().Substring(currentStudent.HoTen.Trim().LastIndexOf(' ') + 1).Substring(0, 1).ToUpper())
                            </div>
                            <div class="space-y-1 min-w-0">
                                <span class="text-[10px] text-sky-200 uppercase font-semibold">Họ và tên học viên</span>
                                <h3 class="text-base font-black text-white truncate" id="card-student-name">@currentStudent.HoTen</h3>
                                <p class="text-xs font-mono text-amber-300 font-bold">Mã HV: #HV@(currentStudent.MaHocVien.ToString("D3"))</p>
                                <p class="text-[11px] text-slate-200">Ngày sinh: @(currentStudent.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật") • @(currentStudent.GioiTinh ?? "Nam")</p>
                                <p class="text-[11px] text-slate-200 truncate">Trình độ: @(currentStudent.TrinhDoHocVan ?? "Đại học") • @(string.IsNullOrWhiteSpace(currentStudent.NgheNghiep) ? "Sinh viên UNETI" : currentStudent.NgheNghiep)</p>
                            </div>
                        </div>

                        <!-- Card Footer: Barcode & Security Badge -->
                        <div class="pt-5 mt-4 border-t border-white/20 flex items-center justify-between">
                            <div class="font-mono text-[9px] tracking-[4px] text-sky-200">
                                |||| ||| ||||| || ||||
                            </div>
                            @if (currentStudent.TrangThai)
                            {
                                <span class="px-2.5 py-0.5 rounded-full bg-emerald-400/20 text-emerald-300 text-[10px] font-bold border border-emerald-400/30">
                                    Thẻ Đang Hiệu Lực
                                </span>
                            }
                            else
                            {
                                <span class="px-2.5 py-0.5 rounded-full bg-rose-400/20 text-rose-200 text-[10px] font-bold border border-rose-400/30">
                                    Tạm Khóa
                                </span>
                            }
                        </div>
                    </div>

                    <div class="p-4 rounded-2xl bg-sky-50 border border-sky-200 text-xs text-sky-900 space-y-1.5">
                        <p class="font-bold flex items-center gap-1.5 text-brand-deep">
                            <span class="material-symbols-outlined text-[16px] text-primary">badge</span>
                            <span>Định danh học viên chính thức UNETI</span>
                        </p>
                        <p class="text-slate-600">Tài khoản đăng nhập: <strong class="font-mono text-brand-deep">@(taiKhoan?.TenDangNhap ?? "hocvien")</strong> • Ngày cấp: <strong class="font-mono text-brand-deep">@currentStudent.NgayTao.ToString("dd/MM/yyyy")</strong></p>
                        <p class="text-slate-600">Thẻ học viên điện tử dùng để điểm danh tại phòng Lab thực hành và đối chiếu cấp chứng chỉ hoàn thành khóa học.</p>
                    </div>
                </div>

                <!-- Right Column: Form Cập Nhật Hồ Sơ Cá Nhân -->
                <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-8 border border-border-standard shadow-xs space-y-6">
                    <div class="border-b border-border-standard pb-4">
                        <h3 class="text-base font-bold text-brand-deep">Thông Tin Hồ Sơ Cá Nhân</h3>
                        <p class="text-xs text-outline">Cập nhật thông tin liên hệ chính xác để nhận thông báo lịch học và in chứng chỉ tốt nghiệp</p>
                    </div>

                    <form id="hosoForm" onsubmit="submitHoSo(event)" class="space-y-5">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MaHocVien" value="@currentStudent.MaHocVien" />
                        <input type="hidden" name="MaTaiKhoan" value="@currentStudent.MaTaiKhoan" />
                        <input type="hidden" name="TrangThai" value="@currentStudent.TrangThai.ToString().ToLower()" />

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-brand-deep uppercase mb-1.5">Họ và tên <span class="text-rose-500">*</span></label>
                                <input type="text" name="HoTen" value="@currentStudent.HoTen" required
                                       class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-brand-deep uppercase mb-1.5">Email tài khoản</label>
                                <input type="email" name="Email" value="@currentStudent.Email" readonly
                                       class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-slate-100 text-slate-500 cursor-not-allowed font-mono" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-brand-deep uppercase mb-1.5">Ngày sinh</label>
                                <input type="date" name="NgaySinh" value="@currentStudent.NgaySinh?.ToString("yyyy-MM-dd")" required
                                       class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep font-mono" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-brand-deep uppercase mb-1.5">Giới tính</label>
                                <select name="GioiTinh" class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep">
                                    <!option value="Nam" @(currentStudent.GioiTinh == "Nam" ? "selected" : "")>Nam</!option>
                                    <!option value="Nữ" @(currentStudent.GioiTinh == "Nữ" ? "selected" : "")>Nữ</!option>
                                    <!option value="Khác" @(currentStudent.GioiTinh == "Khác" ? "selected" : "")>Khác</!option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-brand-deep uppercase mb-1.5">Số điện thoại liên hệ</label>
                                <input type="tel" name="SoDienThoai" value="@currentStudent.SoDienThoai" placeholder="0987654321" maxlength="10"
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);"
                                       class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep font-mono" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-brand-deep uppercase mb-1.5">Trình độ học vấn</label>
                                <select name="TrinhDoHocVan" class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep">
                                    <!option value="Đại học" @(currentStudent.TrinhDoHocVan == "Đại học" ? "selected" : "")>Đại học</!option>
                                    <!option value="Kỹ sư" @(currentStudent.TrinhDoHocVan == "Kỹ sư" ? "selected" : "")>Kỹ sư</!option>
                                    <!option value="Thạc sĩ" @(currentStudent.TrinhDoHocVan == "Thạc sĩ" ? "selected" : "")>Thạc sĩ</!option>
                                    <!option value="Cao đẳng" @(currentStudent.TrinhDoHocVan == "Cao đẳng" ? "selected" : "")>Cao đẳng</!option>
                                    <!option value="Trung cấp" @(currentStudent.TrinhDoHocVan == "Trung cấp" ? "selected" : "")>Trung cấp</!option>
                                    <!option value="THPT" @(currentStudent.TrinhDoHocVan == "THPT" ? "selected" : "")>THPT</!option>
                                    <!option value="Sau đại học" @(currentStudent.TrinhDoHocVan == "Sau đại học" ? "selected" : "")>Sau đại học</!option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-brand-deep uppercase mb-1.5">Nghề nghiệp hiện tại</label>
                                <input type="text" name="NgheNghiep" value="@currentStudent.NgheNghiep" placeholder="Sinh viên, Kỹ sư, Lập trình viên..."
                                       class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-brand-deep uppercase mb-1.5">Địa chỉ thường trú</label>
                                <input type="text" name="DiaChi" value="@currentStudent.DiaChi" placeholder="Số nhà, đường, quận/huyện, TP"
                                       class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep" />
                            </div>
                        </div>

                        <div class="pt-4 border-t border-border-standard flex items-center justify-end">
                            <button type="submit" class="px-6 py-2.5 text-xs font-bold text-white bg-primary hover:bg-primary-hover rounded-xl shadow-md transition-all flex items-center gap-1.5 cursor-pointer">
                                <span class="material-symbols-outlined text-[16px]">save</span>
                                <span>Lưu cập nhật hồ sơ</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Lịch Sử Đóng Học Phí & Biên Lai Điện Tử -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-border-standard shadow-xs space-y-5">
                <div class="flex items-center justify-between pb-3 border-b border-border-standard">
                    <div>
                        <h3 class="text-base font-bold text-brand-deep flex items-center gap-2">
                            <span class="material-symbols-outlined text-[20px] text-primary">receipt_long</span>
                            <span>Lịch Sử Đóng Học Phí & Biên Lai Điện Tử</span>
                        </h3>
                        <p class="text-xs text-outline mt-0.5">Danh sách các khoản học phí bạn đã nộp thành công cho trung tâm</p>
                    </div>
                    <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-xl border border-emerald-200">
                        @paymentHistory.Count biên lai
                    </span>
                </div>

                @if (!paymentHistory.Any())
                {
                    <div class="text-center py-8 text-outline text-xs">
                        <span class="material-symbols-outlined text-[36px] opacity-40 mb-1">credit_card_off</span>
                        <p>Bạn chưa có phát sinh giao dịch đóng học phí nào.</p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-slate-50 text-[11px] font-bold text-outline uppercase tracking-wider border-b border-border-standard">
                                    <th class="py-3 px-4">Mã Đơn</th>
                                    <th class="py-3 px-4">Khóa Học</th>
                                    <th class="py-3 px-4">Ngày Nộp Học Phí</th>
                                    <th class="py-3 px-4">Số Tiền Đã Đóng</th>
                                    <th class="py-3 px-4 text-center">Trạng Thái</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border-standard">
                                @foreach (var p in paymentHistory)
                                {
                                    <tr class="hover:bg-slate-50/70 transition-colors">
                                        <td class="py-3.5 px-4 font-mono font-bold text-primary">
                                            #DK@(p.MaDangKy.ToString("D3"))
                                        </td>
                                        <td class="py-3.5 px-4">
                                            <div class="font-bold text-brand-deep">@(p.LopHoc?.TenLop ?? $"Lớp #{p.MaLopHoc}")</div>
                                            <span class="text-[11px] text-outline font-mono">Học phí gốc: @(p.LopHoc?.HocPhi.ToString("N0") ?? "0") đ</span>
                                        </td>
                                        <td class="py-3.5 px-4 font-mono text-slate-700">
                                            @(p.NgayDongHocPhi?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                        </td>
                                        <td class="py-3.5 px-4 font-mono font-bold text-emerald-700 text-sm">
                                            @p.SoTienDaDong.ToString("N0") đ
                                        </td>
                                        <td class="py-3.5 px-4 text-center">
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                <span class="material-symbols-outlined text-[13px] mr-1">check_circle</span>
                                                Đã xác nhận nộp
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Modal Hướng Dẫn Thanh Toán Học Phí (VietQR & Trực tiếp) -->
<div id="payment-modal" class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 transition-all duration-200 opacity-0 pointer-events-none" style="background-color: rgba(15, 23, 42, 0.75); backdrop-filter: blur(4px);">
    <div class="rounded-3xl max-w-lg w-full p-5 sm:p-6 shadow-2xl transform scale-95 transition-all duration-200 border border-slate-200 max-h-[92vh] flex flex-col" id="payment-modal-content" style="background-color: #ffffff !important; color: #1e293b !important;">
        <!-- Modal Header -->
        <div class="flex items-center justify-between pb-3 border-b border-slate-200 shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[22px]">payments</span>
                </div>
                <div>
                    <h3 class="font-bold text-base text-slate-800">Thanh Toán Học Phí</h3>
                    <p class="text-xs text-slate-500">Quét mã VietQR chuyển khoản ngân hàng hoặc nộp trực tiếp</p>
                </div>
            </div>
            <button type="button" onclick="closePaymentModal()" class="w-8 h-8 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 hover:text-slate-700 transition-colors">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <!-- Modal Body (Scrollable if viewport is small) -->
        <div class="overflow-y-auto py-3 space-y-3 pr-1 text-slate-800">
            <!-- Thông tin khóa học & số tiền -->
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs space-y-2">
                <div class="flex justify-between items-center">
                    <span class="text-slate-500 font-medium">Mã hồ sơ:</span>
                    <strong class="text-slate-800 font-mono text-sm font-bold" id="pay-modal-maDK">#DK000</strong>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-slate-500 font-medium">Lớp học:</span>
                    <strong class="text-slate-900 text-right max-w-[260px] truncate font-bold" id="pay-modal-tenLop">—</strong>
                </div>
                <div class="flex justify-between items-center border-t border-slate-200 pt-2">
                    <span class="text-slate-600 font-medium">Số tiền cần thanh toán:</span>
                    <strong class="text-emerald-600 font-mono text-lg font-black" id="pay-modal-soTien">0 đ</strong>
