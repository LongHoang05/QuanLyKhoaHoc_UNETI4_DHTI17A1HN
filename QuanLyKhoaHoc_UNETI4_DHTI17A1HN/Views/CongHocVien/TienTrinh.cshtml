                    <span class="material-symbols-outlined text-blue-600 text-[16px]">analytics</span>
                    <span>Thành phần điểm quá trình</span>
                </h4>
                <span class="text-[11px] text-slate-400 font-mono">Tỷ trọng 40%</span>
            </div>
            <div class="grid grid-cols-3 gap-2 text-center text-xs">
                <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
                    <span class="text-[11px] text-slate-500 block mb-1">Chuyên cần</span>
                    <strong class="text-sm font-mono text-slate-900 font-bold" id="drawer-score-cc">--</strong>
                </div>
                <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
                    <span class="text-[11px] text-slate-500 block mb-1">Thường xuyên</span>
