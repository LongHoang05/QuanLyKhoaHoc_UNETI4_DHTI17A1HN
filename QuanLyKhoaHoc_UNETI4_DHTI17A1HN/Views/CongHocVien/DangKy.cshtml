@model IEnumerable<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc>

@{
    ViewData["Title"] = "Đăng ký Lớp học (Module 3 - Skeleton)";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <span class="badge bg-primary-subtle text-primary mb-2" style="width: fit-content;">Module 3 • Nguyễn Đức Linh (23103100042)</span>
        <h3 class="fw-bold mb-1">Cổng Đăng ký Lớp học (Skeleton)</h3>
        <p class="text-muted mb-3">Khung giao diện dành cho sinh viên 3 tự triển khai theo Mục 7.3 tài liệu đặc tả.</p>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-warning">@TempData["Error"]</div>
        }

        <div class="alert alert-info mb-0">
            <h6 class="fw-bold mb-2"><i class="bi bi-code-square me-2"></i>Danh sách công việc cần làm (TODO - Mục 7.3):</h6>
            <ul class="mb-0 small">
                <li>Hiển thị bộ lọc tìm kiếm lớp học đang mở theo từ khóa, khóa học và lịch học.</li>
                <li>Hiển thị danh sách lớp học có trạng thái <code>Đang mở đăng ký</code>, sĩ số hiện tại / sĩ số tối đa, hạn đăng ký và học phí.</li>
                <li>Nút gửi form đăng ký lớp tới action <code>DangKyLopPost</code> (tạo bản ghi <code>DangKyHoc</code> trạng thái <code>Chờ duyệt</code>).</li>
            </ul>
        </div>
    </div>
</div>
