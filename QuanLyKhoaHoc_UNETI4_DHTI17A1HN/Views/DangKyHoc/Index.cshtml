                <span class="text-xs text-amber-600 font-medium">cần xử lý</span>
            </div>
        </div>

        <div class="card-pro card-pro-hover p-5 flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
                <span class="text-outline font-label-md text-label-md font-medium">Đã phê duyệt nhập học</span>
                <div class="w-10 h-10 rounded-2xl bg-blue-50 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">how_to_reg</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2">
