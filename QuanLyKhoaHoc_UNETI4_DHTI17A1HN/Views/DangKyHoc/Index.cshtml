                    <!option value="Chờ duyệt" @(selectedTrangThai == "Chờ duyệt" ? "selected" : "")>Chờ duyệt</!option>
                    <!option value="Đã duyệt" @(selectedTrangThai == "Đã duyệt" ? "selected" : "")>Đã duyệt</!option>
                    <!option value="Đã đóng học phí" @(selectedTrangThai == "Đã đóng học phí" ? "selected" : "")>Đã đóng học phí</!option>
                    <!option value="Đang học" @(selectedTrangThai == "Đang học" ? "selected" : "")>Đang học</!option>
                    <!option value="Hoàn thành" @(selectedTrangThai == "Hoàn thành" ? "selected" : "")>Hoàn thành</!option>
                    <!option value="Từ chối" @(selectedTrangThai == "Từ chối" ? "selected" : "")>Từ chối</!option>
                    <!option value="Đã hủy" @(selectedTrangThai == "Đã hủy" ? "selected" : "")>Đã hủy</!option>
                </select>
                <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">expand_more</span>
