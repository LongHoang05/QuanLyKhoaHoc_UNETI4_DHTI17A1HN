            <!-- Sắp xếp (Mục 8.1) -->
            <div class="relative min-w-[165px]">
                <select id="filterSortBy" class="w-full appearance-none bg-surface-white border border-border-standard text-brand-deep text-xs px-3.5 py-2 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-container-low transition-colors font-medium">
                    <!option value="" @(sortBy == "" ? "selected" : "")>Mới nhất trước</!option>
                    <!option value="ngay_asc" @(sortBy == "ngay_asc" ? "selected" : "")>Cũ nhất trước</!option>
                    <!option value="ten_asc" @(sortBy == "ten_asc" ? "selected" : "")>Tên học viên A-Z</!option>
                    <!option value="ten_desc" @(sortBy == "ten_desc" ? "selected" : "")>Tên học viên Z-A</!option>
                    <!option value="tien_desc" @(sortBy == "tien_desc" ? "selected" : "")>Học phí đã thu cao nhất</!option>
                </select>
                <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">sort</span>
            </div>
        </div>

        <button type="button" onclick="resetFilters()" class="text-xs text-outline hover:text-primary font-medium flex items-center gap-1.5 px-3 py-2 rounded-xl border border-border-standard hover:bg-surface-container-low transition-colors cursor-pointer shrink-0" title="Đặt lại bộ lọc">
            <span class="material-symbols-outlined text-[16px]">restart_alt</span>
            <span>Đặt lại</span>
        </button>
    </div>

    <!-- Table Section (SPA Ajax Replace Target) -->
    <div id="table-wrapper">
        @await Html.PartialAsync("_DangKyHocTablePartial", Model)
    </div>
</div>

