@section Scripts {
<script>
    let currentPage = @currentPage;
    let searchDebounceTimer = null;
    let currentHocPhiGoc = 0;

    // Filter Listeners
    document.getElementById('searchInput').addEventListener('input', function() {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => { currentPage = 1; loadTableData(); }, 350);
    });

    document.getElementById('filterMaCT')?.addEventListener('change', () => { currentPage = 1; loadTableData(); });
    document.getElementById('filterTrangThai')?.addEventListener('change', () => { currentPage = 1; loadTableData(); });
    document.getElementById('filterSortBy')?.addEventListener('change', () => { currentPage = 1; loadTableData(); });
    document.getElementById('filterTuNgay')?.addEventListener('change', () => { currentPage = 1; loadTableData(); });
    document.getElementById('filterDenNgay')?.addEventListener('change', () => { currentPage = 1; loadTableData(); });

    function resetFilters() {
        if (document.getElementById('searchInput')) document.getElementById('searchInput').value = '';
        if (document.getElementById('filterMaCT')) document.getElementById('filterMaCT').value = '';
        if (document.getElementById('filterTrangThai')) document.getElementById('filterTrangThai').value = '';
        if (document.getElementById('filterSortBy')) document.getElementById('filterSortBy').value = '';
        if (document.getElementById('filterTuNgay')) document.getElementById('filterTuNgay').value = '';
        if (document.getElementById('filterDenNgay')) document.getElementById('filterDenNgay').value = '';
        currentPage = 1;
        loadTableData();
    }

    function changePage(page) {
        currentPage = page;
        loadTableData();
    }

    function loadTableData() {
        const search = document.getElementById('searchInput')?.value.trim() || '';
        const maChuongTrinh = document.getElementById('filterMaCT')?.value || '';
        const trangThai = document.getElementById('filterTrangThai')?.value || '';
        const sortBy = document.getElementById('filterSortBy')?.value || '';
        const tuNgay = document.getElementById('filterTuNgay')?.value || '';
        const denNgay = document.getElementById('filterDenNgay')?.value || '';

        const params = new URLSearchParams({
            search: search,
            maChuongTrinh: maChuongTrinh,
            trangThai: trangThai,
            sortBy: sortBy,
            tuNgay: tuNgay,
            denNgay: denNgay,
            page: currentPage
        });

        const wrapper = document.getElementById('table-wrapper');
        wrapper.classList.add('opacity-50');

        fetch(`/DangKyHoc/Index?${params.toString()}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.text())
        .then(html => {
            wrapper.innerHTML = html;
            wrapper.classList.remove('opacity-50');
        })
        .catch(err => {
            console.error(err);
            wrapper.classList.remove('opacity-50');
            if (window.showToast) window.showToast('Lỗi tải dữ liệu!', 'error');
        });
    }

    // Modal Duyệt
    function openDuyetModal(id, tenHV, tenLop) {
        document.getElementById('duyet-MaDangKy').value = id;
        document.getElementById('duyet-tenHV').innerText = tenHV;
        document.getElementById('duyet-tenLop').innerText = tenLop;

        const modal = document.getElementById('duyet-modal');
        const content = document.getElementById('duyet-modal-content');
        modal.classList.remove('opacity-0', 'pointer-events-none');
        content.classList.remove('scale-95');
        content.classList.add('scale-100');
    }

    function closeDuyetModal() {
        const modal = document.getElementById('duyet-modal');
        const content = document.getElementById('duyet-modal-content');
        modal.classList.add('opacity-0', 'pointer-events-none');
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
    }

    function updateKpiStats(stats) {
        if (!stats) return;
        const elChoDuyet = document.getElementById('kpi-choduyet');
        const elDaDuyet = document.getElementById('kpi-daduyet');
        const elDoanhThu = document.getElementById('kpi-doanhthu');
        if (elChoDuyet && stats.choDuyetCount !== undefined) elChoDuyet.innerText = stats.choDuyetCount;
        if (elDaDuyet && stats.daDuyetCount !== undefined) elDaDuyet.innerText = stats.daDuyetCount;
        if (elDoanhThu && stats.tongDoanhThuFormatted) elDoanhThu.innerText = stats.tongDoanhThuFormatted;
    }

    function submitDuyet(e) {
        e.preventDefault();
        const formData = new FormData(document.getElementById('duyetForm'));

        fetch('/DangKyHoc/DuyetDangKyPost', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                closeDuyetModal();
                if (window.showToast) window.showToast(res.message, 'success');
                updateKpiStats(res.stats);
                loadTableData();
            } else {
                if (window.showToast) window.showToast(res.message, 'error');
            }
        })
        .catch(() => { if (window.showToast) window.showToast('Có lỗi xảy ra khi phê duyệt hồ sơ.', 'error'); });
    }

    // Modal Từ Chối
    function openTuChoiModal(id, tenHV) {
        document.getElementById('tuchoi-MaDangKy').value = id;
        document.getElementById('tuchoi-subtitle').innerText = `Từ chối đăng ký của học viên ${tenHV}`;
        document.getElementById('tuchoi-LyDo').value = '';

        const modal = document.getElementById('tuchoi-modal');
        const content = document.getElementById('tuchoi-modal-content');
        modal.classList.remove('opacity-0', 'pointer-events-none');
        content.classList.remove('scale-95');
        content.classList.add('scale-100');
    }

    function closeTuChoiModal() {
        const modal = document.getElementById('tuchoi-modal');
        const content = document.getElementById('tuchoi-modal-content');
        modal.classList.add('opacity-0', 'pointer-events-none');
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
    }

    function submitTuChoi(e) {
        e.preventDefault();
        const formData = new FormData(document.getElementById('tuchoiForm'));

        fetch('/DangKyHoc/TuChoiDangKyPost', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                closeTuChoiModal();
                if (window.showToast) window.showToast(res.message, 'success');
                updateKpiStats(res.stats);
                loadTableData();
            } else {
                if (window.showToast) window.showToast(res.message, 'error');
            }
        })
        .catch(() => { if (window.showToast) window.showToast('Có lỗi xảy ra khi từ chối hồ sơ.', 'error'); });
    }

    // Modal Thu Học Phí
    function openThuPhiModal(id) {
        fetch(`/DangKyHoc/GetDangKy?id=${id}`)
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    const d = res.data;
                    document.getElementById('thuphi-MaDangKy').value = d.maDangKy;
                    document.getElementById('thuphi-tenHV').innerText = d.tenHocVien;
                    document.getElementById('thuphi-tenLop').innerText = d.tenLop;
                    document.getElementById('thuphi-hocPhiGoc').innerText = Number(d.hocPhi).toLocaleString('vi-VN') + ' đ';
                    document.getElementById('thuphi-daDong').innerText = Number(d.soTienDaDong).toLocaleString('vi-VN') + ' đ';
                    
                    const conLai = Math.max(0, Number(d.hocPhi) - Number(d.soTienDaDong));
                    currentHocPhiGoc = conLai > 0 ? conLai : Number(d.hocPhi);
                    document.getElementById('thuphi-SoTien').value = currentHocPhiGoc;
                    document.getElementById('thuphi-GhiChu').value = '';

                    const modal = document.getElementById('thuphi-modal');
                    const content = document.getElementById('thuphi-modal-content');
                    modal.classList.remove('opacity-0', 'pointer-events-none');
                    content.classList.remove('scale-95');
                    content.classList.add('scale-100');
                } else {
                    if (window.showToast) window.showToast(res.message, 'error');
                }
            })
            .catch(() => { if (window.showToast) window.showToast('Không thể tải thông tin học phí.', 'error'); });
    }

    function fillFullTuition() {
        document.getElementById('thuphi-SoTien').value = currentHocPhiGoc;
    }

    function closeThuPhiModal() {
        const modal = document.getElementById('thuphi-modal');
        const content = document.getElementById('thuphi-modal-content');
        modal.classList.add('opacity-0', 'pointer-events-none');
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
    }

    function submitThuPhi(e) {
        e.preventDefault();
        const formData = new FormData(document.getElementById('thuphiForm'));

        fetch('/DangKyHoc/ThuHocPhiPost', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                closeThuPhiModal();
                if (window.showToast) window.showToast(res.message, 'success');
                updateKpiStats(res.stats);
                loadTableData();
            } else {
                if (window.showToast) window.showToast(res.message, 'error');
            }
        })
        .catch(() => { if (window.showToast) window.showToast('Có lỗi xảy ra khi thu học phí.', 'error'); });
    }

    // Bắt đầu học
    function batDauHoc(id) {
        const formData = new FormData();
        formData.append('id', id);
        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

        fetch('/DangKyHoc/BatDauHocPost', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                if (window.showToast) window.showToast(res.message, 'success');
                updateKpiStats(res.stats);
                loadTableData();
            } else {
                if (window.showToast) window.showToast(res.message, 'error');
            }
        })
        .catch(() => { if (window.showToast) window.showToast('Có lỗi xảy ra khi cập nhật trạng thái học.', 'error'); });
    }

    // Xóa đơn đăng ký
    function confirmDelete(id, name) {
        if (typeof openGlobalDeleteModal === 'function') {
            openGlobalDeleteModal({
                title: 'Xóa đơn đăng ký',
                message: `Bạn có chắc muốn xóa đơn đăng ký #DK${String(id).padStart(3, '0')} của học viên "${name}"?`,
                warning: 'Chỉ xóa được đơn ở trạng thái Chờ duyệt, Từ chối hoặc Đã hủy.',
                action: '/DangKyHoc/DeletePost',
                id: id,
                onSuccess: function(data) {
                    if (data && data.stats) updateKpiStats(data.stats);
                    loadTableData();
                }
            });
        }
    }

    // CSV Export
    function exportTableToCSV(filename) {
        const rows = document.querySelectorAll("#dangky-table tr");
        let csv = [];
        for (let i = 0; i < rows.length; i++) {
            let row = [], cols = rows[i].querySelectorAll("td, th");
            for (let j = 0; j < cols.length - 1; j++) {
                row.push('"' + cols[j].innerText.replace(/"/g, '""').trim() + '"');
            }
            csv.push(row.join(","));
        }
        const csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
        const downloadLink = document.createElement("a");
        downloadLink.download = filename;
        downloadLink.href = window.URL.createObjectURL(csvFile);
        downloadLink.style.display = "none";
        document.body.appendChild(downloadLink);
        downloadLink.click();
    }
</script>
