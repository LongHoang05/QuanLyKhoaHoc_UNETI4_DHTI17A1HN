                <input type="text" id="searchInput" value="@search" placeholder="Tìm kiếm theo học viên, email, SĐT, lớp..." 
                       class="w-full bg-surface-container-low border border-border-standard pl-9 pr-3 py-2 rounded-xl text-brand-deep text-xs focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
