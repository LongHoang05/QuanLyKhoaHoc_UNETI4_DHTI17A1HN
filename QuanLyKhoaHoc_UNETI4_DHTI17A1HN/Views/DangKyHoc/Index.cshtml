@model IEnumerable<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.DangKyHoc>
@{
    // Họ và tên: Nguyễn Hoàng Long
    // Mã sinh viên: 23103100046
    // Nội dung thực hiện: Xét duyệt đăng ký & Quản lý Học phí (Module 4) - Phong cách Prep.vn
    ViewData["Title"] = "Xét duyệt & Thu học phí";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    string search = ViewBag.Search ?? "";
    int? selectedMaCT = ViewBag.SelectedMaChuongTrinh;
    int? selectedMaLop = ViewBag.SelectedMaLop;
    string selectedTrangThai = ViewBag.SelectedTrangThai ?? "";
    string tuNgay = ViewBag.TuNgay ?? "";
    string denNgay = ViewBag.DenNgay ?? "";
    string sortBy = ViewBag.SortBy ?? "";
    var chuongTrinhList = ViewBag.ChuongTrinhList as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.ChuongTrinhDaoTao> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.ChuongTrinhDaoTao>();
    var lopHocList = ViewBag.LopHocList as IEnumerable<dynamic> ?? new List<dynamic>();
}

<div id="dangky-content-area" class="flex flex-col gap-y-6 transition-opacity duration-200">
    <!-- Sub-header Navigation Bar -->
    <section class="bg-surface-white rounded-2xl border border-border-standard shadow-sm p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4 card-pro">
        <div>
            <div class="flex items-center gap-2 text-outline font-label-sm text-label-sm uppercase tracking-wider mb-1">
                <span>ĐÀO TẠO UNETI</span>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-primary font-semibold">XÉT DUYỆT &amp; THU HỌC PHÍ</span>
            </div>
            <h1 class="font-headline-md text-headline-md text-brand-deep font-bold tracking-tight">
                Tiếp Nhận & Xử Lý Đơn Đăng Ký
            </h1>
        </div>

        <div class="flex items-center gap-2.5">
            <button onclick="exportTableToCSV('danh-sach-dang-ky.csv')" class="hidden">
