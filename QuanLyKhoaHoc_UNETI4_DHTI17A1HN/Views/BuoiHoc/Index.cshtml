                        <button type="button" onclick="confirmCleanupConflicts()" class="px-2 py-0.5 bg-danger-crimson hover:bg-red-700 text-surface-white rounded-lg text-xs font-bold transition-all shadow-xs cursor-pointer inline-flex items-center gap-1">
