                                        <div class="flex items-center gap-1.5 font-medium">
                                            <span class="material-symbols-outlined text-[16px] text-outline">person</span>
                                            <span>@item.GiangVien</span>
                                        </div>
                                    </td>
                                    <td class="py-4 px-4">
                                        @if (isConflict)
                                        {
                                            <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-danger-crimson bg-red-100 px-2.5 py-1 rounded-full animate-pulse">
                                                <span class="w-1.5 h-1.5 rounded-full bg-danger-crimson"></span>
                                                Trùng ca học
                                            </span>
                                        }
                                        else if (item.TrangThai == "Đã hoàn thành")
                                        {
                                            <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-success-emerald bg-[#10B981]/10 px-2.5 py-1 rounded-full">
                                                <span class="w-1.5 h-1.5 rounded-full bg-success-emerald"></span>
                                                Hoàn thành
                                            </span>
                                        }
                                        else if (item.TrangThai == "Đã hủy")
                                        {
                                            <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-outline bg-surface-container px-2.5 py-1 rounded-full">
                                                <span class="w-1.5 h-1.5 rounded-full bg-outline"></span>
                                                Đã hủy
                                            </span>
                                        }
                                        else if (overdueIds.Contains(item.MaBuoiHoc) || (item.ThoiGianKetThuc < DateTime.Now && item.TrangThai == "Đã lên lịch"))
                                        {
                                            <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-amber-800 bg-amber-100/90 px-2.5 py-1 rounded-full font-medium" title="Buổi học đã kết thúc nhưng chưa hoàn thành hoặc điểm danh">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                                Đã kết thúc (Chờ xác nhận)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-primary bg-primary/10 px-2.5 py-1 rounded-full">
                                                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                                                Đã lên lịch
                                            </span>
                                        }
                                    </td>
                                    <td class="py-4 px-6 text-right">
                                        <div class="inline-flex items-center gap-1">
                                            <button onclick="openEditDrawerFromRow(this)" class="p-1.5 rounded-lg text-outline hover:text-secondary-container hover:bg-surface-container-low transition-colors cursor-pointer" title="Chỉnh sửa">
                                                <span class="material-symbols-outlined text-[18px]">edit</span>
                                            </button>
                                            <button onclick="confirmDelete(@item.MaBuoiHoc, '@($"#BH{item.MaBuoiHoc:D3}") - @((item.LopHoc?.TenLop ?? "").Replace("'", "\\'")) (@((item.PhongHoc ?? "").Replace("'", "\\'")))')" class="p-1.5 rounded-lg text-outline hover:text-danger-crimson hover:bg-red-50 transition-colors cursor-pointer" title="Xóa buổi học">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Clean Reusable Pagination Component -->
            @await Html.PartialAsync("_Pagination", new QuanLyKhoaHoc_UNETI4_DHTI17A1HN.ViewModels.PaginationModel {
                CurrentPage = currentPage,
                TotalPages = totalPages,
                TotalItems = totalRecords,
                PageSize = pageSize,
                ItemLabel = "buổi học",
                BaseUrl = "/BuoiHoc/Index",
                AjaxFunction = "loadBuoiHocPage",
                RouteParams = new Dictionary<string, string?> {
                    { "maLop", selectedMaLop?.ToString() },
                    { "phong", selectedPhong },
                    { "trangThai", selectedTrangThai },
                    { "search", search }
                }
            })
            </div>
        </div>
    </div>

<!-- RIGHT SLIDE-OVER DRAWER (CREATE / UPDATE FORM - Smooth Slide Animation) -->
