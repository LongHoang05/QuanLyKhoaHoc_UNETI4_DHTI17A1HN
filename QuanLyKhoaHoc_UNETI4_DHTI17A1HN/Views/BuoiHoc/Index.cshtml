Họ và tên: Nguyễn Tùng Dương
Mã sinh viên: 23103100003
Nội dung thực hiện: Module 5 - Quản lý lịch học: Thời khóa biểu dạng tuần kết hợp CRUD chuẩn Prep.vn
*@

@model IEnumerable<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.BuoiHoc>
@{
    ViewData["Title"] = "Quản lý lịch học";

    Func<DateTime, int> getCa = (dt) => {
        TimeSpan t = dt.TimeOfDay;
        if (t < new TimeSpan(9, 25, 0)) return 1; // Ca 1 (Sáng 1): 07:00 - 09:15
        if (t < new TimeSpan(13, 0, 0)) return 2;  // Ca 2 (Sáng 2): 09:30 - 11:45
        if (t < new TimeSpan(15, 55, 0)) return 3; // Ca 3 (Chiều 1): 13:30 - 15:45
        return 4;                                   // Ca 4 (Chiều 2): 16:00 - 18:15
    };

    var days = new DayOfWeek[] {
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday
    };

    var dayNames = new Dictionary<DayOfWeek, string> {
        { DayOfWeek.Monday, "Thứ 2" },
        { DayOfWeek.Tuesday, "Thứ 3" },
        { DayOfWeek.Wednesday, "Thứ 4" },
        { DayOfWeek.Thursday, "Thứ 5" },
        { DayOfWeek.Friday, "Thứ 6" },
        { DayOfWeek.Saturday, "Thứ 7" },
        { DayOfWeek.Sunday, "Chủ Nhật" }
    };

    var caNames = new Dictionary<int, (string TenCa, string Gio, string Tiet)> {
        { 1, ("Ca 1 (Sáng)", "07:00 - 09:15", "Tiết 1-3") },
        { 2, ("Ca 2 (Sáng)", "09:30 - 11:45", "Tiết 4-6") },
        { 3, ("Ca 3 (Chiều)", "13:30 - 15:45", "Tiết 7-9") },
        { 4, ("Ca 4 (Chiều)", "16:00 - 18:15", "Tiết 10-12") }
    };

    var conflictIds = ViewBag.ConflictIds as HashSet<int> ?? new HashSet<int>();
    var overdueIds = ViewBag.OverdueIds as HashSet<int> ?? new HashSet<int>();
    var allBuoiHocs = ViewBag.AllBuoiHocs as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.BuoiHoc> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.BuoiHoc>();

    int totalSessions = ViewBag.TotalSessions ?? 0;
    int completedSessions = ViewBag.CompletedSessions ?? 0;
    int scheduledSessions = ViewBag.ScheduledSessions ?? 0;
    int canceledSessions = ViewBag.CanceledSessions ?? 0;
    int conflictCount = ViewBag.SoLoiTrung ?? 0;
    int soChinhKhoa = ViewBag.SoChinhKhoa ?? 0;
    int soThi = ViewBag.SoThi ?? 0;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? 0;
    int pageSize = ViewBag.PageSize ?? 8;
    int startRecord = totalRecords == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    int endRecord = Math.Min(currentPage * pageSize, totalRecords);

    var lopHocs = ViewBag.LopHocList as IEnumerable<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc>();
    var danhSachPhong = ViewBag.DanhSachPhong as IEnumerable<string> ?? new List<string>();
    var danhSachGV = ViewBag.DanhSachGiangVien as IEnumerable<string> ?? new List<string>();
    var giangVienList = ViewBag.GiangVienList as IEnumerable<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.GiangVien> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.GiangVien>();

    int? selectedMaLop = ViewBag.SelectedMaLop;
    string selectedPhong = ViewBag.SelectedPhong as string ?? "";
    string selectedTrangThai = ViewBag.SelectedTrangThai as string ?? "";
    string search = ViewBag.Search as string ?? "";

    double completionRate = totalSessions > 0 ? Math.Round((double)completedSessions / totalSessions * 100, 1) : 0;

    DateTime today = DateTime.Today;
    int diffToMonday = (7 + (int)today.DayOfWeek - (int)DayOfWeek.Monday) % 7;
    DateTime mondayDate = ViewBag.CurrentMonday != null ? (DateTime)ViewBag.CurrentMonday : today.AddDays(-diffToMonday);
    DateTime sundayDate = ViewBag.CurrentSunday != null ? (DateTime)ViewBag.CurrentSunday : mondayDate.AddDays(6);
    int weekOfYear = ViewBag.WeekOfYear != null ? (int)ViewBag.WeekOfYear : System.Globalization.ISOWeek.GetWeekOfYear(mondayDate);

    var dayDates = new Dictionary<DayOfWeek, DateTime> {
        { DayOfWeek.Monday, mondayDate },
        { DayOfWeek.Tuesday, mondayDate.AddDays(1) },
        { DayOfWeek.Wednesday, mondayDate.AddDays(2) },
        { DayOfWeek.Thursday, mondayDate.AddDays(3) },
        { DayOfWeek.Friday, mondayDate.AddDays(4) },
        { DayOfWeek.Saturday, mondayDate.AddDays(5) },
        { DayOfWeek.Sunday, mondayDate.AddDays(6) }
    };
    int totalRoomsCount = danhSachPhong.Any() ? danhSachPhong.Count() : 12;
}

<!-- Flash Notifications -->
