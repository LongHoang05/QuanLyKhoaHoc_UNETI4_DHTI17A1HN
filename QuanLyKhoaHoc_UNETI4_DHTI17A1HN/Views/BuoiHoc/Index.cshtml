                                            @item.ThoiGianBatDau.ToString("dd/MM/yyyy")
                                        </div>
                                        <div class="text-[12px] text-outline font-mono">
                                            @item.ThoiGianBatDau.ToString("HH:mm") - @item.ThoiGianKetThuc.ToString("HH:mm")
                                        </div>
                                    </td>
