@*
Họ và tên: Nguyễn Tùng Dương
Mã sinh viên: 23103100003
Nội dung thực hiện: Module 5 - Quản lý lịch học: Thời khóa biểu dạng tuần kết hợp CRUD chuẩn Prep.vn
*@

@model IEnumerable<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.BuoiHoc>
@{
    ViewData["Title"] = "Quản lý lịch học";

    Func<DateTime, int> getCa = (dt) => {
        int h = dt.Hour;
        if (h < 9 || (h == 9 && dt.Minute <= 20)) return 1;
        if (h < 13) return 2;
        if (h < 16) return 3;
        return 4;
    };

    var days = new DayOfWeek[] {
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday
    };

    var dayNames = new Dictionary<DayOfWeek, string> {
        { DayOfWeek.Monday, "Thứ 2" },
        { DayOfWeek.Tuesday, "Thứ 3" },
        { DayOfWeek.Wednesday, "Thứ 4" },
        { DayOfWeek.Thursday, "Thứ 5" },
        { DayOfWeek.Friday, "Thứ 6" },
        { DayOfWeek.Saturday, "Thứ 7" }
    };

    var caNames = new Dictionary<int, (string TenCa, string Gio, string Tiet)> {
        { 1, ("Ca 1 (Sáng)", "07:00 - 09:15", "Tiết 1-3") },
        { 2, ("Ca 2 (Sáng)", "09:30 - 11:45", "Tiết 4-6") },
        { 3, ("Ca 3 (Chiều)", "13:30 - 15:45", "Tiết 7-9") },
        { 4, ("Ca 4 (Chiều)", "16:00 - 18:15", "Tiết 10-12") }
    };

    var conflictIds = ViewBag.ConflictIds as HashSet<int> ?? new HashSet<int>();
    var allBuoiHocs = ViewBag.AllBuoiHocs as List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.BuoiHoc> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.BuoiHoc>();

    int totalSessions = ViewBag.TotalSessions ?? 0;
    int completedSessions = ViewBag.CompletedSessions ?? 0;
    int scheduledSessions = ViewBag.ScheduledSessions ?? 0;
    int canceledSessions = ViewBag.CanceledSessions ?? 0;
    int conflictCount = ViewBag.SoLoiTrung ?? 0;
    int soChinhKhoa = ViewBag.SoChinhKhoa ?? 0;
    int soThi = ViewBag.SoThi ?? 0;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? 0;
    int pageSize = ViewBag.PageSize ?? 8;
    int startRecord = totalRecords == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    int endRecord = Math.Min(currentPage * pageSize, totalRecords);

    var lopHocs = ViewBag.LopHocList as IEnumerable<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc> ?? new List<QuanLyKhoaHoc_UNETI4_DHTI17A1HN.Models.LopHoc>();
    var danhSachPhong = ViewBag.DanhSachPhong as IEnumerable<string> ?? new List<string>();
    var danhSachGV = ViewBag.DanhSachGiangVien as IEnumerable<string> ?? new List<string>();

    int? selectedMaLop = ViewBag.SelectedMaLop;
    string selectedPhong = ViewBag.SelectedPhong as string ?? "";
    string selectedTrangThai = ViewBag.SelectedTrangThai as string ?? "";
    string search = ViewBag.Search as string ?? "";

    double completionRate = totalSessions > 0 ? Math.Round((double)completedSessions / totalSessions * 100, 1) : 0;

    DateTime today = DateTime.Today;
    int diffToMonday = (7 + (int)today.DayOfWeek - (int)DayOfWeek.Monday) % 7;
    DateTime mondayDate = today.AddDays(-diffToMonday);
    DateTime sundayDate = mondayDate.AddDays(6);
    int weekOfYear = System.Globalization.ISOWeek.GetWeekOfYear(today);

    var dayDates = new Dictionary<DayOfWeek, DateTime> {
        { DayOfWeek.Monday, mondayDate },
        { DayOfWeek.Tuesday, mondayDate.AddDays(1) },
        { DayOfWeek.Wednesday, mondayDate.AddDays(2) },
        { DayOfWeek.Thursday, mondayDate.AddDays(3) },
        { DayOfWeek.Friday, mondayDate.AddDays(4) },
        { DayOfWeek.Saturday, mondayDate.AddDays(5) }
    };
    int totalRoomsCount = danhSachPhong.Any() ? danhSachPhong.Count() : 12;
}

<!-- Flash Notifications -->
@if (TempData["Success"] != null)
{
    <div id="toast-success" class="mb-4 flex items-center justify-between p-4 bg-emerald-50 border border-emerald-200 rounded-2xl text-emerald-800 shadow-sm animate-fade-in">
        <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-success-emerald text-[22px]">check_circle</span>
            <span class="font-label-md text-label-md font-semibold">@TempData["Success"]</span>
        </div>
        <button onclick="document.getElementById('toast-success').remove()" class="text-emerald-600 hover:text-emerald-900 cursor-pointer">
            <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div id="toast-error" class="mb-4 flex items-center justify-between p-4 bg-red-50 border border-red-200 rounded-2xl text-danger-crimson shadow-sm animate-fade-in">
        <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-danger-crimson text-[22px]">error</span>
            <span class="font-label-md text-label-md font-semibold">@TempData["Error"]</span>
        </div>
        <button onclick="document.getElementById('toast-error').remove()" class="text-red-500 hover:text-red-800 cursor-pointer">
            <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
    </div>
}

<div id="buoihoc-content-area" class="flex flex-col gap-y-6 transition-opacity duration-200">
    <!-- Contextual Sub-Header & Controls -->
    <section class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-surface-white p-5 rounded-2xl border border-border-subtle shadow-[0_2px_12px_rgba(13, 71, 161,0.03)]">
        <div class="flex items-center gap-space-sm min-w-0">
            <div class="flex flex-col">
                <div class="flex items-center gap-1.5 text-outline font-label-sm text-label-sm tracking-wide">
                    <span>ĐÀO TẠO UNETI</span>
                    <span class="material-symbols-outlined text-[13px]">chevron_right</span>
                    <span class="text-primary-container font-semibold">LỊCH HỌC & PHÒNG MÁY</span>
                </div>
                <h1 class="font-headline-md text-headline-md text-brand-deep tracking-tight truncate font-extrabold mt-0.5">
                    Quản lý lịch học
                </h1>
            </div>
        </div>

        <div class="flex items-center flex-wrap gap-2.5">
            <!-- View Mode Switcher -->
            <div class="flex p-1 bg-surface-container-low rounded-xl border border-border-subtle text-xs font-semibold">
                <button type="button" id="tab-btn-timetable" onclick="switchView('timetable')" class="px-3.5 py-1.5 rounded-lg bg-surface-white text-primary-container font-bold shadow-xs transition-all flex items-center gap-1.5 cursor-pointer">
                    <span class="material-symbols-outlined text-[16px]">calendar_view_week</span>
                    <span>Thời khóa biểu tuần</span>
                </button>
                <button type="button" id="tab-btn-table" onclick="switchView('table')" class="px-3.5 py-1.5 rounded-lg text-outline hover:text-brand-deep transition-all flex items-center gap-1.5 cursor-pointer">
                    <span class="material-symbols-outlined text-[16px]">table_rows</span>
                    <span>Danh sách chi tiết</span>
                </button>
            </div>

            @* <button onclick="exportTableToCSV('danh-sach-lich-hoc.csv')" class="inline-flex items-center gap-1.5 bg-surface-white border border-border-standard hover:bg-surface-container-low text-brand-deep font-label-md text-label-md px-3.5 py-2 rounded-xl transition-all shadow-xs cursor-pointer">
                <span class="material-symbols-outlined text-[18px] text-primary">file_download</span>
                <span class="hidden sm:inline">Xuất Excel</span>
            </button> *@
            <button onclick="openDrawer('create')" class="inline-flex items-center gap-1.5 bg-secondary-container hover:bg-secondary text-surface-white font-label-md text-label-md px-4 py-2 rounded-xl shadow-sm hover:shadow-md transition-transform active:scale-95 cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                <span> Xếp lịch học</span>
            </button>
        </div>
    </section>

    <!-- Quick Analytics Stats Row (3 Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Stat 1 -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_1px_3px_rgba(13, 71, 161,0.04),0_8px_24px_-4px_rgba(13, 71, 161,0.06)] flex items-center justify-between">
            <div>
                <span class="font-label-sm text-label-sm text-outline tracking-wider uppercase block mb-1">Tổng số buổi học</span>
                <div class="flex items-baseline gap-2">
                    <span class="font-metric-stat text-metric-stat text-brand-deep tabular-nums">@totalSessions</span>
                    <span class="font-body-sm text-body-sm text-outline">buổi</span>
                </div>
                <div class="flex items-center gap-2 mt-2">
                    <span class="inline-flex items-center gap-1 font-label-sm text-label-sm text-success-emerald bg-[#10B981]/10 px-2 py-0.5 rounded-full">
                        <span class="w-1.5 h-1.5 rounded-full bg-success-emerald animate-pulse"></span>
                        @scheduledSessions Đang mở
                    </span>
                    <span class="font-body-sm text-body-sm text-outline">/ @canceledSessions Đã hủy</span>
                </div>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[26px]">calendar_month</span>
            </div>
        </div>

        <!-- Stat 2 -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_1px_3px_rgba(13, 71, 161,0.04),0_8px_24px_-4px_rgba(13, 71, 161,0.06)] flex items-center justify-between">
            <div>
                <span class="font-label-sm text-label-sm text-outline tracking-wider uppercase block mb-1">Buổi học đã hoàn thành</span>
                <div class="flex items-baseline gap-2">
                    <span class="font-metric-stat text-metric-stat text-brand-deep tabular-nums">@completedSessions</span>
                    <span class="font-body-sm text-body-sm text-outline">buổi</span>
                </div>
                <div class="flex items-center gap-1.5 mt-2">
                    <span class="font-label-sm text-label-sm text-primary font-bold">@completionRate%</span>
                    <span class="font-body-sm text-body-sm text-on-surface-variant">tiến độ hoàn tất</span>
                </div>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-secondary-container/10 flex items-center justify-center text-secondary-container">
                <span class="material-symbols-outlined text-[26px]">fact_check</span>
            </div>
        </div>

        <!-- Stat 3 -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_1px_3px_rgba(13, 71, 161,0.04),0_8px_24px_-4px_rgba(13, 71, 161,0.06)] flex items-center justify-between">
            <div class="min-w-0 pr-2">
                <span class="font-label-sm text-label-sm text-outline tracking-wider uppercase block mb-1">Cảnh báo trùng lịch</span>
                <p class="font-headline-sm text-headline-sm text-brand-deep truncate">
                    @(conflictCount > 0 ? $"{conflictCount} ca học xung đột" : "An toàn - 0 xung đột")
                </p>
                <div class="flex items-center gap-2 mt-2 flex-wrap">
                    @if (conflictCount > 0)
                    {
                        <span class="font-label-md text-label-md text-danger-crimson font-bold tabular-nums">Cần xếp lại</span>
                        <span class="font-body-sm text-body-sm text-outline">(Trùng phòng / GV)</span>
                        <form method="post" action="/BuoiHoc/XuLyTrungLich" class="inline" onsubmit="return confirm('Bạn có chắc muốn tự động dọn dẹp các ca học bị trùng lịch (hủy bớt các ca lặp và giữ lại 1 ca chuẩn)?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="px-2 py-0.5 bg-danger-crimson hover:bg-red-700 text-surface-white rounded-lg text-xs font-bold transition-all shadow-xs cursor-pointer inline-flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">auto_fix_high</span>
                                Dọn dẹp ca trùng
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="font-label-md text-label-md text-success-emerald font-bold tabular-nums">Tối ưu</span>
                        <span class="font-body-sm text-body-sm text-outline">(Đúng quy định UNETI)</span>
                    }
                </div>
            </div>
            <div class="w-12 h-12 rounded-2xl @(conflictCount > 0 ? "bg-red-100 text-danger-crimson" : "bg-tertiary/10 text-tertiary") flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[26px]">@(conflictCount > 0 ? "warning" : "verified")</span>
            </div>
        </div>
    </div>

    <!-- ==================== VIEW 1: THỜI KHÓA BIỂU DẠNG TUẦN (MẪU CHUẨN ĐÀO TẠO MỚI) ==================== -->
    <div id="view-timetable" class="flex flex-col gap-5 min-w-0 w-full">
        <!-- Top Toolbar: Navigation Tuần & Bộ lọc trực quan -->
        <div class="bg-surface-white p-4 rounded-2xl border border-border-subtle shadow-sm flex flex-col xl:flex-row xl:items-center justify-between gap-3">
            <!-- Left: Điều hướng tuần -->
            <div class="flex items-center gap-2.5 flex-wrap">
                <button type="button" onclick="goToToday()" class="px-3 py-1.5 rounded-xl border border-border-standard bg-surface-white hover:bg-surface-container-low text-brand-deep font-label-sm text-xs font-bold transition-all shadow-2xs cursor-pointer">
                    Hôm nay
                </button>
                <div class="flex items-center gap-1 bg-surface-container-low p-1 rounded-xl border border-border-subtle">
                    <button type="button" onclick="changeWeek(-1)" class="w-7 h-7 rounded-lg bg-surface-white text-outline hover:text-brand-deep hover:bg-surface-container flex items-center justify-center transition-all shadow-2xs cursor-pointer" title="Tuần trước">
                        <span class="material-symbols-outlined text-[16px]">chevron_left</span>
                    </button>
                    <button type="button" onclick="changeWeek(1)" class="w-7 h-7 rounded-lg bg-surface-white text-outline hover:text-brand-deep hover:bg-surface-container flex items-center justify-center transition-all shadow-2xs cursor-pointer" title="Tuần tiếp theo">
                        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    </button>
                </div>
                <div class="flex items-center gap-2">
                    <span class="font-bold text-sm text-brand-deep" id="week-display-title">
                        Tuần @(weekOfYear) (@mondayDate.ToString("dd/MM") - @sundayDate.ToString("dd/MM/yyyy"))
                    </span>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200/70 text-xs font-semibold">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span id="week-sessions-count">@(allBuoiHocs.Count(b => b.TrangThai != "Đã hủy")) buổi học phân bổ</span>
                    </span>
                </div>
            </div>

            <!-- Right: Bộ lọc nhanh Phòng máy, Giảng viên, Trạng thái & Cuộn ma trận -->
            <div class="flex items-center gap-2 flex-wrap">
                <!-- Dropdown lọc phòng -->
                <div class="relative">
                    <select id="filter-timetable-phong" onchange="applyTimetableFilters()" class="appearance-none bg-surface-container-low border border-border-standard text-brand-deep font-label-sm text-xs px-3 py-1.5 pr-7 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-white transition-colors">
                        <option value="">Tất cả phòng học (@totalRoomsCount phòng)</option>
                        @foreach (var p in danhSachPhong)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                    <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[15px]">expand_more</span>
                </div>

                <!-- Dropdown lọc giảng viên -->
                <div class="relative">
                    <select id="filter-timetable-gv" onchange="applyTimetableFilters()" class="appearance-none bg-surface-container-low border border-border-standard text-brand-deep font-label-sm text-xs px-3 py-1.5 pr-7 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-white transition-colors">
                        <option value="">Tất cả giảng viên</option>
                        @foreach (var gv in danhSachGV)
                        {
                            <option value="@gv">@gv</option>
                        }
                    </select>
                    <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[15px]">expand_more</span>
                </div>

                <!-- Dropdown lọc trạng thái -->
                <div class="relative">
                    <select id="filter-timetable-trangthai" onchange="applyTimetableFilters()" class="appearance-none bg-surface-container-low border border-border-standard text-brand-deep font-label-sm text-xs px-3 py-1.5 pr-7 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-white transition-colors">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Đã lên lịch">Đã lên lịch</option>
                        <option value="Đã hoàn thành">Đã hoàn thành</option>
                        <option value="Đã hủy">Đã hủy</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[15px]">expand_more</span>
                </div>

                @if (conflictCount > 0)
                {
                    <form method="post" action="/BuoiHoc/XuLyTrungLich" class="inline" onsubmit="return confirm('Bạn có chắc muốn tự động dọn dẹp các ca học bị trùng lặp?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="px-2.5 py-1.5 bg-danger-crimson hover:bg-red-700 text-surface-white rounded-xl text-xs font-bold transition-all shadow-xs cursor-pointer inline-flex items-center gap-1" title="Tự động hủy các ca trùng lặp">
                            <span class="material-symbols-outlined text-[14px]">auto_fix_high</span>
                            Dọn dẹp ca trùng
                        </button>
                    </form>
                }

                <!-- Nút cuộn ma trận ngang -->
                <div class="flex items-center gap-1 bg-surface-container-low p-1 rounded-xl border border-border-subtle text-xs">
                    <button type="button" onclick="scrollTimetable(-260)" class="w-6.5 h-6.5 rounded-lg bg-surface-white text-outline hover:text-brand-deep flex items-center justify-center transition-all shadow-2xs cursor-pointer" title="Cuộn sang trái">
                        <span class="material-symbols-outlined text-[16px]">chevron_left</span>
                    </button>
                    <button type="button" onclick="scrollTimetable(260)" class="w-6.5 h-6.5 rounded-lg bg-surface-white text-outline hover:text-brand-deep flex items-center justify-center transition-all shadow-2xs cursor-pointer" title="Cuộn sang phải">
                        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Weekly Timetable Grid Card -->
        <div class="bg-surface-white rounded-2xl border border-border-subtle shadow-[0_2px_12px_rgba(13, 71, 161,0.03)] overflow-hidden w-full relative">
            <div class="w-full overflow-x-auto custom-scrollbar pb-2.5" id="timetable-scroll-container">
                <div class="min-w-[1020px] w-full flex flex-col">
                    <!-- 1. Header: Ngày trong tuần (Thứ 2 -> Thứ 7) -->
                    <div class="grid grid-cols-[130px_repeat(6,minmax(148px,1fr))] bg-canvas-base border-b border-border-standard text-xs font-bold text-brand-deep sticky top-0 z-10">
                        <div class="py-3 px-2 border-r border-border-standard text-center flex flex-col items-center justify-center">
                            <span class="font-bold text-[11px] text-brand-deep uppercase tracking-wider">KHUNG GIỜ</span>
                            <span class="text-[9.5px] text-outline font-normal mt-0.5">Các ca học song song</span>
                        </div>
                        @foreach (var day in days)
                        {
                            var isToday = today.DayOfWeek == day;
                            var dDate = dayDates[day];
                            var countInDay = allBuoiHocs.Count(b => b.ThoiGianBatDau.DayOfWeek == day && b.TrangThai != "Đã hủy");

                            <div class="py-3 px-2 border-r border-border-standard text-center min-w-0 @(isToday ? "bg-primary/5" : "")">
                                @if (isToday)
                                {
                                    <div class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-primary text-surface-white font-bold text-xs shadow-xs">
                                        <span>@dayNames[day]</span>
                                    </div>
                                    <div class="text-[11px] font-semibold text-primary mt-1 truncate">
                                        <span id="day-date-@day">@dDate.ToString("dd/MM")</span> • Hôm nay (@countInDay lớp)
                                    </div>
                                }
                                else
                                {
                                    <div class="font-bold text-brand-deep text-sm truncate">
                                        @dayNames[day]
                                    </div>
                                    <div class="text-[11px] text-outline font-medium mt-0.5 truncate">
                                        <span id="day-date-@day">@dDate.ToString("dd/MM")</span> • @countInDay ca dạy
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- 2. BUỔI SÁNG (07:00 – 11:45) -->
                    <div class="bg-amber-500/10 border-b border-amber-200/80 px-4 py-2 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                            <span class="font-bold text-xs text-brand-deep uppercase tracking-wider">BUỔI SÁNG</span>
                            <span class="font-mono text-xs text-outline">07:00 – 11:45</span>
                        </div>
                        <span class="text-[11px] text-outline italic hidden sm:inline">Tiết 1 đến Tiết 6</span>
                    </div>

                    <!-- Ca 1: Tiết 1 - 3 -->
                    <div class="grid grid-cols-[130px_repeat(6,minmax(148px,1fr))] min-h-[145px] divide-x divide-border-subtle border-b border-border-subtle hover:bg-canvas-base/15 transition-colors">
                        <div class="p-3 bg-canvas-base/50 flex flex-col justify-center items-center text-center select-none border-r border-border-standard">
                            <span class="text-[12px] font-bold text-brand-deep">Tiết 1 – 3</span>
                            <span class="text-[10.5px] font-mono text-outline mt-0.5">07:00 - 09:15</span>
                            <span class="text-[9px] font-bold text-outline bg-surface-container-high px-2 py-0.5 rounded-md mt-1.5 border border-border-subtle">Ca 1</span>
                        </div>
                        @foreach (var day in days)
                        {
                            var classesInSlot = allBuoiHocs
