                    }
                </div>
            </div>
            <div class="w-12 h-12 rounded-2xl @(conflictCount > 0 ? "bg-red-100 text-danger-crimson" : "bg-tertiary/10 text-tertiary") flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[26px]">@(conflictCount > 0 ? "warning" : "verified")</span>
            </div>
        </div>
    </div>

        <!-- ==================== VIEW 1: THỜI KHÓA BIỂU DẠNG TUẦN (MẪU CHUẨN ĐÀO TẠO MỚI) ==================== -->
    <div id="view-timetable" class="flex flex-col gap-5 min-w-0 w-full">
        <!-- Top Toolbar: Navigation Tuần & Bộ lọc trực quan -->
        <div class="bg-surface-white p-4 rounded-2xl border border-border-standard shadow-sm flex flex-col xl:flex-row xl:items-center justify-between gap-3">
            <!-- Left: Điều hướng tuần -->
            <div class="flex items-center gap-2.5 flex-wrap">
                <button type="button" onclick="goToToday()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-border-standard bg-surface-white hover:bg-surface-container-low text-brand-deep font-label-sm text-xs font-bold transition-all shadow-2xs hover:shadow-xs cursor-pointer active:scale-95">
                    <span class="material-symbols-outlined text-[16px] text-primary">today</span>
                    <span>Tuần hiện tại</span>
                </button>
                <div class="flex items-center gap-1 bg-surface-container-low p-1 rounded-xl border border-border-subtle">
                    <button type="button" onclick="changeWeek(-1)" class="w-7 h-7 rounded-lg bg-surface-white text-outline hover:text-brand-deep hover:bg-surface-container flex items-center justify-center transition-all shadow-2xs cursor-pointer active:scale-95" title="Tuần trước">
                        <span class="material-symbols-outlined text-[16px]">chevron_left</span>
                    </button>
                    <button type="button" onclick="changeWeek(1)" class="w-7 h-7 rounded-lg bg-surface-white text-outline hover:text-brand-deep hover:bg-surface-container flex items-center justify-center transition-all shadow-2xs cursor-pointer active:scale-95" title="Tuần tiếp theo">
                        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    </button>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-bold text-sm text-brand-deep" id="week-display-title">
                        Tuần @(weekOfYear) (@mondayDate.ToString("dd/MM") - @sundayDate.ToString("dd/MM/yyyy"))
                    </span>
                    <input type="date" value="@mondayDate.ToString("yyyy-MM-dd")" onchange="navigateToWeek(this.value)" class="bg-surface-container-low border border-border-standard text-brand-deep font-mono text-xs px-2.5 py-1 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-white transition-colors" title="Chọn ngày để nhảy đến tuần tương ứng"/>
                    @{
                        int weekSessionsCount = allBuoiHocs.Count(b => b.ThoiGianBatDau.Date >= mondayDate.Date && b.ThoiGianBatDau.Date <= sundayDate.Date && b.TrangThai != "Đã hủy");
                    }
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200/70 text-xs font-semibold">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span id="week-sessions-count">@weekSessionsCount buổi học trong tuần</span>
                    </span>
                </div>
            </div>

            <!-- Right: Bộ lọc nhanh Phòng máy, Giảng viên, Trạng thái & Cuộn ma trận -->
            <div class="flex items-center gap-2 flex-wrap">
                <!-- Dropdown lọc phòng -->
                <div class="relative">
                    <select id="filter-timetable-phong" onchange="applyTimetableFilters()" class="appearance-none bg-surface-container-low border border-border-standard text-brand-deep font-label-sm text-xs px-3 py-1.5 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-white transition-colors">
                        <option value="">Tất cả phòng học (@totalRoomsCount phòng)</option>
                        @foreach (var p in danhSachPhong)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                    <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[15px] transition-transform duration-200">expand_more</span>
                </div>

                <!-- Dropdown lọc giảng viên -->
                <div class="relative">
                    <select id="filter-timetable-gv" onchange="applyTimetableFilters()" class="appearance-none bg-surface-container-low border border-border-standard text-brand-deep font-label-sm text-xs px-3 py-1.5 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-white transition-colors">
                        <option value="">Tất cả giảng viên</option>
                        @foreach (var gv in danhSachGV)
                        {
                            <option value="@gv">@gv</option>
                        }
                    </select>
                    <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[15px] transition-transform duration-200">expand_more</span>
                </div>

                <!-- Dropdown lọc trạng thái -->
                <div class="relative">
                    <select id="filter-timetable-trangthai" onchange="applyTimetableFilters()" class="appearance-none bg-surface-container-low border border-border-standard text-brand-deep font-label-sm text-xs px-3 py-1.5 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-white transition-colors">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Đã lên lịch">Đã lên lịch</option>
                        <option value="Đã hoàn thành">Đã hoàn thành</option>
                        <option value="Đã hủy">Đã hủy</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[15px] transition-transform duration-200">expand_more</span>
                </div>

                @if (conflictCount > 0)
                {
                    <button type="button" onclick="confirmCleanupConflicts()" class="px-2.5 py-1.5 bg-danger-crimson hover:bg-red-700 text-surface-white rounded-xl text-xs font-bold transition-all shadow-xs cursor-pointer inline-flex items-center gap-1 active:scale-95" title="Tự động hủy các ca trùng lặp">
                        <span class="material-symbols-outlined text-[14px]">auto_fix_high</span>
                        <span>Dọn dẹp ca trùng</span>
                    </button>
                }

                <!-- Nút cuộn ma trận ngang -->
                <div class="flex items-center gap-1 bg-surface-container-low p-1 rounded-xl border border-border-subtle text-xs">
                    <button type="button" onclick="scrollTimetable(-260)" class="w-6.5 h-6.5 rounded-lg bg-surface-white text-outline hover:text-brand-deep flex items-center justify-center transition-all shadow-2xs cursor-pointer active:scale-95" title="Cuộn sang trái">
                        <span class="material-symbols-outlined text-[16px]">chevron_left</span>
                    </button>
                    <button type="button" onclick="scrollTimetable(260)" class="w-6.5 h-6.5 rounded-lg bg-surface-white text-outline hover:text-brand-deep flex items-center justify-center transition-all shadow-2xs cursor-pointer active:scale-95" title="Cuộn sang phải">
                        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    </button>
                </div>
            </div>
        </div>

        @{
            var shiftSchedule = new[] {
                new { Ca = 1, Name = "Ca 1", Tiet = "Tiết 1 – 3", Time = "07:00 – 09:15" },
                new { Ca = 2, Name = "Ca 2", Tiet = "Tiết 4 – 6", Time = "09:30 – 11:45" },
                new { Ca = 3, Name = "Ca 3", Tiet = "Tiết 7 – 9", Time = "13:30 – 15:45" },
                new { Ca = 4, Name = "Ca 4", Tiet = "Tiết 10 – 12", Time = "16:00 – 18:15" }
            };
        }

        <!-- Weekly Timetable Grid Card -->
        <div class="bg-surface-white rounded-2xl border border-border-standard shadow-[0_2px_12px_rgba(13,71,161,0.04)] overflow-hidden w-full relative">
            <div class="w-full overflow-x-auto custom-scrollbar pb-1" id="timetable-scroll-container">
                <div class="min-w-[1200px] w-full flex flex-col">
                    <!-- 1. Header: Ngày trong tuần (Thứ 2 -> Chủ Nhật) -->
                    <div class="grid grid-cols-[140px_repeat(7,minmax(150px,1fr))] bg-canvas-base border-b border-border-standard text-xs font-bold text-brand-deep sticky top-0 z-20">
                        <div class="py-3.5 px-3 border-r border-border-standard text-center flex flex-col items-center justify-center bg-surface-container-low/70">
                            <span class="font-extrabold text-[11px] text-brand-deep uppercase tracking-wider flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[15px] text-primary">schedule</span>
                                KHUNG GIỜ
                            </span>
                            <span class="text-[10px] text-outline font-normal mt-0.5">Ca học song song</span>
                        </div>
                        @foreach (var day in days)
                        {
                            var dDate = dayDates[day];
                            var isToday = today.Date == dDate.Date;
                            var countInDay = allBuoiHocs.Count(b => b.ThoiGianBatDau.Date == dDate.Date && b.TrangThai != "Đã hủy");

                            <div class="py-3 px-3 border-r border-border-standard text-center min-w-0 transition-colors @(isToday ? "bg-primary/[0.04] relative" : "hover:bg-surface-container-low/40")">
                                @if (isToday)
                                {
                                    <div class="absolute top-0 left-0 right-0 h-1 bg-primary"></div>
                                    <div class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-primary text-surface-white font-bold text-xs shadow-xs tracking-tight">
                                        <span class="material-symbols-outlined text-[13px]">calendar_today</span>
                                        <span>@dayNames[day]</span>
                                    </div>
                                    <div class="text-[11px] font-semibold text-primary mt-1.5 flex items-center justify-center gap-1 truncate">
                                        <span id="day-date-@day" class="font-bold">@dDate.ToString("dd/MM")</span>
                                        <span class="text-outline/40">•</span>
                                        <span class="text-[10px] bg-primary/10 text-primary px-2 py-0.5 rounded-full font-bold">Hôm nay (@countInDay ca)</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="font-bold text-brand-deep text-sm tracking-tight truncate">
                                        @dayNames[day]
                                    </div>
                                    <div class="text-[11px] text-outline font-medium mt-1 flex items-center justify-center gap-1 truncate">
                                        <span id="day-date-@day" class="font-semibold text-brand-deep">@dDate.ToString("dd/MM")</span>
                                        <span class="text-outline/40">•</span>
                                        <span class="text-[10.5px] text-outline">@countInDay ca</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- 2. VÒNG LẶP CÁC CA HỌC (CA 1 -> CA 4) -->
                    @foreach (var shift in shiftSchedule)
                    {
                        @if (shift.Ca == 1)
                        {
                            <!-- Dải phân cách Buổi Sáng -->
                            <div class="bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent border-y border-amber-200/80 px-4 py-2 flex items-center justify-between sticky left-0 z-10">
                                <div class="flex items-center gap-2.5">
                                    <span class="w-6 h-6 rounded-lg bg-amber-500/15 text-amber-700 flex items-center justify-center shadow-2xs">
                                        <span class="material-symbols-outlined text-[15px]">wb_sunny</span>
                                    </span>
                                    <span class="font-extrabold text-xs text-amber-950 uppercase tracking-wider">BUỔI SÁNG</span>
                                    <span class="font-mono text-[11px] text-amber-800 bg-amber-100/70 border border-amber-200 px-2.5 py-0.5 rounded-full font-semibold">07:00 – 11:45</span>
                                </div>
                                <span class="text-[11px] text-amber-800/80 font-medium hidden sm:inline flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[13px]">school</span>
                                    Tiết 1 đến Tiết 6 (Ca 1 &amp; Ca 2)
                                </span>
                            </div>
                        }
                        else if (shift.Ca == 3)
                        {
                            <!-- Dải phân cách Buổi Chiều -->
                            <div class="bg-gradient-to-r from-primary/10 via-primary/5 to-transparent border-t-2 border-b border-primary/20 px-4 py-2 flex items-center justify-between sticky left-0 z-10">
                                <div class="flex items-center gap-2.5">
                                    <span class="w-6 h-6 rounded-lg bg-primary/15 text-primary flex items-center justify-center shadow-2xs">
                                        <span class="material-symbols-outlined text-[15px]">routine</span>
                                    </span>
                                    <span class="font-extrabold text-xs text-primary uppercase tracking-wider">BUỔI CHIỀU</span>
                                    <span class="font-mono text-[11px] text-primary bg-primary/10 border border-primary/20 px-2.5 py-0.5 rounded-full font-semibold">13:30 – 18:15</span>
                                </div>
                                <span class="text-[11px] text-outline font-medium hidden sm:inline flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[13px]">school</span>
                                    Tiết 7 đến Tiết 12 (Ca 3 &amp; Ca 4)
                                </span>
                            </div>
                        }

                        <!-- Hàng Ca Học -->
                        <div class="grid grid-cols-[140px_repeat(7,minmax(150px,1fr))] min-h-[145px] divide-x divide-border-subtle border-b border-border-subtle hover:bg-canvas-base/15 transition-colors">
                            <!-- Cột trái: Thông tin Ca & Giờ -->
                            <div class="p-3 bg-canvas-base/50 flex flex-col justify-center items-center text-center select-none border-r border-border-standard gap-1">
                                <span class="px-2.5 py-0.5 rounded-full bg-surface-white border border-border-standard shadow-2xs text-primary font-bold text-[10px] uppercase tracking-wide">
                                    @shift.Name
                                </span>
                                <span class="text-[12px] font-bold text-brand-deep">@shift.Tiet</span>
                                <span class="text-[10.5px] font-mono text-outline font-semibold flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[13px] text-outline">schedule</span>
                                    @shift.Time
                                </span>
                            </div>

                            @foreach (var day in days)
                            {
                                var targetDate = dayDates[day];
                                var classesInSlot = allBuoiHocs
                                    .Where(b => b.ThoiGianBatDau.Date == targetDate.Date && getCa(b.ThoiGianBatDau) == shift.Ca && b.TrangThai != "Đã hủy")
                                    .ToList();
                                int occupiedRooms = classesInSlot.Select(c => c.PhongHoc).Where(p => !string.IsNullOrEmpty(p)).Distinct().Count();
                                int emptyRooms = Math.Max(0, totalRoomsCount - occupiedRooms);
                                bool isConflict = classesInSlot.Count > 1 && classesInSlot.Any(b1 => classesInSlot.Any(b2 => b1 != b2 && (b1.PhongHoc == b2.PhongHoc || b1.GiangVien == b2.GiangVien)));
                                bool isToday = today.Date == targetDate.Date;

                                <div class="p-2 relative min-w-0 overflow-hidden flex flex-col justify-between @(isToday ? "bg-primary/[0.03]" : "")">
                                    @if (classesInSlot.Count == 0)
                                    {
                                        <!-- Ô Trống Lịch -->
                                        <div onclick="quickAddScheduleSlot('@targetDate.ToString("yyyy-MM-dd")', @shift.Ca)" 
                                             class="h-full min-h-[135px] flex flex-col items-center justify-center border-2 border-dashed border-border-standard/70 hover:border-primary/80 rounded-xl bg-canvas-base/20 hover:bg-primary/[0.04] p-3 transition-all duration-200 cursor-pointer group select-none text-center" 
                                             title="Xếp lớp vào @dayNames[day] (@targetDate.ToString("dd/MM")) @shift.Name">
                                            <div class="w-7 h-7 rounded-full bg-surface-white border border-border-standard group-hover:border-primary group-hover:bg-primary group-hover:text-surface-white flex items-center justify-center text-outline/70 transition-all duration-200 shadow-2xs group-hover:scale-110">
                                                <span class="material-symbols-outlined text-[16px]">add</span>
                                            </div>
                                            <span class="text-[11px] font-semibold text-outline group-hover:text-primary mt-2 transition-colors">
                                                Trống lịch
                                            </span>
                                            <span class="text-[9.5px] text-outline/60 mt-0.5 group-hover:text-brand-deep">
                                                @emptyRooms phòng khả dụng
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex flex-col gap-1.5 h-full">
                                            <!-- Micro Header: Số lớp & Trạng thái -->
                                            <div class="flex items-center justify-between pb-1 border-b border-border-subtle/70 text-[9.5px]">
                                                @if (classesInSlot.Count == 1)
                                                {
                                                    <span class="px-2 py-0.5 rounded-md bg-surface-container-high text-outline font-semibold">1 lớp học</span>
                                                }
                                                else
                                                {
                                                    <span class="px-2 py-0.5 rounded-full bg-purple-50 text-purple-700 font-bold border border-purple-200/60 flex items-center gap-1">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
                                                        @classesInSlot.Count lớp song song
                                                    </span>
                                                }
                                                @if (classesInSlot.All(c => c.TrangThai == "Đã hoàn thành"))
                                                {
                                                    <span class="text-success-emerald font-bold flex items-center gap-0.5">
                                                        <span class="material-symbols-outlined text-[12px]">check_circle</span> Đã xong
                                                    </span>
                                                }
                                            </div>

                                            @if (isConflict)
                                            {
                                                <!-- Cảnh báo Trùng Phòng / Giảng Viên -->
                                                <div class="bg-red-50 border border-danger-crimson/50 rounded-xl p-2 text-danger-crimson text-xs shadow-2xs flex items-center justify-between gap-1">
                                                    <span class="font-bold text-[10px] flex items-center gap-1 text-danger-crimson truncate">
                                                        <span class="material-symbols-outlined text-[13px] text-danger-crimson flex-shrink-0">warning</span>
                                                        TRÙNG: @classesInSlot.First().PhongHoc
                                                    </span>
                                                    <button type="button" onclick="openEditDrawerById(@classesInSlot.First().MaBuoiHoc)" class="text-[10px] font-bold text-danger-crimson hover:text-red-900 underline flex-shrink-0 cursor-pointer">
                                                        Sửa
                                                    </button>
                                                </div>
                                            }

                                            <!-- Danh Sách Thẻ Buổi Học -->
                                            <div class="flex flex-col gap-1.5 flex-1">
                                                @foreach (var b in classesInSlot)
                                                {
                                                    var rm = b.PhongHoc ?? "P.---";
                                                    string rmBadgeClass = "bg-amber-50 text-amber-800 border-amber-200";
                                                    string rmIcon = "meeting_room";
                                                    if (rm.Contains("Lab") || rm.Contains("Máy"))
                                                    {
                                                        rmBadgeClass = "bg-cyan-50 text-cyan-800 border-cyan-200";
                                                        rmIcon = "desktop_windows";
                                                    }
                                                    else if (rm.Contains("Hội trường"))
                                                    {
                                                        rmBadgeClass = "bg-purple-50 text-purple-800 border-purple-200";
                                                        rmIcon = "apartment";
                                                    }
                                                    else if (rm.Contains("AI") || rm.Contains("Studio"))
                                                    {
                                                        rmBadgeClass = "bg-emerald-50 text-emerald-800 border-emerald-200";
                                                        rmIcon = "smart_toy";
                                                    }
                                                    else if (rm.StartsWith("HA"))
                                                    {
                                                        rmBadgeClass = "bg-blue-50 text-blue-800 border-blue-200";
                                                        rmIcon = "school";
                                                    }

                                                    bool isCardToday = today.Date == targetDate.Date;
                                                    string statusText = "Đã lên lịch";
                                                    string statusColor = "text-primary font-semibold";
                                                    string statusDot = "bg-primary";

                                                    if (b.TrangThai == "Đã hoàn thành")
                                                    {
                                                        statusText = "Đã xong";
                                                        statusColor = "text-success-emerald font-semibold";
                                                        statusDot = "bg-success-emerald";
                                                    }
                                                    else if (b.TrangThai == "Đã hủy")
                                                    {
                                                        statusText = "Đã hủy";
                                                        statusColor = "text-outline font-semibold";
                                                        statusDot = "bg-outline";
                                                    }
                                                    else if (overdueIds.Contains(b.MaBuoiHoc) || (b.TrangThai == "Đã lên lịch" && b.ThoiGianKetThuc < DateTime.Now))
                                                    {
                                                        statusText = "Đã kết thúc (Chờ xác nhận)";
                                                        statusColor = "text-amber-800 font-semibold bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200";
                                                        statusDot = "bg-amber-500";
                                                    }
                                                    else if (b.ThoiGianBatDau <= DateTime.Now && b.ThoiGianKetThuc >= DateTime.Now)
                                                    {
                                                        statusText = "Đang diễn ra";
                                                        statusColor = "text-indigo-600 font-bold";
                                                        statusDot = "bg-indigo-500 animate-ping";
                                                    }
                                                    else if (isCardToday)
                                                    {
                                                        statusText = "Hôm nay";
                                                        statusColor = "text-primary font-bold";
                                                        statusDot = "bg-primary animate-pulse";
                                                    }

                                                    <div class="timetable-card group relative bg-surface-white border rounded-xl p-2.5 transition-all duration-200 cursor-pointer flex flex-col justify-between gap-1.5 hover:-translate-y-0.5 @(isCardToday ? "border-primary/40 shadow-xs hover:border-primary hover:shadow-md ring-1 ring-primary/20" : "border-border-standard/90 shadow-2xs hover:border-primary/60 hover:shadow-md")"
                                                         data-id="@b.MaBuoiHoc"
                                                         data-malop="@b.MaLopHoc"
                                                         data-tenlop="@(b.LopHoc?.TenLop ?? "")"
                                                         data-phong="@b.PhongHoc"
                                                         data-gv="@b.GiangVien"
                                                         data-batdau="@b.ThoiGianBatDau.ToString("yyyy-MM-ddTHH:mm")"
                                                         data-ketthuc="@b.ThoiGianKetThuc.ToString("yyyy-MM-ddTHH:mm")"
                                                         data-noidung="@b.NoiDung"
                                                         data-ghichu="@b.GhiChu"
                                                         data-trangthai="@b.TrangThai"
                                                         onclick="openEditDrawerFromElement(this)">
                                                        
                                                        <!-- Top: Mã Buổi Học & Tag Phòng Học -->
                                                        <div class="flex items-center justify-between gap-1">
                                                            <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded-md bg-surface-container text-primary border border-border-subtle truncate">
                                                                @($"#BH{b.MaBuoiHoc:D2}")
                                                            </span>
                                                            <span class="inline-flex items-center gap-1 font-bold font-mono text-[9.5px] px-2 py-0.5 rounded-md border @rmBadgeClass truncate max-w-[105px]" title="Phòng học: @b.PhongHoc">
                                                                <span class="material-symbols-outlined text-[11px]">@rmIcon</span>
                                                                <span class="truncate">@b.PhongHoc</span>
                                                            </span>
                                                        </div>

                                                        <!-- Mid: Tên Lớp Học & Bài Học -->
                                                        <div class="min-w-0 my-0.5">
                                                            <div class="font-extrabold text-brand-deep text-[11.5px] leading-snug truncate group-hover:text-primary transition-colors flex items-center gap-1" title="@(b.LopHoc?.TenLop ?? $"Lớp #{b.MaLopHoc}")">
                                                                <span class="truncate">@(b.LopHoc?.TenLop ?? $"Lớp #{b.MaLopHoc}")</span>
                                                            </div>
                                                            <div class="text-[10px] text-outline truncate leading-tight mt-0.5 flex items-center gap-1" title="@(b.NoiDung ?? "Chương trình chuẩn UNETI")">
                                                                <span class="material-symbols-outlined text-[11px] text-outline/70 flex-shrink-0">menu_book</span>
                                                                <span class="truncate">@(b.NoiDung ?? "Chương trình chuẩn UNETI")</span>
                                                            </div>
                                                        </div>

                                                        <!-- Bot: Giảng Viên & Trạng Thái -->
                                                        <div class="pt-1.5 border-t border-border-subtle/70 flex items-center justify-between text-[10px] text-outline gap-1">
                                                            <span class="truncate max-w-[90px] font-medium text-brand-deep flex items-center gap-1" title="@b.GiangVien">
                                                                <span class="material-symbols-outlined text-[12px] text-outline">person</span>
                                                                <span class="truncate">@b.GiangVien</span>
                                                            </span>
                                                            <span class="@statusColor truncate font-medium flex items-center gap-1">
                                                                <span class="w-1.5 h-1.5 rounded-full @statusDot"></span>
                                                                <span>@statusText</span>
                                                            </span>
                                                        </div>
                                                    </div>
                                                }

                                                <!-- Nút Xếp Thêm Lớp (Dạng thanh tinh gọn, thanh thoát) -->
                                                <button type="button" onclick="quickAddScheduleSlot('@day', @shift.Ca)" 
                                                        class="w-full py-1.5 border border-dashed border-border-standard hover:border-primary/70 hover:bg-primary/[0.04] text-outline hover:text-primary rounded-lg text-[10px] font-semibold transition-all duration-150 flex items-center justify-center gap-1 cursor-pointer group mt-0.5" 
                                                        title="Xếp thêm lớp vào @dayNames[day] @shift.Name">
                                                    <span class="material-symbols-outlined text-[13px] group-hover:scale-110 transition-transform">add</span>
                                                    <span>+ Thêm lớp</span>
                                                    @if (emptyRooms > 0)
                                                    {
                                                        <span class="text-[9px] text-outline/60 group-hover:text-primary/70">(@emptyRooms phòng)</span>
                                                    }
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== VIEW 2: BẢNG DANH SÁCH CHI TIẾT (CRUD TABLE) ==================== -->
    <div id="view-table" class="hidden flex flex-col gap-6">
        <!-- Filter & Operation Toolbar -->
        <div class="bg-surface-white rounded-2xl border border-border-standard shadow-sm p-4 card-pro flex flex-wrap items-center justify-between gap-3">
            <form method="get" action="/BuoiHoc/Index" class="flex flex-wrap items-center gap-3 flex-1 min-w-[280px]" id="filter-form" onsubmit="event.preventDefault(); filterBuoiHocAjax();">
                <!-- Search Field -->
                <div class="relative min-w-[220px] max-w-xs flex-1">
                    <span class="material-symbols-outlined text-outline absolute left-3 top-1/2 -translate-y-1/2 text-[18px]">search</span>
                    <input name="search" value="@search" class="w-full bg-surface-container-low border border-border-standard pl-9 pr-3 py-2 rounded-xl text-brand-deep text-xs focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" id="table-search" placeholder="Tìm theo giảng viên, phòng, lớp..." type="text"/>
                </div>

                <!-- Filter Dropdown: Lớp học -->
                <div class="relative min-w-[170px]">
                    <select name="maLop" onchange="filterBuoiHocAjax()" class="w-full appearance-none bg-surface-white border border-border-standard text-brand-deep text-xs px-3.5 py-2 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-container-low transition-colors">
                        <option value="">Tất cả Lớp học</option>
                        @foreach (var lop in lopHocs)
                        {
                            <!option value="@lop.MaLopHoc" @(selectedMaLop == lop.MaLopHoc ? "selected" : "")>@lop.TenLop</!option>
                        }
                    </select>
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">expand_more</span>
                </div>

                <!-- Filter Dropdown: Phòng học -->
                <div class="relative min-w-[150px]">
                    <select name="phong" onchange="filterBuoiHocAjax()" class="w-full appearance-none bg-surface-white border border-border-standard text-brand-deep text-xs px-3.5 py-2 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-container-low transition-colors">
                        <option value="">Tất cả Phòng học</option>
                        @foreach (var p in danhSachPhong)
                        {
                            <!option value="@p" @(selectedPhong == p ? "selected" : "")>@p</!option>
                        }
                    </select>
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">expand_more</span>
                </div>

                <!-- Filter Dropdown: Trạng thái -->
                <div class="relative min-w-[160px]">
                    <select name="trangThai" onchange="filterBuoiHocAjax()" class="w-full appearance-none bg-surface-white border border-border-standard text-brand-deep text-xs px-3.5 py-2 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-container-low transition-colors">
                        <option value="">Trạng thái: Tất cả</option>
                        <!option value="Đã lên lịch" @(selectedTrangThai == "Đã lên lịch" ? "selected" : "")>● Đã lên lịch</!option>
                        <!option value="Đã hoàn thành" @(selectedTrangThai == "Đã hoàn thành" ? "selected" : "")>● Đã hoàn thành</!option>
                        <!option value="Đã hủy" @(selectedTrangThai == "Đã hủy" ? "selected" : "")>○ Đã hủy</!option>
                    </select>
                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">expand_more</span>
                </div>
            </form>

            <div class="flex items-center gap-2">
                <button id="btnBulkDeleteBuoiHoc" class="hidden items-center gap-1.5 px-3 py-2 rounded-xl bg-rose-50 text-rose-600 border border-rose-200 text-xs font-semibold hover:bg-rose-100 transition-all cursor-pointer shadow-xs active:scale-95" title="Xóa các buổi học đã chọn">
                    <span class="material-symbols-outlined text-[16px]">delete_sweep</span>
                    <span>Xóa đã chọn (<span id="selectedBuoiHocCount">0</span>)</span>
                </button>
                <a href="/BuoiHoc/Index" onclick="event.preventDefault(); document.getElementById('filter-form').reset(); loadBuoiHocPage('/BuoiHoc/Index');" class="text-xs text-outline hover:text-primary font-medium flex items-center gap-1.5 px-3 py-2 rounded-xl border border-border-standard hover:bg-surface-container-low transition-colors cursor-pointer shrink-0" title="Đặt lại bộ lọc">
                    <span class="material-symbols-outlined text-[16px]">restart_alt</span>
                    <span>Đặt lại</span>
                </a>
            </div>
        </div>

        <!-- Data Table Container -->
        <div class="bg-surface-white rounded-2xl border border-border-standard shadow-sm overflow-hidden card-pro">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse" id="crud-table">
                    <thead>
                        <tr class="bg-surface-container-low/80 border-b border-border-standard font-label-sm text-[11px] text-outline font-bold tracking-wider uppercase">
                            <th class="py-3.5 pl-6 w-12 text-center">
                                <input class="rounded border-border-standard text-primary focus:ring-primary h-4 w-4 cursor-pointer" type="checkbox" id="selectAllBuoiHoc"/>
                            </th>
                            <th class="py-3.5 px-3 w-10 text-center">#</th>
                            <th class="py-3.5 px-4">Mã ca</th>
                            <th class="py-3.5 px-4 min-w-[200px]">Lớp học</th>
                            <th class="py-3.5 px-4">Thời gian học</th>
                            <th class="py-3.5 px-3 text-center">Phòng</th>
                            <th class="py-3.5 px-4">Giảng viên</th>
                            <th class="py-3.5 px-4">Trạng thái</th>
                            <th class="py-3.5 px-4 pr-6 text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-subtle text-xs text-brand-deep">
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="py-12 text-center text-outline">
                                    <span class="material-symbols-outlined text-4xl block mb-2 text-outline/50">event_busy</span>
                                    Chưa có buổi học nào phù hợp với bộ lọc hiện tại.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int idx = (currentPage - 1) * pageSize + 1;
                            @foreach (var item in Model)
                            {
                                bool isConflict = conflictIds.Contains(item.MaBuoiHoc);
                                <tr class="hover:bg-surface-container-low/50 transition-colors group @(isConflict ? "bg-red-50/50" : "")" 
                                    data-id="@item.MaBuoiHoc"
                                    data-malop="@item.MaLopHoc"
                                    data-tenlop="@(item.LopHoc?.TenLop ?? "")"
                                    data-phong="@item.PhongHoc"
                                    data-gv="@item.GiangVien"
                                    data-batdau="@item.ThoiGianBatDau.ToString("yyyy-MM-ddTHH:mm")"
                                    data-ketthuc="@item.ThoiGianKetThuc.ToString("yyyy-MM-ddTHH:mm")"
                                    data-noidung="@item.NoiDung"
                                    data-ghichu="@item.GhiChu"
                                    data-trangthai="@item.TrangThai">
                                    <td class="p-4 pl-6 text-center">
                                        <input class="rounded border-border-standard text-primary focus:ring-primary h-4 w-4 buoihoc-cb cursor-pointer" type="checkbox" value="@item.MaBuoiHoc"/>
                                    </td>
                                    <td class="py-3.5 px-3 text-center text-outline font-mono text-[11px]">@(idx++)</td>
                                    <td class="py-4 px-4 font-mono font-semibold text-primary">
                                        @($"#BH{item.MaBuoiHoc:D3}")
                                    </td>
                                    <td class="py-4 px-4">
                                        <div class="font-label-md text-label-md text-brand-deep font-semibold">
                                            @(item.LopHoc?.TenLop ?? $"Lớp #{item.MaLopHoc}")
                                        </div>
                                        <div class="text-outline text-[12px] truncate max-w-xs">
                                            @(item.NoiDung ?? "Nội dung chuẩn theo đề cương")
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 text-on-surface">
