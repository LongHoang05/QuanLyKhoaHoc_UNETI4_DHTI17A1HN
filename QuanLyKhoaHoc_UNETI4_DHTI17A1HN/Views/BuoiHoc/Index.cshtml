    // Micro-interactions for Drawer and Global Modal
    const drawerBackdrop = document.getElementById('drawer-backdrop');
    const drawerPanel = document.getElementById('drawer-panel');
    const drawerForm = document.getElementById('drawer-form');

    function updateStatusRadioStyles() {
        const map = [
            { radio: 'radio-trangthai-scheduled', label: 'label-trangthai-scheduled', active: ['border-primary', 'bg-primary/10', 'ring-1', 'ring-primary'] },
            { radio: 'radio-trangthai-completed', label: 'label-trangthai-completed', active: ['border-emerald-500', 'bg-emerald-50', 'ring-1', 'ring-emerald-500'] },
            { radio: 'radio-trangthai-canceled', label: 'label-trangthai-canceled', active: ['border-rose-500', 'bg-rose-50', 'ring-1', 'ring-rose-500'] }
        ];
        map.forEach(m => {
            const r = document.getElementById(m.radio);
            const l = document.getElementById(m.label);
            if (!r || !l) return;
            m.active.forEach(cls => l.classList.remove(cls));
            if (r.checked) {
                m.active.forEach(cls => l.classList.add(cls));
            }
        });
    }

    document.querySelectorAll('input[name="TrangThai"]').forEach(r => {
        r.addEventListener('change', updateStatusRadioStyles);
    });

    // Helper: Tìm kiếm nhanh lớp học trong Drawer
    function filterDrawerLopHoc(kw) {
        const q = (kw || '').trim().toLowerCase();
        const select = document.getElementById('drawer-malop');
        const clearBtn = document.getElementById('drawer-clear-search-lop');
        const countEl = document.getElementById('drawer-lop-count');
        if (!select) return;

        if (clearBtn) {
            if (q) clearBtn.classList.remove('hidden');
            else clearBtn.classList.add('hidden');
        }

        let matchCount = 0;
        const optgroups = select.querySelectorAll('optgroup');
        optgroups.forEach(grp => {
            let grpMatch = 0;
            const options = grp.querySelectorAll('option');
            options.forEach(opt => {
                const text = (opt.text || '').toLowerCase();
                const gv = (opt.dataset.gv || '').toLowerCase();
                const ctdt = (opt.dataset.ctdt || '').toLowerCase();
                if (!q || text.includes(q) || gv.includes(q) || ctdt.includes(q)) {
                    opt.hidden = false;
                    grpMatch++;
                    matchCount++;
                } else {
                    opt.hidden = true;
                }
            });
            grp.hidden = (grpMatch === 0);
        });

        if (countEl) {
            if (q) countEl.innerText = `${matchCount} lớp khớp`;
            else countEl.innerText = `${select.querySelectorAll('option:not([value=""])').length} lớp`;
        }
    }

    function clearDrawerLopSearch() {
        const input = document.getElementById('drawer-search-lop');
        if (input) {
            input.value = '';
            filterDrawerLopHoc('');
        }
    }

    // Helper: Tự động điền Giảng viên khi chọn Lớp học
    function onDrawerLopChanged(selectEl, autoSelectGv = true) {
        if (!selectEl) return;
        const opt = selectEl.options[selectEl.selectedIndex];
        const card = document.getElementById('drawer-lop-info-card');
        const textEl = document.getElementById('drawer-lop-info-text');
        const badgeGv = document.getElementById('drawer-gv-autofill-badge');

        if (!opt || !opt.value) {
            if (card) card.classList.add('hidden');
            if (badgeGv) badgeGv.classList.add('hidden');
            return;
        }

        const tenLop = opt.dataset.ten || opt.text;
        const gvLop = opt.dataset.gv || '';
        const siso = opt.dataset.siso || '';
        const sobuoi = opt.dataset.sobuoi || '';
        const khaigiang = opt.dataset.khaigiang || '';
        const mota = opt.dataset.mota || '';

        if (card && textEl) {
            let infoText = `${tenLop} • Sĩ số: ${siso} SV • Quy định: ${sobuoi} buổi`;
            if (khaigiang) infoText += ` • Khai giảng: ${khaigiang}`;
            if (mota) {
                const shiftHint = mota.includes('Sáng') ? 'Ca Sáng (07:00-11:45)' : (mota.includes('Chiều') ? 'Ca Chiều (13:30-18:15)' : '');
                if (shiftHint) infoText += ` • ${shiftHint}`;
            }
            textEl.innerText = infoText;
            card.classList.remove('hidden');
        }

        // Tự động căn ngày bắt đầu tối thiểu từ Ngày Khai Giảng nếu đang tạo mới và ngày hiện tại trước khai giảng
        const curBatDau = document.getElementById('drawer-batdau')?.value;
        const mode = document.getElementById('drawer-mabuoi')?.value;
        if ((mode === '0' || !mode) && khaigiang && curBatDau) {
            const curDate = curBatDau.split('T')[0];
            if (curDate < khaigiang) {
                const timePart = curBatDau.split('T')[1] || "07:00";
                document.getElementById('drawer-batdau').value = `${khaigiang}T${timePart}`;
                const curKetThuc = document.getElementById('drawer-ketthuc')?.value;
                const endTimePart = (curKetThuc && curKetThuc.includes('T')) ? curKetThuc.split('T')[1] : "09:15";
                document.getElementById('drawer-ketthuc').value = `${khaigiang}T${endTimePart}`;
            }
        }

        if (autoSelectGv && gvLop) {
            setDrawerGiangVienValue(gvLop);
            if (badgeGv) {
                badgeGv.innerText = `✓ Theo lớp: ${gvLop}`;
                badgeGv.classList.remove('hidden');
            }
        } else if (!autoSelectGv && gvLop) {
            if (badgeGv) {
                badgeGv.innerText = `✓ GV lớp: ${gvLop}`;
                badgeGv.classList.remove('hidden');
            }
        } else {
            if (badgeGv) badgeGv.classList.add('hidden');
        }

        checkScheduleConflictLive();
    }

    // Helper: Gán giá trị Giảng viên vào Dropdown (Hỗ trợ cả khớp chính xác & thỉnh giảng)
    function setDrawerGiangVienValue(gvName) {
        const gvSelect = document.getElementById('drawer-gv');
        if (!gvSelect || !gvName) return;

        let matched = false;
        for (let i = 0; i < gvSelect.options.length; i++) {
            const val = gvSelect.options[i].value;
            if (val && val.toLowerCase() === gvName.toLowerCase()) {
                gvSelect.selectedIndex = i;
                matched = true;
                break;
            }
        }
        if (!matched) {
            for (let i = 0; i < gvSelect.options.length; i++) {
                const val = gvSelect.options[i].value;
                if (val && (val.toLowerCase().includes(gvName.toLowerCase()) || gvName.toLowerCase().includes(val.toLowerCase()))) {
                    gvSelect.selectedIndex = i;
                    matched = true;
                    break;
                }
            }
        }
        if (!matched && gvName) {
            const opt = new Option(gvName, gvName, true, true);
            gvSelect.add(opt);
        }
    }

