{
    <div id="toast-success" class="mb-4 flex items-center justify-between p-4 bg-emerald-50 border border-emerald-200 rounded-2xl text-emerald-800 shadow-sm animate-fade-in">
        <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-success-emerald text-[22px]">check_circle</span>
            <span class="font-label-md text-label-md font-semibold">@TempData["Success"]</span>
        </div>
        <button onclick="document.getElementById('toast-success').remove()" class="text-emerald-600 hover:text-emerald-900 cursor-pointer">
            <span class="material-symbols-outlined text-[18px]">close</span>
