<script>
    // Weekly Timetable Week Navigation & Realtime Filters
    let currentWeekOffset = 0;
    const baseMondayDate = new Date('@mondayDate.ToString("yyyy-MM-ddTHH:mm:ss")');

    function updateWeekDisplay() {
        const monday = new Date(baseMondayDate);
        monday.setDate(monday.getDate() + (currentWeekOffset * 7));
        const sunday = new Date(monday);
        sunday.setDate(sunday.getDate() + 6);

        const pad = (n) => String(n).padStart(2, '0');
        const mondayStr = `${pad(monday.getDate())}/${pad(monday.getMonth() + 1)}`;
        const sundayStr = `${pad(sunday.getDate())}/${pad(sunday.getMonth() + 1)}/${sunday.getFullYear()}`;

        // Tính số tuần ISO
        const target = new Date(monday.valueOf());
        const dayNr = (monday.getDay() + 6) % 7;
        target.setDate(target.getDate() - dayNr + 3);
        const firstThursday = target.valueOf();
        target.setMonth(0, 1);
        if (target.getDay() !== 4) {
            target.setMonth(0, 1 + ((4 - target.getDay()) + 7) % 7);
        }
        const weekNum = 1 + Math.ceil((firstThursday - target) / 604800000);

        const titleEl = document.getElementById('week-display-title');
        if (titleEl) {
            titleEl.innerText = `Tuần ${weekNum} (${mondayStr} - ${sundayStr})`;
        }

        const daysArr = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        daysArr.forEach((d, idx) => {
            const dDate = new Date(monday);
            dDate.setDate(dDate.getDate() + idx);
            const dStr = `${pad(dDate.getDate())}/${pad(dDate.getMonth() + 1)}`;
            const el = document.getElementById(`day-date-${d}`);
            if (el) el.innerText = dStr;
        });
    }

    function changeWeek(delta) {
        currentWeekOffset += delta;
        updateWeekDisplay();
    }

    function goToToday() {
        currentWeekOffset = 0;
        updateWeekDisplay();
    }

    function applyTimetableFilters() {
        const filterPhong = document.getElementById('filter-timetable-phong')?.value?.toLowerCase() || '';
        const filterGv = document.getElementById('filter-timetable-gv')?.value?.toLowerCase() || '';
        const filterStatus = document.getElementById('filter-timetable-trangthai')?.value?.toLowerCase() || '';

        const cards = document.querySelectorAll('.timetable-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const phong = (card.dataset.phong || '').toLowerCase();
            const gv = (card.dataset.gv || '').toLowerCase();
            const status = (card.dataset.trangthai || '').toLowerCase();

            let match = true;
            if (filterPhong && !phong.includes(filterPhong)) match = false;
            if (filterGv && !gv.includes(filterGv)) match = false;
            if (filterStatus && status !== filterStatus) match = false;

            if (match) {
                card.classList.remove('hidden');
                visibleCount++;
            } else {
                card.classList.add('hidden');
            }
        });

        const countEl = document.getElementById('week-sessions-count');
        if (countEl) {
            countEl.innerText = `${visibleCount} buổi học phân bổ`;
        }
    }

    // Tab View Switcher (Timetable vs Table)
    window.currentViewMode = 'timetable';
    function switchView(mode) {
        window.currentViewMode = mode;
        const viewTimetable = document.getElementById('view-timetable');
        const viewTable = document.getElementById('view-table');
        const btnTimetable = document.getElementById('tab-btn-timetable');
        const btnTable = document.getElementById('tab-btn-table');
        if (!viewTimetable || !viewTable || !btnTimetable || !btnTable) return;

        if (mode === 'timetable') {
            viewTimetable.classList.remove('hidden');
            viewTable.classList.add('hidden');
            btnTimetable.className = 'px-3.5 py-1.5 rounded-lg bg-surface-white text-primary-container font-bold shadow-xs transition-all flex items-center gap-1.5 cursor-pointer';
            btnTable.className = 'px-3.5 py-1.5 rounded-lg text-outline hover:text-brand-deep transition-all flex items-center gap-1.5 cursor-pointer';
        } else {
            viewTimetable.classList.add('hidden');
            viewTable.classList.remove('hidden');
            btnTable.className = 'px-3.5 py-1.5 rounded-lg bg-surface-white text-primary-container font-bold shadow-xs transition-all flex items-center gap-1.5 cursor-pointer';
            btnTimetable.className = 'px-3.5 py-1.5 rounded-lg text-outline hover:text-brand-deep transition-all flex items-center gap-1.5 cursor-pointer';
        }
    }

    // Filter BuoiHoc via AJAX without reloading page
    function filterBuoiHocAjax() {
        const form = document.getElementById('filter-form');
        if (!form) return;
        const formData = new FormData(form);
        const params = new URLSearchParams(formData);
        params.set('page', '1');
        const url = `/BuoiHoc/Index?${params.toString()}`;
        loadBuoiHocPage(url);
    }

    // Universal AJAX Page Loader for BuoiHoc (Pagination, Filter, Refresh)
    async function loadBuoiHocPage(url, pushState = true) {
        const area = document.getElementById('buoihoc-content-area');
        if (area) {
            area.classList.add('opacity-50', 'pointer-events-none');
        }

        try {
            const res = await fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const html = await res.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            const newContent = doc.getElementById('buoihoc-content-area');
            if (newContent && area) {
                area.innerHTML = newContent.innerHTML;
                switchView(window.currentViewMode || 'timetable');
                bindSelectAll();
            }

            if (pushState) {
                window.history.pushState({ url: url, viewMode: window.currentViewMode }, '', url);
            }
        } catch (err) {
            console.error('Lỗi khi tải trang AJAX:', err);
            window.location.href = url;
        } finally {
            if (area) {
                area.classList.remove('opacity-50', 'pointer-events-none');
            }
        }
    }

    window.addEventListener('popstate', (e) => {
        if (e.state && e.state.url) {
            if (e.state.viewMode) window.currentViewMode = e.state.viewMode;
            loadBuoiHocPage(e.state.url, false);
        } else {
            loadBuoiHocPage(window.location.href, false);
        }
    });

    // Smooth horizontal scroll for weekly timetable
    function scrollTimetable(offset) {
        const container = document.getElementById('timetable-scroll-container');
        if (container) {
            container.scrollBy({ left: offset, behavior: 'smooth' });
        }
    }

    // Micro-interactions for Drawer and Global Modal
    const drawer = document.getElementById('drawer-container');
    const drawerForm = document.getElementById('drawer-form');

    function updateStatusRadioStyles() {
        const map = [
            { radio: 'radio-trangthai-scheduled', label: 'label-trangthai-scheduled', active: ['border-primary', 'bg-primary/10', 'ring-1', 'ring-primary'] },
            { radio: 'radio-trangthai-completed', label: 'label-trangthai-completed', active: ['border-emerald-500', 'bg-emerald-50', 'ring-1', 'ring-emerald-500'] },
            { radio: 'radio-trangthai-canceled', label: 'label-trangthai-canceled', active: ['border-rose-500', 'bg-rose-50', 'ring-1', 'ring-rose-500'] }
        ];
        map.forEach(m => {
            const r = document.getElementById(m.radio);
            const l = document.getElementById(m.label);
            if (!r || !l) return;
            m.active.forEach(cls => l.classList.remove(cls));
            if (r.checked) {
                m.active.forEach(cls => l.classList.add(cls));
            }
        });
    }

    document.querySelectorAll('input[name="TrangThai"]').forEach(r => {
        r.addEventListener('change', updateStatusRadioStyles);
    });

    function openDrawer(mode) {
        drawer.classList.remove('hidden');
        const statusGroup = document.getElementById('drawer-trangthai-group');
        if (mode === 'create') {
            document.getElementById('drawer-title').innerText = 'Xếp lịch học mới';
            document.getElementById('drawer-subtitle').innerText = 'Nhập thông tin ca học, phòng máy và phân công giảng viên.';
            document.getElementById('drawer-submit-text').innerText = 'Lưu buổi học';
            drawerForm.action = '/BuoiHoc/Create';
            document.getElementById('drawer-mabuoi').value = '0';
            document.getElementById('radio-trangthai-scheduled').checked = true;
            if (statusGroup) statusGroup.classList.add('hidden');
            updateStatusRadioStyles();
            
            // Set default times (Tomorrow 08:00 to 11:30)
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            const yyyy = tomorrow.getFullYear();
            const mm = String(tomorrow.getMonth() + 1).padStart(2, '0');
            const dd = String(tomorrow.getDate()).padStart(2, '0');
            document.getElementById('drawer-batdau').value = `${yyyy}-${mm}-${dd}T08:00`;
            document.getElementById('drawer-ketthuc').value = `${yyyy}-${mm}-${dd}T11:30`;
            checkScheduleConflictLive();
        }
    }

    function closeDrawer() {
        drawer.classList.add('hidden');
        const box = document.getElementById('drawer-conflict-box');
        if (box) box.classList.add('hidden');
    }

    // Quick Add Schedule into a specific Day and Shift from Timetable Grid
    function quickAddScheduleSlot(dayName, caNumber) {
        openDrawer('create');
        
        // Calculate date for next dayName
        const dayMap = { 'Monday': 1, 'Tuesday': 2, 'Wednesday': 3, 'Thursday': 4, 'Friday': 5, 'Saturday': 6 };
        const targetDay = dayMap[dayName] || 1;
        const now = new Date();
        const currentDay = now.getDay() || 7;
        let diff = targetDay - currentDay;
        if (diff <= 0) diff += 7;
        const targetDate = new Date(now.setDate(now.getDate() + diff));

        const yyyy = targetDate.getFullYear();
        const mm = String(targetDate.getMonth() + 1).padStart(2, '0');
        const dd = String(targetDate.getDate()).padStart(2, '0');

        let startH = "07:00", endH = "09:15";
        if (caNumber === 2) { startH = "09:30"; endH = "11:45"; }
        else if (caNumber === 3) { startH = "13:30"; endH = "15:45"; }
        else if (caNumber === 4) { startH = "16:00"; endH = "18:15"; }

        document.getElementById('drawer-batdau').value = `${yyyy}-${mm}-${dd}T${startH}`;
        document.getElementById('drawer-ketthuc').value = `${yyyy}-${mm}-${dd}T${endH}`;
        checkScheduleConflictLive();
    }

    function openEditDrawerFromElement(btnOrEl) {
        const item = btnOrEl.closest('[data-id]');
        if (!item) return;

        document.getElementById('drawer-title').innerText = 'Cập nhật buổi học';
        document.getElementById('drawer-subtitle').innerText = 'Điều chỉnh thời gian, phòng học hoặc trạng thái ca học.';
        document.getElementById('drawer-submit-text').innerText = 'Cập nhật';
        drawerForm.action = '/BuoiHoc/EditPost';

        document.getElementById('drawer-mabuoi').value = item.dataset.id;
        document.getElementById('drawer-malop').value = item.dataset.malop;
        document.getElementById('drawer-phong').value = item.dataset.phong;
        document.getElementById('drawer-gv').value = item.dataset.gv;
        document.getElementById('drawer-batdau').value = item.dataset.batdau;
        document.getElementById('drawer-ketthuc').value = item.dataset.ketthuc;
        document.getElementById('drawer-noidung').value = item.dataset.noidung || '';
        document.getElementById('drawer-ghichu').value = item.dataset.ghichu || '';

        const statusGroup = document.getElementById('drawer-trangthai-group');
        if (statusGroup) statusGroup.classList.remove('hidden');

        const status = item.dataset.trangthai;
        if (status === 'Đã hoàn thành') {
            document.getElementById('radio-trangthai-completed').checked = true;
        } else if (status === 'Đã hủy') {
            document.getElementById('radio-trangthai-canceled').checked = true;
        } else {
            document.getElementById('radio-trangthai-scheduled').checked = true;
        }
        updateStatusRadioStyles();

        drawer.classList.remove('hidden');
        checkScheduleConflictLive();
    }

    function openEditDrawerFromRow(btn) {
        openEditDrawerFromElement(btn);
    }

    function openEditDrawerById(id) {
        const el = document.querySelector(`[data-id="${id}"]`);
        if (el) {
            openEditDrawerFromElement(el);
        } else {
            openDrawer('create');
        }
    }

    function confirmDelete(id, sessionName) {
        openGlobalDeleteModal({
            action: '/BuoiHoc/DeletePost',
            id: id,
            title: 'Xóa buổi học này?',
            itemName: sessionName,
            message: `Bạn có chắc chắn muốn xóa buổi học <strong class="text-brand-deep">${sessionName}</strong>? Ca học và dữ liệu phân công giảng dạy liên quan sẽ bị gián đoạn.`,
            warning: 'Hành động này mang tính vĩnh viễn và không thể hoàn tác sau khi xác nhận.',
            submitText: 'Xóa vĩnh viễn'
        });
    }

    // Handle AJAX Delete Callback
    window.onDeleteSuccess = function(data) {
        loadBuoiHocPage(window.location.href, false);
    };

    // Realtime Schedule Conflict Checker
    let conflictCheckTimeout = null;
    let isCurrentFormConflicted = false;

    async function checkScheduleConflictLive() {
        clearTimeout(conflictCheckTimeout);
        conflictCheckTimeout = setTimeout(async () => {
            const maBuoi = document.getElementById('drawer-mabuoi')?.value || '0';
            const maLop = document.getElementById('drawer-malop')?.value;
            const phong = document.getElementById('drawer-phong')?.value?.trim();
            const gv = document.getElementById('drawer-gv')?.value?.trim();
            const batdau = document.getElementById('drawer-batdau')?.value;
            const ketthuc = document.getElementById('drawer-ketthuc')?.value;

            const box = document.getElementById('drawer-conflict-box');
            const conflictAlert = document.getElementById('drawer-conflict-alert');
            const validAlert = document.getElementById('drawer-valid-alert');
            const conflictMsg = document.getElementById('drawer-conflict-msg');
            const submitBtn = document.getElementById('drawer-submit-btn') || drawerForm?.querySelector('button[type="submit"]');

            if (!maLop || !phong || !batdau || !ketthuc) {
                if (box) box.classList.add('hidden');
                isCurrentFormConflicted = false;
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                }
                return;
            }

            try {
                const params = new URLSearchParams({
                    maBuoiHoc: maBuoi,
                    maLopHoc: maLop,
                    phongHoc: phong,
                    giangVien: gv || '',
                    batDau: batdau,
                    ketThuc: ketthuc
                });

                const res = await fetch(`/BuoiHoc/KiemTraTrungLich?${params.toString()}`);
                if (res.ok) {
                    const data = await res.json();
                    if (box) box.classList.remove('hidden');

                    if (data.hasConflict) {
                        isCurrentFormConflicted = true;
                        if (conflictAlert) conflictAlert.classList.remove('hidden');
                        if (validAlert) validAlert.classList.add('hidden');
                        if (conflictMsg) conflictMsg.innerText = data.message;
                        if (submitBtn) {
                            submitBtn.disabled = true;
                            submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
                        }
                    } else {
                        isCurrentFormConflicted = false;
                        if (conflictAlert) conflictAlert.classList.add('hidden');
                        if (validAlert) validAlert.classList.remove('hidden');
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                        }
                    }
                }
            } catch (err) {
                console.error('Lỗi khi kiểm tra trùng lịch:', err);
            }
        }, 250);
    }

    ['drawer-malop', 'drawer-phong', 'drawer-gv', 'drawer-batdau', 'drawer-ketthuc'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('input', checkScheduleConflictLive);
            el.addEventListener('change', checkScheduleConflictLive);
        }
    });

    // AJAX Form Submission for Right Drawer (Create & Edit)
    if (drawerForm) {
        drawerForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            if (isCurrentFormConflicted) {
                if (window.showToast) {
                    window.showToast('Không thể lưu do lịch học đang bị trùng! Vui lòng chọn giờ hoặc phòng khác.', 'error');
                } else {
                    alert('Không thể lưu do lịch học đang bị trùng! Vui lòng chọn giờ hoặc phòng khác.');
                }
                return;
            }

            const submitBtn = document.getElementById('drawer-submit-btn') || drawerForm.querySelector('button[type="submit"]');
            const submitText = document.getElementById('drawer-submit-text');
            const originalText = submitText ? submitText.innerText : 'Lưu buổi học';
            if (submitBtn) submitBtn.disabled = true;
            if (submitText) submitText.innerText = 'Đang xử lý...';

            try {
                const formData = new FormData(drawerForm);
                const res = await fetch(drawerForm.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                const contentType = res.headers.get("content-type");
                if (contentType && contentType.indexOf("application/json") !== -1) {
                    const data = await res.json();
                    if (data.success) {
                        closeDrawer();
                        if (window.showToast) window.showToast(data.message, 'success');
                        await loadBuoiHocPage(window.location.href, false);
                    } else {
                        if (window.showToast) window.showToast(data.message, 'error');
                    }
                } else {
                    closeDrawer();
                    await loadBuoiHocPage(window.location.href, false);
                }
            } catch (err) {
                console.error('Lỗi khi gửi form buổi học:', err);
                if (window.showToast) window.showToast('Có lỗi xảy ra khi lưu buổi học.', 'error');
            } finally {
                if (submitBtn && !isCurrentFormConflicted) submitBtn.disabled = false;
                if (submitText) submitText.innerText = originalText;
            }
        });
    }

    // Select-all Checkbox helper
    function bindSelectAll() {
        const selectAll = document.getElementById('select-all');
        if (selectAll) {
            selectAll.onchange = function(e) {
                document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = e.target.checked);
            };
        }
    }
    bindSelectAll();

    // Client-side CSV Exporter
    function exportTableToCSV(filename) {
        let csv = [];
        const rows = document.querySelectorAll("#crud-table tr");
        for (let i = 0; i < rows.length; i++) {
            let row = [], cols = rows[i].querySelectorAll("td, th");
            for (let j = 1; j < cols.length - 1; j++) {
                let data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").trim();
                data = data.replace(/"/g, '""');
                row.push('"' + data + '"');
            }
            csv.push(row.join(","));
        }
        const csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
        const downloadLink = document.createElement("a");
        downloadLink.download = filename;
        downloadLink.href = window.URL.createObjectURL(csvFile);
        downloadLink.style.display = "none";
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
    }
// Tự động mở ngăn kéo Xếp lịch học nếu URL có tham số create=true
    (function checkUrlForCreate() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('create') === 'true' || urlParams.get('action') === 'create') {
            setTimeout(() => {
                openDrawer('create');
                const cleanUrl = window.location.pathname + window.location.search.replace(/[?&]create=true/, '').replace(/[?&]action=create/, '');
                window.history.replaceState({}, document.title, cleanUrl || window.location.pathname);
            }, 150);
        }
    })();
</script>
