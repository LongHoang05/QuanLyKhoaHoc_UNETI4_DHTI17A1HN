                                                            @(b.LopHoc?.TenLop ?? $"Lớp #{b.MaLopHoc}")
                                                        </div>
                                                        <div class="text-[9px] text-outline truncate leading-tight mt-0.5" title="@(b.NoiDung ?? "Chương trình chuẩn UNETI")">
