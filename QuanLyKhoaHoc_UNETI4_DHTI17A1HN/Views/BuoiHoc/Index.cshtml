    // Helper: Nút chọn nhanh 4 ca chuẩn UNETI từ Drawer
    function setDrawerShift(caNumber) {
        const curStart = document.getElementById('drawer-batdau')?.value;
        let datePart = curStart && curStart.includes('T') ? curStart.split('T')[0] : '';
        if (!datePart) {
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            const yyyy = tomorrow.getFullYear();
            const mm = String(tomorrow.getMonth() + 1).padStart(2, '0');
            const dd = String(tomorrow.getDate()).padStart(2, '0');
            datePart = `${yyyy}-${mm}-${dd}`;
        }
        
        let startH = "07:00", endH = "09:15";
        if (caNumber === 2) { startH = "09:30"; endH = "11:45"; }
        else if (caNumber === 3) { startH = "13:30"; endH = "15:45"; }
        else if (caNumber === 4) { startH = "16:00"; endH = "18:15"; }

        document.getElementById('drawer-batdau').value = `${datePart}T${startH}`;
        document.getElementById('drawer-ketthuc').value = `${datePart}T${endH}`;
        checkScheduleConflictLive();
    }

    // Quick Add Schedule into a specific Day and Shift from Timetable Grid
    function quickAddScheduleSlot(dateStrOrDay, caNumber) {
        openDrawer('create');
        
        let datePart = dateStrOrDay;
        if (!/^\d{4}-\d{2}-\d{2}$/.test(datePart)) {
            const dayMap = { 'Monday': 1, 'Tuesday': 2, 'Wednesday': 3, 'Thursday': 4, 'Friday': 5, 'Saturday': 6, 'Sunday': 7 };
            const targetDay = dayMap[dateStrOrDay] || 1;
            const now = new Date();
            const currentDay = now.getDay() || 7;
            let diff = targetDay - currentDay;
            if (diff <= 0) diff += 7;
            const targetDate = new Date(now.setDate(now.getDate() + diff));

            const yyyy = targetDate.getFullYear();
            const mm = String(targetDate.getMonth() + 1).padStart(2, '0');
            const dd = String(targetDate.getDate()).padStart(2, '0');
            datePart = `${yyyy}-${mm}-${dd}`;
        }

        let startH = "07:00", endH = "09:15";
        if (caNumber === 2) { startH = "09:30"; endH = "11:45"; }
        else if (caNumber === 3) { startH = "13:30"; endH = "15:45"; }
        else if (caNumber === 4) { startH = "16:00"; endH = "18:15"; }

        document.getElementById('drawer-batdau').value = `${datePart}T${startH}`;
        document.getElementById('drawer-ketthuc').value = `${datePart}T${endH}`;
        checkScheduleConflictLive();
    }

