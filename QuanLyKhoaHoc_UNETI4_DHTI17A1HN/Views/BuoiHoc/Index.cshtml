                        </label>
                        <label class="cursor-pointer border border-border-standard rounded-xl p-2.5 flex items-center justify-center gap-1.5 hover:bg-surface-container-low transition-colors" id="label-trangthai-canceled">
                            <input type="radio" name="TrangThai" value="Đã hủy" class="hidden" id="radio-trangthai-canceled"/>
