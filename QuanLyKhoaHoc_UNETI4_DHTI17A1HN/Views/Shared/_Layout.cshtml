@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    string userHoTen = session?.GetString("HoTen") ?? "Khách";
    string userVaiTro = session?.GetString("VaiTro") ?? "Admin";
    string userEmail = session?.GetString("Email") ?? "admin@uneti.edu.vn";
    int? maTaiKhoan = session?.GetInt32("MaTaiKhoan");

    bool isAdmin = string.Equals(userVaiTro, "Admin", StringComparison.OrdinalIgnoreCase);
    bool isGiaoVu = string.Equals(userVaiTro, "GiaoVu", StringComparison.OrdinalIgnoreCase) || string.Equals(userVaiTro, "Giáo vụ", StringComparison.OrdinalIgnoreCase);
    bool isGiangVien = string.Equals(userVaiTro, "GiangVien", StringComparison.OrdinalIgnoreCase) || string.Equals(userVaiTro, "Giảng viên", StringComparison.OrdinalIgnoreCase);
    bool isHocVien = string.Equals(userVaiTro, "HocVien", StringComparison.OrdinalIgnoreCase) || string.Equals(userVaiTro, "Học viên", StringComparison.OrdinalIgnoreCase);
    bool isStaff = isAdmin || isGiaoVu;

    string homeUrl = isGiangVien ? "/GiangVien/Index" : (isHocVien ? "/CongHocVien/TienTrinh" : "/ThongKe/Dashboard");
    string roleLabel = isAdmin ? "Quản trị viên" : (isGiaoVu ? "Giáo vụ đào tạo" : (isGiangVien ? "Giảng viên" : "Học viên"));
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="web_standard" name="shell-type">
    <title>@ViewData["Title"] - UNETI ĐÀO TẠO</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&family=Inter:wght@100..900&display=swap" rel="stylesheet">
    <style>
        @@layer base {
            html, body { margin: 0; padding: 0; font-family: 'Be Vietnam Pro', 'Inter', sans-serif; }
            body { overscroll-behavior: none; }
            main > :first-child { margin-top: 0 !important; }
            main > :last-child { margin-bottom: 0 !important; }
        }
        ::-webkit-scrollbar { display: none; }
        .custom-scrollbar::-webkit-scrollbar {
            display: block !important;
            height: 6px !important;
            width: 6px !important;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #F1F5F9;
            border-radius: 9999px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 9999px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #2196F3;
        }
        .custom-scrollbar {
            scrollbar-width: thin;
            scrollbar-color: #CBD5E1 #F1F5F9;
        }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "brand-deep": "#0D47A1",
                        "primary": "#2196F3",
                        "primary-dark": "#1976D2",
                        "primary-container": "#1E88E5",
                        "primary-light": "#90CAF9",
                        "primary-bg": "#E3F2FD",
                        "canvas-base": "#F8FAFC",
                        "surface-white": "#FFFFFF",
                        "surface-container-lowest": "#FFFFFF",
                        "surface-container-low": "#F1F5F9",
                        "surface-container": "#E2E8F0",
                        "surface-container-high": "#CBD5E1",
                        "surface-container-highest": "#94A3B8",
                        "surface-dim": "#F1F5F9",
                        "surface-bright": "#FFFFFF",
                        "surface": "#F8FAFC",
                        "border-standard": "#E2E8F0",
                        "border-subtle": "#E2E8F0",
                        "border-brand": "#90CAF9",
                        "outline": "#64748B",
                        "outline-variant": "#94A3B8",
                        "on-surface": "#0F172A",
                        "on-surface-variant": "#334155",
                        "on-primary": "#FFFFFF",
                        "on-primary-container": "#FFFFFF",
                        "secondary": "#1565C0",
                        "secondary-container": "#1E88E5",
                        "tertiary": "#0284C7",
                        "success-emerald": "#10B981",
                        "warning-amber": "#F59E0B",
                        "danger-crimson": "#EF4444",
                        "error": "#EF4444",
                        "on-error": "#FFFFFF"
                    },
                    borderRadius: { DEFAULT: "0.25rem", lg: "0.5rem", xl: "0.75rem", full: "9999px" },
                    spacing: {
                        "space-xl": "2rem",
                        "space-sm": "0.5rem",
                        "space-xs": "0.25rem",
                        "gutter-mobile": "0.75rem",
                        "space-md": "1rem",
                        "margin-mobile": "1rem",
                        gutter: "1.5rem",
                        "space-lg": "1.5rem",
                        margin: "2rem"
                    },
                    fontFamily: {
                        display: ["'Be Vietnam Pro'", "Inter", "sans-serif"],
                        "headline-md": ["'Be Vietnam Pro'", "Inter", "sans-serif"],
                        "label-md": ["'Be Vietnam Pro'", "Inter", "sans-serif"],
                        "headline-lg-mobile": ["'Be Vietnam Pro'", "Inter", "sans-serif"],
                        "headline-sm": ["'Be Vietnam Pro'", "Inter", "sans-serif"],
                        "body-lg": ["'Be Vietnam Pro'", "Inter", "sans-serif"],
                        "metric-stat": ["'Be Vietnam Pro'", "Inter", "sans-serif"],
                        "label-sm": ["'Be Vietnam Pro'", "Inter", "sans-serif"],
                        "body-sm": ["'Be Vietnam Pro'", "Inter", "sans-serif"],
                        "display-mobile": ["'Be Vietnam Pro'", "Inter", "sans-serif"],
                        "body-md": ["'Be Vietnam Pro'", "Inter", "sans-serif"],
                        "headline-lg": ["'Be Vietnam Pro'", "Inter", "sans-serif"]
                    },
                    fontSize: {
                        display: ["32px", { lineHeight: "40px", letterSpacing: "-0.02em", fontWeight: "800" }],
                        "headline-md": ["20px", { lineHeight: "28px", letterSpacing: "-0.015em", fontWeight: "700" }],
                        "label-md": ["13px", { lineHeight: "16px", fontWeight: "600" }],
                        "headline-lg-mobile": ["20px", { lineHeight: "28px", fontWeight: "700" }],
                        "headline-sm": ["15px", { lineHeight: "22px", fontWeight: "600" }],
                        "body-lg": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "metric-stat": ["26px", { lineHeight: "32px", fontWeight: "800" }],
                        "label-sm": ["11px", { lineHeight: "14px", fontWeight: "600" }],
                        "body-sm": ["13px", { lineHeight: "18px", fontWeight: "400" }],
                        "display-mobile": ["24px", { lineHeight: "32px", fontWeight: "800" }],
                        "body-md": ["14px", { lineHeight: "20px", fontWeight: "400" }],
                        "headline-lg": ["24px", { lineHeight: "32px", fontWeight: "700" }]
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-canvas-base font-body-md text-body-md text-on-surface antialiased min-h-screen">
    <div class="flex min-h-screen w-full bg-canvas-base">
        <!-- Left Sidebar Navigation (Clean & Minimal) -->
        <aside id="adminSidebar" class="w-60 lg:w-64 flex-shrink-0 bg-surface-white border-r border-border-standard h-screen fixed lg:sticky top-0 -translate-x-full lg:translate-x-0 transition-transform duration-300 flex flex-col justify-between p-4 z-50 select-none shadow-2xl lg:shadow-none">
            <div class="flex flex-col gap-4 overflow-hidden">
                <!-- Logo & School Brand -->
                <div class="flex items-center justify-between pb-3 border-b border-border-standard">
                    <a href="@homeUrl" class="flex items-center gap-2.5 group">
                        <div class="w-9 h-9 rounded-xl bg-brand-deep text-surface-white flex items-center justify-center font-bold text-lg shadow-xs shrink-0">
                            <span class="material-symbols-outlined text-[20px]">school</span>
                        </div>
                        <div class="flex flex-col min-w-0">
                            <span class="text-sm text-brand-deep font-extrabold leading-tight truncate">UNETI ĐÀO TẠO</span>
                            <span class="text-[11px] text-outline leading-tight truncate">Hệ thống Quản lý Khóa học</span>
                        </div>
                    </a>
                    <button type="button" onclick="toggleMobileSidebar()" class="lg:hidden p-1.5 rounded-xl text-outline hover:text-brand-deep hover:bg-surface-container-low transition-colors" title="Đóng menu">
                        <span class="material-symbols-outlined text-xl">close</span>
                    </button>
                </div>

                <!-- Vertical Navigation Links -->
                <nav class="flex flex-col gap-1 overflow-y-auto max-h-[calc(100vh-190px)] pr-1 custom-scrollbar" id="sidebar-nav">
                    @* 1. PHÂN HỆ QUẢN TRỊ ĐÀO TẠO (CHỈ ADMIN & GIÁO VỤ) *@
                    @if (isStaff)
                    {
                        <div class="text-[11px] font-semibold text-outline px-3 mt-1 mb-1">Bàn làm việc</div>

                        <a href="/ThongKe/Dashboard" data-url="/thongke/dashboard" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                            <span class="material-symbols-outlined text-[19px] text-outline">dashboard</span>
                            <span>Tổng quan</span>
                        </a>

                        <a href="/DangKyHoc/Index" data-url="/dangkyhoc" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                            <span class="material-symbols-outlined text-[19px] text-outline">how_to_reg</span>
                            <span>Xét duyệt & Học phí</span>
                        </a>

                        <div class="text-[11px] font-semibold text-outline px-3 mt-3 mb-1">Quản lý đào tạo</div>

                        <a href="/ChuongTrinhDaoTao/Index" data-url="/chuongtrinhdaotao" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                            <span class="material-symbols-outlined text-[19px] text-outline">layers</span>
                            <span>Chương trình đào tạo</span>
                        </a>

                        <a href="/LopHoc/Index" data-url="/lophoc" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                            <span class="material-symbols-outlined text-[19px] text-outline">meeting_room</span>
                            <span>Lớp học phần</span>
                        </a>

                        <a href="/BuoiHoc/Index" data-url="/buoihoc" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                            <span class="material-symbols-outlined text-[19px] text-outline">calendar_today</span>
                            <span>Lịch học</span>
                        </a>

                        <a href="/KetQuaHocTap/Index" data-url="/ketquahoctap" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                            <span class="material-symbols-outlined text-[19px] text-outline">workspace_premium</span>
                            <span>Kết quả học tập</span>
                        </a>

                        <div class="text-[11px] font-semibold text-outline px-3 mt-3 mb-1">Hồ sơ & Hệ thống</div>

                        <a href="/GiangVien/QuanLy" data-url="/giangvien/quanly" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                            <span class="material-symbols-outlined text-[19px] text-outline">badge</span>
                            <span>Giảng viên</span>
                        </a>

                        <a href="/HocVien/Index" data-url="/hocvien" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                            <span class="material-symbols-outlined text-[19px] text-outline">group</span>
                            <span>Học viên (Module 3)</span>
                        </a>

                        <a href="/ThongKe/Index" data-url="/thongke/index" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                            <span class="material-symbols-outlined text-[19px] text-outline">bar_chart</span>
                            <span>Báo cáo thống kê</span>
                        </a>

                        @if (isAdmin)
                        {
                            <a href="/TaiKhoan/Index" data-url="/taikhoan" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                                <span class="material-symbols-outlined text-[19px] text-outline">manage_accounts</span>
                                <span>Tài khoản & Phân quyền</span>
                            </a>
                        }
                    }

                    @* 2. PHÂN HỆ CỔNG GIẢNG VIÊN (CHỈ DÀNH CHO GIẢNG VIÊN) *@
                    @if (isGiangVien)
                    {
                        <div class="text-[11px] font-semibold text-outline px-3 mt-1 mb-1">Cổng giảng viên</div>

                        <a href="/GiangVien/Index" data-url="/giangvien/index" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                            <span class="material-symbols-outlined text-[19px] text-outline">dashboard_customize</span>
                            <span>Bàn làm việc</span>
                        </a>

                        <a href="/GiangVien/LichDay" data-url="/giangvien/lichday" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                            <span class="material-symbols-outlined text-[19px] text-outline">calendar_month</span>
                            <span>Lịch giảng dạy</span>
                        </a>

                        <a href="/GiangVien/ChamDiem" data-url="/giangvien/chamdiem" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                            <span class="material-symbols-outlined text-[19px] text-outline">fact_check</span>
                            <span>Chấm điểm học viên</span>
                        </a>
                    }

                    @* 3. PHÂN HỆ CỔNG HỌC VIÊN (CHỈ DÀNH CHO HỌC VIÊN) *@
                    @if (isHocVien)
                    {
                        <div class="text-[11px] font-semibold text-outline px-3 mt-1 mb-1">Cổng học viên</div>

                        <a href="/CongHocVien/DangKy" data-url="/conghocvien/dangky" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                            <span class="material-symbols-outlined text-[19px] text-outline">app_registration</span>
                            <span>Đăng ký lớp học</span>
                        </a>

                        <a href="/CongHocVien/TienTrinh" data-url="/conghocvien/tientrinh" class="sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl font-medium text-[13px] text-on-surface-variant hover:text-brand-deep hover:bg-surface-container-low transition-all">
                            <span class="material-symbols-outlined text-[19px] text-outline">receipt_long</span>
                            <span>Tiến trình & Kết quả</span>
                        </a>
                    }
                </nav>
            </div>

            <!-- Sidebar Bottom User Profile -->
            <div class="pt-3 border-t border-border-standard">
                <div class="flex items-center justify-between p-2 rounded-xl bg-surface-container-low">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <div class="w-8 h-8 rounded-full bg-brand-deep text-surface-white font-bold text-xs flex items-center justify-center shrink-0">
                            @(string.IsNullOrWhiteSpace(userHoTen) ? "U" : userHoTen.Substring(0, 1).ToUpper())
                        </div>
                        <div class="flex flex-col text-left truncate">
                            <span class="text-xs text-brand-deep leading-tight font-bold truncate">@userHoTen</span>
                            <span class="text-[11px] text-outline leading-tight font-medium">@roleLabel</span>
                        </div>
                    </div>
                    <a href="/TaiKhoan/Logout" title="Đăng xuất" class="p-1.5 rounded-lg text-outline hover:text-rose-600 hover:bg-rose-50 transition-colors">
                        <span class="material-symbols-outlined text-[18px]">logout</span>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Mobile Sidebar Backdrop Overlay -->
        <div id="sidebarBackdrop" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-brand-deep/40 backdrop-blur-xs z-40 hidden lg:hidden transition-opacity"></div>

        <!-- Right Content Main Wrapper -->
        <div class="flex-1 min-w-0 flex flex-col min-h-screen bg-canvas-base">
            <!-- Clean Top Navigation Header -->
            <header class="w-full bg-surface-white border-b border-border-standard h-14 px-4 lg:px-6 flex items-center justify-between sticky top-0 z-30">
                <div class="flex items-center gap-3">
                    <!-- Mobile Hamburger Button -->
                    <button type="button" onclick="toggleMobileSidebar()" class="lg:hidden p-1.5 rounded-xl text-outline hover:text-brand-deep hover:bg-surface-container-low transition-colors" title="Menu điều hướng">
                        <span class="material-symbols-outlined text-[22px]">menu</span>
                    </button>
                    <span class="text-sm font-bold text-brand-deep truncate">@(ViewData["Title"] ?? "Hệ thống Quản lý Khóa học")</span>
                </div>

                <div class="flex items-center gap-2">
                    <a href="/?storefront=true" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-surface-white hover:bg-surface-container-low text-on-surface-variant font-medium text-xs transition-colors border border-border-standard" title="Xem Trang chủ giới thiệu khóa học">
                        <span class="material-symbols-outlined text-[16px] text-primary">storefront</span>
                        <span class="hidden sm:inline">Trang chủ EdTech</span>
                    </a>
                    <a href="/TaiKhoan/Login?switchAccount=true" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-surface-container-low hover:bg-surface-container text-brand-deep font-semibold text-xs transition-colors" title="Chuyển đổi tài khoản khác">
                        <span class="material-symbols-outlined text-[16px] text-primary">switch_account</span>
                        <span>Đổi tài khoản</span>
                    </a>
                </div>
            </header>

            <!-- Main Content Body -->
            <main class="flex-1 px-4 lg:px-6 py-5 flex flex-col gap-y-5">
                @RenderBody()
            </main>

            <!-- Simple Footer -->
            <footer class="w-full bg-surface-white border-t border-border-standard py-4">
                <div class="w-full px-4 lg:px-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-outline text-xs">
                    <div>
                        <strong class="text-brand-deep">UNETI</strong> • Hệ thống Quản lý Đăng ký Khóa học &amp; Học viên
                    </div>
                    <div>
                        Nhóm 4 - Khoa CNTT (DHTI17A1HN)
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Active Link Highlighter Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const currentPath = window.location.pathname.toLowerCase();
            const links = document.querySelectorAll('.sidebar-link');
            
            links.forEach(link => {
                const targetUrl = link.getAttribute('data-url').toLowerCase();
                const isMatch = (currentPath === '/' && targetUrl.includes('dashboard')) || 
                                (currentPath.includes(targetUrl));

                if (isMatch) {
                    link.className = 'sidebar-link flex items-center gap-2.5 px-3 py-2 rounded-xl bg-brand-deep text-surface-white font-semibold text-[13px] shadow-xs transition-all';
                    const icon = link.querySelector('span.material-symbols-outlined');
                    if (icon) {
                        icon.className = 'material-symbols-outlined text-[19px] text-white';
                    }
                }
            });
        });
    </script>

    <!-- Global Toast Notification Container -->
    <div id="global-toast-container" class="fixed top-5 right-5 z-[100] flex flex-col gap-2.5 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

    <script>
        window.showToast = function(message, type = 'success') {
            const container = document.getElementById('global-toast-container');
            if (!container) return;

            const isSuccess = type === 'success';
            const toast = document.createElement('div');
            toast.className = `pointer-events-auto flex items-center justify-between p-4 rounded-2xl shadow-xl border transition-all duration-300 transform -translate-y-2 opacity-0 ${
                isSuccess 
                    ? 'bg-emerald-50/95 border-emerald-200 text-emerald-900 backdrop-blur-sm' 
                    : 'bg-red-50/95 border-red-200 text-danger-crimson backdrop-blur-sm'
            }`;

            toast.innerHTML = `
                <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-[22px] flex-shrink-0 ${isSuccess ? 'text-success-emerald' : 'text-danger-crimson'}">
                        ${isSuccess ? 'check_circle' : 'error'}
                    </span>
                    <span class="font-label-md text-label-md font-semibold leading-snug break-words">${message}</span>
                </div>
                <button type="button" class="ml-3 text-outline hover:text-brand-deep cursor-pointer flex-shrink-0">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            `;

            const closeBtn = toast.querySelector('button');
            const removeToast = () => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', '-translate-y-2');
                setTimeout(() => toast.remove(), 300);
            };
            closeBtn.onclick = removeToast;

            container.appendChild(toast);
            void toast.offsetWidth;
            toast.classList.remove('opacity-0', '-translate-y-2');
            toast.classList.add('opacity-100', 'translate-y-0');

            setTimeout(removeToast, isSuccess ? 4000 : 6000);
        };

        window.toggleMobileSidebar = function() {
            const sidebar = document.getElementById('adminSidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            if (!sidebar || !backdrop) return;
            const isClosed = sidebar.classList.contains('-translate-x-full');
            if (isClosed) {
                sidebar.classList.remove('-translate-x-full');
                backdrop.classList.remove('hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                backdrop.classList.add('hidden');
            }
        };
    </script>

    <!-- Global Delete Confirmation Modal for all pages -->
    <partial name="_DeleteModal" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
