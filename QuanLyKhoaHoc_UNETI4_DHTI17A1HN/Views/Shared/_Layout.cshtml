@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UNETI EDU | Quản Lý Khóa Học & Học Viên</title>
    <!-- Google Fonts: Playfair Display + Montserrat -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Container Toast thông báo -->
    <div id="toastContainer" class="toast-container-custom"></div>

    @{
        var currentRole = Context.Session.GetString("VaiTro");
        var currentHoTen = Context.Session.GetString("HoTen");
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <!-- ==================== 1. SIDEBAR TRÁI ==================== -->
    <aside class="sidebar">
        <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
            <div class="brand-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div>
                <div style="line-height: 1.15;">UNETI EDU</div>
                <div style="font-size: 0.65rem; color: #64748b; font-weight: 500; font-family: var(--font-sans);">Khoa CNTT - Nhóm 4</div>
            </div>
        </a>

        <ul class="sidebar-menu">
            <div class="sidebar-category">Bảng điều khiển</div>
            <li>
                <a asp-controller="Home" asp-action="Index" class="sidebar-link @(currentController == "Home" ? "active" : "")">
                    <span class="sidebar-link-left"><i class="bi bi-speedometer2"></i> Tổng quan & Phân công</span>
                </a>
            </li>

            <div class="sidebar-category">Quản lý đào tạo (5 Module)</div>
            <li>
                <a href="/prototype/admin-chuong-trinh.html" class="sidebar-link" title="Module 1 - Phụ trách: Vũ Đình Trường (Dữ liệu mẫu)">
                    <span class="sidebar-link-left"><i class="bi bi-journal-bookmark-fill"></i> Chương trình ĐT (M1)</span>
                    <span class="badge bg-secondary bg-opacity-75 rounded-pill">M1</span>
                </a>
            </li>
            <li>
                <a href="/prototype/admin-lop-hoc.html" class="sidebar-link" title="Module 2 - Phụ trách: Nguyễn Đình Kiên (Dữ liệu mẫu)">
                    <span class="sidebar-link-left"><i class="bi bi-easel2-fill"></i> Quản lý Lớp học (M2)</span>
                    <span class="badge bg-success bg-opacity-75 rounded-pill">18 lớp</span>
                </a>
            </li>
            <li>
                <a asp-controller="HocVien" asp-action="Index" class="sidebar-link @(currentController == "HocVien" && currentAction != "Portal" ? "active" : "")">
                    <span class="sidebar-link-left"><i class="bi bi-person-lines-fill"></i> Học viên & Hồ sơ (M3)</span>
                    <span class="badge rounded-pill fw-bold" style="background: var(--primary-rose); color: #fff;">CSDL Thật</span>
                </a>
            </li>
            <li>
                <a href="/prototype/admin-dang-ky.html" class="sidebar-link" title="Module 4 - Phụ trách: Nguyễn Hoàng Long (Dữ liệu mẫu)">
                    <span class="sidebar-link-left"><i class="bi bi-clipboard2-check-fill"></i> Duyệt ĐK & Học phí (M4)</span>
                    <span class="badge rounded-pill fw-bold" style="background: var(--primary-rose); color: #fff;">8 mới</span>
                </a>
            </li>
            <li>
                <a href="/prototype/admin-buoi-hoc.html" class="sidebar-link" title="Module 5 - Phụ trách: Lê Tiến Dương (Dữ liệu mẫu)">
                    <span class="sidebar-link-left"><i class="bi bi-calendar-week-fill"></i> Lịch học & Buổi học (M5)</span>
                    <span class="badge bg-secondary bg-opacity-50 rounded-pill">M5</span>
                </a>
            </li>
            <li>
                <a href="/prototype/admin-ket-qua.html" class="sidebar-link" title="Module 5: Kết quả học tập & Bảng điểm (Dữ liệu mẫu)">
                    <span class="sidebar-link-left"><i class="bi bi-award-fill"></i> Kết quả học tập (M5)</span>
                </a>
            </li>

            <div class="sidebar-category">Thống kê & Cổng sinh viên</div>
            <li>
                <a href="/prototype/admin-thong-ke.html" class="sidebar-link" title="Module 5: Báo cáo Thống kê LINQ (Dữ liệu mẫu)">
                    <span class="sidebar-link-left"><i class="bi bi-bar-chart-line-fill"></i> Báo cáo LINQ (M5)</span>
                </a>
            </li>
            <li>
                <a asp-controller="HocVien" asp-action="Portal" class="sidebar-link @(currentAction == "Portal" ? "active" : "") text-warning fw-semibold">
                    <span class="sidebar-link-left"><i class="bi bi-box-arrow-up-right"></i> Cổng Học Viên (Mục 17.1)</span>
                    <span class="badge bg-warning text-dark rounded-pill">Mới</span>
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <span><i class="bi bi-person-badge me-1" style="color: var(--primary-blush);"></i> Phụ trách M3:</span>
                <span class="text-white fw-semibold">Nguyễn Đức Linh</span>
            </div>
            <div class="small" style="font-size: 0.72rem; color: #64748b;">
                MSV: 23103100042 • Đề tài 16 UNETI
            </div>
        </div>
    </aside>

    <!-- ==================== 2. MAIN CONTENT WRAPPER ==================== -->
    <div class="main-wrapper">

        <!-- Topbar điều hướng -->
        <header class="topbar">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Hệ Thống</a></li>
                    @if (currentController == "HocVien")
                    {
                        <li class="breadcrumb-item"><a asp-controller="HocVien" asp-action="Index">Học viên & Hồ sơ (Module 3)</a></li>
                        @if (currentAction == "Create")
                        {
                            <li class="breadcrumb-item active" aria-current="page">Thêm mới học viên</li>
                        }
                        else if (currentAction == "Edit")
                        {
                            <li class="breadcrumb-item active" aria-current="page">Cập nhật hồ sơ</li>
                        }
                        else if (currentAction == "Details")
                        {
                            <li class="breadcrumb-item active" aria-current="page">Chi tiết hồ sơ</li>
                        }
                        else if (currentAction == "Portal")
                        {
                            <li class="breadcrumb-item active" aria-current="page">Cổng thông tin học viên</li>
                        }
                        else
                        {
                            <li class="breadcrumb-item active" aria-current="page">Danh sách học viên</li>
                        }
                    }
                    else
                    {
                        <li class="breadcrumb-item active" aria-current="page">Tổng quan & Phân công</li>
                    }
                </ol>
            </nav>

            <div class="d-flex align-items-center gap-2 gap-sm-3">
                <!-- Nút chuyển sang Cổng học viên -->
                <a asp-controller="HocVien" asp-action="Portal" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold" style="font-size: 0.8rem;">
                    <i class="bi bi-mortarboard me-1"></i> Cổng Học Viên
                </a>

                <!-- Hiển thị tài khoản và phiên đăng nhập -->
                <div class="text-end d-none d-sm-block">
                    <div class="fw-bold small" style="color: var(--text-dark);">
                        @(string.IsNullOrEmpty(currentHoTen) ? "Khách truy cập" : currentHoTen)
                    </div>
                    <div style="font-size: 0.72rem; color: var(--text-muted);">
                        Vai trò: <span class="badge bg-primary bg-opacity-10 text-primary">@(string.IsNullOrEmpty(currentRole) ? "Chưa đăng nhập" : currentRole)</span>
                    </div>
                </div>

                <!-- Dropdown Đổi Phiên Test Session -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-warning rounded-pill px-3 py-1 fw-bold dropdown-toggle text-dark" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.8rem;">
                        <i class="bi bi-shield-lock-fill me-1"></i> Đổi Phiên Test
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2" style="font-size: 0.85rem;">
                        <li class="px-3 py-2 border-bottom fw-bold text-dark d-flex justify-content-between align-items-center">
                            <span>Phiên Kiểm Thử Session</span>
                            <span class="badge bg-light text-muted">Slide 8-11</span>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" asp-controller="HocVien" asp-action="DangNhapThuNghiem" asp-route-role="GiaoVu">
                                <i class="bi bi-person-badge text-primary me-2"></i> Giáo vụ (GiaoVu) - Có quyền M3
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" asp-controller="HocVien" asp-action="DangNhapThuNghiem" asp-route-role="Admin">
                                <i class="bi bi-shield-fill text-danger me-2"></i> Quản trị viên (Admin) - Toàn quyền
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" asp-controller="HocVien" asp-action="DangNhapThuNghiem" asp-route-role="HocVien">
                                <i class="bi bi-mortarboard text-warning me-2"></i> Học viên - Bị chặn Quản trị
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item py-2 text-danger fw-semibold" asp-controller="HocVien" asp-action="DangXuatThuNghiem">
                                <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất (Clear Session)
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Khung nội dung chính -->
        <main class="content-area">
            <!-- Thông báo Alert TempData -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-success border-opacity-25 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-danger border-opacity-25 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>

        <!-- Chân trang -->
        <footer class="py-3 px-4 bg-white border-top text-center text-muted small mt-auto">
            <span>&copy; 2026 - BTL Lập trình .NET - <strong>Nhóm 4 (Lớp DHTI17A1HN)</strong> - Khoa CNTT Trường ĐH Kinh tế - Kỹ thuật Công nghiệp (UNETI)</span>
        </footer>
    </div>

    <!-- Script Libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Hàm helper hiển thị Toast dùng chung chuẩn Giao_DIen_Test -->
    <script>
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            if (!container) return;
            const toast = document.createElement('div');
            toast.className = 'custom-toast';
            
            let icon = 'bi-info-circle-fill text-primary';
            if (type === 'success') icon = 'bi-check-circle-fill text-success';
            if (type === 'danger' || type === 'error') icon = 'bi-exclamation-triangle-fill text-danger';
            if (type === 'warning') icon = 'bi-exclamation-circle-fill text-warning';

            toast.innerHTML = `
                <i class="bi ${icon} fs-5"></i>
                <div class="flex-grow-1">
                    <div class="fw-semibold small">${message}</div>
                </div>
                <button type="button" class="btn-close btn-close-sm ms-2" onclick="this.parentElement.remove()"></button>
            `;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.4s ease';
                setTimeout(() => toast.remove(), 400);
            }, 3500);
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
