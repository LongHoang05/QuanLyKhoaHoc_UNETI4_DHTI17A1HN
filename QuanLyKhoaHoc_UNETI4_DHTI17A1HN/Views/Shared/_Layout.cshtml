@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Khóa Học & Học Viên (UNETI Nhóm 4)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill me-2"></i>UNETI - Quản Lý Khóa Học & Học Viên (Nhóm 4 - DHTI17A1HN)
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill"></i> Phân công nhiệm vụ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-bold bg-white bg-opacity-25 rounded px-3 ms-lg-2" asp-controller="HocVien" asp-action="Index">
                                <i class="bi bi-people-fill me-1"></i> Module 3: Quản Lý Học Viên
                            </a>
                        </li>
                    </ul>

                    @{
                        var currentRole = Context.Session.GetString("VaiTro");
                        var currentHoTen = Context.Session.GetString("HoTen");
                    }
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(currentRole))
                        {
                            <span class="badge bg-light text-dark px-3 py-2 fw-semibold">
                                <i class="bi bi-person-circle text-primary me-1"></i> @currentHoTen (@currentRole)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark px-3 py-2 fw-semibold">
                                <i class="bi bi-clock-history me-1"></i> Chưa có Session
                            </span>
                        }

                        <div class="dropdown">
                            <button class="btn btn-warning btn-sm dropdown-toggle fw-bold text-dark" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-shield-lock-fill me-1"></i> Đổi Phiên Test
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li><h6 class="dropdown-header text-uppercase small">Vai trò kiểm thử</h6></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="HocVien" asp-action="DangNhapThuNghiem" asp-route-role="GiaoVu">
                                        <i class="bi bi-person-badge text-primary me-2"></i> Giáo vụ (GiaoVu)
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="HocVien" asp-action="DangNhapThuNghiem" asp-route-role="Admin">
                                        <i class="bi bi-shield-fill text-danger me-2"></i> Quản trị viên (Admin)
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="HocVien" asp-action="DangNhapThuNghiem" asp-route-role="HocVien">
                                        <i class="bi bi-mortarboard text-warning me-2"></i> Học viên (Chặn quản trị)
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" asp-controller="HocVien" asp-action="DangXuatThuNghiem">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất (Clear Session)
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <!-- Thông báo Alert TempData -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container text-center">
            <small>&copy; 2026 - BTL Lập trình .NET - Nhóm 4 (Lớp DHTI17A1HN) - Khoa CNTT Trường ĐH Kinh tế - Kỹ thuật Công nghiệp (UNETI)</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
