@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    string userHoTen = session?.GetString("HoTen") ?? "";
    string userVaiTro = session?.GetString("VaiTro") ?? "";
    string userEmail = session?.GetString("Email") ?? "";
    int? maTaiKhoan = session?.GetInt32("MaTaiKhoan");
    int? maHocVien = session?.GetInt32("MaHocVien");
    bool isLoggedIn = maTaiKhoan.HasValue;
    bool isStaffOrAdmin = string.Equals(userVaiTro, "Admin", StringComparison.OrdinalIgnoreCase) || string.Equals(userVaiTro, "GiaoVu", StringComparison.OrdinalIgnoreCase) || string.Equals(userVaiTro, "Giáo vụ", StringComparison.OrdinalIgnoreCase);
    bool isGiangVien = string.Equals(userVaiTro, "GiangVien", StringComparison.OrdinalIgnoreCase) || string.Equals(userVaiTro, "Giảng viên", StringComparison.OrdinalIgnoreCase);
    bool isHocVien = string.Equals(userVaiTro, "HocVien", StringComparison.OrdinalIgnoreCase) || string.Equals(userVaiTro, "Học viên", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewData["Title"] - UNETI EDUTECH | Hệ Thống Khóa Học Chất Lượng Cao</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        @@layer base {
            html, body { margin: 0; padding: 0; font-family: 'Be Vietnam Pro', 'Inter', sans-serif; scroll-behavior: smooth; }
            body { background-color: #F8FAFC; color: #0F172A; }
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #F1F5F9;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #0052cc;
        }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'brand-deep': '#001656',
                        'primary': '#0052cc',
                        'primary-hover': '#0047b3',
                        'primary-light': '#eff4ff',
                        'canvas-base': '#F8FAFC',
                        'border-standard': '#E2E8F0',
                        'outline': '#64748B',
                        'accent-orange': '#FF6B00',
                        'accent-emerald': '#10B981'
                    },
                    fontFamily: {
                        sans: ['"Be Vietnam Pro"', 'Inter', 'sans-serif']
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-canvas-base text-slate-800 antialiased min-h-screen flex flex-col justify-between">
    <!-- Top Alert Notification Bar -->
    <div class="bg-gradient-to-r from-brand-deep via-[#002f87] to-primary text-white text-xs py-2 px-4 text-center font-medium shadow-xs">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <span class="hidden sm:inline">🎉 <strong>Ưu đãi tuyển sinh 2026:</strong> Giảm 10% học phí cho học viên đăng ký sớm trong tuần này!</span>
            <span class="sm:hidden font-semibold">🎉 Ưu đãi 10% học phí khi đăng ký sớm!</span>
            <div class="flex items-center gap-4 text-[11px] text-white/90">
                <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">call</span> Hotline: 1900 6868</span>
                <span class="hidden md:flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">verified</span> Cam kết chuẩn đầu ra</span>
            </div>
        </div>
    </div>

    <!-- Main Navigation Header (Edu-Commerce Storefront Style) -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-border-standard shadow-xs transition-all">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
            <!-- Brand Logo -->
            <a href="/?storefront=true" class="flex items-center gap-3 shrink-0 group">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-brand-deep to-primary text-white flex items-center justify-center font-bold text-2xl shadow-md shadow-primary/20 group-hover:scale-105 transition-transform">
                    <span class="material-symbols-outlined text-[26px]">school</span>
                </div>
                <div class="flex flex-col">
                    <div class="flex items-center gap-1.5">
                        <span class="text-base sm:text-lg font-black text-brand-deep tracking-tight leading-none">UNETI</span>
                        <span class="text-xs px-1.5 py-0.5 rounded bg-primary text-white font-extrabold uppercase tracking-wide">EDUSPACE</span>
                    </div>
                    <span class="text-[11px] text-outline font-medium tracking-tight mt-0.5">Học viện Đào tạo & Kỹ năng Thực chiến</span>
                </div>
            </a>

            <!-- Navigation Links (Role-aware) -->
            <nav class="hidden md:flex items-center gap-1 sm:gap-2 text-xs sm:text-sm font-bold text-brand-deep">
                <a href="/?storefront=true#gioi-thieu" class="px-3.5 py-2 rounded-xl hover:bg-primary-light hover:text-primary transition-colors flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[19px] text-primary">info</span>
                    <span>Giới thiệu</span>
                </a>
                <a href="/?storefront=true#kham-pha-khoa-hoc" class="px-3.5 py-2 rounded-xl hover:bg-primary-light hover:text-primary transition-colors flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[19px] text-primary">explore</span>
                    <span>Khám phá khóa học</span>
                </a>
                <a href="/?storefront=true#lien-he" class="px-3.5 py-2 rounded-xl hover:bg-amber-50 text-slate-700 hover:text-amber-700 transition-colors flex items-center gap-1.5 cursor-pointer">
                    <span class="material-symbols-outlined text-[19px] text-amber-500">support_agent</span>
                    <span>Liên hệ</span>
                </a>
            </nav>

            <!-- Navigation Links & Account Area -->
            <div class="flex items-center gap-2 sm:gap-4 shrink-0">
                <!-- Mobile Contact button -->
                <button type="button" onclick="openContactSupportModal()" class="md:hidden p-2 rounded-xl text-slate-700 hover:bg-slate-100 flex items-center gap-1 text-xs font-semibold" title="Liên hệ">
                    <span class="material-symbols-outlined text-[20px] text-amber-500">support_agent</span>
                    <span>Liên hệ</span>
                </button>

                <div class="h-6 w-px bg-border-standard hidden sm:block"></div>

                @if (isLoggedIn)
                {
                    <!-- User Account Dropdown -->
                    <div class="relative" id="user-menu-wrapper">
                        <button type="button" onclick="toggleUserDropdown()" class="flex items-center gap-2.5 p-1.5 sm:px-3 sm:py-2 rounded-2xl hover:bg-slate-100 transition-colors cursor-pointer border border-border-standard">
                            <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-brand-deep to-primary text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-xs">
                                @(string.IsNullOrWhiteSpace(userHoTen) ? "U" : userHoTen.Substring(0, 1).ToUpper())
                            </div>
                            <div class="hidden sm:flex flex-col text-left">
                                <span class="text-xs font-bold text-brand-deep leading-tight truncate max-w-[130px]">@userHoTen</span>
                                <span class="text-[10px] text-primary font-semibold leading-tight">@userVaiTro</span>
                            </div>
                            <span class="material-symbols-outlined text-outline text-[18px]">expand_more</span>
                        </button>

                        <!-- Dropdown Menu -->
                        <div id="user-dropdown" class="absolute right-0 mt-2 w-64 bg-white rounded-2xl shadow-xl border border-border-standard py-2 z-50 hidden transform transition-all origin-top-right">
                            <div class="px-4 py-3 border-b border-border-standard bg-slate-50/70 rounded-t-2xl">
                                <p class="text-xs text-outline">Đang đăng nhập với</p>
                                <p class="text-xs font-bold text-brand-deep truncate">@userHoTen</p>
                                <span class="inline-block mt-1 px-2 py-0.5 rounded text-[10px] font-bold bg-primary-light text-primary">
                                    Vai trò: @userVaiTro
                                </span>
                            </div>

                            <div class="py-1 text-xs text-slate-700">
                                @if (isHocVien)
                                {
                                    <a href="/CongHocVien/TienTrinh?tab=dangky" class="flex items-center gap-2.5 px-4 py-2 hover:bg-primary-light hover:text-primary transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                                        <span>Đơn đăng ký & Học phí</span>
                                    </a>
                                    <a href="/CongHocVien/TienTrinh?tab=tkb" class="flex items-center gap-2.5 px-4 py-2 hover:bg-primary-light hover:text-primary transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                                        <span>Thời khóa biểu tuần</span>
                                    </a>
                                    <a href="/CongHocVien/TienTrinh?tab=ketqua" class="flex items-center gap-2.5 px-4 py-2 hover:bg-primary-light hover:text-primary transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">school</span>
                                        <span>Bảng điểm & Chứng nhận</span>
                                    </a>
                                    <a href="/CongHocVien/TienTrinh?tab=hoso" class="flex items-center gap-2.5 px-4 py-2 hover:bg-primary-light hover:text-primary transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">badge</span>
                                        <span>Thẻ sinh viên & Hồ sơ</span>
                                    </a>
                                }
                                @if (isStaffOrAdmin)
                                {
                                    <a href="/ThongKe/Dashboard" class="flex items-center gap-2.5 px-4 py-2 text-primary font-bold hover:bg-primary-light transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">admin_panel_settings</span>
                                        <span>Trang Quản trị Hệ thống</span>
                                    </a>
                                    <a href="/LopHoc/Index" class="flex items-center gap-2.5 px-4 py-2 hover:bg-primary-light hover:text-primary transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">meeting_room</span>
                                        <span>Quản lý Lớp học</span>
                                    </a>
                                    <a href="/DangKyHoc/Index" class="flex items-center gap-2.5 px-4 py-2 hover:bg-primary-light hover:text-primary transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">how_to_reg</span>
                                        <span>Xét duyệt & Học phí</span>
                                    </a>
                                }
                                @if (isGiangVien)
                                {
                                    <a href="/GiangVien/Index" class="flex items-center gap-2.5 px-4 py-2 text-primary font-bold hover:bg-primary-light transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">dashboard_customize</span>
                                        <span>Bàn làm việc Giảng viên</span>
                                    </a>
                                    <a href="/GiangVien/LichDay" class="flex items-center gap-2.5 px-4 py-2 hover:bg-primary-light hover:text-primary transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                                        <span>Lịch giảng dạy</span>
                                    </a>
                                    <a href="/GiangVien/ChamDiem" class="flex items-center gap-2.5 px-4 py-2 hover:bg-primary-light hover:text-primary transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">fact_check</span>
                                        <span>Chấm điểm học viên</span>
                                    </a>
                                }
                            </div>

                            <div class="border-t border-border-standard pt-1">
                                <a href="/TaiKhoan/Logout" class="flex items-center gap-2.5 px-4 py-2 text-xs text-rose-600 hover:bg-rose-50 font-semibold transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">logout</span>
                                    <span>Đăng xuất</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-2">
                        <a href="/TaiKhoan/Login" class="text-xs font-bold text-brand-deep hover:text-primary px-3 py-2 rounded-xl hover:bg-slate-100 transition-colors">
                            Đăng nhập
                        </a>
                        <a href="/TaiKhoan/DangKy" class="text-xs font-bold text-white bg-primary hover:bg-primary-hover px-4 py-2 rounded-xl shadow-xs hover:shadow transition-all">
                            Đăng ký tài khoản
                        </a>
                    </div>
                }
            </div>
        </div>
    </header>

    <!-- Main Content Body -->
    <main class="flex-1">
        @RenderBody()
    </main>

    <!-- Edu-Commerce Storefront Footer -->
    <footer class="bg-brand-deep text-white mt-16 border-t border-white/10">
        <!-- Top Footer Grid -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
                <!-- Col 1: Brand Info -->
                <div class="lg:col-span-2 space-y-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-white text-brand-deep flex items-center justify-center font-black text-xl shadow-md">
                            <span class="material-symbols-outlined text-[24px]">school</span>
                        </div>
                        <div>
                            <span class="text-lg font-black text-white tracking-tight">UNETI EDUSPACE</span>
                            <p class="text-[11px] text-slate-300">Hệ Thống Đào Tạo Chứng Chỉ & Kỹ Năng Nghề Nghiệp</p>
                        </div>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed max-w-sm">
                        Đơn vị tiên phong cung cấp các chương trình đào tạo thực chiến chuẩn quốc tế tại Đại học Kinh tế - Kỹ thuật Công nghiệp, kết nối hơn 100+ doanh nghiệp công nghệ hàng đầu.
                    </p>
                    <div class="flex items-center gap-3 text-xs text-slate-300">
                        <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-accent-emerald text-[18px]">verified</span> Bằng cấp uy tín</span>
                        <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-accent-emerald text-[18px]">work</span> Hỗ trợ việc làm</span>
                    </div>
                </div>

                <!-- Col 2: Programs -->
                <div class="space-y-3">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-white">Chương Trình Đào Tạo</h4>
                    <ul class="space-y-2 text-xs text-slate-300">
                        <li><a href="/?storefront=true" class="hover:text-white transition-colors">Lập trình Web ASP.NET Core</a></li>
                        <li><a href="/?storefront=true" class="hover:text-white transition-colors">Lập trình ReactJS & Frontend</a></li>
                        <li><a href="/?storefront=true" class="hover:text-white transition-colors">Khoa học Dữ liệu với Python</a></li>
                        <li><a href="/?storefront=true" class="hover:text-white transition-colors">Tiếng Anh Giao Tiếp Chuẩn Quốc Tế</a></li>
                        <li><a href="/?storefront=true" class="hover:text-white transition-colors">Lập trình Mobile với Flutter</a></li>
                    </ul>
                </div>

                <!-- Col 3: Student Portal Support -->
                <div class="space-y-3">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-white">Cổng Học Viên</h4>
                    <ul class="space-y-2 text-xs text-slate-300">
                        <li><a href="/?storefront=true" class="hover:text-white transition-colors">Danh sách lớp mở tuyển sinh</a></li>
                        <li><a href="/TaiKhoan/Login" class="hover:text-white transition-colors">Đăng nhập cổng học vụ</a></li>
                        <li><a href="/TaiKhoan/DangKy" class="hover:text-white transition-colors">Đăng ký tài khoản mới</a></li>
                    </ul>
                </div>

                <!-- Col 4: Contact & Hotline -->
                <div class="space-y-3">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-white">Liên Hệ Tuyển Sinh</h4>
                    <div class="space-y-2 text-xs text-slate-300">
                        <p class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-[16px] text-primary shrink-0 mt-0.5">location_on</span>
                            <span>Trường ĐH Kinh tế - Kỹ thuật Công nghiệp (UNETI), Hà Nội & Nam Định</span>
                        </p>
                        <p class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-[16px] text-primary shrink-0">call</span>
                            <span class="font-bold text-white">Hotline: 1900 6868</span>
                        </p>
                        <p class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-[16px] text-primary shrink-0">mail</span>
                            <span>tuyensinh@uneti.edu.vn</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Copyright -->
        <div class="border-t border-white/10 py-5 bg-black/20 text-xs text-slate-400">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3">
                <div>
                    © 2026 UNETI EDUSPACE. Đề tài 16: Quản lý Đăng ký Khóa học & Học viên.
                </div>
                <div>
                    Thực hiện bởi: <strong class="text-white">Nhóm 5</strong> - Khoa CNTT (DHTI17A1HN).
                </div>
            </div>
        </div>
    </footer>

    <!-- Contact & Support Modal -->
    <div id="contactSupportModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-7 shadow-2xl border border-border-standard relative space-y-5 animate-in fade-in duration-200">
            <button type="button" onclick="closeContactSupportModal()" class="absolute top-4 right-4 p-2 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>

            <div class="flex items-center gap-3 border-b border-border-standard pb-4">
                <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[28px]">support_agent</span>
                </div>
                <div>
                    <h3 class="text-base sm:text-lg font-black text-brand-deep">Trung Tâm Hỗ Trợ Học Viên UNETI</h3>
                    <p class="text-xs text-outline">Giải đáp học vụ, lịch học, học phí & tư vấn tuyển sinh 24/7</p>
                </div>
            </div>

            <!-- Hotline & Channels -->
            <div class="space-y-3">
                <div class="p-3.5 rounded-2xl bg-primary-light border border-primary/20 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary text-[24px]">call</span>
                        <div>
                            <span class="text-[11px] text-outline font-semibold block">Tổng đài tư vấn tuyển sinh & học phí</span>
                            <a href="tel:19006868" class="text-base font-black text-primary hover:underline">1900 6868</a>
                            <span class="text-[10px] text-slate-500 block">(Bấm phím 1: Học vụ • Phím 2: Học phí)</span>
                        </div>
                    </div>
                    <a href="tel:19006868" class="px-3.5 py-1.5 rounded-xl bg-primary hover:bg-primary-hover text-white text-xs font-bold shadow-xs transition-colors">
                        Gọi ngay
                    </a>
                </div>

                <div class="p-3.5 rounded-2xl bg-slate-50 border border-border-standard flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-emerald-600 text-[24px]">mark_email_read</span>
                        <div>
                            <span class="text-[11px] text-outline font-semibold block">Hòm thư tiếp nhận yêu cầu</span>
                            <span class="text-xs font-bold text-brand-deep">tuyensinh@uneti.edu.vn</span>
                        </div>
                    </div>
                    <a href="mailto:tuyensinh@uneti.edu.vn" class="px-3 py-1.5 rounded-xl border border-border-standard bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700">
                        Gửi Email
                    </a>
                </div>

                <div class="p-3.5 rounded-2xl bg-slate-50 border border-border-standard space-y-1.5 text-xs text-slate-700">
                    <div class="flex items-start gap-2">
                        <span class="material-symbols-outlined text-[18px] text-primary shrink-0 mt-0.5">location_on</span>
                        <div>
                            <strong class="text-brand-deep">Cơ sở Hà Nội:</strong> 218 Lĩnh Nam, Hoàng Mai & 456 Minh Khai, Hai Bà Trưng.
                        </div>
                    </div>
                    <div class="flex items-start gap-2">
                        <span class="material-symbols-outlined text-[18px] text-primary shrink-0 mt-0.5">location_on</span>
                        <div>
                            <strong class="text-brand-deep">Cơ sở Nam Định:</strong> 353 Trần Hưng Đạo, TP. Nam Định.
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-2 flex justify-end gap-2">
                <button type="button" onclick="closeContactSupportModal()" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold cursor-pointer transition-colors">
                    Đóng
                </button>
            </div>
        </div>
    </div>

    <!-- Global Toast Notification Container -->
    <div id="global-toast-container" class="fixed top-5 right-5 z-[100] flex flex-col gap-2.5 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

    <script>
        function openContactSupportModal() {
            const modal = document.getElementById('contactSupportModal');
            if (modal) modal.classList.remove('hidden');
        }

        function closeContactSupportModal() {
            const modal = document.getElementById('contactSupportModal');
            if (modal) modal.classList.add('hidden');
        }

        function toggleUserDropdown() {
            const dropdown = document.getElementById('user-dropdown');
            dropdown.classList.toggle('hidden');
        }

        document.addEventListener('click', function(e) {
            const wrapper = document.getElementById('user-menu-wrapper');
            const dropdown = document.getElementById('user-dropdown');
            if (wrapper && !wrapper.contains(e.target) && dropdown && !dropdown.classList.contains('hidden')) {
                dropdown.classList.add('hidden');
            }
        });

        window.showToast = function(message, type = 'success') {
            const container = document.getElementById('global-toast-container');
            if (!container) return;

            const isSuccess = type === 'success';
            const toast = document.createElement('div');
            toast.className = `pointer-events-auto flex items-center justify-between p-4 rounded-2xl shadow-xl border transition-all duration-300 transform -translate-y-2 opacity-0 ${
                isSuccess 
                    ? 'bg-emerald-50/95 border-emerald-200 text-emerald-900 backdrop-blur-sm' 
                    : 'bg-red-50/95 border-red-200 text-red-900 backdrop-blur-sm'
            }`;

            toast.innerHTML = `
                <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-[22px] shrink-0 ${isSuccess ? 'text-emerald-600' : 'text-red-600'}">
                        ${isSuccess ? 'check_circle' : 'error'}
                    </span>
                    <span class="font-semibold text-xs leading-snug break-words">${message}</span>
                </div>
                <button type="button" class="ml-3 text-slate-400 hover:text-slate-700 cursor-pointer shrink-0">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            `;

            const closeBtn = toast.querySelector('button');
            const removeToast = () => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', '-translate-y-2');
                setTimeout(() => toast.remove(), 300);
            };
            closeBtn.onclick = removeToast;

            container.appendChild(toast);
            void toast.offsetWidth;
            toast.classList.remove('opacity-0', '-translate-y-2');
            toast.classList.add('opacity-100', 'translate-y-0');

            setTimeout(removeToast, isSuccess ? 4000 : 6000);
        };
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
