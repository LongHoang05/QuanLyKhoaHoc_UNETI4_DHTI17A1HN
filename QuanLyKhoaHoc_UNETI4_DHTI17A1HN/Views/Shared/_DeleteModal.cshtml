@*
    Universal Reusable Delete Confirmation Modal
    Họ và tên: Nguyễn Tùng Dương - MSV: 23103100003
*@

<!-- GLOBAL DELETE / CONFIRMATION MODAL -->
<div class="fixed inset-0 z-[110] flex items-center justify-center p-4 backdrop-blur-xs hidden transition-all duration-300" id="global-delete-modal" style="background-color: rgba(15, 23, 42, 0.55);">
    <div class="bg-white max-w-md w-full rounded-2xl shadow-2xl border border-slate-200/90 p-6 space-y-4" style="background-color: #ffffff !important;" onclick="event.stopPropagation()">
        <!-- Icon Container -->
        <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center" id="global-delete-icon-box">
            <span class="material-symbols-outlined text-[28px]" id="global-delete-icon">delete_forever</span>
        </div>

        <!-- Title & Description -->
        <div class="space-y-1.5">
            <h3 class="text-lg text-brand-deep font-bold" id="global-delete-title">
                Xác nhận xóa?
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed" id="global-delete-msg">
                Bạn có chắc chắn muốn xóa bản ghi này?
            </p>
        </div>

        <!-- Warning Alert Box -->
        <div class="bg-rose-50 border border-rose-200/80 rounded-xl p-3 flex items-start gap-2.5" id="global-delete-warning-box">
            <span class="material-symbols-outlined text-rose-600 text-[18px] flex-shrink-0 mt-0.5" id="global-delete-warning-icon">warning</span>
            <span class="text-xs text-rose-700 font-medium" id="global-delete-warning">
                Hành động này mang tính vĩnh viễn và không thể hoàn tác sau khi xác nhận.
            </span>
        </div>

        <!-- Action Form -->
        <form method="post" id="global-delete-form" action="">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="global-delete-id" value="0"/>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" class="border border-border-standard text-slate-700 px-4 py-2 rounded-xl text-sm font-medium hover:bg-slate-50 transition-colors cursor-pointer active:scale-95" onclick="closeGlobalDeleteModal()">
                    Hủy bỏ
                </button>
                <button type="submit" id="global-delete-submit-btn" class="bg-rose-600 hover:bg-rose-700 text-white px-4 py-2 rounded-xl text-sm font-semibold shadow-xs flex items-center gap-1.5 transition-all cursor-pointer active:scale-95">
                    <span class="material-symbols-outlined text-[18px]" id="global-delete-submit-icon">delete</span>
                    <span id="global-delete-btn-text">Xóa vĩnh viễn</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    window._currentDeleteOptions = null;

    window.openGlobalDeleteModal = function(options) {
        options = options || {};
        window._currentDeleteOptions = options;
        const modal = document.getElementById('global-delete-modal');
        if (!modal) return;

        const form = document.getElementById('global-delete-form');
        const idInput = document.getElementById('global-delete-id');
        const titleEl = document.getElementById('global-delete-title');
        const msgEl = document.getElementById('global-delete-msg');
        const warningBox = document.getElementById('global-delete-warning-box');
        const warningIcon = document.getElementById('global-delete-warning-icon');
        const warningEl = document.getElementById('global-delete-warning');
        const btnTextEl = document.getElementById('global-delete-btn-text');
        const iconBox = document.getElementById('global-delete-icon-box');
        const iconEl = document.getElementById('global-delete-icon');
        const submitBtn = document.getElementById('global-delete-submit-btn');
        const submitIconEl = document.getElementById('global-delete-submit-icon');

        // Reset custom onclick handlers from previous modal invocations
        if (submitBtn) {
            submitBtn.onclick = null;
            submitBtn.disabled = false;
        }

        const actionUrl = options.action || options.confirmUrl || '';
        const targetId = options.id !== undefined ? options.id : options.itemId;
        const theme = options.theme || 'danger'; // 'danger' | 'warning' | 'primary'

        form.action = actionUrl;
        idInput.name = options.paramName || 'id';
        idInput.value = targetId !== undefined ? targetId : 0;
        titleEl.innerText = options.title || 'Xác nhận xóa?';

        if (options.message) {
            msgEl.innerHTML = options.message;
        } else if (options.itemName) {
            msgEl.innerHTML = `Bạn có chắc chắn muốn xóa <span class="font-semibold text-gray-900">${options.itemName}</span>? Tất cả dữ liệu liên quan sẽ bị gián đoạn.`;
        } else {
            msgEl.innerText = 'Bạn có chắc chắn muốn xóa bản ghi này?';
        }

        if (options.warning === false) {
            warningBox.classList.add('hidden');
        } else {
            warningBox.classList.remove('hidden');
            warningEl.innerText = options.warning || 'Hành động này mang tính vĩnh viễn và không thể hoàn tác sau khi xác nhận.';
        }

        // Apply theme colors
        if (theme === 'warning') {
            iconBox.className = 'w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center';
            warningBox.className = 'bg-amber-50 border border-amber-200/80 rounded-xl p-3 flex items-start gap-2.5' + (options.warning === false ? ' hidden' : '');
            warningIcon.className = 'material-symbols-outlined text-amber-600 text-[18px] flex-shrink-0 mt-0.5';
            warningEl.className = 'text-xs text-amber-800 font-medium';
            submitBtn.className = 'bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-xl text-sm font-semibold shadow-xs flex items-center gap-1.5 transition-all cursor-pointer active:scale-95';
        } else if (theme === 'primary') {
            iconBox.className = 'w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center';
            warningBox.className = 'bg-blue-50 border border-blue-200/80 rounded-xl p-3 flex items-start gap-2.5' + (options.warning === false ? ' hidden' : '');
            warningIcon.className = 'material-symbols-outlined text-blue-600 text-[18px] flex-shrink-0 mt-0.5';
            warningEl.className = 'text-xs text-blue-800 font-medium';
            submitBtn.className = 'bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl text-sm font-semibold shadow-xs flex items-center gap-1.5 transition-all cursor-pointer active:scale-95';
        } else {
            iconBox.className = 'w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center';
            warningBox.className = 'bg-rose-50 border border-rose-200/80 rounded-xl p-3 flex items-start gap-2.5' + (options.warning === false ? ' hidden' : '');
            warningIcon.className = 'material-symbols-outlined text-rose-600 text-[18px] flex-shrink-0 mt-0.5';
            warningEl.className = 'text-xs text-rose-700 font-medium';
            submitBtn.className = 'bg-rose-600 hover:bg-rose-700 text-white px-4 py-2 rounded-xl text-sm font-semibold shadow-xs flex items-center gap-1.5 transition-all cursor-pointer active:scale-95';
        }

        btnTextEl.innerText = options.submitText || 'Xóa vĩnh viễn';
        iconEl.innerText = options.icon || 'delete_forever';
        submitIconEl.innerText = options.submitIcon || (theme === 'warning' ? 'check_circle' : (theme === 'primary' ? 'check_circle' : 'delete'));

        modal.classList.remove('hidden');
    };

    window.confirmLogout = function(logoutUrl = '/TaiKhoan/Logout') {
        openGlobalDeleteModal({
            title: 'Xác nhận thoát / đăng xuất?',
            message: 'Bạn có chắc chắn muốn đăng xuất khỏi phiên làm việc hiện tại không?',
            warning: 'Bạn sẽ cần đăng nhập lại để tiếp tục sử dụng các chức năng quản lý.',
            submitText: 'Đăng xuất ngay',
            submitIcon: 'logout',
            icon: 'logout',
            theme: 'warning',
            onConfirm: function() {
                window.location.href = logoutUrl;
            }
        });
    };

    window.closeGlobalDeleteModal = function() {
        const modal = document.getElementById('global-delete-modal');
        if (modal) modal.classList.add('hidden');
    };

    document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('global-delete-modal');
        if (modal) {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    closeGlobalDeleteModal();
                }
            });
        }

        document.addEventListener('click', (e) => {
            const trigger = e.target.closest('.btn-open-delete-modal');
            if (trigger) {
                e.preventDefault();
                openGlobalDeleteModal({
                    action: trigger.dataset.deleteAction,
                    id: trigger.dataset.deleteId,
                    title: trigger.dataset.deleteTitle,
                    itemName: trigger.dataset.deleteName,
                    message: trigger.dataset.deleteMessage,
                    warning: trigger.dataset.deleteWarning,
                    submitText: trigger.dataset.deleteSubmit,
                    icon: trigger.dataset.deleteIcon
                });
            }
        });

        const deleteForm = document.getElementById('global-delete-form');
        if (deleteForm) {
            deleteForm.addEventListener('submit', async function(e) {
                const opts = window._currentDeleteOptions || {};

                if (typeof opts.onConfirm === 'function') {
                    e.preventDefault();
                    closeGlobalDeleteModal();
                    opts.onConfirm();
                    return;
                }

                const successCallback = typeof opts.onSuccess === 'function'
                    ? opts.onSuccess
                    : (typeof window.onDeleteSuccess === 'function' ? window.onDeleteSuccess : null);

                if (successCallback) {
                    e.preventDefault();
                    const submitBtn = document.getElementById('global-delete-submit-btn');
                    const btnText = document.getElementById('global-delete-btn-text');
                    const originalText = btnText ? btnText.innerText : 'Xóa vĩnh viễn';
                    if (submitBtn) submitBtn.disabled = true;
                    if (btnText) btnText.innerText = 'Đang xóa...';

                    try {
                        const formData = new FormData(deleteForm);
                        const res = await fetch(deleteForm.action, {
                            method: 'POST',
                            body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        
                        const contentType = res.headers.get("content-type");
                        if (contentType && contentType.indexOf("application/json") !== -1) {
                            const data = await res.json();
                            closeGlobalDeleteModal();
                            if (data.success) {
                                if (window.showToast) window.showToast(data.message, 'success');
                                successCallback(data);
                            } else {
                                if (window.showToast) window.showToast(data.message, 'error');
                            }
                        } else {
                            closeGlobalDeleteModal();
                            window.location.reload();
                        }
                    } catch (err) {
                        console.error('Lỗi khi xóa:', err);
                        if (window.showToast) window.showToast('Đã xảy ra lỗi khi thực hiện xóa.', 'error');
                    } finally {
                        if (submitBtn) submitBtn.disabled = false;
                        if (btnText) btnText.innerText = originalText;
                    }
                }
            });
        }
    });

    // ========================================================
    // UNIVERSAL BULK / BATCH DELETE HELPER (CHO TẤT CẢ CÁC BẢNG)
    // ========================================================
    window.initBulkDelete = function(config) {
        const {
            selectAllId = 'selectAll',
            checkboxClass = 'row-checkbox',
            btnDeleteId = 'btnBulkDelete',
            countBadgeId = 'selectedCount',
            deleteUrl = '',
            itemLabel = 'mục',
            onSuccess = null
        } = config;

        function getCheckboxes() {
            return document.querySelectorAll('.' + checkboxClass);
        }

        function getSelectedIds() {
            const checked = document.querySelectorAll('.' + checkboxClass + ':checked');
            return Array.from(checked).map(cb => parseInt(cb.value, 10)).filter(id => !isNaN(id) && id > 0);
        }

        function updateState() {
            const selectAllEl = document.getElementById(selectAllId);
            const btnDelete = document.getElementById(btnDeleteId);
            const countBadge = document.getElementById(countBadgeId);
            const checkboxes = getCheckboxes();
            const selected = getSelectedIds();
            const total = checkboxes.length;

            if (countBadge) countBadge.innerText = selected.length;

            if (btnDelete) {
                if (selected.length > 0) {
                    btnDelete.classList.remove('hidden');
                    btnDelete.classList.add('inline-flex');
                } else {
                    btnDelete.classList.add('hidden');
                    btnDelete.classList.remove('inline-flex');
                }
            }

            if (selectAllEl) {
                selectAllEl.checked = total > 0 && selected.length === total;
                selectAllEl.indeterminate = selected.length > 0 && selected.length < total;
            }

            checkboxes.forEach(cb => {
                const tr = cb.closest('tr');
                if (tr) {
                    if (cb.checked) {
                        tr.classList.add('bg-blue-50/50');
                    } else {
                        tr.classList.remove('bg-blue-50/50');
                    }
                }
            });
        }

        // Delegate SelectAll & Row checkboxes
        document.addEventListener('change', function(e) {
            if (e.target && e.target.id === selectAllId) {
                const checkboxes = getCheckboxes();
                checkboxes.forEach(cb => {
                    cb.checked = e.target.checked;
                });
                updateState();
            } else if (e.target && e.target.classList && e.target.classList.contains(checkboxClass)) {
                updateState();
            }
        });

        // Delegate Delete Button
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('#' + btnDeleteId);
            if (btn) {
                e.preventDefault();
                const ids = getSelectedIds();
                if (ids.length === 0) {
                    if (window.showToast) window.showToast('Vui lòng chọn ít nhất 1 ' + itemLabel + ' để xóa.', 'warning');
                    return;
                }

                openGlobalDeleteModal({
                    title: 'Xóa nhiều ' + itemLabel + '?',
                    message: `Bạn có chắc chắn muốn xóa <strong class="text-rose-600 font-bold">${ids.length}</strong> ${itemLabel} đã chọn?`,
                    warning: 'Hành động này mang tính vĩnh viễn và không thể hoàn tác sau khi xác nhận.',
                    submitText: `Xóa ${ids.length} ${itemLabel}`,
                    icon: 'delete_sweep',
                    onConfirm: async function() {
                        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                        try {
                            const res = await fetch(deleteUrl, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-Requested-With': 'XMLHttpRequest',
                                    'RequestVerificationToken': csrfToken
                                },
                                body: JSON.stringify(ids)
                            });
                            const data = await res.json();
                            if (data.success) {
                                if (window.showToast) window.showToast(data.message, 'success');
                                if (typeof onSuccess === 'function') {
                                    onSuccess(data);
                                } else {
                                    window.location.reload();
                                }
                            } else {
                                if (window.showToast) window.showToast(data.message, 'error');
                            }
                        } catch (err) {
                            console.error(err);
                            if (window.showToast) window.showToast('Đã xảy ra lỗi khi thực hiện xóa.', 'error');
                        }
                    }
                });
            }
        });

        updateState();
        return { updateState, getSelectedIds };
    };
</script>
